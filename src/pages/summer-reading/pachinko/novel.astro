      '<circle cx="' + c + '" cy="' + c + '" r="' + ro + '" stroke="var(--p-teal)" stroke-width="1.5"/>' +
      '<circle cx="' + c + '" cy="' + c + '" r="' + ri + '" stroke="var(--p-teal)" stroke-width="1"/>' +
      '<path d="M ' + c + ' ' + (c - r2) + ' A ' + r2 + ' ' + r2 + ' 0 0 0 ' + c + ' ' + (c + r2) + ' Z" fill="' + W + '" opacity="0.85"/>' +
      '<path d="M ' + c + ' ' + (c - r2) + ' A ' + r2 + ' ' + r2 + ' 0 0 1 ' + c + ' ' + (c + r2) + ' Z" fill="' + C + '" opacity="0.85"/>' +
      '<circle cx="' + c + '" cy="' + c + '" r="' + dot + '" fill="var(--p-gold)"/></svg>';
  }

  function butterfly(size: number): string {
