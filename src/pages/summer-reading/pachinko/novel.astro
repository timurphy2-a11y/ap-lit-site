      left.concat(right).forEach(function (p: number[]) {
        parts.push('<circle cx="' + p[0] + '" cy="' + p[1] + '" r="2.6" fill="var(--p-teal)"/>');
      });
      interior.forEach(function (p: number[]) {
        parts.push('<circle cx="' + p[0] + '" cy="' + p[1] + '" r="2.2" fill="var(--p-teal)" opacity="0.45"/>');
      });
      parts.push('<path d="M40 54 L88 178" stroke="var(--p-teal)" stroke-width="0.8" opacity="0.25"/>');
      parts.push('<path d="M160 54 L112 178" stroke="var(--p-teal)" stroke-width="0.8" opacity="0.25"/>');
      parts.push('<path d="M100 70 C 76 78, 60 80, 52 80" fill="none" stroke="var(--p-orange)" stroke-width="1.4" stroke-dasharray="2 4" opacity="0.55"/>');
      parts.push('<line x1="47" y1="75" x2="57" y2="85" stroke="var(--p-orange)" stroke-width="1.2" opacity="0.55"/>');
      parts.push('<line x1="57" y1="75" x2="47" y2="85" stroke="var(--p-orange)" stroke-width="1.2" opacity="0.55"/>');
      parts.push('<path d="M100 26 C 118 56, 84 84, 104 110 S 118 152, 100 180" fill="none" stroke="var(--p-gold)" stroke-width="1.6" stroke-dasharray="2 5" stroke-linecap="round"/>');
      parts.push('<circle cx="100" cy="186" r="6.5" fill="var(--p-gold)"/>');
      parts.push('<path d="M88 200 L100 192 L112 200" fill="none" stroke="var(--color-muted)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>');
      return '<svg viewBox="0 0 200 212" role="img" aria-label="A funnel of pachinko pins narrowing downward channels a single gold ball from an origin point to one exit; a faint dashed alternative path veers off and dies at a blocked pin." fill="none">' + parts.join('') + '</svg>';
    }
    parts.push('<circle cx="56" cy="62" r="24" fill="none" stroke="var(--p-teal)" stroke-width="1.3" stroke-dasharray="3 5" opacity="0.45"/>');
    parts.push('<circle cx="144" cy="62" r="24" fill="none" stroke="var(--color-muted)" stroke-width="1.3" stroke-dasharray="3 5" opacity="0.5"/>');
    parts.push('<text x="56" y="66" text-anchor="middle" font-family="var(--font-mono)" font-size="8" letter-spacing="1" fill="var(--p-teal)" opacity="0.6">KOREA</text>');
    parts.push('<text x="144" y="66" text-anchor="middle" font-family="var(--font-mono)" font-size="8" letter-spacing="1" fill="var(--color-muted)" opacity="0.6">JAPAN</text>');
    parts.push('<line x1="22" y1="156" x2="178" y2="156" stroke="var(--color-rule)" stroke-width="1" opacity="0.7"/>');
    parts.push('<path d="M30 156 q14 -12 28 0" fill="none" stroke="var(--color-muted)" stroke-width="1.4"/>');
    parts.push('<rect x="38" y="150" width="12" height="10" rx="1" transform="rotate(-12 44 155)" fill="none" stroke="var(--p-orange)" stroke-width="1.3"/>');
    parts.push('<path d="M52 150 C 72 120, 100 104, 128 150" fill="none" stroke="var(--p-gold)" stroke-width="1.6" stroke-dasharray="2 5" stroke-linecap="round"/>');
    parts.push('<circle cx="132" cy="150" r="5.5" fill="var(--p-gold)"/>');
    parts.push('<path d="M160 138 A 15 15 0 0 0 160 162" fill="none" stroke="var(--p-gold)" stroke-width="2.4" stroke-linecap="round"/>');
    parts.push('<circle cx="156" cy="150" r="3" fill="var(--p-gold)"/>');
    return '<svg viewBox="0 0 200 184" role="img" aria-label="Two faint rings labelled Korea and Japan; a journey of gold dots leaves a grave, passes between the nations, and arrives at an open arc that waits." fill="none">' + parts.join('') + '</svg>';
  }

  function bookPlate(which: string | null): string {
    var C = 110, parts: string[] = [];
    function open(extra: string): string {
      return '<svg viewBox="0 0 220 220" role="img" aria-label="' + (extra || '') + '" fill="none">';
    }
    if (which === 'dickens') {
      parts.push('<circle cx="110" cy="110" r="86" stroke="var(--p-teal)" stroke-width="1.6" opacity="0.4"/>');
      parts.push('<circle cx="110" cy="110" r="66" stroke="var(--p-teal)" stroke-width="1.6" opacity="0.6"/>');
      parts.push('<circle cx="110" cy="110" r="44" stroke="var(--p-teal)" stroke-width="1.8"/>');
      var pins: number[][] = [[110, 24], [158, 52], [186, 110], [158, 168], [62, 168], [34, 110], [62, 52]];
      pins.forEach(function (p: number[]) {
        var dx = 110 - p[0], dy = 110 - p[1], L = Math.hypot(dx, dy);
        var x2 = p[0] + dx / L * (L - 50), y2 = p[1] + dy / L * (L - 50);
        parts.push('<line x1="' + p[0] + '" y1="' + p[1] + '" x2="' + x2.toFixed(1) + '" y2="' + y2.toFixed(1) + '" stroke="var(--p-orange)" stroke-width="1" stroke-dasharray="2 4" opacity="0.55"/>');
        parts.push('<circle cx="' + p[0] + '" cy="' + p[1] + '" r="2.4" fill="var(--p-orange)" opacity="0.7"/>');
      });
      parts.push('<path d="M 196 110 A 86 86 0 0 1 150 184" stroke="var(--p-orange)" stroke-width="2" stroke-dasharray="3 5" stroke-linecap="round"/>');
      parts.push('<circle cx="110" cy="110" r="12" fill="var(--p-gold)"/>');
      parts.push('<circle cx="110" cy="110" r="20" stroke="var(--p-gold)" stroke-width="1" opacity="0.6"/>');
      return open('Concentric rings drawing inward; dotted paths converge on a gold core.') + parts.join('') + '</svg>';
    }
    if (which === 'park') {
      parts.push('<circle cx="110" cy="110" r="84" stroke="var(--p-teal)" stroke-width="2"/>');
      parts.push('<defs><clipPath id="pkClipPark"><circle cx="110" cy="110" r="84"/></clipPath></defs>');
      parts.push('<g clip-path="url(#pkClipPark)">');
      parts.push('<path d="M26 138 q26 -30 52 0 t52 0 t52 0 t52 0" stroke="var(--p-orange)" stroke-width="1.6" opacity="0.75"/>');
      parts.push('<path d="M26 156 q26 -26 52 0 t52 0 t52 0 t52 0" stroke="var(--p-orange)" stroke-width="1.4" opacity="0.4"/>');
      var grid: number[][] = [[70, 70], [110, 60], [150, 70], [88, 96], [132, 96], [110, 110]];
      grid.forEach(function (g: number[]) { parts.push('<circle cx="' + g[0] + '" cy="' + g[1] + '" r="3" fill="var(--p-teal)" opacity="0.8"/>'); });
      parts.push('<line x1="180" y1="26" x2="180" y2="194" stroke="var(--color-muted)" stroke-width="1.4" stroke-dasharray="3 5" opacity="0.7"/>');
      parts.push('</g>');
      parts.push('<circle cx="110" cy="110" r="3" fill="var(--p-gold)"/>');
      return open('A boundaryless circle of identical pins over a hill horizon; one faint dashed border enters the frame.') + parts.join('') + '</svg>';
    }
    var n = 10, R = 70, nodes: number[][] = [];
    for (var i = 0; i < n; i++) {
      var a = (i / n) * 2 * Math.PI - Math.PI / 2;
      nodes.push([C + R * Math.cos(a), C + R * Math.sin(a)]);
    }
    for (var x = 0; x < n; x++) {
      for (var step = 2; step <= 3; step++) {
        var y2i = (x + step) % n;
        parts.push('<line x1="' + nodes[x][0].toFixed(1) + '" y1="' + nodes[x][1].toFixed(1) + '" x2="' + nodes[y2i][0].toFixed(1) + '" y2="' + nodes[y2i][1].toFixed(1) + '" stroke="var(--p-teal)" stroke-width="0.7" opacity="0.28"/>');
      }
    }
    parts.push('<circle cx="110" cy="110" r="70" stroke="var(--p-teal)" stroke-width="2"/>');
    nodes.forEach(function (p: number[]) { parts.push('<circle cx="' + p[0].toFixed(1) + '" cy="' + p[1].toFixed(1) + '" r="3.4" fill="var(--p-teal)"/>'); });
    parts.push('<circle cx="110" cy="110" r="4" fill="var(--p-gold)" opacity="0.5"/>');
    parts.push('<circle cx="200" cy="150" r="5" fill="none" stroke="var(--p-orange)" stroke-width="1.8"/>');
    parts.push('<circle cx="200" cy="150" r="2" fill="var(--p-orange)"/>');
    parts.push('<line x1="176" y1="146" x2="192" y2="149" stroke="var(--p-orange)" stroke-width="1" stroke-dasharray="2 3" opacity="0.6"/>');
    return open('A closed rosette of connected pins forming a bounded community; one orange pin stranded outside the ring.') + parts.join('') + '</svg>';
  }

  function buildMotifs(): void {
    document.querySelectorAll('[data-motif]').forEach(function (el) {
      var k = el.getAttribute('data-motif');
      var size = parseInt(el.getAttribute('data-size') || '40', 10);
      var w = parseFloat(el.getAttribute('data-w') || '80');
      var op = parseFloat(el.getAttribute('data-op') || '0.7');
      var color = el.getAttribute('data-color') || 'var(--p-orange)';
      if (k === 'medallion-flip') el.innerHTML = medallionFlip(size);
      else if (k === 'rosette') el.innerHTML = rosette(size, 'var(--p-orange)', 20);
      else if (k === 'butterfly') el.innerHTML = butterfly(size);
      else if (k === 'floral') el.innerHTML = floral(w, 'var(--p-orange)');
      else if (k === 'pk-glyph') el.innerHTML = pkGlyph(parseInt(el.getAttribute('data-idx') || '4', 10), w, color);
      else if (k === 'pk-crest') el.innerHTML = pkCrest(w, color, op);
      else if (k === 'pk-plate') el.innerHTML = bookPlate(el.getAttribute('data-plate'));
      else if (k === 'pk-register') el.innerHTML = registerPanel(el.getAttribute('data-side'));
      else if (k === 'pk-figure') el.innerHTML = sectionFigure(el.getAttribute('data-fig'));
    });
  }

  /* ── Boot ── */
  function boot(): void {
    buildMotifs();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
