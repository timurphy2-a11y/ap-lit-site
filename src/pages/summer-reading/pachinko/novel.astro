  }

  function pkCrest(size: number, color: string, op: number): string {
    var C = 200, parts: string[] = [], i: number, a: number;
    parts.push('<circle cx="200" cy="200" r="168" fill="none" stroke="' + color + '" stroke-width="0.8" opacity="0.4"/>');
    parts.push('<circle cx="200" cy="200" r="146" fill="none" stroke="' + color + '" stroke-width="0.8" opacity="0.3"/>');
    for (i = 0; i < 5; i++) {
      a = (i / 5) * 2 * Math.PI - Math.PI / 2;
      parts.push('<line x1="' + (C + 40 * Math.cos(a)).toFixed(1) + '" y1="' + (C + 40 * Math.sin(a)).toFixed(1) +
        '" x2="' + (C + 162 * Math.cos(a)).toFixed(1) + '" y2="' + (C + 162 * Math.sin(a)).toFixed(1) +
        '" stroke="' + color + '" stroke-width="1.1" opacity="0.55"/>');
    }
    for (i = 0; i < 5; i++) {
      var base = (i / 5) * 2 * Math.PI - Math.PI / 2 + Math.PI / 5;
      for (var row = 0; row < 4; row++) {
        var rr = 64 + row * 26;
        for (var k = -row; k <= row; k += 2) {
          var aa = base + (k * 0.052);
          parts.push('<circle cx="' + (C + rr * Math.cos(aa)).toFixed(1) + '" cy="' + (C + rr * Math.sin(aa)).toFixed(1) + '" r="1.7" fill="' + color + '" opacity="0.45"/>');
        }
      }
    }
    var balls: [number, number][] = [[150, 120], [262, 150], [236, 262], [128, 236]];
    balls.forEach(function (b) { parts.push('<circle cx="' + b[0] + '" cy="' + b[1] + '" r="4" fill="var(--p-gold)" opacity="0.7"/>'); });
    parts.push('<circle cx="200" cy="200" r="34" fill="none" stroke="' + color + '" stroke-width="1.4" opacity="0.85"/>');
    parts.push('<circle cx="200" cy="200" r="27" fill="none" stroke="' + color + '" stroke-width="0.8" opacity="0.55"/>');
    parts.push('<path d="M200 206 C190 206, 176 214, 176 202 C176 194, 190 198, 200 206Z" fill="' + color + '" opacity="0.5"/>');
    parts.push('<path d="M200 206 C210 206, 224 214, 224 202 C224 194, 210 198, 200 206Z" fill="' + color + '" opacity="0.5"/>');
    parts.push('<path d="M200 200 C194 196, 184 188, 186 184 C188 180, 196 188, 200 200Z" fill="var(--p-gold)" opacity="0.6"/>');
    parts.push('<path d="M200 200 C206 196, 216 188, 214 184 C212 180, 204 188, 200 200Z" fill="var(--p-gold)" opacity="0.6"/>');
    return '<svg viewBox="0 0 400 400" width="' + size + '" height="' + size + '" fill="none" aria-hidden="true" style="display:block;overflow:visible;opacity:' + op + '">' + parts.join('') + '</svg>';
  }

  function registerPanel(which: string | null): string {
    var cx = 100, cy = 96, parts: string[] = [];
    function wrap(label: string): string {
      return '<svg viewBox="0 0 200 200" role="img" aria-label="' + label + '" fill="none">' + parts.join('') + '</svg>';
    }
    if (which === 'fingerprint') {
      for (var i = 0; i < 6; i++) {
        var rx = 20 + i * 13, ry = 24 + i * 14, y0 = cy + ry * 0.5;
        parts.push('<path d="M ' + (cx - rx) + ' ' + y0.toFixed(1) +
          ' C ' + (cx - rx) + ' ' + (cy - ry) + ', ' + (cx + rx) + ' ' + (cy - ry) + ', ' + (cx + rx) + ' ' + y0.toFixed(1) +
          '" fill="none" stroke="var(--p-teal)" stroke-width="1.3" opacity="' + (0.85 - i * 0.09).toFixed(2) + '" stroke-linecap="round"/>');
      }
      [[100, 40], [80, 56], [120, 56], [66, 80], [134, 80], [90, 70], [110, 70]].forEach(function (p: number[]) {
        parts.push('<circle cx="' + p[0] + '" cy="' + p[1] + '" r="1.7" fill="var(--p-teal)" opacity="0.6"/>');
      });
      parts.push('<circle cx="' + cx + '" cy="' + (cy + 6) + '" r="9" fill="var(--p-gold)"/>');
      parts.push('<circle cx="' + cx + '" cy="' + (cy + 6) + '" r="14" fill="none" stroke="var(--p-gold)" stroke-width="1" opacity="0.5"/>');
      return wrap('A fingerprint whose ridges are nested arches dotted with pachinko pins, a single gold ball pressed at its core like an inkpad.');
    }
    var r = 54;
    function pt(ang: number, rad: number): string[] { return [(cx + Math.cos(ang) * rad).toFixed(1), (cy + Math.sin(ang) * rad).toFixed(1)]; }
    var gapStart = -0.30, gapEnd = -0.86, gapMid = -0.58;
    var s = pt(gapStart, r), e = pt(gapEnd, r);
    parts.push('<path d="M ' + s[0] + ' ' + s[1] + ' A ' + r + ' ' + r + ' 0 1 1 ' + e[0] + ' ' + e[1] + '" fill="none" stroke="var(--p-teal)" stroke-width="2.4"/>');
    parts.push('<circle cx="' + cx + '" cy="' + cy + '" r="40" fill="none" stroke="var(--p-teal)" stroke-width="1" opacity="0.4"/>');
    parts.push('<circle cx="' + cx + '" cy="' + cy + '" r="8" fill="none" stroke="var(--p-gold)" stroke-width="1.3" opacity="0.5"/>');
    var out = pt(gapMid, r + 32);
    parts.push('<path d="M ' + cx + ' ' + cy + ' Q 132 74, ' + out[0] + ' ' + out[1] + '" fill="none" stroke="var(--p-orange)" stroke-width="1.6" stroke-dasharray="2 5" stroke-linecap="round"/>');
    parts.push('<circle cx="' + out[0] + '" cy="' + out[1] + '" r="9" fill="var(--p-gold)"/>');
    return wrap('A medallion ring with a gap at its upper edge, expelling a gold ball outward past the rim along a dotted path — the same ball, now cast out.');
  }

  function sectionFigure(which: string | null): string {
    var parts: string[] = [];
    if (which === 'channel') {
      parts.push('<circle cx="100" cy="22" r="3.5" fill="var(--p-teal)"/>');
      var left: number[][] = [[40, 54], [50, 80], [60, 106], [70, 132], [80, 156], [88, 178]];
