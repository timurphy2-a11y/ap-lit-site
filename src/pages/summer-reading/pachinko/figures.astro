---
import SummerLayout from '../../../layouts/SummerLayout.astro';
import SpokePagination from '../../../components/summer-reading/SpokePagination.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('summerReading', 'pachinko/figures');
const { Content } = await render(entry);
---
<SummerLayout title={entry.data.title} section="pachinko" spoke="figures">
  <Content />
  <SpokePagination
    section="pachinko"
    prev={{ slug: 'history', title: 'Zainichi', number: 3 }}
    next={{ slug: 'novel', title: 'Connections', number: 5 }}
  />
</SummerLayout>
