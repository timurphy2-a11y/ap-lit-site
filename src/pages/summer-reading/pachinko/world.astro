---
import SummerLayout from '../../../layouts/SummerLayout.astro';
import SpokePagination from '../../../components/summer-reading/SpokePagination.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('summerReading', 'pachinko/world');
const { Content } = await render(entry);
---
<SummerLayout title={entry.data.title} section="pachinko" spoke="world">
  <Content />
  <SpokePagination section="pachinko" next={{ slug: 'culture', title: 'Identity', number: 2 }} />
</SummerLayout>
