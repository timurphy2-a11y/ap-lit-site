---
import SummerLayout from '../../../layouts/SummerLayout.astro';
import SpokePagination from '../../../components/summer-reading/SpokePagination.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('summerReading', 'pachinko/culture');
const { Content } = await render(entry);
---
<SummerLayout title={entry.data.title} section="pachinko" spoke="culture">
  <Content />
  <SpokePagination
    section="pachinko"
    prev={{ slug: 'world', title: 'The World of the Novel', number: 1 }}
    next={{ slug: 'history', title: 'Japanese Colonialism', number: 3 }}
  />
</SummerLayout>
