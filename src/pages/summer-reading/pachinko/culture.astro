    s += '<path class="ln" d="M ' + (wx - 15) + ' ' + (wy - 8) + ' L ' + (wx + 13) + ' ' + (wy - 12) + ' L ' + (wx + 17) + ' ' + (wy + 6) + ' L ' + (wx - 11) + ' ' + (wy + 10) + ' Z"/>';
    s += '<path class="ln-fine" d="M ' + (wx + 20) + ' ' + (wy - 10) + ' q 8 2 6 10 M ' + (wx + 22) + ' ' + (wy + 2) + ' q 9 1 7 10"/>';
    s += '<path class="ln-fine" d="M 150 ' + (g - 2) + ' q 18 -10 40 -6 M 156 ' + (g + 2) + ' q 16 -6 34 -3"/>';
    s += jdxBloom(158, g - 12, 15) + jdxBloom(190, g - 7, 13);
    s += '<path class="speech" d="M ' + (cx + 34) + ' ' + (g - 150) + ' C ' + (cx + 78) + ' ' + (g - 168) + ' ' + (cx + 70) + ' ' + (g - 212) + ' ' + (cx + 108) + ' ' + (g - 232) + '"/><circle class="dot" cx="' + (cx + 112) + '" cy="' + (g - 236) + '" r="2"/>';
    var nx = 92, ny = 120;
    s += '<path class="ghost" d="M ' + (nx - 16) + ' ' + ny + ' q -6 -10 4 -14 q 12 -5 24 2 q 11 7 4 16 q -6 8 -18 5 q -12 -3 -14 -9 z"/><path class="ln-fine" d="M ' + (nx - 8) + ' ' + (ny - 3) + ' q 8 6 18 1" opacity="0.6"/>';
    s += jdxLeader(120, g - 28, 156, g - 16) + jdxLbl(20, g - 30, '국화', 'gukhwa', 'the flower she carries');
    s += jdxLeader(240, 346, 212, 360) + jdxLbl(242, 334, '닦다', 'dakda', 'wiping a clean stone');
    s += jdxLbl(cx + 118, g - 244, '말', 'mal', 'the words she still says');
    s += jdxLbl(nx - 36, ny - 48, '호박엿', 'hobak-yeot · pumpkin taffy', 'for a son with no grave');
    s += '<text x="' + (nx - 30) + '" y="' + (ny + 30) + '" class="t-en-cold">offered only in memory</text>';
    return s + '</svg>';
  }
  function buildJdx() {
    var riteEl = document.getElementById('jdx-rite');
    var echoEl = document.getElementById('jdx-echo');
    if (riteEl) riteEl.innerHTML = rite();
    if (echoEl) echoEl.innerHTML = echo();
  }

  function initCoda() {
    var field = document.querySelector('.sr-scrolly-zone--coda .coda-field');
    if (!field) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    field.classList.add('coda-motion');
    function check() {
      var r = field.getBoundingClientRect();
      if (r.top < window.innerHeight * 0.82 && r.bottom > window.innerHeight * 0.12) field.classList.add('is-revealed');
    }
    window.addEventListener('scroll', check, { passive: true });
    check();
    observers.push({ disconnect: function () { window.removeEventListener('scroll', check); } });
  }

  /* ───────────────────── Diagram 1 · PILLARS (pin-stack, B) ───────────── */
  var PX = [185, 310, 435], PLABELS = ['LANGUAGE', 'NAMES', 'RELIGION'];
  function warmCap(i, x) {
    if (i === 0) return '<rect x="' + (x - 48) + '" y="70" width="96" height="62" rx="2" fill="' + WW + '" stroke="' + W + '" stroke-width="1.5"/>' +
      '<text x="' + x + '" y="114" text-anchor="middle" class="idg-kr" font-size="30" fill="' + W + '">한글</text>';
    if (i === 1) return '<rect x="' + (x - 26) + '" y="54" width="52" height="100" rx="2" fill="' + WW + '" stroke="' + W + '" stroke-width="1.5"/>' +
      '<text x="' + x + '" y="98" text-anchor="middle" class="idg-kr" font-size="28" fill="' + W + '">金</text>' +
      '<text x="' + x + '" y="138" text-anchor="middle" class="idg-kr" font-size="20" fill="' + W + '" opacity="0.72">氏</text>';
    return '<line x1="' + x + '" y1="62" x2="' + x + '" y2="142" stroke="' + W + '" stroke-width="3" stroke-linecap="round"/>' +
      '<line x1="' + (x - 24) + '" y1="90" x2="' + (x + 24) + '" y2="90" stroke="' + W + '" stroke-width="3" stroke-linecap="round"/>';
  }
  function coldMark(i, x) {
    if (i === 0) return '<text x="' + x + '" y="116" text-anchor="middle" class="idg-jp" font-size="30" fill="' + C + '" transform="rotate(-7 ' + x + ' 108)">国語</text>';
    if (i === 1) return '<text x="' + (x + 4) + '" y="108" text-anchor="middle" class="idg-jp" font-size="27" fill="' + C + '" transform="rotate(-7 ' + (x + 4) + ' 100)">金本</text>';
    return '<path d="M ' + (x - 34) + ' 86 Q ' + x + ' 74 ' + (x + 34) + ' 86" fill="none" stroke="' + C + '" stroke-width="4"/>' +
      '<line x1="' + (x - 23) + '" y1="102" x2="' + (x + 23) + '" y2="102" stroke="' + C + '" stroke-width="3"/>' +
      '<line x1="' + (x - 18) + '" y1="88" x2="' + (x - 18) + '" y2="146" stroke="' + C + '" stroke-width="4"/>' +
      '<line x1="' + (x + 18) + '" y1="88" x2="' + (x + 18) + '" y2="146" stroke="' + C + '" stroke-width="4"/>';
  }
  function pressMark(x) {
    return '<line x1="' + (x - 58) + '" y1="160" x2="' + (x + 58) + '" y2="160" stroke="' + C + '" stroke-width="2.5"/>' +
      '<line x1="' + (x + 58) + '" y1="160" x2="' + (x + 58) + '" y2="170" stroke="' + C + '" stroke-width="2.5"/>';
  }
  function shaftPins(x, cold) {
    var s = '', row = 0;
    for (var y = 198; y <= 462; y += 33, row++) {
      var xs = (row % 2 === 0) ? [x - 17, x + 17] : [x];
      for (var k = 0; k < xs.length; k++) {
        s += cold
          ? '<circle cx="' + xs[k] + '" cy="' + y + '" r="8.5" fill="' + CW + '" stroke="' + C + '" stroke-width="2"/>'
          : '<circle cx="' + xs[k] + '" cy="' + y + '" r="8.5" fill="' + W + '"/>';
      }
    }
    return s;
  }
  function pillarsSVG() {
    var s = '<svg viewBox="0 0 620 560" fill="none" role="img" aria-label="Three pillars — Language, Names, Religion — each a stack of warm Korean pins capped by a Korean artifact, overdrawn pillar by pillar with a cold colonial mark and knocked cold.">';
    for (var i = 0; i < 3; i++) {
      var x = PX[i];
      s += '<g class="pp-warm-' + (i + 1) + '">' + warmCap(i, x) + shaftPins(x, false) + '</g>';
      s += '<g class="pp-cold-' + (i + 1) + '">' + coldMark(i, x) + shaftPins(x, true) + '</g>';
      s += '<g class="pp-press-' + (i + 1) + '">' + pressMark(x) + '</g>';
      s += '<text x="' + x + '" y="512" text-anchor="middle" class="idg-label" font-size="15">' + PLABELS[i] + '</text>';
    }
    s += '<line x1="148" y1="478" x2="472" y2="478" stroke="var(--color-rule)" stroke-width="1"/>';
    return s + '</svg>';
  }

  /* ───────────────────── Diagram 2 · DESCENT (accumulate) ─────────────── */
  function descentSVG() {
    var cx = 150, CYS = [128, 348, 568], SHELL = [6, 16, 26], CORE = [44, 26, 9];
    var GENS = [
      ['ISSEI · FIRST GENERATION', 'Sunja · Isak', 'names, language, faith intact'],
      ['NISEI · SECOND GENERATION', 'Noa · Mozasu', 'stateless in the only home they know'],
      ['SANSEI · THIRD GENERATION', 'Solomon', 'measured, still, by the name — the filament holds']
    ];
    var FIL = [[66, 192], [192, 412], [412, 628]];
    var s = '<svg viewBox="0 0 560 690" fill="none" role="img" aria-label="A vertical generational descent: Issei, Nisei, Sansei. Each is a warm Korean core inside a cold tsumei shell; the core recedes and the shell thickens down the generations, but a warm filament threading them never reaches zero.">';
    s += '<line x1="40" y1="88" x2="40" y2="606" stroke="var(--color-rule)" stroke-width="1" stroke-dasharray="2 5"/>' +
         '<path d="M 35 600 L 40 612 L 45 600" fill="none" stroke="var(--color-rule)" stroke-width="1"/>';
    for (var i = 0; i < 3; i++) {
      var cy = CYS[i], g = GENS[i];
      s += '<g class="dgen-' + (i + 1) + '">';
      s += '<line x1="' + cx + '" y1="' + FIL[i][0] + '" x2="' + cx + '" y2="' + FIL[i][1] + '" stroke="' + W + '" stroke-width="2" opacity="0.55"/>';
      if (i === 2) s += '<circle cx="' + cx + '" cy="636" r="3.5" fill="' + W + '"/>';
      s += '<circle cx="' + cx + '" cy="' + cy + '" r="62" stroke="' + C + '" stroke-width="' + SHELL[i] + '"/>';
      s += '<circle cx="' + cx + '" cy="' + cy + '" r="' + CORE[i] + '" fill="' + W + '"/>';
      s += '<text x="256" y="' + (cy - 22) + '" class="idg-mono" font-size="13" letter-spacing="2" fill="' + CD + '">' + g[0] + '</text>';
      s += '<text x="256" y="' + (cy + 8) + '" class="idg-disp" font-size="25" fill="var(--color-ink)">' + g[1] + '</text>';
      s += '<text x="256" y="' + (cy + 32) + '" class="idg-cap" font-size="11.5">' + g[2] + '</text>';
      s += '</g>';
    }
    return s + '</svg>';
  }

  /* ────────────── Diagram 3 · REGISTER (accumulate) — Zone 4 ──────────────
   * Three ledger rows — Sunja (held), Noa (erased, stamp lands),
   * Solomon (refracted, fingerprinted) — accumulate across o-1…o-4.
   * HTML (not SVG) so the stamp/strike can transition; visibility still
   * resolves in CSS off field[data-state] (gotcha D). */
  function registerHTML() {
    return '<div class="rgz" role="img" aria-label="An alien-registration ledger with three rows. Sunja: her Korean name held, the passing name only an outline in the margin. Noa: his Korean name struck through, the tsumei Bando stamped over it and rewritten as Nobuo. Solomon: one name in three scripts beside a fingerprint. The real-name column never empties.">' +
      '<div class="rgz-dochead"><span class="rgz-dochead-jp idg-jp">外国人登録</span>' +
        '<span class="rgz-dochead-en idg-mono">REGISTRATION — the institution precedes the person</span></div>' +
      '<div class="rgz-cols idg-mono"><span class="rgz-col rgz-col--warm">本名 · the real name</span>' +
        '<span class="rgz-col rgz-col--cold">通名 · the passing name</span><span class="rgz-col"></span></div>' +
      '<div class="rgz-row rgz-row--1">' +
        '<div class="rgz-name"><span class="rgz-kr idg-kr">순자</span><span class="rgz-kr-sub idg-jp">順子</span></div>' +
        '<div class="rgz-tsumei"><span class="rgz-stamp rgz-stamp--line idg-jp">坂東</span></div>' +
        '<div class="rgz-rownote idg-mono">carried, rarely used — inside Ikaino the real name is the working surface</div>' +
      '</div>' +
      '<div class="rgz-row rgz-row--2">' +
        '<div class="rgz-name"><span class="rgz-kr rgz-kr--struck idg-kr">노아</span></div>' +
        '<div class="rgz-tsumei"><span class="rgz-stamp rgz-stamp--solid idg-jp">坂東</span><span class="rgz-rewrite idg-mono">NOBUO</span></div>' +
        '<div class="rgz-rownote idg-mono">registered at Waseda as Bandō Nobuo — the stamp becomes the self</div>' +
      '</div>' +
      '<div class="rgz-row rgz-row--3">' +
        '<div class="rgz-name"><span class="rgz-kr idg-kr">솔로몬</span></div>' +
        '<div class="rgz-tsumei rgz-tsumei--sol"><span class="rgz-scripts"><span class="rgz-scripts-jp idg-jp">ソロモン</span><span class="rgz-scripts-en idg-mono">SOLOMON</span></span><span class="rgz-print" aria-hidden="true"></span></div>' +
        '<div class="rgz-rownote idg-mono">fingerprinted at fourteen at the ward office — three scripts, one register</div>' +
      '</div>' +
      '<div class="rgz-annot idg-mono">the 本名 column never empties</div>' +
    '</div>';
  }

  function buildDiagrams() {
    document.querySelectorAll('[data-diagram]').forEach(function (el) {
      var k = el.getAttribute('data-diagram');
      if (k === 'pillars') el.innerHTML = pillarsSVG();
      else if (k === 'descent') el.innerHTML = descentSVG();
      else if (k === 'overwrite') el.innerHTML = registerHTML();
    });
  }

  /* ───────────────────────── Scrolly observers ──────────────────────── */
  var observers = [];
  function disconnectAll() { observers.forEach(function (o) { o.disconnect(); }); observers = []; }

  var FIELD_SEL = '.sr-scrolly-zone[data-field="photo"], .sr-scrolly-zone[data-field="pillars"], .sr-scrolly-zone[data-field="descent"], .sr-scrolly-zone[data-field="overwrite"]';

  function initBeatFields() {
    var zones = [];
    document.querySelectorAll(FIELD_SEL).forEach(function (zone) {
      var field = zone.querySelector('.sr-zone-field');
      var beats = [].slice.call(zone.querySelectorAll('[data-beat][data-activates]'));
      if (!field || !beats.length) return;
      field.dataset.state = beats[0].dataset.activates;
      beats[0].classList.add('is-active');
      zones.push({ field: field, beats: beats });
    });
    if (!zones.length) return;

    var TRIGGER = 0.55;
    var ticking = false;
    function update() {
      ticking = false;
      var line = window.innerHeight * TRIGGER;
      zones.forEach(function (z) {
        var fr = z.field.getBoundingClientRect();
        if (fr.bottom <= 0 || fr.top >= window.innerHeight) return;
        var active = z.beats[0];
        z.beats.forEach(function (b) {
          var r = b.getBoundingClientRect();
          if ((r.top + r.height / 2) <= line) active = b;
        });
        if (z.field.dataset.state !== active.dataset.activates) z.field.dataset.state = active.dataset.activates;
        z.beats.forEach(function (b) { b.classList.toggle('is-active', b === active); });
      });
    }
    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(update); } }
    window.addEventListener('scroll', onScroll, { passive: true });
    update();
    observers.push({ disconnect: function () { window.removeEventListener('scroll', onScroll); } });
  }

  function setStaticFinalStates() {
    document.querySelectorAll(FIELD_SEL).forEach(function (zone) {
      var field = zone.querySelector('.sr-zone-field');
      var beats = zone.querySelectorAll('[data-beat][data-activates]');
      if (field && beats.length) field.dataset.state = beats[beats.length - 1].dataset.activates;
    });
  }

  function initOath() {
    document.querySelectorAll('.id-oath[data-oath="animated"]').forEach(function (el) {
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) e.target.classList.add('is-reciting'); });
      }, { threshold: 0.4 });
      obs.observe(el);
      observers.push(obs);
    });
  }

  function initZones() {
    disconnectAll();
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var mobile = window.innerWidth > 0 && window.innerWidth < 768;
    initOath();
    initCoda();
    if (reduced || mobile) { setStaticFinalStates(); return; }
    initBeatFields();
  }

  /* ───────────────────────── Variations panel ───────────────────────── */
  var DEFAULTS = { register: 'ember', tempo3: 'driving', thread: 'off', oath: 'static', dwell: 1 };
  var state = load();
  function load() {
    try { return Object.assign({}, DEFAULTS, JSON.parse(localStorage.getItem('pid-tweaks') || '{}')); }
    catch (e) { return Object.assign({}, DEFAULTS); }
  }
  function save() { try { localStorage.setItem('pid-tweaks', JSON.stringify(state)); } catch (e) {} }

  function apply() {
    var page = document.querySelector('.sr-page');
    page.setAttribute('data-register', state.register === 'ember' ? 'ember' : 'tealumber');
    page.setAttribute('data-thread', state.thread);
    document.documentElement.style.setProperty('--dwell-scale', String(state.dwell));
    var z3 = document.querySelector('.sr-scrolly-zone[data-field="descent"]');
    if (z3) z3.setAttribute('data-tempo', state.tempo3 === 'steady' ? 'steady' : 'driving');
    document.querySelectorAll('.id-oath').forEach(function (el) { el.setAttribute('data-oath', state.oath); });
  }

  function seg(key, label, opts) {
    var btns = opts.map(function (o) {
      return '<button class="pw-opt" data-key="' + key + '" data-val="' + o[0] + '">' + o[1] + '</button>';
    }).join('');
    return '<div class="pw-tweaks-row"><label class="pw-tweaks-label">' + label + '</label><div class="pw-seg">' + btns + '</div></div>';
  }
  function refresh(panel) {
    panel.querySelectorAll('.pw-opt').forEach(function (b) {
      b.classList.toggle('is-on', state[b.getAttribute('data-key')] === b.getAttribute('data-val'));
    });
  }
  function buildPanel() {
    var panel = document.createElement('div');
    panel.className = 'pw-tweaks';
    panel.innerHTML =
      '<button class="pw-tweaks-tab" aria-expanded="true" title="Toggle variations panel">Variations</button>' +
      '<div class="pw-tweaks-body">' +
        '<div class="pw-tweaks-title">Identity — explore</div>' +
        seg('register', 'Warm / cold register', [['ember', 'Ember · Graphite'], ['tealumber', 'Teal · Umber']]) +
        seg('tempo3', 'Zone 3 descent', [['driving', 'Driving'], ['steady', 'Steady']]) +
        seg('thread', 'Warm thread', [['off', 'Off'], ['on', 'On']]) +
        seg('oath', 'Oath of 1938', [['static', 'Static'], ['animated', 'Recited']]) +
        '<div class="pw-tweaks-row">' +
          '<label class="pw-tweaks-label">Scroll dwell <span class="pw-dwell-val">' + state.dwell.toFixed(2) + '×</span></label>' +
          '<input type="range" class="pw-slider" data-key="dwell" min="0.6" max="1.6" step="0.05" value="' + state.dwell + '" />' +
        '</div>' +
        '<button class="pw-reset">Reset</button>' +
      '</div>';
    document.body.appendChild(panel);

    panel.querySelector('.pw-tweaks-tab').addEventListener('click', function () {
      var open = panel.classList.toggle('is-collapsed');
      this.setAttribute('aria-expanded', String(!open));
    });
    panel.querySelectorAll('.pw-opt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        state[this.getAttribute('data-key')] = this.getAttribute('data-val');
        save(); apply(); refresh(panel); initZones();
      });
    });
    var slider = panel.querySelector('.pw-slider');
    slider.addEventListener('input', function () {
      state.dwell = parseFloat(this.value);
      panel.querySelector('.pw-dwell-val').textContent = state.dwell.toFixed(2) + '×';
      save(); apply();
    });
    panel.querySelector('.pw-reset').addEventListener('click', function () {
      state = Object.assign({}, DEFAULTS); save(); apply();
      slider.value = state.dwell;
      panel.querySelector('.pw-dwell-val').textContent = state.dwell.toFixed(2) + '×';
      refresh(panel); initZones();
    });
    refresh(panel);
  }

  /* ───────────────────────── Boot ───────────────────────── */
  function boot() {
    buildMotifs();
    buildDiagrams();
    buildJdx();
    apply();
    buildPanel();
    initZones();
    var rt;
    window.addEventListener('resize', function () {
      clearTimeout(rt);
      rt = setTimeout(function () { initZones(); }, 250);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
