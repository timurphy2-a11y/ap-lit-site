      if (!beats.length) return;
      beats[0].classList.add('is-active');
      if (field && beats[0].dataset.activates) field.dataset.state = beats[0].dataset.activates;
      var obs = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          beats.forEach(function (b) { b.classList.remove('is-active'); });
          e.target.classList.add('is-active');
          var s = e.target.dataset.activates;
          if (s && field) field.dataset.state = s;
        });
      }, { threshold: 0, rootMargin: '-40% 0px -40% 0px' });
      beats.forEach(function (b) { obs.observe(b); });
      observers.push(obs);
    });
  }

  var statusSweeps = [];
  function initStatus() {
    statusSweeps = [];
    document.querySelectorAll('.sr-scrolly-zone[data-field="map"]').forEach(function (zone) {
      var field = zone.querySelector('.sr-zone-field');
      var beats = Array.prototype.slice.call(zone.querySelectorAll('[data-beat]'));
      var ceil = field && field.querySelector('.sd-ceil');
      if (!field || !beats.length) return;
      function sweep() {
        var line = ceil ? ceil.getBoundingClientRect().top : window.innerHeight * 0.38;
        var lastPassed = -1;
        beats.forEach(function (el, i) {
          if (el.getBoundingClientRect().top <= line + 1) lastPassed = i;
        });
        beats.forEach(function (el, i) { el.classList.toggle('is-active', i === lastPassed); });
        if (lastPassed >= 0 && beats[lastPassed].dataset.activates) {
          field.dataset.state = beats[lastPassed].dataset.activates;
        } else {
          field.removeAttribute('data-state');
        }
      }
      statusSweeps.push(sweep);
      sweep();
    });
  }

  var cascadeSweeps = [];
  function initCascade() {
    cascadeSweeps = [];
    document.querySelectorAll('.sr-scrolly-zone[data-field="cascade"]').forEach(function (zone) {
      var entries = Array.prototype.slice.call(zone.querySelectorAll('.sr-cascade-entry'));
      var progress = zone.querySelector('.sr-zone-cascade-progress');
      if (!entries.length) return;
      function sweep() {
        var line = window.innerHeight * 0.5;
        var lastLit = -1;
        entries.forEach(function (el, i) {
          var rect = el.getBoundingClientRect();
          var anchor = rect.top + 8;
          var lit = anchor < line;
          var was = el.classList.contains('is-revealed');
          if (lit) {
            lastLit = i;
            if (!was) {
              el.classList.add('is-revealed');
              el.classList.remove('landed');
              void el.offsetWidth;
              el.classList.add('landed');
            }
          } else if (was) {
            el.classList.remove('is-revealed', 'landed');
          }
        });
        entries.forEach(function (el, i) { el.classList.toggle('is-newest', i === lastLit); });
        if (progress) progress.style.height = Math.max(0, Math.round(((lastLit + 1) / entries.length) * 100)) + '%';
      }
      cascadeSweeps.push(sweep);
      sweep();
    });
  }

  var sweepQueued = false;
  function runScrollSweeps() {
    if (sweepQueued) return;
    sweepQueued = true;
    var schedule = document.hidden
      ? function (fn) { setTimeout(fn, 16); }
      : function (fn) { requestAnimationFrame(fn); };
    schedule(function () {
      sweepQueued = false;
      cascadeSweeps.forEach(function (fn) { fn(); });
      statusSweeps.forEach(function (fn) { fn(); });
    });
  }

  function initZones() {
    disconnectAll();
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var w = window.innerWidth;
    var mobile = w > 0 && w < 768;
    if (reduced || mobile) return;
    initPhotoMap();
    initStatus();
    initCascade();
  }

  var DEFAULTS = { cascade: 'land', img: 'framed', dwell: 1 };
  var state = load();

  function load() {
    try {
      var s = JSON.parse(localStorage.getItem('pz-tweaks') || '{}');
      return Object.assign({}, DEFAULTS, s);
    } catch (e) { return Object.assign({}, DEFAULTS); }
  }
  function save() { try { localStorage.setItem('pz-tweaks', JSON.stringify(state)); } catch (e) {} }

  function apply() {
    var root = document.documentElement;
    var page = document.querySelector('.sr-page');
    if (page) page.setAttribute('data-img-mode', state.img);
    root.style.setProperty('--dwell-scale', String(state.dwell));
    document.querySelectorAll('.sr-scrolly-zone[data-field="cascade"]').forEach(function (z) {
      z.setAttribute('data-cascade-variant', state.cascade);
    });
  }

  function buildPanel() {
    var panel = document.createElement('div');
    panel.className = 'pw-tweaks';
    panel.innerHTML =
      '<button class="pw-tweaks-tab" aria-expanded="true" title="Toggle variations panel">Variations</button>' +
      '<div class="pw-tweaks-body">' +
        '<div class="pw-tweaks-title">Zainichi — explore</div>' +
        seg('cascade', 'Colonial timeline', [['land', 'Landing'], ['calm', 'Calm']]) +
        seg('img', 'Image fields', [['framed', 'Framed plate'], ['bleed', 'Full bleed']]) +
        '<div class="pw-tweaks-row">' +
          '<label class="pw-tweaks-label">Scroll dwell <span class="pw-dwell-val">' + state.dwell.toFixed(2) + '×</span></label>' +
          '<input type="range" class="pw-slider" data-key="dwell" min="0.6" max="1.6" step="0.05" value="' + state.dwell + '" />' +
        '</div>' +
        '<button class="pw-reset">Reset</button>' +
      '</div>';
    document.body.appendChild(panel);

    panel.querySelector('.pw-tweaks-tab').addEventListener('click', function () {
      var open = panel.classList.toggle('is-collapsed');
      this.setAttribute('aria-expanded', String(!open));
    });
    panel.querySelectorAll('.pw-opt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var key = this.getAttribute('data-key');
        state[key] = this.getAttribute('data-val');
        save(); apply(); refresh(panel);
      });
    });
    var slider = panel.querySelector('.pw-slider');
    slider.addEventListener('input', function () {
      state.dwell = parseFloat(this.value);
      panel.querySelector('.pw-dwell-val').textContent = state.dwell.toFixed(2) + '×';
      save(); apply();
    });
    panel.querySelector('.pw-reset').addEventListener('click', function () {
      state = Object.assign({}, DEFAULTS); save(); apply();
      slider.value = state.dwell;
      panel.querySelector('.pw-dwell-val').textContent = state.dwell.toFixed(2) + '×';
      refresh(panel);
    });
    refresh(panel);
  }

  function seg(key, label, opts) {
    var btns = opts.map(function (o) {
      return '<button class="pw-opt" data-key="' + key + '" data-val="' + o[0] + '">' + o[1] + '</button>';
    }).join('');
    return '<div class="pw-tweaks-row"><label class="pw-tweaks-label">' + label + '</label>' +
      '<div class="pw-seg">' + btns + '</div></div>';
  }
  function refresh(panel) {
    panel.querySelectorAll('.pw-opt').forEach(function (b) {
      var on = state[b.getAttribute('data-key')] === b.getAttribute('data-val');
      b.classList.toggle('is-on', on);
    });
  }

  function boot() {
    buildMotifs();
    apply();
    buildPanel();
    initZones();
    window.addEventListener('scroll', runScrollSweeps, { passive: true });
    var rt;
    window.addEventListener('resize', function () {
      clearTimeout(rt);
      rt = setTimeout(function () { initZones(); runScrollSweeps(); }, 250);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
