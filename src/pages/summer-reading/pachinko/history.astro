---
import SummerLayout from '../../../layouts/SummerLayout.astro';
import SpokePagination from '../../../components/summer-reading/SpokePagination.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('summerReading', 'pachinko/history');
const { Content } = await render(entry);
---
<SummerLayout title={entry.data.title} section="pachinko" spoke="history">
  <Content />
  <SpokePagination
    section="pachinko"
    prev={{ slug: 'culture', title: 'Korean Identity', number: 2 }}
    next={{ slug: 'figures', title: 'Key Figures', number: 4 }}
  />
</SummerLayout>
