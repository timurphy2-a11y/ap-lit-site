          <circle class="tfa-ember tfa-ember--1" cx="384" cy="250" r="2.4"></circle>
          <circle class="tfa-ember tfa-ember--2" cx="396" cy="252" r="3"></circle>
          <circle class="tfa-ember tfa-ember--3" cx="408" cy="250" r="2.6"></circle>
          <circle class="tfa-ember tfa-ember--4" cx="416" cy="252" r="2"></circle>
          <circle class="tfa-ember tfa-ember--5" cx="390" cy="252" r="1.8"></circle>
          <path class="tfa-flame-lick tfa-flame-lick--a" style="animation-delay:0ms" d="M383.8 252.0 C379.1 241.1 383.2 234.3 386.6 230.9 C384.9 226.8 387.2 224.8 388.3 222.1 C389.3 226.2 390.0 227.9 391.3 226.5 C392.0 222.1 392.7 219.4 393.0 217.7 C393.4 222.1 394.4 226.2 395.7 227.5 C395.1 224.8 397.1 226.2 396.8 228.9 C400.2 234.3 404.9 241.1 400.2 252.0 C397.1 254.0 386.9 254.0 383.8 252.0 Z"></path>
          <path class="tfa-flame-lick tfa-flame-lick--b" style="animation-delay:420ms" d="M401.8 252.0 C398.1 243.7 401.2 238.5 403.8 235.9 C402.5 232.8 404.4 231.2 405.1 229.1 C405.9 232.2 406.4 233.5 407.5 232.5 C408.0 229.1 408.5 227.0 408.8 225.7 C409.0 229.1 409.8 232.2 410.9 233.3 C410.3 231.2 411.9 232.2 411.6 234.3 C414.2 238.5 417.9 243.7 414.2 252.0 C411.9 253.6 404.1 253.6 401.8 252.0 Z"></path>
