              <stop offset="45%" stop-color="#E8923A" stop-opacity="0.42"></stop>
              <stop offset="100%" stop-color="#D4762A" stop-opacity="0"></stop>
            </linearGradient>
          </defs>

          <!-- platform 1: in season -->
          <line class="dsc-ground dsc-ground--barn" x1="58" y1="150" x2="248" y2="150"></line>
          <path class="dsc-barn" d="M96 150 v-20 M120 150 v-20 M144 150 v-20 M88 130 h64 M80 130 L120 118 L160 130"></path>
