---
import SummerLayout from '../../../layouts/SummerLayout.astro';
import SectionOpener from '../../../components/summer-reading/SectionOpener.astro';
import ZoneSeam from '../../../components/summer-reading/ZoneSeam.astro';
import UliSun from '../../../components/summer-reading/UliSun.astro';
import UliTendril from '../../../components/summer-reading/UliTendril.astro';
import UliCurve from '../../../components/summer-reading/UliCurve.astro';
import AkweteChevron from '../../../components/summer-reading/AkweteChevron.astro';
import TSpokeGlyph from '../../../components/summer-reading/TSpokeGlyph.astro';
---

<SummerLayout title="Connections to the Novel — Things Fall Apart" section="tfa" spoke="novel">

  <!-- ════════════════════════════════════════════════════════════
       SPOKE HEADER — umber band + UliSun watermark + Akwete chevron
       ════════════════════════════════════════════════════════════ -->
  <div class="tfa-spoke-header">
    <div class="tfa-spoke-header-watermark" aria-hidden="true">
      <UliSun size={440} line="var(--t-cream)" />
    </div>
    <div class="tfa-spoke-header-inner">
      <span class="tfa-spoke-header-eyebrow">Things Fall Apart · Spoke 05</span>
      <div class="tfa-spoke-header-title-row">
        <div class="tfa-spoke-badge" style="border-color: var(--t-forest);"><TSpokeGlyph idx={4} size={38} color="var(--t-cream)" /></div>
        <h1 class="tfa-spoke-header-title">Connections to the Novel</h1>
      </div>
      <p class="tfa-spoke-header-deck">Where the history meets the book. What Achebe builds before it breaks, what Okonkwo carries, how the church worked through the culture's own fault lines — and the reasonable paragraph that the whole novel was written to answer.</p>
    </div>
  </div>
  <div class="tfa-header-chevron" aria-hidden="true">
    <AkweteChevron width={1200} height={9} />
  </div>

  <!-- ════════════════════════════════════════════════════════════
       SPOILER BANNER
       ════════════════════════════════════════════════════════════ -->
  <div class="tfa-spoiler" data-screen-label="Spoiler banner">
    <div class="tfa-spoiler-inner">
      <span class="tfa-spoiler-tag">Before you read on</span>
      <p class="tfa-spoiler-text">This section discusses major plot events, including the endings of several characters' storylines. If you are still reading the novel, you may want to return to this page after you finish <em>Things Fall Apart</em>.</p>
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════
       OPENING ORIENTATION — cream · no zone opener
       ════════════════════════════════════════════════════════════ -->
  <section class="sr-scrolly-zone" data-ground="cream" data-screen-label="Opening orientation">
    <div class="tfa-orient">
      <span class="tfa-orient-eyebrow">Spoke Five · Connections to the Novel</span>
      <p>The other pages on this site have covered the history and culture that <em>Things Fall Apart</em> inhabits: Igbo political structure and cosmology, the agricultural rhythms of Umuofia, British colonialism and its administrative machinery, the missionaries and the social disruptions they produced. This page builds the connections between that context and the specific cultural claims Achebe makes with his novel.</p>
      <p class="tfa-orient-lead">Context is not the same as argument. Understanding the warrant chief system is historical information. Understanding what Achebe is asserting about Igbo civilization — and about the tradition of Western writing that had erased it — is literary analysis.</p>
      <div class="tfa-orient-rule" aria-hidden="true">
        <UliCurve width={120} color="var(--t-terra)" opacity={0.7} />
      </div>
    </div>
  </section>

  <ZoneSeam text="tfa" groundFrom="cream" groundTo="cream" />

  <!-- ════════════════════════════════════════════════════════════
       ZONE 1 — The Epigraph · ground · still · cream
       ════════════════════════════════════════════════════════════ -->
  <section class="sr-scrolly-zone sr-scrolly-zone--ground" data-field="ground" data-tempo="still" data-ground="cream" data-text="tfa" data-screen-label="§1 The Epigraph">
    <div class="sr-zone-ground-content">

      <SectionOpener text="tfa" eyebrow="The Epigraph" heading="Achebe and Yeats" background="cream" motifIdx={4} />

      <figure class="sr-pullquote sr-pullquote--tfa tfa-zone-pull tfa-verse">
        <div class="sr-pullquote-bracket sr-pullquote-bracket--top" aria-hidden="true"><UliTendril width={80} color="var(--t-terra)" opacity={0.7} /></div>
        <blockquote class="sr-pullquote-body"><p>Turning and turning in the widening gyre<br />The falcon cannot hear the falconer;<br />Things fall apart; the centre cannot hold;<br />Mere anarchy is loosed upon the world.</p></blockquote>
        <figcaption class="sr-pullquote-attribution">— W. B. Yeats, "The Second Coming" (1919)</figcaption>
        <div class="sr-pullquote-bracket sr-pullquote-bracket--bottom" aria-hidden="true"><UliTendril width={80} color="var(--t-terra)" opacity={0.7} /></div>
      </figure>

      <figure class="tfa-gyre-fig" aria-label="Yeats's widening gyre: a spiral that widens with every turn, leaving its fixed centre behind.">
        <svg viewBox="0 0 240 200" class="tfa-gyre-svg" role="img" aria-label="A spiral that widens with every turn around a small fixed centre point; a small arrowhead at the open end shows it spinning outward.">
          <path d="M125.0 100.0 L125.5 100.8 L125.8 101.7 L126.0 102.7 L126.0 103.7 L125.8 104.9 L125.4 106.0 L124.8 107.1 L124.0 108.2 L122.9 109.2 L121.7 110.0 L120.3 110.7 L118.8 111.1 L117.1 111.3 L115.4 111.3 L113.6 111.0 L111.8 110.4 L110.1 109.5 L108.4 108.3 L106.9 106.8 L105.6 105.1 L104.5 103.2 L103.7 101.0 L103.2 98.7 L103.1 96.2 L103.3 93.7 L103.9 91.2 L104.8 88.7 L106.2 86.4 L107.9 84.2 L110.0 82.2 L112.4 80.5 L115.1 79.1 L118.0 78.1 L121.1 77.5 L124.3 77.4 L127.6 77.7 L130.8 78.6 L134.0 79.9 L137.0 81.6 L139.8 83.9 L142.3 86.5 L144.5 89.6 L146.2 92.9 L147.4 96.6 L148.1 100.5 L148.3 104.5 L147.9 108.5 L146.9 112.6 L145.3 116.5 L143.2 120.2 L140.4 123.6 L137.2 126.7 L133.6 129.3 L129.5 131.4 L125.1 132.9 L120.5 133.8 L115.7 134.0 L110.8 133.6 L106.0 132.5 L101.4 130.6 L97.0 128.1 L92.9 125.0 L89.2 121.3 L86.1 117.0 L83.6 112.3 L81.7 107.2 L80.6 101.8 L80.2 96.2 L80.6 90.6 L81.9 85.0 L83.9 79.5 L86.7 74.4 L90.2 69.6 L94.4 65.4 L99.3 61.7 L104.7 58.7 L110.5 56.4 L116.6 55.0 L122.9 54.5 L129.4 54.8 L135.8 56.1 L142.0 58.3 L147.9 61.3 L153.4 65.2 L158.3 69.9 L162.6 75.3 L166.1 81.3 L168.7 87.7 L170.5 94.6 L171.2 101.7 L171.0 108.9 L169.8 116.1 L167.5 123.1 L164.2 129.8 L160.0 136.1 L154.9 141.7 L149.0 146.6 L142.4 150.6 L135.3 153.8 L127.7 155.9 L119.8 156.9 L111.8 156.9 L103.8 155.7 L96.0 153.3 L88.5 149.9 L81.5 145.4 L75.2 139.9 L69.6 133.6 L65.0 126.4 L61.3 118.7 L58.8 110.4 L57.4 101.7 L57.3 92.9 L58.4 84.1 L60.7 75.5 L64.3 67.2 L69.0 59.4 L74.8 52.3 L81.6 46.1 L89.3 40.8 L97.7 36.6 L106.6 33.6 L116.0 31.9 L125.6 31.5 L135.2 32.4 L144.7 34.7 L153.8 38.3 L162.4 43.3 L170.2 49.4 L177.2 56.5 L183.2 64.7 L188.0 73.7 L191.5 83.3 L193.6 93.4 L194.3 103.8 L193.6 114.2 L191.4 124.5 L187.7 134.4 L182.7 143.8 L176.3 152.5 L168.8 160.2 L160.1 166.9 L150.6 172.3 L140.3 176.4 L129.6 179.0" fill="none" stroke="#41525E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M120 180 L130 175 M120 180 L130 185" stroke="#41525E" stroke-width="2" stroke-linecap="round"></path>
          <circle cx="120" cy="100" r="3" fill="var(--color-muted)"></circle>
        </svg>
        <figcaption class="tfa-gyre-cap">
          <span class="tfa-gyre-key">Turning and turning · the widening gyre</span>
          Yeats's figure for history — a spiral that widens with every turn until the centre it spun from can no longer hold it. Achebe sets the same gyre spinning over <em>Umuofia.</em>
        </figcaption>
      </figure>

      <div class="tfa-passage">
        <div class="tfa-passage-body tfa-passage-body--lede">
          <p>Achebe opens his novel with four lines from Yeats's "The Second Coming," written in the immediate aftermath of World War I. Yeats's poem is a vision of civilizational collapse — order dissolving, the falcon losing contact with the falconer, the center failing to hold. By choosing this epigraph, Achebe is making a claim before his novel has even begun.</p>
        </div>
      </div>

      <div class="tfa-passage">
        <div class="tfa-passage-body">
          <p>In Yeats, the center that cannot hold is European civilization; the collapse is the crisis of Western modernity. Achebe borrows the image and recontextualizes it entirely. In <em>Things Fall Apart</em>, the center that cannot hold is Umuofia — an African civilization, fully realized on its own terms, destroyed not by internal failure but by external force. The widening gyre is colonial encroachment. The falcon that cannot hear the falconer is Okonkwo, increasingly unable to orient himself within a world that no longer operates by its own rules.</p>
        </div>
      </div>

      <div class="tfa-passage">
        <div class="tfa-passage-body">
          <p>The choice of a Yeats epigraph is itself an argument about literary authority. Achebe is claiming the same register — the same weight of tragedy, the same civilizational stakes — for Igbo civilization's collapse that Yeats claimed for the collapse of the European order. He is insisting that what happens to Umuofia belongs in the same conversation as what Yeats was mourning. There is also a quiet irony in the choice: Yeats could not have imagined his poem about European crisis being repurposed as the frame for an African novel written in deliberate opposition to the assumptions of that same tradition. That act of appropriation is itself a form of the novel's argument — the tools of the colonial literary tradition can be used to tell the story of what that tradition erased.</p>
        </div>
      </div>

    </div>
  </section>

  <ZoneSeam text="tfa" groundFrom="cream" groundTo="cream" />

  <!-- ════════════════════════════════════════════════════════════
       ZONE 2 — Before the Missionaries · ground · still · cream
       ════════════════════════════════════════════════════════════ -->
  <section class="sr-scrolly-zone sr-scrolly-zone--ground" data-field="ground" data-tempo="still" data-ground="cream" data-text="tfa" data-screen-label="§2 Before the Missionaries">
    <div class="sr-zone-ground-content">

      <SectionOpener text="tfa" eyebrow="The Structural Argument" heading="Before the Missionaries" background="cream" motifIdx={4} />

      <figure class="sr-pullquote sr-pullquote--tfa tfa-zone-pull">
        <div class="sr-pullquote-bracket sr-pullquote-bracket--top" aria-hidden="true"><UliTendril width={80} color="var(--t-terra)" opacity={0.7} /></div>
        <blockquote class="sr-pullquote-body"><p>"Okonkwo was well known throughout the nine villages and even beyond. His fame rested on solid personal achievements."</p></blockquote>
        <figcaption class="sr-pullquote-attribution">— Things Fall Apart, Chinua Achebe (opening pages)</figcaption>
        <div class="sr-pullquote-bracket sr-pullquote-bracket--bottom" aria-hidden="true"><UliTendril width={80} color="var(--t-terra)" opacity={0.7} /></div>
      </figure>

      <div class="tfa-passage">
        <div class="tfa-passage-body tfa-passage-body--lede">
          <p>The most important structural decision in <em>Things Fall Apart</em> is not what Achebe shows but when he shows it. He begins with Okonkwo throwing Amalinze the Cat. He gives the reader Umuofia's governance, its cosmology, its agricultural rhythms, its gender dynamics, its internal tensions — before any British presence has appeared. Part I of the novel is an extended act of cultural construction: a world built on the page so that when it is disrupted, the reader has experienced its logic from the inside.</p>
        </div>
      </div>

      <div class="tfa-passage">
        <div class="tfa-passage-body">
          <p>Achebe's critique of the Western literary tradition — of Conrad's <em>Heart of Darkness</em>, of Joyce Cary's <em>Mister Johnson</em> — was that Africa existed in those books without interiority, without history, without a functioning civilization whose disruption could be experienced as genuine loss. The pre-colonial world was rendered as absence, as darkness, as the condition colonialism was correcting. Achebe renders the pre-colonial world as presence: a functional cultural system, however imperfect, that is being destroyed by hostile encroachment.</p>
        </div>
      </div>

      <div class="tfa-passage">
        <div class="tfa-passage-body">
          <p>The reader who has lived inside Umuofia's justice system — who has watched the egwugwu adjudicate a dispute, understood the Oracle's authority, witnessed the Week of Peace as a genuine communal obligation — experiences the colonial disruption of those institutions as tragic loss rather than civilizing progress. That experience is the structural argument of the novel, built into the sequence of what we are shown and when.</p>
        </div>
      </div>

      <div class="tfa-c-diagram-block">
        <span class="tfa-diagram-eyebrow">The novel, measured</span>
        <svg data-novel-structure role="img" aria-label="A horizontal bar standing for the length of the novel. The first and largest segment, warm, is Part One — the wrestling match, governance, cosmology, the harvest, the egwugwu — a world built from the inside. A dashed seam late along the bar marks where the missionaries first arrive. The short final segment cools to umber: Parts Two and Three, the disruption and the closing paragraph."></svg>
        <p class="tfa-diagram-cap">Most of the reader's experience is the intact world, lived from the inside, <b>before any British presence appears</b>. The disruption — and the administrator's closing paragraph — arrive only at the end. The order is the argument.</p>
      </div>

    </div>
  </section>

  <ZoneSeam text="tfa" groundFrom="cream" groundTo="tinted" />

  <!-- ════════════════════════════════════════════════════════════
       ZONE 3 — Okonkwo's Values · ground · still · tinted
       ════════════════════════════════════════════════════════════ -->
  <section class="sr-scrolly-zone sr-scrolly-zone--ground" data-field="ground" data-tempo="still" data-ground="tinted" data-text="tfa" data-screen-label="§3 Okonkwo's Values">
    <div class="sr-zone-ground-content">

      <SectionOpener text="tfa" eyebrow="The Hero and His Flaw" heading="Okonkwo's Values" background="tinted" motifIdx={4} />

      <figure class="sr-pullquote sr-pullquote--tfa tfa-zone-pull">
        <div class="sr-pullquote-bracket sr-pullquote-bracket--top" aria-hidden="true"><UliTendril width={80} color="var(--t-terra)" opacity={0.7} /></div>
        <blockquote class="sr-pullquote-body"><p>"His whole life was dominated by fear, the fear of failure and of weakness… It was not external but lay deep within himself. It was the fear of himself, lest he should be found to resemble his father."</p></blockquote>
        <figcaption class="sr-pullquote-attribution">— Things Fall Apart, Chinua Achebe</figcaption>
        <div class="sr-pullquote-bracket sr-pullquote-bracket--bottom" aria-hidden="true"><UliTendril width={80} color="var(--t-terra)" opacity={0.7} /></div>
      </figure>

      <div class="tfa-passage">
        <div class="tfa-passage-body tfa-passage-body--lede">
          <p>Okonkwo is a man who has internalized the Igbo achievement ethic completely and amplified it to a pathological extreme. His insistence on masculine strength, his contempt for weakness, his emotional repression, his violence: these are not personal pathologies in a cultural vacuum. They are the Igbo masculine ideal operating at maximum intensity. The title system rewards demonstrated achievement. The community's judgment falls on those, like Unoka, who fail to meet their obligations. Okonkwo has absorbed all of this — and then amplified it, driven by a terror that he will become his father.</p>
        </div>
      </div>

      <figure class="tfa-seq" aria-label="The killing of Ikemefuna — a four-beat sequence with quotations from Things Fall Apart, chapters 7 and 8">
        <figcaption class="tfa-seq-head">
          <span class="tfa-seq-eyebrow">The killing of Ikemefuna · a sequence</span>
          <span class="tfa-seq-eyebrow tfa-seq-eyebrow--muted">Chinua Achebe · ch. 7–8</span>
        </figcaption>
        <div class="tfa-seq-track">
          <div class="tfa-seq-phase">The act</div>
          <article class="tfa-seq-beat">
            <span class="tfa-seq-kicker">The warning</span>
            <div class="tfa-seq-glyph">
              <svg viewBox="0 0 200 168" class="tfa-seq-svg" role="img" aria-label="A balance tilts: a light ring rises, a heavy dark disc sinks.">
                <line x1="74" y1="120" x2="126" y2="120" stroke="var(--color-rule)" stroke-width="2" stroke-linecap="round"></line>
                <path d="M86 120 L114 120 L100 78 Z" fill="none" stroke="var(--color-muted)" stroke-width="2" stroke-linejoin="round"></path>
                <line x1="50" y1="62" x2="150" y2="96" stroke="var(--t-umber)" stroke-width="3" stroke-linecap="round"></line>
                <circle cx="100" cy="79" r="4" fill="var(--t-umber)"></circle>
                <line x1="50" y1="62" x2="50" y2="78" stroke="var(--color-muted)" stroke-width="1.5"></line>
                <circle cx="50" cy="86" r="8.5" fill="none" stroke="var(--t-terra)" stroke-width="2.6"></circle>
                <line x1="150" y1="96" x2="150" y2="110" stroke="var(--color-muted)" stroke-width="1.5"></line>
                <circle cx="150" cy="124" r="13" fill="var(--t-umber)"></circle>
              </svg>
            </div>
            <div class="tfa-seq-rail"><span class="tfa-seq-dot"></span></div>
            <blockquote class="tfa-seq-quote">"That boy calls you father. Do not bear a hand in his death." Okonkwo was surprised, and was about to say something when the old man continued: "Yes, Umuofia has decided to kill him. The Oracle of the Hills and the Caves has pronounced it… But I want you to have nothing to do with it. He calls you his father."</blockquote>
          </article>
          <article class="tfa-seq-beat">
            <span class="tfa-seq-kicker">The blow</span>
            <div class="tfa-seq-glyph">
              <svg viewBox="0 0 200 168" class="tfa-seq-svg" role="img" aria-label="A heavy diagonal stroke drives down to a point and shatters it into sharp, irregular shards.">
                <line x1="40" y1="48" x2="54" y2="62" stroke="var(--t-terra)" stroke-width="1.6" stroke-linecap="round" opacity="0.28"></line>
                <line x1="50" y1="36" x2="64" y2="50" stroke="var(--t-terra)" stroke-width="1.6" stroke-linecap="round" opacity="0.22"></line>
                <line x1="100" y1="94" x2="144" y2="88" stroke="var(--t-terra)" stroke-width="2.6" stroke-linecap="round"></line>
                <line x1="100" y1="94" x2="138" y2="120" stroke="var(--t-terra)" stroke-width="2.2" stroke-linecap="round" opacity="0.85"></line>
                <line x1="100" y1="94" x2="106" y2="138" stroke="var(--t-umber)" stroke-width="2.8" stroke-linecap="round"></line>
                <line x1="100" y1="94" x2="72" y2="130" stroke="var(--t-terra)" stroke-width="2.2" stroke-linecap="round" opacity="0.85"></line>
                <line x1="100" y1="94" x2="60" y2="100" stroke="var(--t-terra)" stroke-width="2.6" stroke-linecap="round"></line>
                <line x1="100" y1="94" x2="130" y2="64" stroke="var(--t-terra)" stroke-width="2.2" stroke-linecap="round" opacity="0.7"></line>
                <line x1="100" y1="94" x2="96" y2="62" stroke="var(--t-umber)" stroke-width="2.4" stroke-linecap="round"></line>
                <line x1="152" y1="82" x2="160" y2="78" stroke="var(--t-terra)" stroke-width="2" stroke-linecap="round" opacity="0.7"></line>
                <line x1="114" y1="146" x2="119" y2="155" stroke="var(--t-terra)" stroke-width="2" stroke-linecap="round" opacity="0.6"></line>
                <line x1="56" y1="114" x2="48" y2="120" stroke="var(--t-terra)" stroke-width="1.8" stroke-linecap="round" opacity="0.6"></line>
                <line x1="46" y1="38" x2="110" y2="104" stroke="var(--t-umber)" stroke-width="7.5" stroke-linecap="round"></line>
              </svg>
            </div>
            <div class="tfa-seq-rail"><span class="tfa-seq-dot"></span></div>
            <blockquote class="tfa-seq-quote">"As the man who had cleared his throat drew up and raised his machete, Okonkwo looked away. He heard the blow. The pot fell and broke in the sand. He heard Ikemefuna cry, 'My father, they have killed me!' as he ran towards him. Dazed with fear, Okonkwo drew his machete and cut him down."</blockquote>
          </article>
          <div class="tfa-seq-phase">The aftermath</div>
          <article class="tfa-seq-beat">
            <span class="tfa-seq-kicker">The numbing</span>
            <div class="tfa-seq-glyph">
              <svg viewBox="0 0 200 168" class="tfa-seq-svg" role="img" aria-label="A gourd cup of palm wine; rings of awareness beside it dissolve into faint dashes.">
                <path d="M120 74 A30 30 0 0 1 120 122" fill="none" stroke="var(--t-terra)" stroke-width="2" stroke-dasharray="3 8" stroke-linecap="round" opacity="0.4"></path>
                <path d="M120 62 A42 42 0 0 1 120 134" fill="none" stroke="var(--t-terra)" stroke-width="1.6" stroke-dasharray="2 10" stroke-linecap="round" opacity="0.26"></path>
                <ellipse cx="80" cy="72" rx="20" ry="6" fill="none" stroke="var(--t-umber)" stroke-width="2"></ellipse>
                <path d="M60 72 C58 100 68 126 80 126 C92 126 102 100 100 72" fill="none" stroke="var(--t-umber)" stroke-width="2.4" stroke-linecap="round"></path>
                <path d="M64 98 C72 104 88 104 96 98 C95 112 88 119 80 119 C72 119 65 112 64 98 Z" fill="var(--t-terra)" opacity="0.5"></path>
                <circle cx="80" cy="136" r="3" fill="var(--t-terra)" opacity="0.6"></circle>
                <circle cx="80" cy="146" r="2" fill="var(--t-terra)" opacity="0.35"></circle>
              </svg>
            </div>
            <div class="tfa-seq-rail"><span class="tfa-seq-dot"></span></div>
            <blockquote class="tfa-seq-quote">"Okonkwo did not taste any food for two days after the death of Ikemefuna. He drank palm wine from morning till night, and his eyes were red and fierce like the eyes of a rat when it was caught by the tail and dashed against the floor. He called his son, Nwoye, to sit with him in his obi. But the boy was afraid of him and slipped out of the hut as soon as he noticed him dozing."</blockquote>
          </article>
          <article class="tfa-seq-beat">
            <span class="tfa-seq-kicker">The night</span>
            <div class="tfa-seq-glyph">
              <svg viewBox="0 0 200 168" class="tfa-seq-svg" role="img" aria-label="A spiral coiled inward to a sealed centre, a crescent moon above.">
