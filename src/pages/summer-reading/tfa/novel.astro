          <circle class="tfa-roar-spark tfa-roar-spark--2" cx="192" cy="92" r="1.5"></circle>
          <circle class="tfa-roar-spark tfa-roar-spark--3" cx="185" cy="82" r="2"></circle>
          <path class="dg-ok-line" style="stroke-width:5.0" d="M178.0 124.0 L172.0 150.0"></path>
          <path class="dg-ok-line" style="stroke-width:5.0" d="M192.0 124.0 L198.0 150.0"></path>
          <path class="dg-ok-b" d="M168.0 93.0 L202.0 93.0 L192.0 124.0 L178.0 124.0 Z"></path>
          <path class="dg-ok-line" style="stroke-width:4.0" d="M168.0 93.0 L155.0 107.0 L168.0 112.0"></path>
          <path class="dg-ok-line" style="stroke-width:4.0" d="M202.0 93.0 L215.0 107.0 L202.0 112.0"></path>
          <circle class="dg-ok-h" cx="185.0" cy="81.0" r="9.0"></circle>
          <line class="dg-title" x1="169.0" y1="156.0" x2="201.0" y2="156.0"></line>
          <line class="dg-title" x1="174.0" y1="160.0" x2="196.0" y2="160.0"></line>
          <text class="dsc-lbl dsc-lbl--terra" x="155" y="176" text-anchor="middle">In season</text>
          <text class="dsc-sub" x="155" y="192" text-anchor="middle">the roaring flame</text>

          <!-- step → exile -->
          <path class="dsc-frontier" d="M250 150 C 300 150, 300 250, 350 250"></path>
          <text class="dsc-tag" x="300" y="196" text-anchor="middle">↓ EXILE</text>
          <text class="dsc-sub" x="300" y="212" text-anchor="middle">seven harvests</text>

          <!-- platform 2: displaced — glowing coals -->
          <line class="dsc-ground" x1="332" y1="250" x2="470" y2="250"></line>
