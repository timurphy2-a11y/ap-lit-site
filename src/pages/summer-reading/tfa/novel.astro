          <!-- platform 3: out of season — the book -->
          <rect class="dsc-haze" x="566" y="214" width="154" height="160"></rect>
          <rect class="dsc-book-edge" x="606" y="251" width="80" height="62" rx="2"></rect>
          <rect class="dsc-book-cover" x="602" y="248" width="80" height="62" rx="2"></rect>
          <line class="dsc-book-line" x1="610" y1="248" x2="610" y2="310"></line>
          <line class="dsc-book-line" x1="634" y1="274" x2="676" y2="274"></line>
          <line class="dsc-book-line" x1="634" y1="286" x2="676" y2="286"></line>
