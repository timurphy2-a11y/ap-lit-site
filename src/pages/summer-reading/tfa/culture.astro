<script>
// TFA Culture — position-driven scroll reveal engine.
// Drives §1 (acephalous rings), §2 (ascent ladder + pan), §3a (cosmo axis).
// Sightline = 50vh. Accumulative diagram reveal. JS tweens inline opacity.
(function () {
  'use strict';

  var sweeps: Array<() => void> = [];

  function initZones(): void {
    sweeps = [];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const mobile = window.innerWidth > 0 && window.innerWidth < 768;
    if (reduced || mobile) return;

    const zones: Array<{ el: Element; field: Element | null }> = [];

    // §3a: standard map scrolly zone
    document.querySelectorAll<HTMLElement>('.sr-scrolly-zone[data-field="map"]').forEach(z => {
      zones.push({ el: z, field: z.querySelector('.sr-zone-field') });
    });
    // §1 and §2: custom two-column sticky splits
    document.querySelectorAll<HTMLElement>('.tfa-s1-cols').forEach(z => {
      zones.push({ el: z, field: z.querySelector('.tfa-s1-sticky') });
    });

    zones.forEach(({ el, field }) => {
      const beats = Array.from(el.querySelectorAll<HTMLElement>('[data-beat]'));
      if (!beats.length) return;

      function sweep(): void {
        const line = window.innerHeight * 0.5;
        let bestIdx = 0, bestDist = Infinity, lastPassed = -1;
        beats.forEach((beat, i) => {
          const rect = beat.getBoundingClientRect();
          const mid = rect.top + rect.height / 2;
          const dist = Math.abs(mid - line);
          if (dist < bestDist) { bestDist = dist; bestIdx = i; }
          if (rect.top + 8 < line) lastPassed = i;
        });

        beats.forEach((beat, i) => beat.classList.toggle('is-active', i === bestIdx));

        if (field && field.querySelector('[data-show-from]')) {
          const revealed: Record<string, number> = {};
          const topIdx = Math.max(lastPassed, bestIdx);
          for (let i = 0; i <= topIdx; i++) {
            const key = (beats[i] as HTMLElement).dataset.activates;
            if (key) revealed[key] = 1;
          }
          setFieldReveal(field, revealed);

          const cur = (beats[bestIdx] as HTMLElement).dataset.activates;
          field.querySelectorAll('[data-show-from]').forEach(g => {
            g.classList.toggle('is-current', !!cur && g.getAttribute('data-show-from') === cur);
          });

          // §2 ladder pan: translateY so active rung sits at viewBox y=310
          const pan = field.querySelector<SVGGElement>('.asc-pan');
          if (pan) {
            const act = (field.querySelector('[data-show-from].is-current') ||
                         field.querySelector('.asc-base')) as HTMLElement | null;
            const cy = act ? parseFloat(act.getAttribute('data-cy') ?? '310') : 310;
            pan.style.transform = `translateY(${310 - cy}px)`;
          }
        }
      }

      sweeps.push(sweep);
      sweep();
    });
  }

  // CSS opacity transitions freeze on SVG <g> elements in this engine.
  // We tween a static inline opacity per rAF frame instead.
  type RevealEl = HTMLElement & { __t?: number; __c?: number };
  let revealTween: number | ReturnType<typeof setTimeout> | null = null;
  const nextFrame = (fn: () => void): number | ReturnType<typeof setTimeout> =>
    document.hidden ? setTimeout(fn, 16) : requestAnimationFrame(fn);

  function setFieldReveal(field: Element, revealed: Record<string, number>): void {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let changed = false;
    field.querySelectorAll<RevealEl>('[data-show-from]').forEach(g => {
      const target = revealed[g.getAttribute('data-show-from') ?? ''] ? 1 : 0;
      if (g.__t === undefined) g.__t = parseFloat(getComputedStyle(g).opacity) || 0;
      if (g.__t !== target) { g.__t = target; changed = true; }
      if (g.__c === undefined) g.__c = parseFloat(getComputedStyle(g).opacity) || 0;
      if (reduced) { g.__c = target; g.style.opacity = String(target); }
    });
    if (reduced || !changed) return;
    if (!revealTween) revealTween = nextFrame(tickReveal);
  }

  function tickReveal(): void {
    revealTween = null;
    let moving = false;
    document.querySelectorAll<RevealEl>('[data-show-from]').forEach(g => {
      if (g.__t === undefined) return;
      let cur = g.__c !== undefined ? g.__c : (parseFloat(getComputedStyle(g).opacity) || 0);
      const diff = g.__t - cur;
      if (Math.abs(diff) < 0.02) { cur = g.__t; }
      else { cur += diff * 0.16; moving = true; }
      g.__c = cur;
      g.style.opacity = String(cur);
    });
    if (moving) revealTween = nextFrame(tickReveal);
  }

  let sweepQueued = false;
  function runSweeps(): void {
    if (sweepQueued) return;
    sweepQueued = true;
    nextFrame(() => { sweepQueued = false; sweeps.forEach(fn => fn()); });
  }

  function boot(): void {
    initZones();
    window.addEventListener('scroll', runSweeps, { passive: true });
    let resizeTimer: ReturnType<typeof setTimeout>;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { initZones(); runSweeps(); }, 250);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>

<script>
// TFA §5 Key Practices — triptych full-account popovers.
// Hover/focus reveal via CSS; click-to-pin via JS; Escape/outside-click dismissal.
// opacity/visibility flip instantly (no transition) to prevent freeze bug.
(function () {
  'use strict';

  function boot(): void {
    if (!document.querySelector('.tfa-tri-col')) return;

    function btnFor(detail: Element): HTMLButtonElement | null {
      return detail.parentElement?.querySelector<HTMLButtonElement>('.tfa-tri-more') ?? null;
    }
    function unpin(detail: Element): void {
      detail.classList.remove('is-pinned');
      const b = btnFor(detail);
      if (b) b.setAttribute('aria-expanded', 'false');
    }
    function closeAll(except: Element | null): void {
      document.querySelectorAll('.tfa-tri-detail.is-pinned').forEach(d => {
        if (d !== except) unpin(d);
      });
    }

    document.querySelectorAll<HTMLButtonElement>('.tfa-tri-more').forEach(btn => {
      const detail = document.getElementById(btn.getAttribute('aria-controls') ?? '');
      if (!detail) return;
      btn.addEventListener('click', e => {
        e.stopPropagation();
        const willPin = !detail.classList.contains('is-pinned');
        closeAll(detail);
        detail.classList.toggle('is-pinned', willPin);
        btn.setAttribute('aria-expanded', String(willPin));
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.tfa-tri-detail-close').forEach(x => {
      x.addEventListener('click', e => {
        e.stopPropagation();
        const detail = x.closest('.tfa-tri-detail');
        if (!detail) return;
        unpin(detail);
        btnFor(detail)?.focus();
      });
    });

    document.addEventListener('click', (e: MouseEvent) => {
      const t = e.target as Element;
      if (t.closest('.tfa-tri-detail') || t.closest('.tfa-tri-more')) return;
      closeAll(null);
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeAll(null);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
