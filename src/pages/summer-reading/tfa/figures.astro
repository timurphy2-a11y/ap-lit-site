---
import SummerLayout from '../../../layouts/SummerLayout.astro';
import SpokePagination from '../../../components/summer-reading/SpokePagination.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('summerReading', 'tfa/figures');
const { Content } = await render(entry);
---
<SummerLayout title={entry.data.title} section="tfa" spoke="figures">
  <Content />
  <SpokePagination
    section="tfa"
    prev={{ slug: 'history', title: 'Colonial History', number: 3 }}
    next={{ slug: 'novel', title: 'The Novel', number: 5 }}
  />
</SummerLayout>
