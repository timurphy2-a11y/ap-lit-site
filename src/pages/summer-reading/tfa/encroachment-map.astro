  <script>
    const chapters = Array.from(document.querySelectorAll<HTMLElement>('.scrolly-chapter[data-chapter]'));
    const layers   = Array.from(document.querySelectorAll<HTMLElement>('.enc-layer[data-chapter]'));
    const segments = Array.from(document.querySelectorAll<HTMLElement>('.scrolly-progress-segment'));
    const caption  = document.getElementById('enc-caption');

    let revealedUpTo  = 0;
    let activeChapter = 0;

    function revealMapUpTo(chNum: number) {
      if (chNum <= revealedUpTo) return;
      revealedUpTo = chNum;
      layers.forEach(layer => {
        if (parseInt(layer.dataset.chapter ?? '0', 10) <= revealedUpTo)
          layer.classList.add('is-visible');
      });
    }

    function activateChapter(chNum: number, captionText: string) {
      if (chNum === activeChapter) return;
      activeChapter = chNum;

      chapters.forEach((el, i) => {
        const n = i + 1;
        el.classList.toggle('is-active',   n === chNum);
        el.classList.toggle('is-inactive', n !== chNum);
      });

      segments.forEach((seg, i) => {
        seg.classList.toggle('is-active', i < chNum);
      });

      if (caption) caption.textContent = captionText;
    }

    // Initialise: chapter 1 active, map layer 1 visible
    revealMapUpTo(1);
    activateChapter(1, 'Umuofia — before colonization');

    // Drop observer below 720px (TFA sticky threshold)
    if (window.matchMedia('(min-width: 720px)').matches) {
      const obs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          const el  = entry.target as HTMLElement;
          const ch  = parseInt(el.dataset.chapter ?? '0', 10);
          const cap = el.dataset.caption ?? '';
          revealMapUpTo(ch);
          activateChapter(ch, cap);
        });
      }, { threshold: 0.5 });

      chapters.forEach(ch => obs.observe(ch));
    }
  </script>

