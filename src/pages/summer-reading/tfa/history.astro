  function cpReached(p) {
    const [px, py, label] = p;
    let s = `<circle class="cp-reached-halo" cx="${px}" cy="${py}" r="7"/>` +
      `<circle class="cp-excluded" cx="${px}" cy="${py}" r="4.2"/>` +
      `<circle class="cp-reached" cx="${px}" cy="${py}" r="2.4"/>`;
    if (label) s += `<text class="cp-lbl" x="${+px - 9}" y="${+py + 3}" text-anchor="end">${label}</text>`;
    return s;
  }
  function cpChapel(x, y) {
    return `<g><rect class="cp-chapel" x="${x - 7}" y="${y}" width="14" height="12"/>` +
      `<path class="cp-chapel" d="M${x - 9} ${y} L${x} ${y - 10} L${x + 9} ${y}"/>` +
      `<line class="cp-chapel" x1="${x}" y1="${y - 18}" x2="${x}" y2="${y - 11}"/>` +
      `<line class="cp-chapel" x1="${x - 2.6}" y1="${y - 15}" x2="${x + 2.6}" y2="${y - 15}"/>` +
      `<text class="cp-lbl" x="${x}" y="${y + 26}" text-anchor="middle">THE CHURCH</text></g>`;
  }
  function buildChurchPath() {
    const svg = document.querySelector('[data-church-path]');
    if (!svg) return;
    const frame = '<rect class="cp-frame" x="58" y="44" width="350" height="276" rx="10"/>' +
      '<text class="cp-frame-lbl" x="64" y="38">UMUOFIA · SCHEMATIC</text>';
    const discs = CP_COMMS.map(cpDisc).join('');
    const path  = `<path class="cp-path" d="${smoothPath(CP_PATH)}"/>`;
    const reach = CP_REACH.map(p => cpReached(p)).join('');
    const note  = '<text class="cp-note" x="233" y="340" text-anchor="middle">Not the centre — the margins.</text>';
    svg.innerHTML = frame + discs + path + reach + cpChapel(46, 290) + note;
  }

  /* ═══════════════════ Zone 3 — church pipeline ══════════════════════════ */
  const PIPE = [
    { x: 78,  name: ['Mission', 'church'],       sub: "Mr. Brown's church",  g: 'chapel' },
    { x: 194, name: ['Mission', 'school'],        sub: 'the road to letters', g: 'book' },
    { x: 310, name: ['Literacy'],                 sub: 'reading · writing',   g: 'pen' },
    { x: 426, name: ['Colonial', 'post'],         sub: 'clerk · interpreter', g: 'doc' },
    { x: 540, name: ['Administrative', 'class'],  sub: 'who governs Nigeria', g: 'columns' }
  ];
  function pipeMix(t) {
    return [
      Math.round(196 + (44 - 196) * t),
      Math.round(114 + (26 - 114) * t),
      Math.round(42  + (8  - 42)  * t)
    ];
  }
  function pipeGlyph(kind, x, col) {
    const s = ` stroke="${col}" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"`;
    const sf = ` fill="${col}"`;
    if (kind === 'chapel') return `<g${s}><rect x="${x - 7}" y="90" width="14" height="12"/><path d="M${x - 9} 90 L${x} 80 L${x + 9} 90"/><line x1="${x}" y1="73" x2="${x}" y2="79"/><line x1="${x - 2.6}" y1="76" x2="${x + 2.6}" y2="76"/></g>`;
    if (kind === 'book')   return `<g${s}><line x1="${x}" y1="84" x2="${x}" y2="103"/><path d="M${x} 85 C ${x - 10} 83 ${x - 13} 88 ${x - 13} 100 L ${x} 102"/><path d="M${x} 85 C ${x + 10} 83 ${x + 13} 88 ${x + 13} 100 L ${x} 102"/></g>`;
    if (kind === 'pen')    return `<g${s}><line x1="${x - 9}" y1="90" x2="${x + 3}" y2="90"/><line x1="${x - 9}" y1="95" x2="${x + 6}" y2="95"/><line x1="${x - 9}" y1="100" x2="${x}" y2="100"/><line x1="${x + 11}" y1="80" x2="${x - 1}" y2="101"/><path${sf} stroke="none" d="M${x - 1} 101 L${x - 4.5} 104 L${x + 1.5} 103.5 Z"/></g>`;
    if (kind === 'doc')    return `<g${s}><rect x="${x - 9}" y="80" width="17" height="23" rx="1"/><line x1="${x - 5}" y1="86" x2="${x + 4}" y2="86"/><line x1="${x - 5}" y1="91" x2="${x + 4}" y2="91"/><line x1="${x - 5}" y1="96" x2="${x + 1}" y2="96"/><circle cx="${x + 7}" cy="101" r="4.5"/><path d="M${x + 4.6} 101 l1.6 1.7 l3 -3.4"/></g>`;
    return `<g${s}><path d="M${x - 12} 88 L${x} 79 L${x + 12} 88 Z"/><line x1="${x - 8}" y1="90" x2="${x - 8}" y2="102"/><line x1="${x}" y1="90" x2="${x}" y2="102"/><line x1="${x + 8}" y1="90" x2="${x + 8}" y2="102"/><line x1="${x - 12}" y1="104" x2="${x + 12}" y2="104"/></g>`;
  }
  function buildChurchPipeline() {
    const svg = document.querySelector('[data-church-pipe]');
    if (!svg) return;
    const defs = '<defs><linearGradient id="tcp-grad" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#C4722A"/><stop offset="1" stop-color="#2C1A08"/></linearGradient></defs>';
    const eyebrow = '<text class="tcp-eyebrow" x="78" y="30">SOFT ENTRY → HARD RULE</text>';
    const spine = '<line x1="78" y1="96" x2="540" y2="96" stroke="url(#tcp-grad)" stroke-width="2.5"/>';
    let chevs = '';
    for (let k = 0; k < PIPE.length - 1; k++) {
      const mx = (PIPE[k].x + PIPE[k + 1].x) / 2;
      const [r, g, b] = pipeMix((k + 0.5) / (PIPE.length - 1));
      chevs += `<path d="M${mx - 3} 92 L${mx + 3} 96 L${mx - 3} 100" fill="none" stroke="rgb(${r},${g},${b})" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`;
    }
    const nodes = PIPE.map((st, i) => {
      const [r, g, b] = pipeMix(i / (PIPE.length - 1));
      const col = `rgb(${r},${g},${b})`;
      const faint = `rgba(${r},${g},${b},0.07)`;
      const node = `<circle cx="${st.x}" cy="96" r="27" fill="${faint}" stroke="${col}" stroke-width="1.6"/>`;
      const glyph = pipeGlyph(st.g, st.x, col);
      const nameCls = i <= 1 ? 'tcp-name--warm' : (i === 2 ? 'tcp-name--mid' : 'tcp-name--cold');
      const ny = 152;
      const names = st.name.map((ln, j) => `<text class="${nameCls}" x="${st.x}" y="${ny + j * 15}" text-anchor="middle">${ln}</text>`).join('');
      const sub   = `<text class="tcp-sub" x="${st.x}" y="${ny + st.name.length * 15 + 4}" text-anchor="middle">${st.sub}</text>`;
      return node + glyph + names + sub;
    }).join('');
    svg.innerHTML = defs + eyebrow + spine + chevs + nodes;
  }

  /* ═══════════════════ Zone 4 — disappearance emblem ════════════════════ */
  function person(x, baseY, h, hCls, bCls) {
    const hr = h * 0.17, headCy = baseY - h + hr;
    const shoulder = headCy + hr * 1.25, half = h * 0.23;
    return `<circle class="${hCls}" cx="${x.toFixed(1)}" cy="${headCy.toFixed(1)}" r="${hr.toFixed(1)}"/>` +
      `<path class="${bCls}" d="M${(x - half).toFixed(1)} ${baseY.toFixed(1)} L${x.toFixed(1)} ${shoulder.toFixed(1)} L${(x + half).toFixed(1)} ${baseY.toFixed(1)} Z"/>`;
  }
  function flamePath(cx, baseY, k) {
    const X = o => (cx + o * k).toFixed(1);
    const Y = o => (baseY + o * k).toFixed(1);
    return `M${X(-24)} ${Y(0)}` +
      ` C${X(-38)} ${Y(-32)} ${X(-26)} ${Y(-52)} ${X(-16)} ${Y(-62)}` +
      ` C${X(-21)} ${Y(-74)} ${X(-14)} ${Y(-80)} ${X(-11)} ${Y(-88)}` +
      ` C${X(-8)} ${Y(-76)} ${X(-6)} ${Y(-71)} ${X(-2)} ${Y(-75)}` +
      ` C${X(0)} ${Y(-88)} ${X(2)} ${Y(-96)} ${X(3)} ${Y(-101)}` +
      ` C${X(4)} ${Y(-88)} ${X(7)} ${Y(-76)} ${X(11)} ${Y(-72)}` +
      ` C${X(9)} ${Y(-80)} ${X(15)} ${Y(-76)} ${X(14)} ${Y(-68)}` +
      ` C${X(24)} ${Y(-52)} ${X(38)} ${Y(-32)} ${X(24)} ${Y(0)}` +
      ` C${X(15)} ${Y(6)} ${X(-15)} ${Y(6)} ${X(-24)} ${Y(0)} Z`;
  }
  function flameAura(cx, baseY, k) { return `<path class="dg-flame" d="${flamePath(cx, baseY, k)}"/>`; }
  function ankletCords(cx, baseY, k) {
    function band(ax) {
      return `<line class="dg-anklet" x1="${(ax - 4 * k).toFixed(1)}" y1="${(baseY - 7 * k).toFixed(1)}" x2="${(ax + 4 * k).toFixed(1)}" y2="${(baseY - 7 * k).toFixed(1)}"/>` +
        `<line class="dg-anklet" x1="${(ax - 3.5 * k).toFixed(1)}" y1="${(baseY - 4 * k).toFixed(1)}" x2="${(ax + 3.5 * k).toFixed(1)}" y2="${(baseY - 4 * k).toFixed(1)}"/>`;
    }
    return band(cx - 12 * k) + band(cx + 12 * k);
  }
  function emblem(cx, baseY, h, level) {
    const k = h / 78;
    const hr = 9 * k, headCy = baseY - h + hr;
    const shY = headCy + hr + 3 * k, shH = 17 * k;
    const hipY = baseY - 26 * k, hipH = 7 * k, foot = 13 * k;
    const hCls = level === 'reduced' ? 'dg-mid-h' : 'dg-ok-h';
    const bCls = level === 'reduced' ? 'dg-mid-b' : 'dg-ok-b';
    const lCls = level === 'reduced' ? 'dg-mid-line' : 'dg-ok-line';
    const p = [];
    if (level === 'full') p.push(flameAura(cx, baseY, k));
    p.push(`<path class="${lCls}" style="stroke-width:${(5 * k).toFixed(1)}" d="M${(cx - hipH).toFixed(1)} ${hipY.toFixed(1)} L${(cx - foot).toFixed(1)} ${baseY.toFixed(1)}"/>`);
    p.push(`<path class="${lCls}" style="stroke-width:${(5 * k).toFixed(1)}" d="M${(cx + hipH).toFixed(1)} ${hipY.toFixed(1)} L${(cx + foot).toFixed(1)} ${baseY.toFixed(1)}"/>`);
    p.push(`<path class="${bCls}" d="M${(cx - shH).toFixed(1)} ${shY.toFixed(1)} L${(cx + shH).toFixed(1)} ${shY.toFixed(1)} L${(cx + hipH).toFixed(1)} ${hipY.toFixed(1)} L${(cx - hipH).toFixed(1)} ${hipY.toFixed(1)} Z"/>`);
    if (level === 'full') {
      p.push(`<path class="${lCls}" style="stroke-width:${(4 * k).toFixed(1)}" d="M${(cx - shH).toFixed(1)} ${shY.toFixed(1)} L${(cx - 30 * k).toFixed(1)} ${(shY + 14 * k).toFixed(1)} L${(cx - 17 * k).toFixed(1)} ${(shY + 19 * k).toFixed(1)}"/>`);
      p.push(`<path class="${lCls}" style="stroke-width:${(4 * k).toFixed(1)}" d="M${(cx + shH).toFixed(1)} ${shY.toFixed(1)} L${(cx + 30 * k).toFixed(1)} ${(shY + 14 * k).toFixed(1)} L${(cx + 17 * k).toFixed(1)} ${(shY + 19 * k).toFixed(1)}"/>`);
    } else {
      p.push(`<path class="${lCls}" style="stroke-width:${(3.4 * k).toFixed(1)}" d="M${(cx - shH + 1).toFixed(1)} ${shY.toFixed(1)} L${(cx - shH - 3 * k).toFixed(1)} ${(shY + 16 * k).toFixed(1)}"/>`);
      p.push(`<path class="${lCls}" style="stroke-width:${(3.4 * k).toFixed(1)}" d="M${(cx + shH - 1).toFixed(1)} ${shY.toFixed(1)} L${(cx + shH + 3 * k).toFixed(1)} ${(shY + 16 * k).toFixed(1)}"/>`);
    }
    p.push(`<circle class="${hCls}" cx="${cx.toFixed(1)}" cy="${headCy.toFixed(1)}" r="${hr.toFixed(1)}"/>`);
    if (level === 'full') {
      p.push(ankletCords(cx, baseY, k));
      p.push(`<line class="dg-title" x1="${(cx - 16 * k).toFixed(1)}" y1="${(baseY + 6 * k).toFixed(1)}" x2="${(cx + 16 * k).toFixed(1)}" y2="${(baseY + 6 * k).toFixed(1)}"/>`);
      p.push(`<line class="dg-title" x1="${(cx - 11 * k).toFixed(1)}" y1="${(baseY + 10 * k).toFixed(1)}" x2="${(cx + 11 * k).toFixed(1)}" y2="${(baseY + 10 * k).toFixed(1)}"/>`);
    } else {
      p.push(`<line class="dg-title" x1="${(cx - 10 * k).toFixed(1)}" y1="${(baseY + 6 * k).toFixed(1)}" x2="${(cx + 10 * k).toFixed(1)}" y2="${(baseY + 6 * k).toFixed(1)}" style="stroke:#97602e;opacity:0.75"/>`);
    }
    return p.join('');
  }
  function buildDiminish() {
    const svg = document.querySelector('[data-diminish]');
    if (!svg) return;
    const baseY = 250;
    const parts = [];
    parts.push(`<line class="dg-base" x1="40" y1="${baseY}" x2="800" y2="${baseY}"/>`);
    // Station 1 — at the centre of his world
    const c1x = 150, clan1 = 7;
    for (let i = 0; i < clan1; i++) {
      const a = -Math.PI + (i / (clan1 - 1)) * Math.PI;
      parts.push(person(c1x + Math.cos(a) * 78, 188 + Math.sin(a) * 70, 13, 'dg-clan-h', 'dg-clan-b'));
    }
    parts.push(emblem(c1x, baseY, 86, 'full'));
    parts.push(`<text class="dg-lbl dg-lbl--terra" x="${c1x}" y="318" text-anchor="middle">At the centre of his world</text>`);
    parts.push(`<text class="dg-scale" x="${c1x}" y="334" text-anchor="middle">the roaring flame</text>`);
    // Station 2 — the fire cools
    const c2x = 420, clan2 = 5;
    parts.push('<g opacity="0.3">');
    for (let j = 0; j < clan2; j++) {
      const a2 = -Math.PI + (j / (clan2 - 1)) * Math.PI;
      parts.push(person(c2x + Math.cos(a2) * 54, 206 + Math.sin(a2) * 46, 11, 'dg-clan-h', 'dg-clan-b'));
    }
    parts.push('</g>');
    parts.push(emblem(c2x, baseY, 52, 'reduced'));
    parts.push(`<text class="dg-lbl" x="${c2x}" y="318" text-anchor="middle">As the world falls apart</text>`);
    parts.push(`<text class="dg-scale" x="${c2x}" y="334" text-anchor="middle">the fire cools</text>`);
    // Station 3 — a reasonable paragraph
    const c3x = 680, boxL = 624, boxW = 116;
    const lineYs = [182, 194, 206, 218, 230, 242];
    const rline = rng(4471);
    lineYs.forEach((ly, kk) => {
      const w = boxW * (0.72 + rline() * 0.28);
      if (kk === 3) {
        parts.push(`<line class="dg-textline" x1="${boxL}" y1="${ly}" x2="${c3x - 9}" y2="${ly}"/>`);
        parts.push(`<line class="dg-textline" x1="${c3x + 9}" y1="${ly}" x2="${boxL + w}" y2="${ly}"/>`);
      } else {
        parts.push(`<line class="dg-textline" x1="${boxL}" y1="${ly}" x2="${boxL + w}" y2="${ly}"/>`);
      }
    });
    parts.push(person(c3x, 221, 13, 'dg-rec-h', 'dg-rec-b'));
    parts.push(`<text class="dg-lbl dg-lbl--umber" x="${c3x}" y="318" text-anchor="middle">A reasonable paragraph</text>`);
    parts.push(`<text class="dg-scale" x="${c3x}" y="334" text-anchor="middle">cold, impotent ash</text>`);
    function conn(x1, x2) {
      const my = baseY - 4;
      parts.push(`<line class="dg-conn" x1="${x1}" y1="${my}" x2="${x2 - 7}" y2="${my}"/>`);
      parts.push(`<path class="dg-arrow" d="M${x2 - 7} ${my - 3.2} L${x2} ${my} L${x2 - 7} ${my + 3.2} Z"/>`);
    }
    conn(258, 360);
    conn(486, 602);
    svg.innerHTML = parts.join('');
  }

  /* ═══════════════════ Exclusive-crossfade scroll engine ═════════════════
     CSS transitions freeze on SVG <g> elements; tween opacity per rAF instead.
  ══════════════════════════════════════════════════════════════════════════ */
  let sweeps = [];
  let revealTween = null;
  const nextFrame = fn => document.hidden ? setTimeout(fn, 16) : requestAnimationFrame(fn);

  function initZones() {
    sweeps = [];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || window.innerWidth < 768) return;

    document.querySelectorAll('.sr-scrolly-zone[data-field="map"]').forEach(z => {
      const field = z.querySelector('.sr-zone-field');
      const beats = Array.from(z.querySelectorAll('[data-beat]'));
      if (!beats.length) return;

      function sweep() {
        const line = window.innerHeight * 0.5;
        let bestIdx = 0, bestDist = Infinity;
        beats.forEach((beat, i) => {
          const rect = beat.getBoundingClientRect();
          const dist = Math.abs((rect.top + rect.height / 2) - line);
          if (dist < bestDist) { bestDist = dist; bestIdx = i; }
        });
        beats.forEach((beat, i) => beat.classList.toggle('is-active', i === bestIdx));

        if (field && field.querySelector('[data-show-from]')) {
          const curKey = beats[bestIdx] && beats[bestIdx].dataset.activates;
          const revealed = {};
          if (curKey) revealed[curKey] = 1;
          setFieldReveal(field, revealed);
          field.querySelectorAll('[data-show-from]').forEach(g => {
            g.classList.toggle('is-current', !!curKey && g.getAttribute('data-show-from') === curKey);
          });
        }
      }
      sweeps.push(sweep);
      sweep();
    });
  }

  function setFieldReveal(field, revealed) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let changed = false;
    field.querySelectorAll('[data-show-from]').forEach(g => {
      const target = revealed[g.getAttribute('data-show-from')] ? 1 : 0;
      if (g.__t === undefined) g.__t = parseFloat(getComputedStyle(g).opacity) || 0;
      if (g.__t !== target) { g.__t = target; changed = true; }
      if (g.__c === undefined) g.__c = parseFloat(getComputedStyle(g).opacity) || 0;
      if (reduced) { g.__c = target; g.style.opacity = String(target); }
    });
    if (reduced || !changed) return;
    if (!revealTween) revealTween = nextFrame(tickReveal);
  }

  function tickReveal() {
    revealTween = null;
    let moving = false;
    document.querySelectorAll('[data-show-from]').forEach(g => {
      if (g.__t === undefined) return;
      let cur = g.__c !== undefined ? g.__c : (parseFloat(getComputedStyle(g).opacity) || 0);
      const diff = g.__t - cur;
      if (Math.abs(diff) < 0.02) { cur = g.__t; }
      else { cur += diff * 0.16; moving = true; }
      g.__c = cur; g.style.opacity = String(cur);
    });
    if (moving) revealTween = nextFrame(tickReveal);
  }

  let sweepQueued = false;
  function runSweeps() {
    if (sweepQueued) return; sweepQueued = true;
    nextFrame(() => { sweepQueued = false; sweeps.forEach(fn => fn()); });
  }

  function boot() {
    document.body.classList.add('tfa-close-disappearance');
    buildWarrantMap();
    buildPartitionMap();
    buildReplacement();
    buildEncircle();
    buildChurchPath();
    buildChurchPipeline();
    buildDiminish();
    initZones();
    window.addEventListener('scroll', runSweeps, { passive: true });
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { initZones(); runSweeps(); }, 250);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
})();
</script>
