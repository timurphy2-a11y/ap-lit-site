---
import { getEntry } from 'astro:content';
import PeriodMotif from '../../../components/PeriodMotif.astro';
import { HUB_DATA } from '../../../data/hub-introductions';
import { HUB_EVENTS } from '../../../data/timeline-events';
import { HISTORICAL_MOMENTS } from '../../../data/historical-moments';

export async function getStaticPaths() {
  const ids = [
    '00-medieval',
    '01-renaissance',
    '02-baroque',
    '03-enlightenment',
    '04-romanticism',
    '05-modernism',
  ] as const;

  return ids.map((id, index) => ({
    params: { unit: id },
    props: {
      prevUnit: index > 0 ? ids[index - 1] : null,
      nextUnit: index < ids.length - 1 ? ids[index + 1] : null,
    },
  }));
}

const { unit } = Astro.params;
const { prevUnit, nextUnit } = Astro.props;

const [philosophy, art, music, sculpture] = await Promise.all([
  getEntry('units', `${unit}/philosophy`),
  getEntry('units', `${unit}/art`),
  getEntry('units', `${unit}/music`),
  getEntry('units', `${unit}/sculpture`),
]);

const meta = philosophy.data;
const unitNumber = unit.slice(0, 2);
const hubData = HUB_DATA[unit];
const moment = HISTORICAL_MOMENTS[unit];
const timelineEvents = HUB_EVENTS[unit] ?? [];

// Per-unit mark palette (CSS-var parameterized motifs)
const MARK_VARS: Record<string, { primary: string; highlight: string; spot: string }> = {
  '00-medieval':      { primary: '#C9A24B', highlight: '#E0C387', spot: 'transparent' },
  '01-renaissance':   { primary: '#B54C3A', highlight: '#C68A7A', spot: '#2C4A82' },
  '02-baroque':       { primary: '#B07028', highlight: '#D49432', spot: 'transparent' },
  '03-enlightenment': { primary: '#698BA1', highlight: '#A2B7C8', spot: 'transparent' },
  '04-romanticism':   { primary: '#3D5A6D', highlight: '#8AA3B5', spot: '#A85428' },
  '05-modernism':     { primary: '#A03828', highlight: '#D49A8C', spot: '#A07820' },
};
const marks = MARK_VARS[unit] ?? MARK_VARS['00-medieval'];

// Per-unit accent color sets
const ACCENTS: Record<string, { acc: string; philosophy: string; art: string; music: string }> = {
  '00-medieval':      { acc: '#C9A24B', philosophy: '#C9A24B', art: '#C9A24B', music: '#C9A24B' },
  '01-renaissance':   { acc: '#B54C3A', philosophy: '#B54C3A', art: '#B54C3A', music: '#B54C3A' },
  '02-baroque':       { acc: '#B07028', philosophy: '#B07028', art: '#B07028', music: '#B07028' },
  '03-enlightenment': { acc: '#698BA1', philosophy: '#698BA1', art: '#698BA1', music: '#698BA1' },
  '04-romanticism':   { acc: '#3D5A6D', philosophy: '#3D5A6D', art: '#3D5A6D', music: '#3D5A6D' },
  '05-modernism':     { acc: '#A03828', philosophy: '#A03828', art: '#A03828', music: '#A03828' },
};
const colors = ACCENTS[unit] ?? ACCENTS['00-medieval'];

// Prev/next labels
const prevLabel = prevUnit
  ? (await getEntry('units', `${prevUnit}/philosophy`))?.data.period
  : null;
const nextLabel = nextUnit
  ? (await getEntry('units', `${nextUnit}/philosophy`))?.data.period
  : null;

// Drop cap for intro text
const dropLetter = hubData.intro.charAt(0);
const introRest  = hubData.intro.slice(1);

// Pass moment data to client for modal
const momentJson = JSON.stringify({
  title: hubData.historicalMomentTitle,
  subtitle: moment.subtitle,
  paragraphs: moment.paragraphs,
});
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,400;1,500&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{meta.period} — AP Literature</title>
</head>
<body style={`--acc:${colors.acc}; --acc-philosophy:${colors.philosophy}; --acc-art:${colors.art}; --acc-music:${colors.music}; --mark-primary:${marks.primary}; --mark-highlight:${marks.highlight}; --mark-spot:${marks.spot}; --mark-ink:#2C2820; --mark-cream:#F6F1E8; --mark-tile:#EDE8DC; --mark-rule:#C8C0B0; --mark-muted:#6B6355;`}>

<!-- ── Top nav ── -->
<div class="topbar">
  <a href="/" class="brand">AP Literature</a>
  <nav class="nav">
    <a href="/timeline">Timeline</a>
    <a href="/people">People</a>
    <a href="/compare">Compare</a>
    <a href="/seeing-through-paint">Painting</a>
    <a href="/sculpting-through-time">Sculpture</a>
    <a href="/hearing-through-form">Music</a>
  </nav>
</div>

<!-- ── Header band (role 6) ── -->
<div class="header-band" aria-hidden="true">
  <PeriodMotif unit={unit} role={6} />
</div>

<!-- ── Breadcrumb ── -->
<div class="crumb">
  <a href="/">Home</a>
  <span class="sep">/</span>
  <span>Units</span>
  <span class="sep">/</span>
  <span style="color:var(--ink-mute)">{unitNumber} — {meta.period}</span>
</div>

<!-- ── Unit header ── -->
<section class="unit-head">
  <div>
    <div class="unit-num">{unitNumber}</div>
    <div class="unit-meta">Unit · {meta.core_text ? `Anchor: ${meta.core_text}` : 'Foundation'}</div>
    <h1 class="unit-title">{meta.period}</h1>
    <div class="unit-dates">{meta.dates}</div>
  </div>
  <div class="unit-head-right">
    <span class="page-sig" aria-hidden="true">
      <PeriodMotif unit={unit} role={5} />
    </span>
    <p class="unit-kicker">{hubData.kicker}</p>
  </div>
</section>

<!-- ── Pull quotes ── -->
<section class="quotes">
  {hubData.epigraphs.map((epigraph) => (
    <div class="quote">
      <blockquote>{epigraph.quote}</blockquote>
      <cite set:html={epigraph.attribution.replace(/‘(.*?)’/g, '<em>$1</em>').replace(/'(.*?)'/g, '<em>$1</em>')} />
    </div>
  ))}
</section>

<!-- ── About prose ── -->
<div class="about">
  <span class="drop">{dropLetter}</span>{introRest}
</div>

<!-- ── Thread buttons ── -->
<section class="thread-section">
  <div class="thread-frieze">
    <span class="frieze-label">The Four Threads</span>
    <div class="frieze-band" aria-hidden="true">
      <PeriodMotif unit={unit} role={6} />
    </div>
    <span class="frieze-label">Unit {unitNumber} · {meta.period}</span>
  </div>
  <div class="thread-buttons">

    <!-- Philosophy -->
    <a class="thread-btn" href={`/units/${unit}/philosophy`}>
      <div class="btn-top">
        <div class="btn-sigil">
          <svg viewBox="0 0 40 40" fill="none" stroke="#F6F1E8" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="20" cy="20" r="14"/>
            <circle cx="20" cy="20" r="8"/>
            <circle cx="20" cy="20" r="1.8" fill="#F6F1E8" stroke="none"/>
          </svg>
        </div>
        <div class="btn-label">Philosophy</div>
      </div>
      <div class="btn-bottom">
        <div class="btn-caption">Argument, faith, the human position</div>
        <div class="btn-footer">
          <span>Open thread</span>
          <span class="btn-arrow">→</span>
        </div>
      </div>
    </a>

    <!-- Painting -->
    <a class="thread-btn" href={`/units/${unit}/art`}>
      <div class="btn-top">
        <span class="btn-eyebrow">Visual Art</span>
        <div class="btn-sigil">
          <svg viewBox="0 0 40 40" fill="none" stroke="#F6F1E8" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="8" width="24" height="24" transform="rotate(45 20 20)"/>
            <circle cx="20" cy="20" r="1.5" fill="#F6F1E8" stroke="none"/>
          </svg>
        </div>
        <div class="btn-label">Painting</div>
      </div>
      <div class="btn-bottom">
        <div class="btn-caption">Figure, space, light, surface</div>
        <div class="btn-footer">
          <span>Open thread</span>
          <span class="btn-arrow">→</span>
        </div>
      </div>
    </a>

    <!-- Sculpture -->
    <a class="thread-btn" href={`/units/${unit}/sculpture`}>
      <div class="btn-top">
        <span class="btn-eyebrow">Visual Art</span>
        <div class="btn-sigil">
          <svg viewBox="0 0 40 40" fill="none" stroke="#F6F1E8" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 L34 14 L34 28 L20 36 L6 28 L6 14 Z"/>
            <path d="M6 14 L20 22 L34 14"/>
            <line x1="20" y1="22" x2="20" y2="36"/>
          </svg>
        </div>
        <div class="btn-label">Sculpture</div>
      </div>
      <div class="btn-bottom">
        <div class="btn-caption">Body, volume, material, setting</div>
        <div class="btn-footer">
          <span>Open thread</span>
          <span class="btn-arrow">→</span>
        </div>
      </div>
    </a>

    <!-- Music -->
    <a class="thread-btn" href={`/units/${unit}/music`}>
      <div class="btn-top">
        <div class="btn-sigil">
          <svg viewBox="0 0 40 40" fill="none" stroke="#F6F1E8" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 24 A 14 14 0 0 1 34 24"/>
            <circle cx="20" cy="24" r="2" fill="#F6F1E8" stroke="none"/>
            <line x1="6" y1="32" x2="34" y2="32"/>
          </svg>
        </div>
        <div class="btn-label">Music</div>
      </div>
      <div class="btn-bottom">
        <div class="btn-caption">Texture, consonance, structure</div>
        <div class="btn-footer">
          <span>Open thread</span>
          <span class="btn-arrow">→</span>
        </div>
      </div>
    </a>

  </div>
</section>

<!-- ── Historical Moment ── -->
<div class="section-label" style="padding-top: 72px;">
  <span>Historical Moment</span>
  <span class="rule-line"></span>
</div>

<div class="moment-frame">
  <button class="moment-bar" id="moment-trigger" type="button">
    <span class="label">The Period</span>
    <span class="phrase">{hubData.historicalMomentTitle}</span>
    <span class="chev">Read <span>→</span></span>
  </button>

  <div class="htline">
    <div class="axis" aria-hidden="true"></div>
    <div class="row">
      {timelineEvents.map((evt) => (
        <div class="node">
          <div class="yr">{evt.year}</div>
          <div class="tick" aria-hidden="true"></div>
          <div class="ev">{evt.title}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- ── Historical Moment modal ── -->
<div class="modal-backdrop" id="moment-modal" role="dialog" aria-modal="true" aria-labelledby="moment-title">
  <div class="modal">
    <button class="modal-close" id="moment-close" aria-label="Close">×</button>
    <div class="modal-label">The Period in One Phrase</div>
    <h2 id="moment-title"></h2>
    <div id="moment-body"></div>
  </div>
</div>

<!-- ── Pagination ── -->
<nav class="pager">
  {prevUnit ? (
    <a class="prev" href={`/units/${prevUnit}`}>
      <span class="lbl">Previous</span>
      <span class="title">{prevLabel}</span>
    </a>
  ) : (
    <a class="prev disabled" aria-disabled="true">
      <span class="lbl">Previous</span>
      <span class="title">—</span>
    </a>
  )}
  {nextUnit ? (
    <a class="next" href={`/units/${nextUnit}`}>
      <span class="lbl">Unit {nextUnit?.slice(0,2)}</span>
      <span class="title">{nextLabel}</span>
    </a>
  ) : (
    <a class="next disabled" aria-disabled="true">
      <span class="lbl">Next</span>
      <span class="title">—</span>
    </a>
  )}
</nav>

<footer>
  <div class="colophon">AP Literature · Historical &amp; Aesthetic Background</div>
  <div>Unit {unitNumber} of 06</div>
</footer>

</body>
</html>

<script define:vars={{ momentJson }}>
  (function () {
    const data    = JSON.parse(momentJson);
    const trigger = document.getElementById('moment-trigger');
    const modal   = document.getElementById('moment-modal');
    const close   = document.getElementById('moment-close');
    const titleEl = document.getElementById('moment-title');
    const bodyEl  = document.getElementById('moment-body');

    function mdItalics(text) {
      return text.replace(/\*(.*?)\*/g, '<em>$1</em>');
    }

    function openModal() {
      titleEl.textContent = data.title;
      bodyEl.innerHTML = data.paragraphs.map(p => `<p>${mdItalics(p)}</p>`).join('');
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openModal);
    close.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  })();
</script>

<style is:global>
  /* ── Design tokens ─────────────────────────────────────────── */
  :root {
    --bg:          #F4EDDF;
    --bg-raised:   #EBE2D0;
    --bg-sunken:   #FAF4E6;
    --ink:         #1B1714;
    --ink-mute:    #4a4138;
    --ink-soft:    #6a6053;
    --rule:        #C9BDA5;
    --rule-strong: #A89978;

    --font-display: 'Spectral', Georgia, serif;
    --font-ui:      'IBM Plex Sans', system-ui, sans-serif;
    --font-mono:    'IBM Plex Mono', ui-monospace, monospace;

    --gutter:  clamp(24px, 4vw, 72px);
    --measure: 62ch;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.55;
    padding: 0 var(--gutter);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a { color: inherit; text-decoration: none; }

  /* ── Header band (role 6) ──────────────────────────────────── */
  .header-band {
    width: 100%;
    overflow: hidden;
    margin: 0 calc(-1 * var(--gutter));
    width: calc(100% + 2 * var(--gutter));
  }
  .header-band svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ── Topbar ─────────────────────────────────────────────────── */
  .topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 28px 0 22px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .brand {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 16px;
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .nav { display: flex; gap: 28px; }
  .nav a:hover { color: var(--ink); }

  /* ── Breadcrumb ─────────────────────────────────────────────── */
  .crumb {
    padding: 20px 0 0;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    display: flex;
    gap: 10px;
    align-items: center;
  }
  .crumb a:hover { color: var(--ink); }
  .crumb .sep { color: var(--rule-strong); }

  /* ── Unit header ────────────────────────────────────────────── */
  .unit-head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 72px;
    padding: 48px 0 64px;
    border-bottom: 1px solid var(--rule);
    align-items: end;
  }
  @media (max-width: 960px) {
    .unit-head { grid-template-columns: 1fr; gap: 32px; padding: 32px 0 40px; }
  }

  .unit-num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(60px, 9vw, 120px);
    line-height: 0.85;
    color: var(--acc);
    letter-spacing: -0.04em;
    margin: 0 0 8px;
  }
  .unit-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 12px;
  }
  .unit-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(40px, 5.2vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: var(--ink);
  }
  .unit-dates {
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
  }
  .unit-head-right {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .page-sig {
    display: block;
    width: 56px;
    height: 56px;
  }
  .page-sig svg { width: 100%; height: 100%; }

  .unit-kicker {
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-mute);
    max-width: 48ch;
    margin: 0;
  }

  /* ── Pull quotes ────────────────────────────────────────────── */
  .quotes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 780px) { .quotes { grid-template-columns: 1fr; } }

  .quote {
    background: var(--bg);
    padding: 48px 40px 40px;
    position: relative;
  }
  .quote::before {
    content: '\201C';
    position: absolute;
    top: 6px;
    left: 28px;
    font-family: var(--font-display);
    font-size: 90px;
    line-height: 1;
    color: var(--acc);
    opacity: 0.55;
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink);
    max-width: 42ch;
  }
  .quote cite {
    display: block;
    margin-top: 20px;
    font-family: var(--font-ui);
    font-style: normal;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .quote cite em {
    font-style: italic;
    font-family: var(--font-display);
    font-size: 15px;
    text-transform: none;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
  }

  /* ── Section label ──────────────────────────────────────────── */
  .section-label {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 72px 0 24px;
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .section-label .n { font-family: var(--font-mono); color: var(--ink-mute); }
  .rule-line { flex: 1; height: 1px; background: var(--rule); }

  /* ── About prose ────────────────────────────────────────────── */
  .about {
    max-width: var(--measure);
    margin: 0 auto;
    font-size: 19px;
    line-height: 1.65;
    color: var(--ink-mute);
    padding: 56px 0 24px;
  }
  .about em { font-style: italic; color: var(--ink); }
  .about .drop {
    float: left;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 78px;
    line-height: 0.85;
    color: var(--acc);
    padding: 8px 14px 0 0;
    letter-spacing: -0.02em;
  }

  /* ── Thread buttons ─────────────────────────────────────────── */
  .thread-section {
    margin-top: 48px;
  }

  .thread-frieze {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 18px 4px 14px;
  }
  .frieze-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .frieze-band {
    flex: 1;
    overflow: hidden;
    height: 72px;
  }
  .frieze-band svg {
    display: block;
    width: 100%;
    height: 72px;
  }

  .thread-buttons {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  @media (max-width: 900px) { .thread-buttons { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .thread-buttons { grid-template-columns: 1fr; } }

  .thread-btn {
    display: flex;
    flex-direction: column;
    height: 300px;
    background: var(--bg);
    border: 1px solid var(--mark-highlight);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 160ms ease;
  }
  .thread-btn:hover { border-color: var(--mark-primary); }
  .thread-btn:hover .btn-top { filter: brightness(1.07); }
  .thread-btn:hover .btn-arrow { transform: translateX(2px); }
  @media (max-width: 480px) { .thread-btn { height: auto; } }

  .btn-top {
    flex: 0 0 62%;
    background: var(--mark-primary);
    padding: 22px 18px 18px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    position: relative;
    transition: filter 160ms ease;
  }

  .btn-eyebrow {
    position: absolute;
    top: 12px;
    left: 0; right: 0;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(246,241,232,0.65);
  }

  .btn-sigil {
    width: 64px;
    height: 64px;
    border: 1.25px solid rgba(246,241,232,0.65);
