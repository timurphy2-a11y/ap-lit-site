---
import { getEntry, render } from 'astro:content';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import BioLink from '../../../components/BioLink.astro';
import PullQuote from '../../../components/PullQuote.astro';
import ThreadIcon from '../../../components/ThreadIcon.astro';

// ── Static paths ──────────────────────────────────────────────────────────────

const UNIT_IDS = [
  '00-medieval',
  '01-renaissance',
  '02-baroque',
  '03-enlightenment',
  '04-romanticism',
  '05-modernism',
] as const;

const DOMAINS = ['philosophy', 'art', 'music', 'sculpture'] as const;

export async function getStaticPaths() {
  const ids = [
    '00-medieval',
    '01-renaissance',
    '02-baroque',
    '03-enlightenment',
    '04-romanticism',
    '05-modernism',
  ] as const;
  const domains = ['philosophy', 'art', 'music', 'sculpture'] as const;
  const paths = [];
  for (let i = 0; i < ids.length; i++) {
    for (const domain of domains) {
      paths.push({
        params: { unit: ids[i], domain },
        props: {
          prevUnit: i > 0 ? ids[i - 1] : null,
          nextUnit: i < ids.length - 1 ? ids[i + 1] : null,
        },
      });
    }
  }
  return paths;
}

// ── Load content ──────────────────────────────────────────────────────────────

const { unit, domain } = Astro.params;
const { prevUnit, nextUnit } = Astro.props;

const philosophy = await getEntry('units', `${unit}/philosophy`);
const entry = domain === 'philosophy'
  ? philosophy
  : await getEntry('units', `${unit}/${domain}`);

const { Content } = await render(entry);

const meta = philosophy.data;
const unitNumber = unit.slice(0, 2);
const nextUnitNumber = nextUnit ? nextUnit.slice(0, 2) : null;

// ── Accent colors ─────────────────────────────────────────────────────────────

const ACCENTS: Record<string, {
  philosophy: string;
  art: string;
  sculpture: string;
  music: string;
  subThreads: [string, string, string];
}> = {
  '00-medieval':      { philosophy: '#C9A24B', art: '#C47A5A', sculpture: '#B5714A', music: '#A89553', subThreads: ['#C9A24B', '#A89553', '#C47A5A'] },
  '01-renaissance':   { philosophy: '#B54B3A', art: '#A8663A', sculpture: '#96583A', music: '#966B3A', subThreads: ['#B54B3A', '#966B3A', '#A8663A'] },
  '02-baroque':       { philosophy: '#D4A24C', art: '#C47A5A', sculpture: '#B5714A', music: '#B09040', subThreads: ['#D4A24C', '#B09040', '#C47A5A'] },
  '03-enlightenment': { philosophy: '#6B8CA3', art: '#7A8F88', sculpture: '#6A8A78', music: '#6B8A98', subThreads: ['#6B8CA3', '#6B8A98', '#7A8F88'] },
  '04-romanticism':   { philosophy: '#3E5B6E', art: '#4A6B5E', sculpture: '#3E6055', music: '#3E526B', subThreads: ['#3E5B6E', '#3E526B', '#4A6B5E'] },
  '05-modernism':     { philosophy: '#A03828', art: '#8A4A38', sculpture: '#7A4030', music: '#8A5028', subThreads: ['#A03828', '#8A5028', '#8A4A38'] },
};

const colors = ACCENTS[unit] ?? ACCENTS['00-medieval'];
const threadAcc = colors[domain as keyof typeof colors] as string ?? colors.philosophy;
const subThreadColors = colors.subThreads;

// ── Prev/next labels ──────────────────────────────────────────────────────────

const prevLabel = prevUnit
  ? (await getEntry('units', `${prevUnit}/philosophy`))?.data.period
  : null;
const nextLabel = nextUnit
  ? (await getEntry('units', `${nextUnit}/philosophy`))?.data.period
  : null;

// ── Domain display config ─────────────────────────────────────────────────────

const DOMAIN_LABELS: Record<string, string> = {
  philosophy: 'Philosophy',
  art:        'Painting',
  sculpture:  'Sculpture',
  music:      'Music',
};

const DOMAIN_THREAD_LABEL: Record<string, string> = {
  philosophy: 'Thread I · Philosophy',
  art:        'Thread II · Painting',
  sculpture:  'Thread III · Sculpture',
  music:      'Thread IV · Music',
};

// ── Domain sigil SVG content (injected via set:html to avoid multi-conditional parser issues) ──
const DOMAIN_SIGIL_SVG: Record<string, string> = {
  philosophy: `<circle cx="20" cy="20" r="14" fill="none"/><circle cx="20" cy="20" r="8" fill="none"/><circle cx="20" cy="20" r="1.8" fill="currentColor" stroke="none"/>`,
  art:        `<rect x="8" y="8" width="24" height="24" transform="rotate(45 20 20)" fill="none"/><circle cx="20" cy="20" r="1.5" fill="currentColor" stroke="none"/>`,
  sculpture:  `<path d="M20 6 L34 14 L34 28 L20 36 L6 28 L6 14 Z" fill="none"/><path d="M6 14 L20 22 L34 14" fill="none"/><line x1="20" y1="22" x2="20" y2="36"/>`,
  music:      `<path d="M6 24 A14 14 0 0 1 34 24" fill="none"/><circle cx="20" cy="24" r="2" fill="currentColor" stroke="none"/><line x1="6" y1="32" x2="34" y2="32"/>`,
};
const sigilSvg = DOMAIN_SIGIL_SVG[domain] ?? DOMAIN_SIGIL_SVG.philosophy;

const DOMAIN_TITLES: Record<string, string> = {
  philosophy: 'Philosophical Context',
  art:        'Visual Art',
  sculpture:  'Sculpture',
  music:      'Musical Context',
};

const currentLabel = DOMAIN_LABELS[domain] ?? domain;
const threadLabel  = DOMAIN_THREAD_LABEL[domain] ?? domain;
const domainTitle  = DOMAIN_TITLES[domain] ?? domain;
const pageTitle    = `${meta.period}: ${currentLabel} — AP Literature`;
const crumbUnit    = `Unit ${unitNumber} · ${meta.period}`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,400;1,500&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{pageTitle}</title>
</head>
<body style={`--thread-acc: ${threadAcc};`}>

<!-- ── Top nav ── -->
<div class="topbar">
  <a href="/" class="brand">AP Literature</a>
  <nav class="nav">
    <a href="/timeline">Timeline</a>
    <a href="/people">People</a>
    <a href="/compare">Compare</a>
    <a href="/seeing-through-paint">Painting</a>
    <a href="/sculpting-through-time">Sculpture</a>
    <a href="/hearing-through-form">Music</a>
  </nav>
</div>

<!-- ── Breadcrumb ── -->
<div class="crumb">
  <a href="/">Home</a>
  <span class="sep">/</span>
  <a href={`/units/${unit}`}>{crumbUnit}</a>
  <span class="sep">/</span>
  <span class="here">{currentLabel}</span>
</div>

<!-- ── Unit strip ── -->
<section class="unit-strip">
  <div class="num">{unitNumber}</div>
  <div class="title-block">
    <div class="meta">Unit · {meta.core_text ? 'Anchor text' : 'Foundation'}</div>
    <h2>{meta.period}</h2>
  </div>
  <div class="dates">{meta.dates}</div>
</section>

<!-- ── Thread tabs ── -->
<nav class="tabs" aria-label="Analytical threads">
  <a class={`tab${domain === 'philosophy' ? ' active' : ''}`} href={`/units/${unit}/philosophy`} aria-current={domain === 'philosophy' ? 'page' : undefined}>
    <span class="mini" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="20" cy="20" r="14" />
        <circle cx="20" cy="20" r="8" />
        <circle cx="20" cy="20" r="1.8" style="fill:currentColor;stroke:none;" />
      </svg>
    </span>
    <span>Philosophy</span>
  </a>
  <a class={`tab${domain === 'art' ? ' active' : ''}`} href={`/units/${unit}/art`} aria-current={domain === 'art' ? 'page' : undefined}>
    <span class="mini" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <rect x="8" y="8" width="24" height="24" transform="rotate(45 20 20)" />
        <circle cx="20" cy="20" r="1.5" style="fill:currentColor;stroke:none;" />
      </svg>
    </span>
    <span>Painting</span>
  </a>
  <a class={`tab${domain === 'sculpture' ? ' active' : ''}`} href={`/units/${unit}/sculpture`} aria-current={domain === 'sculpture' ? 'page' : undefined}>
    <span class="mini" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 6 L34 14 L34 28 L20 36 L6 28 L6 14 Z" />
        <path d="M6 14 L20 22 L34 14" />
        <line x1="20" y1="22" x2="20" y2="36" />
      </svg>
    </span>
    <span>Sculpture</span>
  </a>
  <a class={`tab${domain === 'music' ? ' active' : ''}`} href={`/units/${unit}/music`} aria-current={domain === 'music' ? 'page' : undefined}>
    <span class="mini" aria-hidden="true">
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 24 A14 14 0 0 1 34 24" />
        <circle cx="20" cy="24" r="2" style="fill:currentColor;stroke:none;" />
        <line x1="6" y1="32" x2="34" y2="32" />
      </svg>
    </span>
    <span>Music</span>
  </a>
</nav>

<!-- ── Page head ── -->
<section class="page-head">
  <div class="sigil-lg" aria-hidden="true">
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" set:html={sigilSvg} />
  </div>
  <div>
    <div class="page-lbl">{threadLabel}</div>
    <h1>{domainTitle}: <em>{meta.period}</em></h1>
  </div>
</section>

<!-- ── Hero image (art / sculpture) ── -->
{(() => {
  const d = entry.data as any;
  if (domain === 'art' && d.hero_painting?.image) {
    const p = d.hero_painting;
    return (
      <figure class="hero-fig">
        <div class="hero-plate"><img src={p.image} alt={p.title} class="hero-img" /></div>
        <figcaption class="hero-cap">
          <span class="hero-title">{p.title}</span>
          <span class="hero-artist">{p.artist}</span>
          <span class="hero-meta">{p.date}{p.medium ? ` · ${p.medium}` : ''}{p.location ? ` · ${p.location}` : ''}</span>
        </figcaption>
      </figure>
    );
  }
  if (domain === 'sculpture' && d.hero_sculpture?.image) {
    const s = d.hero_sculpture;
    return (
      <figure class="hero-fig">
        <div class="hero-plate"><img src={s.image} alt={s.title} class="hero-img" /></div>
        <figcaption class="hero-cap">
          <span class="hero-title">{s.title}</span>
          <span class="hero-artist">{s.artist}</span>
          <span class="hero-meta">{s.date}{s.medium ? ` · ${s.medium}` : ''}{s.location ? ` · ${s.location}` : ''}</span>
        </figcaption>
      </figure>
    );
  }
  return null;
})()}

<!-- ── Two-column layout ── -->
<div class="layout">

  <article class="prose">
    <Content components={{ BioLink, PullQuote }} />
  </article>

  <!-- ── Sidebar ── -->
  <aside>

    <!-- Analytical Threads -->
    <div class="card">
      <h4>Analytical Threads</h4>
      <ul class="threads-list">
        {entry.data.threads.map((t: { id: string; label: string; period_summary: string }, i: number) => {
          const subAcc = subThreadColors[i % subThreadColors.length];
          return (
            <li style={`--sub-acc: ${subAcc};`}>
              <span class="sig-xs">
                <ThreadIcon thread={t.id} size={20} />
              </span>
              <div>
                <div class="tt">{t.label}</div>
                <div class="gloss">{t.period_summary}</div>
              </div>
            </li>
          );
        })}
      </ul>
    </div>

    {/* ── Domain-specific sidebar card ── */}
    {(() => {
      const d = entry.data as any;
      if (domain === 'philosophy' && d.readings) {
        return (
          <div class="card">
            <h4>Readings</h4>
            <ul class="readings">
              {d.readings.map((r: any) => (
                <li>
                  <div class="r-title">{r.title}</div>
                  <div class="r-by">{r.author}{r.date ? ` · ${r.date}` : ''}</div>
                </li>
              ))}
            </ul>
          </div>
        );
      }
      if (domain === 'art' && d.gallery_paintings?.length) {
        return (
          <div class="card">
            <h4>Gallery</h4>
            <div class="gallery">
              {d.gallery_paintings.map((p: any) => (
                <figure class="gallery-fig">
                  {p.image && <div class="gallery-plate"><img src={p.image} alt={p.title} class="gallery-img" /></div>}
                  <figcaption>
                    <span class="r-title">{p.title}</span>
                    <span class="r-by" style={`color: ${threadAcc};`}>{p.artist} · {p.date}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        );
      }
      if (domain === 'sculpture' && d.gallery_sculptures?.length) {
        return (
          <div class="card">
            <h4>Gallery</h4>
            <div class="gallery">
              {d.gallery_sculptures.map((s: any) => (
                <figure class="gallery-fig">
                  {s.image && <div class="gallery-plate"><img src={s.image} alt={s.title} class="gallery-img" /></div>}
                  <figcaption>
                    <span class="r-title">{s.title}</span>
                    <span class="r-by" style={`color: ${threadAcc};`}>{s.artist} · {s.date}</span>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        );
      }
      if (domain === 'music') {
        const featured = d.featured_listening ? (Array.isArray(d.featured_listening) ? d.featured_listening : [d.featured_listening]) : [];
        const gallery  = d.gallery_listening ?? [];
        return (
          <div class="music-sidebar">
            {featured.length > 0 && (
              <div class="card">
                <h4>Featured Listening</h4>
                {featured.map((item: any) => (
                  <div class="music-item">
                    {item.youtube_id && <YouTubeEmbed id={item.youtube_id} title={item.title} />}
                    <div class="music-meta">
                      <div class="music-title">{item.title}</div>
                      <div class="r-by">{item.composer}{item.date ? ` · ${item.date}` : ''}</div>
                      {item.duration && <div class="r-by">{item.duration}</div>}
                      {item.listen_for && <div class="music-listen">{item.listen_for}</div>}
                    </div>
                  </div>
                ))}
              </div>
            )}
            {gallery.length > 0 && (
              <div class="card">
                <h4>Also Listen</h4>
                <div class="gallery-music">
                  {gallery.map((item: any) => (
                    <div class="music-item">
                      {item.youtube_id && <YouTubeEmbed id={item.youtube_id} title={item.title} />}
                      <div class="music-meta">
                        <div class="r-title" style="font-style: italic;">{item.title}</div>
                        <div class="r-by">{item.composer}{item.date ? ` · ${item.date}` : ''}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        );
      }
      return null;
    })()}

  </aside>
</div>

<!-- ── Pager ── -->
<nav class="pager">
  <a class="pager-prev" href={`/units/${unit}`}>
    <span class="pager-lbl">Back</span>
    <span class="pager-title">Unit {unitNumber} Overview</span>
  </a>
  {nextUnit ? (
    <a class="pager-next" href={`/units/${nextUnit}/${domain}`}>
      <span class="pager-lbl">Unit {nextUnitNumber} · {currentLabel}</span>
      <span class="pager-title">{nextLabel}</span>
    </a>
  ) : (
    <div />
  )}
</nav>

<footer>
  <div class="colophon">AP Literature · Historical &amp; Aesthetic Background</div>
  <div>Unit {unitNumber} / {currentLabel}</div>
</footer>

</body>
</html>

<style is:global>
  :root {
    --bg: #141110;
    --bg-raised: #1b1714;
    --bg-sunken: #0d0b0a;
    --ink: #E8DFD0;
    --ink-mute: #B8AE9D;
    --ink-soft: #9A8F7E;
    --rule: #3A332C;
    --rule-strong: #5A4F44;

    --font-display: 'Spectral', Georgia, serif;
    --font-ui: 'IBM Plex Sans', system-ui, sans-serif;
    --font-mono: 'IBM Plex Mono', ui-monospace, monospace;

    --gutter: clamp(24px, 4vw, 72px);
    --measure: 62ch;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.6;
    padding: 0 var(--gutter);
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }

  /* ── Top bar ── */
  .topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 28px 0 22px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .brand {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 16px;
    color: var(--ink);
    text-transform: none;
    letter-spacing: 0.02em;
  }
  .nav { display: flex; gap: 28px; flex-wrap: wrap; }
  .nav a:hover { color: var(--ink); }

  /* ── Breadcrumb ── */
  .crumb {
    padding: 20px 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    display: flex;
    gap: 10px;
    align-items: center;
    flex-wrap: wrap;
  }
  .crumb a:hover { color: var(--ink); }
  .crumb .sep { color: var(--rule-strong); }
  .crumb .here { color: var(--ink-mute); }

  /* ── Unit strip ── */
  .unit-strip {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 28px 0;
    border-bottom: 1px solid var(--rule);
  }
  .unit-strip .num {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 72px;
    line-height: 0.85;
    color: var(--thread-acc);
    letter-spacing: -0.03em;
  }
  .unit-strip .title-block .meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 4px;
  }
  .unit-strip .title-block h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.005em;
    color: var(--ink);
  }
  .unit-strip .dates {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  /* ── Thread tabs ── */
  .tabs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin: 32px 0 0;
  }
  @media (max-width: 700px) { .tabs { grid-template-columns: repeat(2, 1fr); } }
  .tab {
    background: var(--bg);
    padding: 14px 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 15px;
    color: var(--ink-mute);
    transition: background 160ms ease, color 160ms ease;
  }
  .tab:hover { background: var(--bg-raised); color: var(--ink); }
  .mini { width: 20px; height: 20px; flex: 0 0 20px; }
  .mini svg { width: 100%; height: 100%; }
  .tab.active {
    background: var(--bg-raised);
    color: var(--thread-acc);
    box-shadow: inset 0 -2px 0 var(--thread-acc);
  }

  /* ── Page head ── */
  .page-head {
    padding: 80px 0 48px;
    display: grid;
    grid-template-columns: 88px 1fr;
    gap: 32px;
    align-items: start;
    border-bottom: 1px solid var(--rule);
  }
  @media (max-width: 720px) {
    .page-head { grid-template-columns: 1fr; gap: 18px; padding: 48px 0 32px; }
  }
  .sigil-lg {
    width: 88px;
    height: 88px;
    border: 1px solid var(--rule-strong);
    background: var(--bg-sunken);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .sigil-lg svg {
    width: 48px;
    height: 48px;
    stroke: var(--thread-acc);
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
  }
  .page-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--thread-acc);
    margin-bottom: 10px;
  }
  .page-head h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--ink);
    max-width: 22ch;
  }
  .page-head h1 em { font-style: italic; color: var(--ink-mute); }

  /* ── Hero image ── */
  .hero-fig {
    margin: 32px 0 0;
    padding: 0;
  }
  .hero-plate {
    background: var(--bg-sunken);
    border: 1px solid var(--rule);
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    max-height: 520px;
    overflow: hidden;
  }
  .hero-img {
    width: 100%;
    max-height: 508px;
    object-fit: contain;
  }
