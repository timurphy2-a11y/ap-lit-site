---
import { getEntry, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro';
import BioLink from '../../../components/BioLink.astro';
import PullQuote from '../../../components/PullQuote.astro';
import ThreadIcon from '../../../components/ThreadIcon.astro';

// ── Static paths ─────────────────────────────────────────────────────────────

const UNIT_IDS = [
  '00-medieval',
  '01-renaissance',
  '02-baroque',
  '03-enlightenment',
  '04-romanticism',
  '05-modernism',
] as const;

const DOMAINS = ['philosophy', 'art', 'music'] as const;

export async function getStaticPaths() {
  const ids = [
    '00-medieval',
    '01-renaissance',
    '02-baroque',
    '03-enlightenment',
    '04-romanticism',
    '05-modernism',
  ] as const;

  const domains = ['philosophy', 'art', 'music'] as const;

  const paths = [];
  for (let i = 0; i < ids.length; i++) {
    for (const domain of domains) {
      paths.push({
        params: { unit: ids[i], domain },
        props: {
          prevUnit: i > 0 ? ids[i - 1] : null,
          nextUnit: i < ids.length - 1 ? ids[i + 1] : null,
        },
      });
    }
  }
  return paths;
}

// ── Load content ─────────────────────────────────────────────────────────────

const { unit, domain } = Astro.params;
const { prevUnit, nextUnit } = Astro.props;

// Always load philosophy for the unit header metadata
const philosophy = await getEntry('units', `${unit}/philosophy`);
const entry = domain === 'philosophy'
  ? philosophy
  : await getEntry('units', `${unit}/${domain}`);

const { Content } = await render(entry);

const meta = philosophy.data;
const unitNumber = unit.slice(0, 2);

// ── Accent colors ─────────────────────────────────────────────────────────────

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#5b82c8',
  '01-renaissance':   '#e8a820',
  '02-baroque':       '#dc5f6c',
  '03-enlightenment': '#48a0e0',
  '04-romanticism':   '#b978d2',
  '05-modernism':     '#3aa87a',
};
const accent = UNIT_ACCENTS[unit] ?? '#e8a820';

const THREAD_COLORS = ['#e09438', '#c84068', '#48a888'];

const accentText  = `color: ${accent};`;
const badgeStyle  = `background-color: color-mix(in srgb, ${accent} 15%, #1a140c); color: ${accent};`;
const activeTab   = `border-color: ${accent}; color: ${accent}; background-color: color-mix(in srgb, ${accent} 8%, #1a140c);`;
const inactiveTab = `border-color: transparent; color: #a5967d;`;

// ── Prev / next labels ────────────────────────────────────────────────────────

const prevLabel = prevUnit
  ? (await getEntry('units', `${prevUnit}/philosophy`))?.data.period
  : null;
const nextLabel = nextUnit
  ? (await getEntry('units', `${nextUnit}/philosophy`))?.data.period
  : null;

// ── Domain tab config ─────────────────────────────────────────────────────────

const DOMAIN_LABELS: Record<string, string> = {
  philosophy: 'Philosophy',
  art:        'Painting',
  music:      'Music',
};

const activeTabs = [
  { id: 'philosophy', label: 'Philosophy' },
  { id: 'art',        label: 'Painting'   },
  { id: 'music',      label: 'Music'      },
];


const currentLabel = DOMAIN_LABELS[domain] ?? domain;
---

<Layout title={`${meta.period}: ${currentLabel} — AP Literature`}>

  <!-- ── Unit header ─────────────────────────────────────────────── -->
  <div class="border-b border-[#3d2e1a]">
    <div class="max-w-5xl mx-auto px-6 py-8">

      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-[#a09070] mb-4">
        <a href={`/units/${unit}`} class="hover:text-[#f2e8d5] transition-colors">
          {meta.period}
        </a>
        <span class="text-[#4a3a28]">›</span>
        <span style={accentText}>{currentLabel}</span>
      </nav>

      <p class="text-xs font-semibold tracking-widest uppercase mb-2" style={accentText}>
        Unit {unitNumber}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#f2e8d5] mb-1">
        {meta.period}
      </h1>
      <p class="text-[#a09070] text-sm mb-4">{meta.dates}</p>

      {meta.core_text ? (
        <div class="inline-flex items-baseline gap-2 rounded px-3 py-1.5" style={badgeStyle}>
          <span class="text-xs font-semibold uppercase tracking-wider opacity-60">Core Text</span>
          <span class="font-serif italic text-[#f2e8d5]">{meta.core_text}</span>
          {meta.author && <span class="text-[#a09070] text-sm">— {meta.author}</span>}
        </div>
      ) : (
        <p class="text-sm italic text-[#a5967d]">{meta.note}</p>
      )}
    </div>
  </div>

  <!-- ── Sibling tab navigation ───────────────────────────────────── -->
  <div class="border-b border-[#3d2e1a] sticky top-[49px] z-30" style="background-color: #1a140c;">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="flex gap-1 flex-wrap" aria-label="Unit domains">
        {activeTabs.map((tab) => (
          <a
            href={`/units/${unit}/${tab.id}`}
            class="px-5 py-3.5 text-sm font-medium border-b-2 transition-colors -mb-px"
            style={domain === tab.id ? activeTab : inactiveTab}
            aria-current={domain === tab.id ? 'page' : undefined}
          >
            {tab.label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- ── Domain content ───────────────────────────────────────────── -->
  <main class="max-w-5xl mx-auto px-6 py-10">

    {/* ── Art: hero painting ── */}
    {domain === 'art' && entry.data.hero_painting?.image && (
      <figure class="mb-10">
        <div class="rounded-xl overflow-hidden flex items-center justify-center" style="max-height: 520px; background-color: #0e0b06; padding: 6px; border: 1px solid rgba(180,165,140,0.25);">
          <img
            src={entry.data.hero_painting.image}
            alt={entry.data.hero_painting.title}
            class="w-full h-full object-contain rounded-lg"
            style="max-height: 508px;"
          />
        </div>
        <figcaption class="mt-3 text-center">
          <p class="font-serif italic text-sm text-[#f2e8d5]">{entry.data.hero_painting.title}</p>
          <p class="text-xs text-[#a09070] mt-0.5">{entry.data.hero_painting.artist}</p>
          <p class="text-xs text-[#a5967d] mt-0.5">
            {entry.data.hero_painting.date}
            {entry.data.hero_painting.medium && <span> · {entry.data.hero_painting.medium}</span>}
            {entry.data.hero_painting.location && <span> · {entry.data.hero_painting.location}</span>}
          </p>
        </figcaption>
      </figure>
    )}

    <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

      <!-- Main prose -->
      <div
        class="prose prose-stone prose-invert prose-headings:font-serif prose-headings:font-bold prose-h1:text-2xl prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-base prose-p:leading-relaxed max-w-none"
        style={`--prose-drop-cap-color: ${accent};`}
      >
        <Content components={{ BioLink, PullQuote }} />
      </div>

      <!-- Sidebar -->
      <aside class="mt-10 lg:mt-0 space-y-6">

        <!-- Analytical Threads -->
        <div>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-[#a5967d] mb-3">
            Analytical Threads
          </h3>
          <div class="space-y-3">
            {entry.data.threads.map((t, i) => {
              const tc = THREAD_COLORS[i % THREAD_COLORS.length];
              return (
                <div
                  class="border rounded-lg p-3"
                  style={`background-color: color-mix(in srgb, ${tc} 18%, #1a140c); border-color: color-mix(in srgb, ${tc} 55%, transparent);`}
                >
                  <p class="text-xs font-semibold mb-1 flex items-center gap-1.5" style={`color: ${tc};`}>
                    <ThreadIcon thread={t.id} size={16} />{t.label}
                  </p>
                  <p class="text-xs text-[#a09070] leading-relaxed">{t.period_summary}</p>
                </div>
              );
            })}
          </div>
        </div>

        {/* ── Philosophy: readings ── */}
        {domain === 'philosophy' && entry.data.readings && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[#a5967d] mb-3">Readings</h3>
            <ul class="space-y-2">
              {entry.data.readings.map((r) => (
                <li class="border-l-2 border-[#3d2e1a] pl-3">
                  <p class="text-sm font-medium text-[#f2e8d5] leading-snug">{r.title}</p>
                  <p class="text-xs text-[#a09070]">
                    {r.author}{r.date ? ` · ${r.date}` : ''}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* ── Art: gallery ── */}
        {domain === 'art' && entry.data.gallery_paintings && entry.data.gallery_paintings.length > 0 && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[#a5967d] mb-3">Gallery</h3>
            <div class="space-y-4">
              {entry.data.gallery_paintings.map((p) => (
                <figure class="group">
                  {p.image && (
                    <div class="rounded-lg overflow-hidden mb-1.5" style="background-color: #0e0b06; padding: 4px; border: 1px solid rgba(180,165,140,0.2);">
                      <img
                        src={p.image}
                        alt={p.title}
                        class="w-full object-contain rounded transition-transform duration-300 group-hover:scale-[1.02]"
                        style="max-height: 176px;"
                      />
                    </div>
                  )}
                  <figcaption class="mt-1">
                    <p class="text-xs font-serif italic text-[#f2e8d5] leading-snug">{p.title}</p>
                    <p class="text-xs text-[#a5967d]">{p.artist} · {p.date}</p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        )}

        {/* ── Music: featured listening ── */}
        {domain === 'music' && entry.data.featured_listening && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[#a5967d] mb-3">
              Featured Listening
            </h3>
            {(Array.isArray(entry.data.featured_listening)
              ? entry.data.featured_listening
              : [entry.data.featured_listening]
            ).map((item) => (
              <div class="border border-[#3d2e1a] rounded-lg overflow-hidden mb-2" style="background-color: #231a0f;">
                {item.youtube_id && (
                  <YouTubeEmbed id={item.youtube_id} title={item.title} />
                )}
                <div class="p-3">
                  <p class="text-sm font-serif italic font-bold text-[#f2e8d5] leading-snug">{item.title}</p>
                  <p class="text-xs text-[#a09070] mt-1">{item.composer} · {item.date}</p>
                  {item.duration && <p class="text-xs text-[#a5967d] mt-0.5">{item.duration}</p>}
                  {item.listen_for && (
                    <p class="text-xs text-[#a09070] mt-2 leading-relaxed border-t border-[#3d2e1a] pt-2">
                      {item.listen_for}
                    </p>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}

        {/* ── Music: gallery listening ── */}
        {domain === 'music' && entry.data.gallery_listening && entry.data.gallery_listening.length > 0 && (
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[#a5967d] mb-3">
              Also Listen
            </h3>
            <div class="space-y-3">
              {entry.data.gallery_listening.map((item) => (
                <div class="border border-[#3d2e1a] rounded-lg overflow-hidden" style="background-color: #231a0f;">
                  {item.youtube_id && (
                    <YouTubeEmbed id={item.youtube_id} title={item.title} />
                  )}
                  <div class="px-3 py-2">
                    <p class="text-sm font-serif italic text-[#a09070] leading-snug">{item.title}</p>
                    <p class="text-xs text-[#a5967d]">{item.composer} · {item.date}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

      </aside>
    </div>
  </main>

  <!-- ── Unit navigation footer ──────────────────────────────────── -->
  <footer class="border-t border-[#3d2e1a] mt-4">
    <div class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center">

      {prevUnit ? (
        <a
          href={`/units/${prevUnit}/${domain}`}
          class="inline-flex items-center gap-2 text-sm font-medium text-[#a09070] hover:text-[#f2e8d5] transition-colors group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          {prevLabel} {currentLabel}
        </a>
      ) : (
        <div />
      )}

      <a href={`/units/${unit}`} class="text-sm text-[#a5967d] hover:text-[#f2e8d5] transition-colors">
        Unit {unitNumber} Overview
      </a>

      {nextUnit ? (
        <a
          href={`/units/${nextUnit}/${domain}`}
          class="inline-flex items-center gap-2 text-sm font-medium text-[#a09070] hover:text-[#f2e8d5] transition-colors group"
        >
          {nextLabel} {currentLabel}
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      ) : (
        <div />
      )}

    </div>
  </footer>

</Layout>
