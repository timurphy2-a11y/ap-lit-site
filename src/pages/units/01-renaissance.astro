---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const philosophy = await getEntry('units', '01-renaissance/philosophy');
const art        = await getEntry('units', '01-renaissance/art');
const music      = await getEntry('units', '01-renaissance/music');

const { Content: PhilosophyContent } = await render(philosophy);
const { Content: ArtContent }        = await render(art);
const { Content: MusicContent }      = await render(music);

const meta = philosophy.data; // unit-level metadata (period, dates, core_text, author)

const tabs = [
  { id: 'philosophy', label: 'Philosophy',  data: philosophy.data },
  { id: 'art',        label: 'Visual Art',   data: art.data },
  { id: 'music',      label: 'Music',        data: music.data },
];
---

<Layout title={`${meta.period} — AP Literature`}>

  <!-- ── Unit header ─────────────────────────────────────────────────── -->
  <div class="bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-6 py-10">
      <p class="text-xs font-semibold tracking-widest uppercase text-amber-700 mb-2">Unit 01</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-stone-900 mb-1">
        {meta.period}
      </h1>
      <p class="text-stone-500 text-sm mb-4">{meta.dates}</p>
      {meta.core_text && (
        <div class="inline-flex items-baseline gap-2 bg-amber-50 border border-amber-200 rounded px-3 py-1.5">
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-700">Core Text</span>
          <span class="font-serif italic text-stone-800">{meta.core_text}</span>
          <span class="text-stone-500 text-sm">— {meta.author}</span>
        </div>
      )}
    </div>
  </div>

  <!-- ── Tab navigation ──────────────────────────────────────────────── -->
  <div class="bg-white border-b border-stone-200 sticky top-[49px] z-30">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="flex gap-1" role="tablist" aria-label="Unit domains">
        {tabs.map((tab) => (
          <button
            role="tab"
            data-tab={tab.id}
            aria-controls={`panel-${tab.id}`}
            aria-selected={tab.id === 'philosophy' ? 'true' : 'false'}
            class:list={[
              'tab-btn px-5 py-3.5 text-sm font-medium border-b-2 transition-colors -mb-px',
              tab.id === 'philosophy'
                ? 'border-amber-600 text-amber-700'
                : 'border-transparent text-stone-500 hover:text-stone-800 hover:border-stone-300'
            ]}
          >
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
  </div>

  <!-- ── Tab panels ──────────────────────────────────────────────────── -->
  <main class="max-w-5xl mx-auto px-6 py-10">

    <!-- Philosophy panel -->
    <div
      id="panel-philosophy"
      role="tabpanel"
      aria-labelledby="tab-philosophy"
      class="tab-panel"
    >
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <!-- Prose -->
        <div class="prose prose-stone prose-headings:font-serif prose-headings:font-bold prose-h1:text-2xl prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-base prose-h3:font-semibold prose-p:leading-relaxed prose-strong:text-stone-800 max-w-none">
          <PhilosophyContent />
        </div>

        <!-- Sidebar -->
        <aside class="mt-10 lg:mt-0 space-y-6">

          <!-- Thread quick-reference -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {philosophy.data.threads.map((thread) => (
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
                  <p class="text-xs font-semibold text-amber-800 mb-1">{thread.label}</p>
                  <p class="text-xs text-stone-600 leading-relaxed">{thread.period_summary}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Readings list -->
          {philosophy.data.readings && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Readings</h3>
              <ul class="space-y-2">
                {philosophy.data.readings.map((r) => (
                  <li class="border-l-2 border-stone-200 pl-3">
                    <p class="text-sm font-medium text-stone-800 leading-snug">{r.title}</p>
                    <p class="text-xs text-stone-500">{r.author}{r.date ? ` · ${r.date}` : ''}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </aside>
      </div>
    </div>

    <!-- Visual Art panel -->
    <div
      id="panel-art"
      role="tabpanel"
      aria-labelledby="tab-art"
      class="tab-panel hidden"
    >
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <!-- Prose -->
        <div class="prose prose-stone prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-p:leading-relaxed prose-strong:text-stone-800 max-w-none">
          <ArtContent />
        </div>

        <!-- Sidebar -->
        <aside class="mt-10 lg:mt-0 space-y-6">

          <!-- Thread quick-reference -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {art.data.threads.map((thread) => (
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
                  <p class="text-xs font-semibold text-amber-800 mb-1">{thread.label}</p>
                  <p class="text-xs text-stone-600 leading-relaxed">{thread.period_summary}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Hero painting -->
          {art.data.hero_painting && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Featured Work</h3>
              <div class="border border-stone-200 rounded-lg p-3 bg-white">
                <p class="text-sm font-serif italic font-bold text-stone-800 leading-snug">{art.data.hero_painting.title}</p>
                <p class="text-xs text-stone-500 mt-1">{art.data.hero_painting.artist} · {art.data.hero_painting.date}</p>
                {art.data.hero_painting.location && (
                  <p class="text-xs text-stone-400 mt-0.5">{art.data.hero_painting.location}</p>
                )}
              </div>
            </div>
          )}

          <!-- Gallery paintings -->
          {art.data.gallery_paintings && art.data.gallery_paintings.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Gallery Works</h3>
              <ul class="space-y-2">
                {art.data.gallery_paintings.map((p) => (
                  <li class="border-l-2 border-stone-200 pl-3">
                    <p class="text-sm font-serif italic text-stone-800 leading-snug">{p.title}</p>
                    <p class="text-xs text-stone-500">{p.artist} · {p.date}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </aside>
      </div>
    </div>

    <!-- Music panel -->
    <div
      id="panel-music"
      role="tabpanel"
      aria-labelledby="tab-music"
      class="tab-panel hidden"
    >
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <!-- Prose -->
        <div class="prose prose-stone prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-p:leading-relaxed prose-strong:text-stone-800 max-w-none">
          <MusicContent />
        </div>

        <!-- Sidebar -->
        <aside class="mt-10 lg:mt-0 space-y-6">

          <!-- Thread quick-reference -->
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {music.data.threads.map((thread) => (
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
                  <p class="text-xs font-semibold text-amber-800 mb-1">{thread.label}</p>
                  <p class="text-xs text-stone-600 leading-relaxed">{thread.period_summary}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Featured listening -->
          {music.data.featured_listening && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Featured Listening</h3>
              {(Array.isArray(music.data.featured_listening)
                ? music.data.featured_listening
                : [music.data.featured_listening]
              ).map((item) => (
                <div class="border border-stone-200 rounded-lg p-3 bg-white mb-2">
                  <p class="text-sm font-serif italic font-bold text-stone-800 leading-snug">{item.title}</p>
                  <p class="text-xs text-stone-500 mt-1">{item.composer} · {item.date}</p>
                  {item.duration && <p class="text-xs text-stone-400 mt-0.5">{item.duration}</p>}
                  {item.listen_for && <p class="text-xs text-stone-600 mt-2 leading-relaxed border-t border-stone-100 pt-2">{item.listen_for}</p>}
                </div>
              ))}
            </div>
          )}

          <!-- Gallery listening -->
          {music.data.gallery_listening && music.data.gallery_listening.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Also Listen</h3>
              <ul class="space-y-2">
                {music.data.gallery_listening.map((item) => (
                  <li class="border-l-2 border-stone-200 pl-3">
                    <p class="text-sm font-serif italic text-stone-800 leading-snug">{item.title}</p>
                    <p class="text-xs text-stone-500">{item.composer} · {item.date}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}

        </aside>
      </div>
    </div>

  </main>

  <!-- ── Previous / Next navigation ─────────────────────────────────── -->
  <footer class="border-t border-stone-200 bg-white mt-4">
    <div class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center">
      <div class="text-sm text-stone-400 italic">Unit 01 of 05</div>
      <a
        href="/units/02-baroque"
        class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 hover:text-stone-900 transition-colors group"
      >
        Next: The Baroque
        <span class="group-hover:translate-x-1 transition-transform">→</span>
      </a>
    </div>
  </footer>

</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;

      // Update panels
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.id !== `panel-${target}`);
      });

      // Update tab buttons
      tabs.forEach((t) => {
        const isActive = t.dataset.tab === target;
        t.setAttribute('aria-selected', isActive ? 'true' : 'false');
        t.classList.toggle('border-amber-600', isActive);
        t.classList.toggle('text-amber-700', isActive);
        t.classList.toggle('border-transparent', !isActive);
        t.classList.toggle('text-stone-500', !isActive);
      });
    });
  });
</script>
