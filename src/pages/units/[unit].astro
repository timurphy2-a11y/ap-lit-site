---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';

// ── Static paths ─────────────────────────────────────────────────────────────

export async function getStaticPaths() {
  const UNIT_IDS = [
    '00-medieval',
    '01-renaissance',
    '02-baroque',
    '03-enlightenment',
    '04-romanticism',
    '05-modernism',
  ] as const;

  return UNIT_IDS.map((id, index) => ({
    params: { unit: id },
    props: {
      prevUnit: index > 0 ? UNIT_IDS[index - 1] : null,
      nextUnit: index < UNIT_IDS.length - 1 ? UNIT_IDS[index + 1] : null,
    },
  }));
}

// ── Load content ─────────────────────────────────────────────────────────────

const { unit } = Astro.params;
const { prevUnit, nextUnit } = Astro.props;

const [philosophy, art, music] = await Promise.all([
  getEntry('units', `${unit}/philosophy`),
  getEntry('units', `${unit}/art`),
  getEntry('units', `${unit}/music`),
]);

const [
  { Content: PhilosophyContent },
  { Content: ArtContent },
  { Content: MusicContent },
] = await Promise.all([render(philosophy), render(art), render(music)]);

// ── Accent colors ─────────────────────────────────────────────────────────────

const meta = philosophy.data;
const unitNumber = unit.slice(0, 2);

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#5b82c8',  // lapis lazuli
  '01-renaissance':   '#e8a820',  // gilded gold
  '02-baroque':       '#c04050',  // deep crimson
  '03-enlightenment': '#48a0e0',  // sapphire
  '04-romanticism':   '#9b58b8',  // amethyst
  '05-modernism':     '#3aa87a',  // jade
};
const accent = UNIT_ACCENTS[unit] ?? '#e8a820';

// Three thread slot colors — indexed by position, consistent across all units
const THREAD_COLORS = ['#e09438', '#c84068', '#48a888'];

// Pre-compute inline style strings
const accentText  = `color: ${accent};`;
const badgeStyle  = `background-color: color-mix(in srgb, ${accent} 15%, #1a140c); color: ${accent};`;
const activeTab   = `border-color: ${accent}; color: ${accent}; background-color: color-mix(in srgb, ${accent} 8%, #1a140c);`;
const inactiveTab = `border-color: transparent; color: #6e5e48;`;

// Prev / next labels
const prevLabel = prevUnit
  ? (await getEntry('units', `${prevUnit}/philosophy`))?.data.period
  : null;
const nextLabel = nextUnit
  ? (await getEntry('units', `${nextUnit}/philosophy`))?.data.period
  : null;

const tabs = [
  { id: 'philosophy', label: 'Philosophy' },
  { id: 'art',        label: 'Visual Art'  },
  { id: 'music',      label: 'Music'       },
];
---

<Layout title={`${meta.period} — AP Literature`}>

  <!-- ── Unit header ─────────────────────────────────────────────── -->
  <div class="border-b border-[#3d2e1a]">
    <div class="max-w-5xl mx-auto px-6 py-10">
      <p class="text-xs font-semibold tracking-widest uppercase mb-2" style={accentText}>
        Unit {unitNumber}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#f2e8d5] mb-1">
        {meta.period}
      </h1>
      <p class="text-[#a09070] text-sm mb-4">{meta.dates}</p>

      {meta.core_text ? (
        <div class="inline-flex items-baseline gap-2 rounded px-3 py-1.5" style={badgeStyle}>
          <span class="text-xs font-semibold uppercase tracking-wider opacity-60">Core Text</span>
          <span class="font-serif italic text-[#f2e8d5]">{meta.core_text}</span>
          {meta.author && <span class="text-[#a09070] text-sm">— {meta.author}</span>}
        </div>
      ) : (
        <p class="text-sm italic text-[#6e5e48]">{meta.note}</p>
      )}
    </div>
  </div>

  <!-- ── Tab navigation ──────────────────────────────────────────── -->
  <div class="border-b border-[#3d2e1a] sticky top-[49px] z-30" style="background-color: #1a140c;">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="flex gap-1" role="tablist" aria-label="Unit domains">
        {tabs.map((tab, i) => (
          <button
            role="tab"
            data-tab={tab.id}
            data-accent={accent}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            class="tab-btn px-5 py-3.5 text-sm font-medium border-b-2 transition-colors -mb-px"
            style={i === 0 ? activeTab : inactiveTab}
          >
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
  </div>

  <!-- ── Tab panels ──────────────────────────────────────────────── -->
  <main class="max-w-5xl mx-auto px-6 py-10">

    <!-- Philosophy -->
    <div id="panel-philosophy" role="tabpanel" class="tab-panel">
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <div class="prose prose-stone prose-invert prose-headings:font-serif prose-headings:font-bold prose-h1:text-2xl prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-base prose-p:leading-relaxed max-w-none">
          <PhilosophyContent />
        </div>

        <aside class="mt-10 lg:mt-0 space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {philosophy.data.threads.map((t, i) => {
                const tc = THREAD_COLORS[i % THREAD_COLORS.length];
                return (
                  <div class="border rounded-lg p-3" style={`background-color: color-mix(in srgb, ${tc} 18%, #1a140c); border-color: color-mix(in srgb, ${tc} 55%, transparent);`}>
                    <p class="text-xs font-semibold mb-1" style={`color: ${tc};`}>{t.label}</p>
                    <p class="text-xs text-[#a09070] leading-relaxed">{t.period_summary}</p>
                  </div>
                );
              })}
            </div>
          </div>

          {philosophy.data.readings && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Readings</h3>
              <ul class="space-y-2">
                {philosophy.data.readings.map((r) => (
                  <li class="border-l-2 border-[#3d2e1a] pl-3">
                    <p class="text-sm font-medium text-[#f2e8d5] leading-snug">{r.title}</p>
                    <p class="text-xs text-[#a09070]">{r.author}{r.date ? ` · ${r.date}` : ''}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>

      </div>
    </div>

    <!-- Visual Art -->
    <div id="panel-art" role="tabpanel" class="tab-panel hidden">

      {art.data.hero_painting?.image && (
        <figure class="mb-10">
          <div class="rounded-xl overflow-hidden flex items-center justify-center" style="max-height: 520px; background-color: #0e0b06;">
            <img
              src={art.data.hero_painting.image}
              alt={art.data.hero_painting.title}
              class="w-full h-full object-contain"
              style="max-height: 520px;"
            />
          </div>
          <figcaption class="mt-2 text-center text-xs text-[#6e5e48]">
            <span class="font-serif italic">{art.data.hero_painting.title}</span>
            {' — '}{art.data.hero_painting.artist}, {art.data.hero_painting.date}
            {art.data.hero_painting.medium && <span> · {art.data.hero_painting.medium}</span>}
            {art.data.hero_painting.location && <span> · {art.data.hero_painting.location}</span>}
          </figcaption>
        </figure>
      )}

      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <div class="prose prose-stone prose-invert prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-p:leading-relaxed max-w-none">
          <ArtContent />
        </div>

        <aside class="mt-10 lg:mt-0 space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {art.data.threads.map((t, i) => {
                const tc = THREAD_COLORS[i % THREAD_COLORS.length];
                return (
                  <div class="border rounded-lg p-3" style={`background-color: color-mix(in srgb, ${tc} 18%, #1a140c); border-color: color-mix(in srgb, ${tc} 55%, transparent);`}>
                    <p class="text-xs font-semibold mb-1" style={`color: ${tc};`}>{t.label}</p>
                    <p class="text-xs text-[#a09070] leading-relaxed">{t.period_summary}</p>
                  </div>
                );
              })}
            </div>
          </div>

          {art.data.gallery_paintings && art.data.gallery_paintings.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Gallery</h3>
              <div class="space-y-4">
                {art.data.gallery_paintings.map((p) => (
                  <figure>
                    {p.image && (
                      <div class="rounded-lg overflow-hidden mb-1.5" style="background-color: #0e0b06;">
                        <img
                          src={p.image}
                          alt={p.title}
                          class="w-full object-contain"
                          style="max-height: 180px;"
                        />
                      </div>
                    )}
                    <figcaption>
                      <p class="text-xs font-serif italic text-[#a09070] leading-snug">{p.title}</p>
                      <p class="text-xs text-[#6e5e48]">{p.artist} · {p.date}</p>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </aside>

      </div>
    </div>

    <!-- Music -->
    <div id="panel-music" role="tabpanel" class="tab-panel hidden">
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <div class="prose prose-stone prose-invert prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-p:leading-relaxed max-w-none">
          <MusicContent />
        </div>

        <aside class="mt-10 lg:mt-0 space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {music.data.threads.map((t, i) => {
                const tc = THREAD_COLORS[i % THREAD_COLORS.length];
                return (
                  <div class="border rounded-lg p-3" style={`background-color: color-mix(in srgb, ${tc} 18%, #1a140c); border-color: color-mix(in srgb, ${tc} 55%, transparent);`}>
                    <p class="text-xs font-semibold mb-1" style={`color: ${tc};`}>{t.label}</p>
                    <p class="text-xs text-[#a09070] leading-relaxed">{t.period_summary}</p>
                  </div>
                );
              })}
            </div>
          </div>

          {music.data.featured_listening && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Featured Listening</h3>
              {(Array.isArray(music.data.featured_listening)
                ? music.data.featured_listening
                : [music.data.featured_listening]
              ).map((item) => (
                <div class="border border-[#3d2e1a] rounded-lg overflow-hidden mb-2" style="background-color: #231a0f;">
                  {item.youtube_id && (
                    <YouTubeEmbed id={item.youtube_id} title={item.title} />
                  )}
                  <div class="p-3">
                    <p class="text-sm font-serif italic font-bold text-[#f2e8d5] leading-snug">{item.title}</p>
                    <p class="text-xs text-[#a09070] mt-1">{item.composer} · {item.date}</p>
                    {item.duration && <p class="text-xs text-[#6e5e48] mt-0.5">{item.duration}</p>}
                    {item.listen_for && (
                      <p class="text-xs text-[#a09070] mt-2 leading-relaxed border-t border-[#3d2e1a] pt-2">
                        {item.listen_for}
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}

          {music.data.gallery_listening && music.data.gallery_listening.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Also Listen</h3>
              <div class="space-y-3">
                {music.data.gallery_listening.map((item) => (
                  <div class="border border-[#3d2e1a] rounded-lg overflow-hidden" style="background-color: #231a0f;">
                    {item.youtube_id && (
                      <YouTubeEmbed id={item.youtube_id} title={item.title} />
                    )}
                    <div class="px-3 py-2">
                      <p class="text-sm font-serif italic text-[#a09070] leading-snug">{item.title}</p>
                      <p class="text-xs text-[#6e5e48]">{item.composer} · {item.date}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </aside>

      </div>
    </div>

  </main>

  <!-- ── Unit navigation footer ──────────────────────────────────── -->
  <footer class="border-t border-[#3d2e1a] mt-4">
    <div class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center">

      {prevUnit ? (
        <a
          href={`/units/${prevUnit}`}
          class="inline-flex items-center gap-2 text-sm font-medium text-[#a09070] hover:text-[#f2e8d5] transition-colors group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          {prevLabel}
        </a>
      ) : (
        <div />
      )}

      <span class="text-sm text-[#6e5e48]">Unit {unitNumber}</span>

      {nextUnit ? (
        <a
          href={`/units/${nextUnit}`}
          class="inline-flex items-center gap-2 text-sm font-medium text-[#a09070] hover:text-[#f2e8d5] transition-colors group"
        >
          {nextLabel}
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      ) : (
        <div />
      )}

    </div>
  </footer>

</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLDivElement>('.tab-panel');
  const accent = (document.querySelector<HTMLButtonElement>('.tab-btn') as HTMLButtonElement)?.dataset.accent ?? '#d4a820';

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.id !== `panel-${target}`);
      });

      tabs.forEach((t) => {
        const active = t.dataset.tab === target;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.style.borderColor = active ? accent : 'transparent';
        t.style.color       = active ? accent : '#6e5e48';
      });
    });
  });
</script>
