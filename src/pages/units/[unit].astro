---
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// ── Static paths for all six units ──────────────────────────────────────────

export async function getStaticPaths() {
  const UNIT_IDS = [
    '00-medieval',
    '01-renaissance',
    '02-baroque',
    '03-enlightenment',
    '04-romanticism',
    '05-modernism',
  ] as const;

  return UNIT_IDS.map((id, index) => ({
    params: { unit: id },
    props: {
      prevUnit: index > 0 ? UNIT_IDS[index - 1] : null,
      nextUnit: index < UNIT_IDS.length - 1 ? UNIT_IDS[index + 1] : null,
    },
  }));
}

// ── Load content for this unit ───────────────────────────────────────────────

const { unit } = Astro.params;
const { prevUnit, nextUnit } = Astro.props;

const [philosophy, art, music] = await Promise.all([
  getEntry('units', `${unit}/philosophy`),
  getEntry('units', `${unit}/art`),
  getEntry('units', `${unit}/music`),
]);

const [
  { Content: PhilosophyContent },
  { Content: ArtContent },
  { Content: MusicContent },
] = await Promise.all([render(philosophy), render(art), render(music)]);

// ── Derive display metadata ──────────────────────────────────────────────────

const meta = philosophy.data;
const unitNumber = unit.slice(0, 2); // '00', '01', …

// Prev / next labels
const prevLabel = prevUnit
  ? (await getEntry('units', `${prevUnit}/philosophy`))?.data.period
  : null;
const nextLabel = nextUnit
  ? (await getEntry('units', `${nextUnit}/philosophy`))?.data.period
  : null;

const tabs = [
  { id: 'philosophy', label: 'Philosophy' },
  { id: 'art',        label: 'Visual Art'  },
  { id: 'music',      label: 'Music'       },
];
---

<Layout title={`${meta.period} — AP Literature`}>

  <!-- ── Unit header ─────────────────────────────────────────────────── -->
  <div class="bg-white border-b border-stone-200">
    <div class="max-w-5xl mx-auto px-6 py-10">
      <p class="text-xs font-semibold tracking-widest uppercase text-amber-700 mb-2">
        Unit {unitNumber}
      </p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-stone-900 mb-1">
        {meta.period}
      </h1>
      <p class="text-stone-500 text-sm mb-4">{meta.dates}</p>

      {meta.core_text ? (
        <div class="inline-flex items-baseline gap-2 bg-amber-50 border border-amber-200 rounded px-3 py-1.5">
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-700">Core Text</span>
          <span class="font-serif italic text-stone-800">{meta.core_text}</span>
          {meta.author && <span class="text-stone-500 text-sm">— {meta.author}</span>}
        </div>
      ) : (
        <p class="text-sm italic text-stone-400">{meta.note}</p>
      )}
    </div>
  </div>

  <!-- ── Tab navigation ──────────────────────────────────────────────── -->
  <div class="bg-white border-b border-stone-200 sticky top-[49px] z-30">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="flex gap-1" role="tablist" aria-label="Unit domains">
        {tabs.map((tab, i) => (
          <button
            role="tab"
            data-tab={tab.id}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            class:list={[
              'tab-btn px-5 py-3.5 text-sm font-medium border-b-2 transition-colors -mb-px',
              i === 0
                ? 'border-amber-600 text-amber-700'
                : 'border-transparent text-stone-500 hover:text-stone-800 hover:border-stone-300',
            ]}
          >
            {tab.label}
          </button>
        ))}
      </nav>
    </div>
  </div>

  <!-- ── Tab panels ──────────────────────────────────────────────────── -->
  <main class="max-w-5xl mx-auto px-6 py-10">

    <!-- Philosophy -->
    <div id="panel-philosophy" role="tabpanel" class="tab-panel">
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <div class="prose prose-stone prose-headings:font-serif prose-headings:font-bold prose-h1:text-2xl prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-base prose-p:leading-relaxed prose-strong:text-stone-800 max-w-none">
          <PhilosophyContent />
        </div>

        <aside class="mt-10 lg:mt-0 space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {philosophy.data.threads.map((t) => (
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
                  <p class="text-xs font-semibold text-amber-800 mb-1">{t.label}</p>
                  <p class="text-xs text-stone-600 leading-relaxed">{t.period_summary}</p>
                </div>
              ))}
            </div>
          </div>

          {philosophy.data.readings && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Readings</h3>
              <ul class="space-y-2">
                {philosophy.data.readings.map((r) => (
                  <li class="border-l-2 border-stone-200 pl-3">
                    <p class="text-sm font-medium text-stone-800 leading-snug">{r.title}</p>
                    <p class="text-xs text-stone-500">{r.author}{r.date ? ` · ${r.date}` : ''}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>

      </div>
    </div>

    <!-- Visual Art -->
    <div id="panel-art" role="tabpanel" class="tab-panel hidden">

      {/* Hero painting — full width above the prose */}
      {art.data.hero_painting?.image && (
        <figure class="mb-10">
          <div class="bg-stone-100 rounded-xl overflow-hidden flex items-center justify-center" style="max-height: 520px;">
            <img
              src={art.data.hero_painting.image}
              alt={art.data.hero_painting.title}
              class="w-full h-full object-contain"
              style="max-height: 520px;"
            />
          </div>
          <figcaption class="mt-2 text-center text-xs text-stone-400">
            <span class="font-serif italic">{art.data.hero_painting.title}</span>
            {' — '}{art.data.hero_painting.artist}, {art.data.hero_painting.date}
            {art.data.hero_painting.medium && <span> · {art.data.hero_painting.medium}</span>}
            {art.data.hero_painting.location && <span> · {art.data.hero_painting.location}</span>}
          </figcaption>
        </figure>
      )}

      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <div class="prose prose-stone prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-p:leading-relaxed prose-strong:text-stone-800 max-w-none">
          <ArtContent />
        </div>

        <aside class="mt-10 lg:mt-0 space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {art.data.threads.map((t) => (
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
                  <p class="text-xs font-semibold text-amber-800 mb-1">{t.label}</p>
                  <p class="text-xs text-stone-600 leading-relaxed">{t.period_summary}</p>
                </div>
              ))}
            </div>
          </div>

          {art.data.gallery_paintings && art.data.gallery_paintings.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Gallery</h3>
              <div class="space-y-4">
                {art.data.gallery_paintings.map((p) => (
                  <figure>
                    {p.image && (
                      <div class="bg-stone-100 rounded-lg overflow-hidden mb-1.5">
                        <img
                          src={p.image}
                          alt={p.title}
                          class="w-full object-contain"
                          style="max-height: 180px;"
                        />
                      </div>
                    )}
                    <figcaption>
                      <p class="text-xs font-serif italic text-stone-700 leading-snug">{p.title}</p>
                      <p class="text-xs text-stone-400">{p.artist} · {p.date}</p>
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </aside>

      </div>
    </div>

    <!-- Music -->
    <div id="panel-music" role="tabpanel" class="tab-panel hidden">
      <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">

        <div class="prose prose-stone prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-p:leading-relaxed prose-strong:text-stone-800 max-w-none">
          <MusicContent />
        </div>

        <aside class="mt-10 lg:mt-0 space-y-6">
          <div>
            <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Analytical Threads</h3>
            <div class="space-y-3">
              {music.data.threads.map((t) => (
                <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
                  <p class="text-xs font-semibold text-amber-800 mb-1">{t.label}</p>
                  <p class="text-xs text-stone-600 leading-relaxed">{t.period_summary}</p>
                </div>
              ))}
            </div>
          </div>

          {music.data.featured_listening && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Featured Listening</h3>
              {(Array.isArray(music.data.featured_listening)
                ? music.data.featured_listening
                : [music.data.featured_listening]
              ).map((item) => (
                <div class="border border-stone-200 rounded-lg p-3 bg-white mb-2">
                  <p class="text-sm font-serif italic font-bold text-stone-800 leading-snug">{item.title}</p>
                  <p class="text-xs text-stone-500 mt-1">{item.composer} · {item.date}</p>
                  {item.duration && <p class="text-xs text-stone-400 mt-0.5">{item.duration}</p>}
                  {item.listen_for && (
                    <p class="text-xs text-stone-600 mt-2 leading-relaxed border-t border-stone-100 pt-2">
                      {item.listen_for}
                    </p>
                  )}
                </div>
              ))}
            </div>
          )}

          {music.data.gallery_listening && music.data.gallery_listening.length > 0 && (
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-3">Also Listen</h3>
              <ul class="space-y-2">
                {music.data.gallery_listening.map((item) => (
                  <li class="border-l-2 border-stone-200 pl-3">
                    <p class="text-sm font-serif italic text-stone-800 leading-snug">{item.title}</p>
                    <p class="text-xs text-stone-500">{item.composer} · {item.date}</p>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>

      </div>
    </div>

  </main>

  <!-- ── Unit navigation footer ──────────────────────────────────────── -->
  <footer class="border-t border-stone-200 bg-white mt-4">
    <div class="max-w-5xl mx-auto px-6 py-6 flex justify-between items-center">

      {prevUnit ? (
        <a
          href={`/units/${prevUnit}`}
          class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 hover:text-stone-900 transition-colors group"
        >
          <span class="group-hover:-translate-x-1 transition-transform">←</span>
          {prevLabel}
        </a>
      ) : (
        <div />
      )}

      <span class="text-sm text-stone-400">Unit {unitNumber}</span>

      {nextUnit ? (
        <a
          href={`/units/${nextUnit}`}
          class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 hover:text-stone-900 transition-colors group"
        >
          {nextLabel}
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      ) : (
        <div />
      )}

    </div>
  </footer>

</Layout>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLDivElement>('.tab-panel');

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.id !== `panel-${target}`);
      });

      tabs.forEach((t) => {
        const active = t.dataset.tab === target;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.classList.toggle('border-amber-600', active);
        t.classList.toggle('text-amber-700', active);
        t.classList.toggle('border-transparent', !active);
        t.classList.toggle('text-stone-500', !active);
      });
    });
  });
</script>
