---
import Layout from '../layouts/Layout.astro';
import { PEOPLE } from '../components/BiographyPanel.jsx';
import { PERIOD_MOTIFS } from '../data/period-motifs';

const PERIODS = [
  { id: '00-medieval',      n: '00', name: 'The High Middle Ages',       anchor: 'Foundation',         acc: '#C9A24B' },
  { id: '01-renaissance',   n: '01', name: 'Renaissance & Reformation',  anchor: 'Hamlet',              acc: '#B54C3A' },
  { id: '02-baroque',       n: '02', name: 'The Baroque',                anchor: 'Paradise Lost',       acc: '#B07028' },
  { id: '03-enlightenment', n: '03', name: 'The Enlightenment',          anchor: 'Pride and Prejudice', acc: '#698BA1' },
  { id: '04-romanticism',   n: '04', name: 'Romanticism',                anchor: 'Moby-Dick',           acc: '#3D5A6D' },
  { id: '05-modernism',     n: '05', name: 'Modernism',                  anchor: 'Invisible Man',       acc: '#A03828' },
];

// Group people by primary unit
const groups: Record<string, typeof PEOPLE> = {};
PERIODS.forEach(p => { groups[p.id] = []; });
(PEOPLE as Array<{ id: string; name: string; dates: string; field: string; units: string[]; bio?: string; significance?: string; portrait?: string }>)
  .forEach(person => {
    const unit = person.units[0];
    if (groups[unit]) groups[unit].push(person);
  });
---

<Layout title="Biographical Index — AP Literature">

<!-- ── Spectrum band (six period blocks, full-bleed) ── -->
<div class="ppl-band" aria-hidden="true">
  <svg id="ppl-band-svg" viewBox="0 0 1152 36" preserveAspectRatio="none"></svg>
</div>

<!-- ── Centered seal-tile header ── -->
<header class="ppl-head">
  <div class="ppl-seal" aria-hidden="true">
    <!-- People sigil: profile reduced to head + shoulder arc -->
    <svg viewBox="0 0 40 40" width="46" height="46"
         style="stroke:var(--bg);fill:none;stroke-width:1.3;stroke-linecap:round;stroke-linejoin:round;"
         aria-hidden="true">
      <circle cx="20" cy="15" r="5" />
      <path d="M8 32 C 8 24, 32 24, 32 32" />
    </svg>
  </div>
  <p class="ppl-eyebrow"><strong>§ VI</strong> · Shared Resource · People</p>
  <h1 class="ppl-title">Biographical <em>Index</em></h1>
  <p class="ppl-lede">
    Writers, philosophers, artists, and composers across all six periods —
    from Augustine to Ellison. Filter by period or search by name, then open
    any card for a full biographical sketch and a note on course significance.
  </p>
</header>

<!-- ── Controls: filter pills + search ── -->
<div class="ppl-wrap">
  <div class="ppl-controls">

    <div class="ppl-filter-row" id="ppl-filter-row">
      <button class="ppl-pill ppl-pill-all active" data-period="all" type="button">
        <span class="ppl-dot" style="background: var(--ink-soft)" aria-hidden="true"></span>
        All periods
      </button>
      {PERIODS.map(p => (
        <button class="ppl-pill" data-period={p.id} type="button" style={`--c: ${p.acc}`}>
          <span class="ppl-dot" aria-hidden="true"></span>
          {p.name}
        </button>
      ))}
    </div>

    <div class="ppl-search-row">
      <div class="ppl-search-wrap">
        <svg class="ppl-search-glyph" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="7" fill="none" stroke="currentColor" stroke-width="1.4"/>
          <line x1="15.5" y1="15.5" x2="21" y2="21" stroke="currentColor" stroke-width="1.4"/>
        </svg>
        <input id="ppl-search" type="search" autocomplete="off"
               placeholder="Search by name, field, or date…"
               aria-label="Search people" />
      </div>
    </div>

  </div><!-- /.ppl-controls -->

  <!-- ── Period groups ── -->
  <div class="ppl-index" id="ppl-index">

    {PERIODS.map(period => {
      const people = groups[period.id] ?? [];
      const motifSvg = PERIOD_MOTIFS[period.id]?.[1] ?? '';
      return (
        <section class="ppl-group" data-group={period.id}>

          <div class="ppl-group-head" style={`--p: ${period.acc}; --mark-primary: ${period.acc}`}>
            <span class="ppl-group-name">{period.name}</span>
            <span class="ppl-group-sep" aria-hidden="true">·</span>
            <span class="ppl-group-anchor">{period.anchor}</span>
            {motifSvg && (
              <span class="ppl-medallion" aria-hidden="true" set:html={motifSvg}></span>
            )}
          </div>

          <div class="ppl-group-rule"></div>

          <div class="ppl-card-grid">
            {people.map(person => (
              <button
                class="ppl-card bio-link-btn"
                data-bio-id={person.id}
                data-search={`${person.name} ${person.field} ${person.dates}`.toLowerCase()}
                style={`--p: ${period.acc}`}
                type="button"
                aria-label={`Read the biographical sketch of ${person.name}`}
              >
                {person.portrait ? (
                  <img
                    class="ppl-portrait"
                    src={person.portrait}
                    alt={person.name}
                    loading="lazy"
                    width="64"
                    height="64"
                  />
                ) : (
                  <div class="ppl-portrait ppl-portrait-mono" aria-hidden="true">
                    {person.name.split(' ').slice(-2).map((w: string) => w[0]).join('')}
                  </div>
                )}
                <div class="ppl-who">
                  <p class="ppl-name">{person.name}</p>
                  <p class="ppl-role">{person.field}</p>
                  <p class="ppl-dates">{person.dates}</p>
                </div>
              </button>
            ))}
          </div>

        </section>
      );
    })}

    <!-- Empty state (hidden until filter/search leaves nothing visible) -->
    <div class="ppl-empty" id="ppl-empty" hidden>
      <span id="ppl-empty-msg">No one matches your search.</span>
    </div>

  </div><!-- /#ppl-index -->

</div><!-- /.ppl-wrap -->

</Layout>

<style>
  /* ── Spectrum band ───────────────────────────────────────────────── */
  .ppl-band {
    width: 100%;
    height: 36px;
    overflow: hidden;
    line-height: 0;
  }
  .ppl-band svg { display: block; width: 100%; height: 100%; }

  /* ── Centered header ─────────────────────────────────────────────── */
  .ppl-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 18px;
    padding: 40px var(--gutter) 0;
  }
  .ppl-seal {
    width: 88px; height: 88px;
    background: #5A4022;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ppl-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px; letter-spacing: 0.22em;
    text-transform: uppercase; color: var(--ink-soft); margin: 0;
  }
  .ppl-eyebrow strong { color: var(--ink-mute); font-weight: 500; }

  .ppl-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 300;
    font-size: clamp(46px, 6.2vw, 78px);
    line-height: 0.98; letter-spacing: -0.02em;
    margin: 0; color: var(--ink);
  }
  .ppl-title em { font-style: italic; color: var(--ink-mute); }

  .ppl-lede {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic; font-weight: 400;
    font-size: 21px; line-height: 1.45;
    color: var(--ink-mute); max-width: 58ch; margin: 0;
    text-wrap: pretty;
  }

  /* ── Content wrapper ─────────────────────────────────────────────── */
  .ppl-wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--gutter) 96px;
  }

  /* ── Controls ────────────────────────────────────────────────────── */
  .ppl-controls { margin-top: 40px; }

  .ppl-filter-row {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: center; gap: 8px;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }

  .ppl-pill {
    --c: var(--ink-soft);
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 12px;
    border: 1px solid var(--rule);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--ink-mute);
    cursor: pointer; user-select: none; white-space: nowrap;
    transition: border-color 120ms, background 120ms, color 120ms;
  }
  .ppl-pill:hover {
    border-color: color-mix(in oklab, var(--c) 55%, var(--rule));
    color: var(--ink);
  }
  .ppl-dot {
    width: 8px; height: 8px;
    background: var(--c);
    flex-shrink: 0;
  }
  .ppl-pill.active {
    background: color-mix(in oklab, var(--c) 12%, var(--bg));
    border-color: color-mix(in oklab, var(--c) 60%, var(--rule));
    color: var(--ink);
  }
  .ppl-pill-all { --c: var(--ink-soft); }

  /* ── Search ──────────────────────────────────────────────────────── */
  .ppl-search-row {
    display: flex; justify-content: center;
    padding: 14px 0 0;
    border-top: 1px solid var(--rule);
  }
  .ppl-search-wrap { position: relative; width: 100%; max-width: 560px; }
  .ppl-search-glyph {
    position: absolute; left: 16px; top: 50%; transform: translateY(-50%);
    width: 15px; height: 15px; color: var(--ink-soft);
    pointer-events: none;
  }
  #ppl-search {
    width: 100%; padding: 13px 16px 13px 42px;
    background: color-mix(in oklab, var(--bg) 88%, #fff);
    border: 1px solid var(--rule);
    font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em;
    color: var(--ink); outline: none;
    transition: border-color 120ms;
  }
  #ppl-search::placeholder { color: var(--ink-soft); letter-spacing: 0.04em; }
  #ppl-search:focus { border-color: var(--rule-strong); }

  /* ── Period group ────────────────────────────────────────────────── */
  .ppl-index { margin-top: 8px; }
  .ppl-group { margin-top: 52px; }
  .ppl-group:first-child { margin-top: 36px; }

  .ppl-group-head {
    --p: var(--ink-soft);
    display: flex; align-items: center; gap: 14px;
    position: relative; padding-left: 18px;
    margin-bottom: 4px;
  }
  .ppl-group-head::before {
    content: ''; position: absolute; left: 0; top: 2px; bottom: 2px;
    width: 4px; background: var(--p);
  }
  .ppl-group-name {
    font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--ink-mute); white-space: nowrap;
  }
  .ppl-group-sep { color: var(--rule-strong); }
  .ppl-group-anchor {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic; font-size: 19px;
    color: color-mix(in oklab, var(--p) 64%, var(--ink-mute));
  }
  .ppl-medallion {
    margin-left: 4px; display: flex; align-items: center;
    opacity: 0.9; flex-shrink: 0;
    width: 34px; height: 34px;
  }

  .ppl-group-rule {
    height: 1px; background: var(--rule); margin: 16px 0 24px;
  }

  /* ── Card grid ───────────────────────────────────────────────────── */
  .ppl-card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (max-width: 880px) { .ppl-card-grid { grid-template-columns: 1fr; } }

  /* ── Person card ─────────────────────────────────────────────────── */
  .ppl-card {
    --p: var(--ink-soft);
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 20px;
    align-items: center;
    position: relative;
    padding: 18px 22px 18px 24px;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    text-align: left; cursor: pointer;
    transition: background 130ms, border-color 130ms;
  }
  .ppl-card::before {
    content: ''; position: absolute; left: 0; top: -1px; bottom: -1px;
    width: 4px; background: var(--p);
  }
  .ppl-card:hover {
    background: color-mix(in oklab, var(--p) 9%, var(--bg-raised));
    border-color: color-mix(in oklab, var(--p) 40%, var(--rule));
  }

  .ppl-portrait {
    width: 64px; height: 64px;
    object-fit: cover;
    background: var(--bg-sunken);
    border: 1px solid color-mix(in oklab, var(--p) 32%, var(--rule));
    filter: saturate(0.86);
    display: block;
  }
  .ppl-portrait-mono {
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-mono); font-size: 14px; letter-spacing: 0.04em;
    color: var(--ink-soft); filter: none;
    background: var(--bg-sunken);
    border: 1px solid color-mix(in oklab, var(--p) 32%, var(--rule));
  }

  .ppl-who { min-width: 0; }
  .ppl-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500; font-size: 23px;
    line-height: 1.12; letter-spacing: -0.005em;
    color: var(--ink); margin: 0 0 6px;
  }
  .ppl-role {
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-soft); margin: 0;
  }
  .ppl-dates {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em;
    color: color-mix(in oklab, var(--p) 50%, var(--ink-soft));
    margin: 5px 0 0;
  }

  /* ── Empty state ─────────────────────────────────────────────────── */
  .ppl-empty {
    padding: 64px 22px; text-align: center;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic; font-size: 19px;
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    margin-top: 36px;
  }
</style>

<!-- SVG injected via set:html won't get Astro's scope attr — use is:global -->
<style is:global>
  .ppl-medallion svg { display: block; width: 34px; height: 34px; }
</style>

<script>
  // ── Spectrum band: six period-color blocks ────────────────────────────────
  (function buildBand() {
    const W = 1152, H = 36;
    const RULE  = '#C8C0B0';
    const CREAM = '#F4EDDF';
    const ACCENTS = ['#C9A24B', '#B54C3A', '#B07028', '#698BA1', '#3D5A6D', '#A03828'];
    const NS = 'http://www.w3.org/2000/svg';
    function el(tag: string, attrs: Record<string, string | number>) {
      const e = document.createElementNS(NS, tag);
      for (const k in attrs) e.setAttribute(k, String(attrs[k]));
      return e;
    }
    const svg = document.getElementById('ppl-band-svg');
    if (!svg) return;
    svg.appendChild(el('rect', { x: 0, y: 0, width: W, height: H, fill: CREAM }));
    const blockH = 22, blockY = (H - blockH) / 2, gap = 3;
    const blockW = (W - gap * (ACCENTS.length - 1)) / ACCENTS.length;
    ACCENTS.forEach((color, i) => {
      svg.appendChild(el('rect', { x: i * (blockW + gap), y: blockY, width: blockW, height: blockH, fill: color }));
    });
    svg.appendChild(el('line', { x1: 0, y1: blockY - 4,          x2: W, y2: blockY - 4,          stroke: RULE, 'stroke-width': 0.4 }));
    svg.appendChild(el('line', { x1: 0, y1: blockY + blockH + 4, x2: W, y2: blockY + blockH + 4, stroke: RULE, 'stroke-width': 0.4 }));
  })();

  // ── Filter + search ───────────────────────────────────────────────────────
  const state = { period: 'all', query: '' };

  function apply() {
    const q = state.query.trim().toLowerCase();
    let totalVisible = 0;

    document.querySelectorAll<HTMLElement>('.ppl-group').forEach(group => {
      const periodOk = state.period === 'all' || group.dataset.group === state.period;
      let groupVisible = 0;
      group.querySelectorAll<HTMLElement>('.ppl-card').forEach(card => {
        const matchQ = !q || (card.dataset.search ?? '').includes(q);
        const show = periodOk && matchQ;
        card.style.display = show ? '' : 'none';
        if (show) groupVisible++;
      });
      group.style.display = groupVisible > 0 ? '' : 'none';
      totalVisible += groupVisible;
    });

    const emptyEl = document.getElementById('ppl-empty') as HTMLElement | null;
    const msgEl   = document.getElementById('ppl-empty-msg');
    if (emptyEl) {
      if (totalVisible === 0) {
        emptyEl.hidden = false;
        if (msgEl) {
          msgEl.textContent = q
            ? `No one matches "${state.query.trim()}".`
            : 'No one in this period.';
        }
      } else {
        emptyEl.hidden = true;
      }
    }
  }

  document.querySelectorAll<HTMLElement>('#ppl-filter-row .ppl-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#ppl-filter-row .ppl-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      state.period = btn.dataset.period ?? 'all';
      apply();
    });
  });

  const searchInput = document.getElementById('ppl-search') as HTMLInputElement | null;
  searchInput?.addEventListener('input', (e) => {
    state.query = (e.target as HTMLInputElement).value;
    apply();
  });

  apply();
</script>
