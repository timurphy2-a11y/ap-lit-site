---
import Layout from '../layouts/Layout.astro';
import BiographyDemo from '../components/BiographyPanel.jsx';
---

<Layout title="Biographical Index — AP Literature">

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<section class="g-hero">
  <div class="g-wrap">
    <p class="g-label">§ VI &nbsp;·&nbsp; Shared Resource &nbsp;·&nbsp; People</p>
    <h1 class="g-title">Biographical Index</h1>
    <p class="g-thesis">
      Writers, philosophers, artists, and composers across all six periods —
      from Augustine to Ellison. Filter by period or search by name, then click
      any card to read a full biographical sketch and note on course significance.
    </p>
  </div>
</section>

<BiographyDemo client:load />

</Layout>

<style>
  .g-wrap { max-width: 900px; margin: 0 auto; padding: 0 var(--gutter); }

  .g-hero { padding: 64px 0 56px; border-bottom: 1px solid var(--rule); }
  .g-label {
    font-family: var(--font-ui);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 28px;
  }
  .g-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
    color: var(--ink);
  }
  .g-thesis {
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-mute);
    margin: 0;
  }
</style>
