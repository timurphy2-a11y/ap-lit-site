---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BioLink from '../components/BioLink.astro';
import ThreadIcon from '../components/ThreadIcon.astro';

const UNIT_IDS = [
  '00-medieval',
  '01-renaissance',
  '02-baroque',
  '03-enlightenment',
  '04-romanticism',
  '05-modernism',
] as const;

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#5b82c8',
  '01-renaissance':   '#e8a820',
  '02-baroque':       '#dc5f6c',
  '03-enlightenment': '#48a0e0',
  '04-romanticism':   '#b978d2',
  '05-modernism':     '#3aa87a',
};

const NAV_LABELS: Record<string, string> = {
  '00-medieval':      'Medieval',
  '01-renaissance':   'Renaissance',
  '02-baroque':       'Baroque',
  '03-enlightenment': 'Enlightenment',
  '04-romanticism':   'Romanticism',
  '05-modernism':     'Modernism',
};

const SCULPTURE_ACCENT = '#B5714A';
const THREAD_COLORS = ['#B5714A', '#9E5E38', '#C8845A'];

const THREADS = [
  { id: 'body-volume',    label: 'Body & Volume',    question: 'How does the sculpture render the human body in three dimensions — idealized, naturalistic, fragmented, abstracted?' },
  { id: 'material-making', label: 'Material & Making', question: 'What does the choice of material say about the work\'s ambitions and its culture?' },
  { id: 'space-setting',  label: 'Space & Setting',   question: 'Where does the sculpture live, and how does placement shape meaning?' },
];

// Load all sculpture entries in parallel
const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/sculpture`)));
---

<Layout title="Sculpting Through Time — AP Literature">

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="border-b border-[#3d2e1a]">
    <div class="max-w-5xl mx-auto px-6 py-12 md:py-16">
      <p class="text-xs font-semibold tracking-widest uppercase mb-3" style={`color: ${SCULPTURE_ACCENT};`}>Shared Resource · Sculpture</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#f2e8d5] leading-tight mb-4">
        Sculpting Through Time
      </h1>
      <p class="text-[#a09070] text-base leading-relaxed max-w-2xl">
        A complete guide to the sculpture of each period, from the medieval cathedral portal to the Modernist studio. Three threads — Body &amp; Volume, Material &amp; Making, and Space &amp; Setting — run continuously through all six periods. Follow them from start to finish, or jump to any thread below.
      </p>
    </div>
  </section>

  <!-- ── Sticky thread nav ─────────────────────────────────────────────────── -->
  <div class="sticky top-[53px] z-30 bg-[#1a140c]/95 backdrop-blur-sm border-b border-[#3d2e1a] overflow-x-auto">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="flex gap-1 py-2 min-w-max" aria-label="Jump to thread">
        {THREADS.map((thread, ti) => {
          const tc = THREAD_COLORS[ti % THREAD_COLORS.length];
          return (
            <a
              href={`#${thread.id}`}
              class="thread-nav-link px-3 py-1.5 rounded-lg text-xs font-medium transition-colors text-[#a09070] hover:text-[#f2e8d5] whitespace-nowrap inline-flex items-center gap-1.5"
              data-anchor={thread.id}
              style={`--tc: ${tc};`}
            >
              <ThreadIcon thread={thread.id} size={14} />
              {thread.label}
            </a>
          );
        })}
      </nav>
    </div>
  </div>

  <!-- ── Introduction ──────────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-10">
    <div class="prose prose-stone prose-invert prose-headings:font-serif max-w-none">
      <p class="text-[15px] text-[#f2e8d5] leading-[1.75] font-serif">
        Sculpture is the art form that most directly confronts the human body's relationship to matter, space, and time. Unlike painting, which creates an illusion on a flat surface, sculpture occupies the world the viewer occupies — it has weight, volume, and physical presence. The choices sculptors make about how to render the body, what to make it from, and where to place it are never merely aesthetic. They are arguments about what human beings are, what they can create, and what their place in the world is.
      </p>
      <p class="text-[15px] text-[#a09070] leading-[1.75] font-serif mt-4">
        This guide traces three analytical threads across six historical periods, from the medieval cathedral to the Modernist studio. Reading each thread as a continuous arc — rather than encountering the periods one by one — makes visible something that individual unit pages cannot: the story of how Western culture has understood the human figure in three dimensions over time.
      </p>
    </div>
  </section>

  <!-- ── Thread sections ───────────────────────────────────────────────────── -->
  <main class="max-w-5xl mx-auto px-6">
    {THREADS.map((thread, ti) => {
      const tc = THREAD_COLORS[ti % THREAD_COLORS.length];
      const isLast = ti === THREADS.length - 1;

      return (
        <>
          <!-- Thread header -->
          <div
            id={thread.id}
            class="pt-14 pb-6 scroll-mt-24"
          >
            <div class="flex items-center gap-3 mb-2">
              <ThreadIcon thread={thread.id} size={28} />
              <h2 class="font-serif text-2xl font-bold text-[#f2e8d5]">{thread.label}</h2>
            </div>
            <p class="text-sm italic text-[#a5967d] ml-10">{thread.question}</p>
          </div>

          <!-- Thread arc summary -->
          <div
            class="mb-8 rounded-lg p-4 border"
            style={`background-color: color-mix(in srgb, ${tc} 8%, #1a140c); border-color: color-mix(in srgb, ${tc} 25%, transparent);`}
          >
            {thread.id === 'body-volume' && (
              <p class="text-sm text-[#c8b890] leading-relaxed font-serif">
                <strong style={`color: ${tc};`}>The story this thread tells</strong> is the story of the function of the human body. In the medieval period, it is an imperfect vehicle for spiritual meaning — not an end in itself but a legible sign within a theological program. In the Renaissance, it becomes the primary subject, recovered from antiquity and celebrated for its own dignity, beauty, and capacity. The Baroque subjects it to overwhelming forces; the Enlightenment disciplines it back into rational legibility. Romanticism loads it with grief and passion, pressing it to its limits. Modernism asks, finally, whether the body is even necessary — and discovers that stripping it away is itself a statement about human function and value.
              </p>
            )}
            {thread.id === 'material-making' && (
              <p class="text-sm text-[#c8b890] leading-relaxed font-serif">
                <strong style={`color: ${tc};`}>The story this thread tells</strong> is the story of the maker's relationship to their medium and, by extension, to their culture's understanding of what art is and who makes it. The medieval craftsman disappears into communal labor in service of God. The Renaissance sculptor signs his name and claims individual genius. The Baroque sculptor pushes marble to illusionistic extremes as a form of theological persuasion. The Enlightenment recovers classical ideals in polished stone. Romanticism introduces the productive accident and the unfinished surface. Modernism abandons traditional materials altogether in favor of welded steel, glass, found objects, ultimately asking whether the category of sculptural material has or needs any boundaries.
              </p>
            )}
            {thread.id === 'space-setting' && (
              <p class="text-sm text-[#c8b890] leading-relaxed font-serif">
                <strong style={`color: ${tc};`}>The story this thread tells</strong> is perhaps the most legible arc of the three: the long history of the pedestal. Medieval sculpture is embedded in architecture — inseparable from the building, located within the cosmos the building models. The Renaissance liberates the figure onto the pedestal and into the piazza. The Baroque colonizes entire environments — chapels, fountains, public squares. The Enlightenment distributes sculpture into salons and civic spaces as portable intellectual argument. Romanticism brings the pedestal down to ground level. Modernism removes it entirely — and in doing so, asks what it means for a sculpture to exist in the world at all.
              </p>
            )}
          </div>

          <!-- Period cards for this thread -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pb-10">
            {entries.map((entry) => {
              const unitId = entry.data.unit;
              const uAccent = UNIT_ACCENTS[unitId] ?? '#d4a820';
              const num = unitId.slice(0, 2);
              const periodThread = entry.data.threads.find(t => t.id === thread.id);
              const hero = entry.data.hero_sculpture;

              return (
                <div
                  class="rounded-xl border overflow-hidden flex flex-col"
                  style={`background-color: color-mix(in srgb, ${uAccent} 8%, #1a140c); border-color: color-mix(in srgb, ${uAccent} 30%, transparent);`}
                >
                  {hero?.image && (
                    <a href={`/units/${unitId}/sculpture`} class="block overflow-hidden shrink-0">
                      <img
                        src={hero.image}
                        alt={`${hero.title} by ${hero.artist}`}
                        class="w-full aspect-[4/3] object-cover hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    </a>
                  )}

                  <div class="p-4 flex flex-col gap-3 flex-1">
                    <div class="flex items-start gap-2">
                      <span
                        class="font-serif text-xl font-bold tabular-nums shrink-0 leading-none mt-0.5"
                        style={`color: ${uAccent};`}
                      >{num}</span>
                      <div class="min-w-0">
                        <h3 class="font-serif text-sm font-bold text-[#f2e8d5] leading-snug">{entry.data.period}</h3>
                        <p class="text-xs text-[#a5967d]">{entry.data.dates}</p>
                      </div>
                    </div>

                    {periodThread && (
                      <p class="text-sm text-[#c8b890] leading-relaxed flex-1">
                        {periodThread.period_summary}
                      </p>
                    )}

                    {hero && (
                      <div class="mt-auto pt-3 border-t border-[#3d2e1a]">
                        <p class="text-xs font-medium text-[#f2e8d5] leading-snug">
                          <em>{hero.title}</em>
                        </p>
                        <p class="text-xs mt-0.5" style={`color: ${SCULPTURE_ACCENT};`}>{hero.artist}</p>
                      </div>
                    )}

                    <a
                      href={`/units/${unitId}/sculpture`}
                      class="text-xs transition-colors self-start"
                      style={`color: color-mix(in srgb, ${uAccent} 70%, #a09070);`}
                    >
                      Full {entry.data.period} unit →
                    </a>
                  </div>
                </div>
              );
            })}
          </div>

          {!isLast && (
            <hr class="border-0 border-t border-[#3d2e1a] my-2" />
          )}
        </>
      );
    })}
  </main>

  <!-- ── Footer ────────────────────────────────────────────────────────────── -->
  <footer class="border-t border-[#3d2e1a] mt-8">
    <div class="max-w-5xl mx-auto px-6 py-8 flex flex-wrap gap-4 justify-between items-center">
      <a href="/" class="text-sm text-[#a09070] hover:text-[#f2e8d5] transition-colors">← Home</a>
      <div class="flex gap-6">
        <a href="/seeing-through-paint" class="text-sm text-[#a09070] hover:text-[#f2e8d5] transition-colors">
          Seeing Through Paint
        </a>
        <a href="/hearing-through-form" class="text-sm text-[#a09070] hover:text-[#f2e8d5] transition-colors">
          Hearing Through Form
        </a>
      </div>
    </div>
  </footer>

</Layout>

<script>
  // Highlight active thread in the sticky nav based on scroll position
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.thread-nav-link');
  const sections = document.querySelectorAll<HTMLElement>('[id]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            const isActive = link.dataset.anchor === id;
            if (isActive) {
              link.style.backgroundColor = `color-mix(in srgb, var(--tc) 18%, #1a140c)`;
              link.style.color = `var(--tc)`;
            } else {
              link.style.backgroundColor = '';
              link.style.color = '';
            }
          });
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sections.forEach((sec) => observer.observe(sec));
</script>
