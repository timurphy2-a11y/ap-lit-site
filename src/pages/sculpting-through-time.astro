---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const UNIT_IDS = [
  '00-medieval', '01-renaissance', '02-baroque',
  '03-enlightenment', '04-romanticism', '05-modernism',
] as const;

const PERIOD_ACCENTS: Record<string, string> = {
  '00-medieval':      '#C9A24B',
  '01-renaissance':   '#B54C3A',
  '02-baroque':       '#B07028',
  '03-enlightenment': '#698BA1',
  '04-romanticism':   '#3D5A6D',
  '05-modernism':     '#A03828',
};

const THREADS = [
  {
    id: 'body-volume',
    title: 'Body & Volume',
    weight: 'var(--th-1)',
    question: 'How does the sculpture render the human body in three dimensions — idealized, naturalistic, fragmented, abstracted?',
    story: "is the story of the function of the human body. In the medieval period, it is an imperfect vehicle for spiritual meaning — not an end in itself but a legible sign within a theological program. In the Renaissance, it becomes the primary subject, recovered from antiquity and celebrated for its own dignity, beauty, and capacity. The Baroque subjects it to overwhelming forces; the Enlightenment disciplines it back into rational legibility. Romanticism loads it with grief and passion, pressing it to its limits. Modernism asks, finally, whether the body is even necessary — and discovers that stripping it away is itself a statement about human function and value.",
  },
  {
    id: 'material-making',
    title: 'Material & Making',
    weight: 'var(--th-2)',
    question: "What does the choice of material say about the work's ambitions and its culture?",
    story: "is the story of the maker's relationship to their medium and, by extension, to their culture's understanding of what art is and who makes it. The medieval craftsman disappears into communal labor in service of God. The Renaissance sculptor signs his name and claims individual genius. The Baroque sculptor pushes marble to illusionistic extremes as a form of theological persuasion. The Enlightenment recovers classical ideals in polished stone. Romanticism introduces the productive accident and the unfinished surface. Modernism abandons traditional materials altogether in favor of welded steel, glass, found objects, ultimately asking whether the category of sculptural material has or needs any boundaries.",
  },
  {
    id: 'space-setting',
    title: 'Space & Setting',
    weight: 'var(--th-3)',
    question: 'Where does the sculpture live, and how does placement shape meaning?',
    story: "is perhaps the most legible arc of the three: the long history of the pedestal. Medieval sculpture is embedded in architecture — inseparable from the building, located within the cosmos the building models. The Renaissance liberates the figure onto the pedestal and into the piazza. The Baroque colonizes entire environments — chapels, fountains, public squares. The Enlightenment distributes sculpture into salons and civic spaces as portable intellectual argument. Romanticism brings the pedestal down to ground level. Modernism removes it entirely — and in doing so, asks what it means for a sculpture to exist in the world at all.",
  },
];

const SIGS: Record<string, string> = {
  'body-volume':     `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="14" y1="4" x2="14" y2="36"/><line x1="26" y1="4" x2="26" y2="36"/><circle cx="20" cy="11" r="3.5"/><line x1="20" y1="15" x2="20" y2="32"/><line x1="20" y1="19" x2="16" y2="26"/><line x1="20" y1="19" x2="24" y2="26"/></svg>`,
  'material-making': `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="18" width="28" height="16"/><path d="M18 6 L22 6 L20 14 Z"/><line x1="20" y1="14" x2="20" y2="18"/><line x1="10" y1="24" x2="30" y2="24" stroke-dasharray="2 2"/><line x1="10" y1="30" x2="30" y2="30" stroke-dasharray="2 2"/></svg>`,
  'space-setting':   `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 36 L6 16 L20 6 L34 16 L34 36 Z"/><path d="M14 36 L14 24 A6 6 0 0 1 26 24 L26 36"/><circle cx="20" cy="14" r="1.5" fill="currentColor" stroke="none"/></svg>`,
};

const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/sculpture`)));
---

<Layout title="Sculpting Through Time — AP Literature">

<div class="stp-page">

  <!-- Full-bleed three-strand braid band -->
  <div id="stp-band" class="stp-band" aria-hidden="true"></div>

  <!-- Centered header -->
  <header class="stp-head">
    <div class="stp-seal" aria-hidden="true">
      <!-- Sculpture mark: hexagon + inscribed Y strut -->
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 4 L34 12 L34 28 L20 36 L6 28 L6 12 Z"/>
        <path d="M6 12 L20 20 L34 12"/>
        <line x1="20" y1="20" x2="20" y2="36"/>
      </svg>
    </div>
    <p class="stp-eyebrow"><strong>§ III</strong> · Shared Resource · Sculpture</p>
    <h1 class="stp-title">Sculpting Through <em>Time</em></h1>
    <p class="stp-lede">
      A complete guide to the sculpture of each period, from the medieval cathedral portal to the
      Modernist studio. Three threads — Body &amp; Volume, Material &amp; Making, and Space &amp;
      Setting — run continuously through all six periods. Follow them from start to finish, or jump
      to any thread below.
    </p>
  </header>

  <!-- Sticky thread nav -->
  <nav class="stp-tnav" id="stp-tnav" aria-label="Jump to thread">
    <div class="stp-tnav-row">
      {THREADS.map((t, i) => (
        <a
          class:list={['stp-tbtn', i === 0 && 'active']}
          href={`#${t.id}`}
          data-target={t.id}
          style={`--w: ${t.weight}`}
        >
          <span class="stp-tbtn-sig" set:html={SIGS[t.id]}></span>
          <span class="stp-tbtn-label">{t.title}</span>
        </a>
      ))}
    </div>
  </nav>

  <div class="stp-wrap">

    <!-- Intro prose -->
    <section class="stp-intro">
      <p>Sculpture is the art form that most directly confronts the human body's relationship to matter, space, and time. Unlike painting, which creates an illusion on a flat surface, sculpture occupies the world the viewer occupies — it has weight, volume, and physical presence. The choices sculptors make about how to render the body, what to make it from, and where to place it are never merely aesthetic. They are arguments about what human beings are, what they can create, and what their place in the world is.</p>
      <p>This guide traces three analytical threads across six historical periods, from the medieval cathedral to the Modernist studio. Reading each thread as a continuous arc — rather than encountering the periods one by one — makes visible something that individual unit pages cannot: the story of how Western culture has understood the human figure in three dimensions over time.</p>
      <div class="stp-divider"></div>
    </section>

    <!-- Thread sections -->
    <main>
      {THREADS.map((thread) => (
        <section class="stp-thread" id={thread.id} style={`--w: ${thread.weight}`}>

          <div class="stp-thread-head">
            <div class="stp-thread-sigil" set:html={SIGS[thread.id]}></div>
            <div>
              <div class="stp-thread-label">Thread · <strong>{thread.title}</strong></div>
              <h2>{thread.title}</h2>
            </div>
          </div>

          <p class="stp-thread-q">{thread.question}</p>

          <div class="stp-story">
            <p><strong>The story this thread tells</strong> {thread.story}</p>
          </div>

          <div class="stp-cards">
            {entries.map((entry) => {
              const unitId = entry.data.unit;
              const acc = PERIOD_ACCENTS[unitId] ?? '#A07820';
              const num = unitId.slice(0, 2);
              const gloss = entry.data.threads.find((t) => t.id === thread.id)?.period_summary ?? '';
              const hero = entry.data.hero_sculpture;
              return (
                <a class="stp-card" href={`/units/${unitId}/sculpture`} style={`--acc: ${acc}`} aria-label={`Read the full ${entry.data.period} unit`}>
                  {hero?.image && <div class="stp-card-img" style={`background-image:url('${hero.image}')`}></div>}
                  <div class="stp-card-body">
                    <div class="stp-card-top">
                      <span class="stp-card-num">{num}</span>
                      <span class="stp-card-ttl">{entry.data.period}</span>
                    </div>
                    <div class="stp-card-dates">{entry.data.dates}</div>
                    <p class="stp-card-gloss">{gloss}</p>
                    <div class="stp-card-cap">
                      {hero && (
                        <>
                          <div class="stp-card-work">{hero.title}</div>
                          <div class="stp-card-by">{hero.artist}</div>
                        </>
                      )}
                      <span class="stp-card-full">Full {entry.data.period} unit →</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>

        </section>
      ))}
    </main>

    <!-- Footer -->
    <footer class="stp-footer">
      <a class="stp-home" href="/">← Home</a>
      <div class="stp-siblings">
        <a href="/seeing-through-paint">Seeing Through Paint</a>
        <a href="/hearing-through-form">Hearing Through Form</a>
      </div>
    </footer>

  </div><!-- /.stp-wrap -->
</div><!-- /.stp-page -->

</Layout>

<style>
  .stp-page {
    --th-1: #4F6B4D;   /* Body & Volume    · deep moss */
    --th-2: #5F8060;   /* Material & Making · mid green */
    --th-3: #7B9883;   /* Space & Setting  · stone sage */
    --seal:  #5A4022;
    --gutter: clamp(24px, 4.5vw, 80px);
    --maxw: 1320px;
  }

  .stp-band {
    width: 100%;
    height: 60px;
    overflow: hidden;
    line-height: 0;
    background: var(--bg);
  }

  .stp-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 52px var(--gutter) 48px;
    max-width: var(--maxw);
    margin: 0 auto;
  }

  .stp-seal {
    width: 88px;
    height: 88px;
    background: var(--seal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .stp-seal svg { width: 46px; height: 46px; color: var(--bg); }

  .stp-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
  }
  .stp-eyebrow strong { color: var(--ink-mute); font-weight: 500; }

  .stp-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 300;
    font-size: clamp(30px, 5.8vw, 74px);
    line-height: 1.05;
    letter-spacing: -.02em;
    margin: 0;
    color: var(--ink);
    white-space: nowrap;
  }
  .stp-title em { font-style: italic; color: var(--ink-mute); }

  .stp-lede {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-mute);
    max-width: 60ch;
    margin: 0;
    text-wrap: pretty;
  }

  .stp-tnav {
    position: sticky;
    top: 62px;
    z-index: 39;
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
    padding: 14px var(--gutter);
  }
  .stp-tnav-row {
    display: flex;
    gap: 12px;
    max-width: calc(var(--maxw) - 2 * var(--gutter));
    margin: 0 auto;
  }

  .stp-tbtn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--bg);
    border: 1px solid var(--rule);
    padding: 13px 18px;
    position: relative;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    font-size: 18px;
    color: var(--ink-mute);
    text-decoration: none;
    transition: background 160ms, color 160ms, border-color 160ms;
  }
  .stp-tbtn-sig {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 160ms;
  }
  .stp-tbtn-sig svg { width: 100%; height: 100%; }

  .stp-tbtn:hover { background: var(--bg-raised); color: var(--ink); }
  .stp-tbtn:hover .stp-tbtn-sig { color: var(--ink-mute); }

  .stp-tbtn.active {
    background: color-mix(in oklab, var(--w) 12%, var(--bg));
    border-color: var(--w);
    color: var(--w);
  }
  .stp-tbtn.active::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--w);
  }
  .stp-tbtn.active .stp-tbtn-sig { color: var(--w); }

  @media (max-width: 720px) {
    .stp-tbtn { font-size: 0; gap: 0; padding: 13px; }
    .stp-tbtn-sig { width: 24px; height: 24px; }
  }

  .stp-wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .stp-intro { padding: 56px 0 8px; text-align: center; }
  .stp-intro p {
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-mute);
    max-width: 62ch;
    margin: 0 auto 22px;
    text-wrap: pretty;
  }
  .stp-divider { height: 1px; background: var(--rule); margin: 40px 0 0; }

  .stp-thread { padding: 56px 0 8px; scroll-margin-top: 76px; }

  .stp-thread-head {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 22px;
    align-items: center;
    margin-bottom: 8px;
  }
  .stp-thread-sigil {
    width: 64px;
    height: 64px;
    border: 1px solid color-mix(in oklab, var(--w) 32%, var(--rule));
    background: color-mix(in oklab, var(--w) 6%, var(--bg));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--w);
    flex-shrink: 0;
  }
  .stp-thread-sigil svg { width: 36px; height: 36px; }

  .stp-thread-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .stp-thread-label strong { color: var(--w); font-weight: 500; }

  .stp-thread-head h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-size: clamp(34px, 4vw, 46px);
    line-height: 1;
    letter-spacing: -.015em;
    margin: 0;
    color: var(--ink);
  }

  .stp-thread-q {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 21px;
    line-height: 1.4;
    color: var(--w);
    margin: 18px 0 24px;
    max-width: 60ch;
  }

  .stp-story {
    background: color-mix(in oklab, var(--w) 7%, var(--bg));
    border: 1px solid color-mix(in oklab, var(--w) 26%, var(--rule));
    border-left: 3px solid var(--w);
    padding: 26px 30px;
    margin-bottom: 36px;
  }
  .stp-story p {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-mute);
    margin: 0;
    text-wrap: pretty;
  }
  .stp-story p strong { color: var(--w); font-weight: 600; }

  .stp-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 1080px) { .stp-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px)  { .stp-cards { grid-template-columns: 1fr; } }

  .stp-card {
    display: flex;
    flex-direction: column;
    background: color-mix(in oklab, var(--acc) 12%, var(--bg));
    border: 1px solid color-mix(in oklab, var(--acc) 32%, var(--rule));
    border-left: 3px solid var(--acc);
    overflow: hidden;
    text-decoration: none;
    transition: filter 160ms;
  }
  .stp-card:hover { filter: brightness(.97); }

  .stp-card-img {
    aspect-ratio: 4 / 3;
    background-size: cover;
    background-position: center top;
    background-color: var(--bg-sunken);
    border-bottom: 1px solid color-mix(in oklab, var(--acc) 30%, var(--rule));
  }

  .stp-card-body {
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .stp-card-top { display: flex; align-items: baseline; gap: 12px; }
  .stp-card-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-size: 38px;
    line-height: .85;
    color: var(--acc);
    letter-spacing: -.02em;
    flex-shrink: 0;
  }
  .stp-card-ttl {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    font-size: 21px;
    line-height: 1.05;
    color: var(--ink);
    letter-spacing: -.005em;
  }
  .stp-card-dates {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    color: var(--ink-soft);
    margin: 6px 0 0;
  }
  .stp-card-gloss {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 14px 0 0;
    text-wrap: pretty;
  }
  .stp-card-cap {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid color-mix(in oklab, var(--acc) 26%, var(--rule));
  }
  .stp-card-work {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: 15.5px;
    line-height: 1.25;
    color: var(--ink);
  }
  .stp-card-by {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 5px;
  }
  .stp-card-full {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--acc);
  }

  .stp-footer {
    margin: 80px 0 0;
    padding: 26px 0 64px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }
  .stp-home {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 160ms;
  }
  .stp-home:hover { color: var(--ink); }
  .stp-siblings { display: flex; gap: 14px; }
  .stp-siblings a {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 18px;
    color: var(--ink-mute);
    padding: 8px 16px;
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: color 160ms, border-color 160ms;
  }
  .stp-siblings a:hover { color: var(--ink); border-color: var(--rule-strong); }
</style>

<script>
  (function buildBraidBand() {
    const H = 60, mid = H / 2, amp = H * 0.30, wl = H * 1.25;
    const phases = [0, (2 * Math.PI) / 3, (4 * Math.PI) / 3];
    const weights = ['var(--th-1)', 'var(--th-2)', 'var(--th-3)'];
    const sineD = (phase: number) => {
      const step = wl / 24;
      let d = `M ${(-step).toFixed(2)} ${(mid + amp * Math.sin((2 * Math.PI * -step) / wl + phase)).toFixed(2)}`;
      for (let x = 0; x <= wl + step; x += step) {
        d += ` L ${x.toFixed(2)} ${(mid + amp * Math.sin((2 * Math.PI * x) / wl + phase)).toFixed(2)}`;
      }
      return d;
    };
    const strands = phases.map((p, i) => {
      const d = sineD(p);
      return `<path d="${d}" fill="none" stroke="var(--bg)" stroke-width="8"/>`
           + `<path d="${d}" fill="none" stroke="${weights[i]}" stroke-width="3.4" stroke-linecap="round"/>`;
    }).join('');
    const el = document.getElementById('stp-band');
    if (el) {
      el.innerHTML =
        `<svg width="100%" height="${H}" xmlns="http://www.w3.org/2000/svg">`
        + `<defs><pattern id="braidpat-sculpt" width="${wl}" height="${H}" patternUnits="userSpaceOnUse">${strands}</pattern></defs>`
        + `<rect x="0" y="0" width="100%" height="${H}" fill="url(#braidpat-sculpt)"/></svg>`;
    }
  })();

  const btns = [...document.querySelectorAll<HTMLElement>('.stp-tbtn')];
  const secs = ['body-volume', 'material-making', 'space-setting'].map(id => document.getElementById(id));

  const spy = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        btns.forEach(b => b.classList.toggle('active', b.dataset.target === id));
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

  secs.forEach(s => { if (s) spy.observe(s); });
</script>
