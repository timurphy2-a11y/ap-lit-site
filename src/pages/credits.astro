---

<Layout title="Image Credits — Of Imagination All Compact">

<div class="cr-wrap">
  <header class="cr-head">
    <p class="cr-eyebrow">Shared Resource</p>
    <h1 class="cr-title">Image <em>Credits</em></h1>
    <p class="cr-lede">
      Flat reproductions of public-domain paintings and prints are generally public domain
      themselves. Photographs of three-dimensional sculpture are different: the photograph
      carries its own copyright even when the artwork depicted is centuries old. This page
      credits every sculpture photograph on the site, plus the other images sourced alongside
      them, so that attribution is easy to find in one place.
    </p>
    <p class="cr-lede cr-lede-small">
      This list covers the images audited so far. It will grow as more assets are reviewed.
    </p>
  </header>

  <section class="cr-section">
    <h2>Sculpture Photographs</h2>
    <div class="cr-grid">
      {SCULPTURE_PHOTOS.map((c) => (
        <figure class="cr-card">
          <img src={c.image} alt={c.work} loading="lazy" />
          <figcaption>
            <div class="cr-work">{c.work}</div>
            <div class="cr-line">Photograph: {c.photographer}</div>
            <div class="cr-line">
              License: {c.licenseUrl ? <a href={c.licenseUrl}>{c.license}</a> : c.license}
            </div>
            <div class="cr-line"><a href={c.sourceUrl}>Source (Wikimedia Commons)</a></div>
            {c.note && <div class="cr-note">{c.note}</div>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="cr-section">
    <h2>Painting Reproductions</h2>
    <div class="cr-grid">
      {PAINTING_PHOTOS.map((c) => (
        <figure class="cr-card">
          <img src={c.image} alt={c.work} loading="lazy" />
          <figcaption>
            <div class="cr-work">{c.work}</div>
            <div class="cr-line">License: {c.license}</div>
            <div class="cr-line"><a href={c.sourceUrl}>Source (Wikimedia Commons)</a></div>
            {c.note && <div class="cr-note">{c.note}</div>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="cr-section">
    <h2>Biographical Portraits</h2>
    <div class="cr-grid">
      {PORTRAITS.map((c) => (
        <figure class="cr-card">
          <img src={c.image} alt={c.work} loading="lazy" />
          <figcaption>
            <div class="cr-work">{c.work}</div>
            <div class="cr-line">License: {c.license}</div>
            <div class="cr-line"><a href={c.sourceUrl}>Source (Wikimedia Commons)</a></div>
            {c.note && <div class="cr-note">{c.note}</div>}
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
</div>

</Layout>

<style>
  .cr-wrap {
    max-width: var(--col);
    margin: 0 auto;
    padding: 48px var(--gutter) 80px;
  }
  .cr-head {
    text-align: center;
    margin-bottom: 56px;
  }
  .cr-eyebrow {
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 10px;
  }
  .cr-title {
    font-size: clamp(32px, 5vw, 44px);
    margin: 0 0 20px;
  }
  .cr-title em { font-style: italic; color: var(--acc); }
  .cr-lede {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-mute);
    max-width: 640px;
    margin: 0 auto 12px;
  }
  .cr-lede-small {
    font-size: 14px;
    font-style: italic;
    color: var(--ink-soft);
  }

  .cr-section {
    margin-bottom: 48px;
  }
  .cr-section h2 {
    font-family: var(--font-ui);
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    border-bottom: 1px solid var(--rule);
    padding-bottom: 10px;
    margin: 0 0 24px;
  }

  .cr-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
  }
  .cr-card {
    margin: 0;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 4px;
    overflow: hidden;
  }
  .cr-card img {
    display: block;
    width: 100%;
    height: 160px;
    object-fit: cover;
    background: var(--bg-sunken);
  }
  .cr-card figcaption {
    padding: 14px 16px 16px;
  }
  .cr-work {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 8px;
    line-height: 1.35;
  }
  .cr-line {
    font-family: var(--font-ui);
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .cr-line a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
  }
  .cr-line a:hover { color: var(--ink); }
  .cr-note {
    margin-top: 8px;
    font-size: 12px;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>
