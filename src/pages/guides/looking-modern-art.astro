<div class="lightbox" id="lightbox" hidden><button class="lightbox-close" id="lightboxClose" type="button" aria-label="Close enlarged image">×</button><div id="lightboxContent"></div></div>
<script is:inline>
(function(){
 const R=document.body;
 const lb=document.getElementById('lightbox'),lbContent=document.getElementById('lightboxContent'),lbClose=document.getElementById('lightboxClose');
 function closeLightbox(){lb.hidden=true;lbContent.innerHTML=''}
 function parseRatio(str){
  if(!str)return 0;
  const parts=str.split('/').map(s=>parseFloat(s));
  if(parts.length===2&&parts[1])return parts[0]/parts[1];
  if(parts.length===1&&parts[0])return parts[0];
  return 0;
 }
 function fitBox(clone,ratio){
  const vw=window.innerWidth*0.92,vh=window.innerHeight*0.88;
  clone.style.maxWidth='none';clone.style.maxHeight='none';
  if(ratio){
   let W=vw,H=vw/ratio;
   if(H>vh){H=vh;W=vh*ratio}
   clone.style.width=W+'px';clone.style.height=H+'px';
  } else {
   clone.style.maxWidth=vw+'px';clone.style.maxHeight=vh+'px';clone.style.width='auto';clone.style.height='auto';
  }
 }
 function revealAfter(imgs,cb){
  const pending=imgs.filter(im=>!im.complete);
  if(pending.length===0){cb();return}
  let remaining=pending.length;
  const done=()=>{remaining--;if(remaining<=0)cb()};
  pending.forEach(im=>{im.addEventListener('load',done,{once:true});im.addEventListener('error',done,{once:true})});
 }
 function openLightboxScene(scene){
  const clone=scene.cloneNode(true);
  clone.querySelectorAll('.gsvg').forEach(g=>g.remove());
  const clonedImgs=[...clone.querySelectorAll('img')];
  clonedImgs.forEach(im=>{im.loading='eager'});
  clone.style.margin='0';
  lbContent.innerHTML='';lbContent.appendChild(clone);
  revealAfter(clonedImgs,()=>{
   let ratio=parseRatio(scene.style.aspectRatio);
   if(!ratio){
    const primary=clonedImgs[0];
    if(primary&&primary.naturalWidth&&primary.naturalHeight)ratio=primary.naturalWidth/primary.naturalHeight;
   }
   fitBox(clone,ratio);
   lb.hidden=false;
  });
 }
 R.querySelectorAll('#lens-detail .scene').forEach(scene=>{
  scene.style.cursor='zoom-in';
  scene.addEventListener('click',e=>{e.stopPropagation();openLightboxScene(scene)});
 });
 lb.addEventListener('click',closeLightbox);
 lbClose.addEventListener('click',e=>{e.stopPropagation();closeLightbox()});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!lb.hidden)closeLightbox()});
 R.querySelectorAll('[data-role="guide"]').forEach(btn=>{
  const unit=btn.closest('.guide-unit');
  btn.addEventListener('click',()=>{
   const on=btn.getAttribute('aria-pressed')!=='true';
   btn.setAttribute('aria-pressed',String(on));
   btn.querySelector('.gt-label').textContent=on?'Hide visual guide':'Show visual guide';
   unit.classList.toggle('guided',on);
   const cap=unit.querySelector(':scope > .caption');
   if(cap)cap.hidden=!on;
   const hist=unit.querySelector('.scene.natural');
   if(hist&&cap){if(!cap.id)cap.id='cap-auto-'+Math.random().toString(36).slice(2);if(on)hist.setAttribute('aria-describedby',cap.id);else hist.removeAttribute('aria-describedby')}
  });
 });
 R.querySelectorAll('[data-role="takeaway"]').forEach(btn=>{
  btn.addEventListener('click',()=>{
   const wrap=btn.closest('.takeaway-wrap'),p=wrap.querySelector('.takeaway'),on=p.hidden;
   p.hidden=!on;
   btn.setAttribute('aria-expanded',String(on));
   const isConn=btn.textContent.indexOf('connection')>-1;
   btn.textContent=on?(isConn?'Hide takeaway connection':'Hide takeaway concept'):(isConn?'Show takeaway connection':'Show takeaway concept');
  });
 });
 const detail=document.getElementById('lens-detail'),dThread=document.getElementById('dThread'),dClose=document.getElementById('dClose');
 const cards=[...R.querySelectorAll('.ocard')],wraps=[...R.querySelectorAll('.lens-wrap')];
 const soft=()=>window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth';
 function open(id){
  cards.forEach(c=>c.classList.toggle('on',c.dataset.lens===id));
  wraps.forEach(w=>w.classList.toggle('is-hidden',w.dataset.lens!==id));
  detail.classList.remove('is-hidden');
  const card=cards.find(c=>c.dataset.lens===id);
  dThread.textContent=card?card.querySelector('.oname').textContent:'';
  const w=detail.querySelector('.lens-wrap:not(.is-hidden)');
  const h=w?w.querySelector('.lens-title'):null;
  if(h){h.tabIndex=-1;h.focus({preventScroll:true})}
  if(w)window.scrollTo({top:w.getBoundingClientRect().top+window.scrollY-24,behavior:soft()});
 }
 function close(){
  cards.forEach(c=>c.classList.remove('on'));
  wraps.forEach(w=>w.classList.add('is-hidden'));
  detail.classList.add('is-hidden');
 }
 cards.forEach(c=>c.addEventListener('click',()=>{c.classList.contains('on')?close():open(c.dataset.lens)}));
 dClose.addEventListener('click',()=>{const on=cards.find(c=>c.classList.contains('on'));close();if(on){on.focus({preventScroll:true});window.scrollTo({top:on.getBoundingClientRect().top+window.scrollY-80,behavior:soft()})}});
 document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!detail.classList.contains('is-hidden'))dClose.click()});
})();
</script>

