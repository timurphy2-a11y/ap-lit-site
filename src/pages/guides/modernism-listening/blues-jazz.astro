<script is:inline>
(function(){
  const detail=document.getElementById('lens-detail'),dThread=document.getElementById('dThread');
  const wraps=[...document.querySelectorAll('.lens-wrap')],cards=[...document.querySelectorAll('.ocard')];
  const threadName={groove:'Structure & Freedom',dialogue:'Texture & Voices',chorus:'Consonance & Dissonance'};
  function stopAll(){document.querySelectorAll('audio').forEach(a=>{if(!a.paused)a.pause();});}
  function openLens(key){stopAll();detail.classList.remove('is-hidden');wraps.forEach(w=>w.classList.toggle('is-hidden',w.dataset.lens!==key));cards.forEach(c=>{const on=c.dataset.lens===key;c.classList.toggle('on',on);c.setAttribute('aria-pressed',on?'true':'false');});dThread.textContent=threadName[key]||'';}
  function closeLens(){stopAll();detail.classList.add('is-hidden');wraps.forEach(w=>w.classList.add('is-hidden'));cards.forEach(c=>{c.classList.remove('on');c.setAttribute('aria-pressed','false');});}
  cards.forEach(c=>{c.setAttribute('aria-pressed','false');c.addEventListener('click',()=>{c.classList.contains('on')?closeLens():openLens(c.dataset.lens);});});
  document.getElementById('dClose').addEventListener('click',closeLens);
  // pause peers whenever any audio plays (controlled studies self-manage; this covers historical local players too)
  document.addEventListener('play',function(e){if(e.target.tagName!=='AUDIO')return;document.querySelectorAll('audio').forEach(a=>{if(a!==e.target && !a.paused) a.pause();});},true);
  // connection reveals (optional extension)
  document.querySelectorAll('.connection-reveal').forEach(btn=>{btn.addEventListener('click',()=>{const open=btn.getAttribute('aria-expanded')==='true';btn.setAttribute('aria-expanded',String(!open));document.getElementById(btn.getAttribute('aria-controls')).classList.toggle('open',!open);});});
})();
</script>
<script is:inline>
(()=>{

    (() => {
      const root = document;
      const ns = 'http://www.w3.org/2000/svg';
      const audios = ['jazz-groove-audio','jazz-dialogue-audio','jazz-chorus-audio','jazz-texture-audio'].map(id=>document.getElementById(id)).filter(Boolean);
      const x0 = 92;
      const width = 636;
      const make = (name, attrs, className) => {
        const node = document.createElementNS(ns, name);
        Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));
        if (className) node.setAttribute('class', className);
        return node;
      };
      const xAt = (time, duration) => x0 + Math.max(0, Math.min(1, time / duration)) * width;
      const moveHead = (id, time, duration) => {
        const head = root.querySelector(id);
        const x = xAt(time, duration);
        head.setAttribute('x1', x);
        head.setAttribute('x2', x);
      };
      const wire = (audio, paint) => {
        let frame = 0;
        const draw = () => {
          paint(audio.currentTime, Number.isFinite(audio.duration) ? audio.duration : 1);
          if (!audio.paused && !audio.ended) frame = requestAnimationFrame(draw);
        };
        audio.addEventListener('play', () => {
          audios.forEach(peer => { if (peer !== audio) peer.pause(); });
          cancelAnimationFrame(frame);
          draw();
        });
        audio.addEventListener('timeupdate', () => paint(audio.currentTime, Number.isFinite(audio.duration) ? audio.duration : 1));
        audio.addEventListener('pause', () => cancelAnimationFrame(frame));
        audio.addEventListener('ended', () => { cancelAnimationFrame(frame); paint(0, audio.duration || 1); });
        paint(0, Number(audio.dataset.duration));
      };

      const grooveAudio = root.querySelector('#jazz-groove-audio');
      grooveAudio.dataset.duration = '26.25';
      const grooveStream = root.querySelector('#jazz-groove-stream');
      const beat = .49;
      const pulseStart = .1;
      const phraseOffsets = [0,.18,.42,-.28,.5,-.12,.35,0];
      wire(grooveAudio, time => {
        while (grooveStream.firstChild) grooveStream.removeChild(grooveStream.firstChild);
        const pixelsPerSecond = 82;
        const pastSeconds = 2.4;
        const start = time - pastSeconds;
        const end = time + (636 / pixelsPerSecond - pastSeconds);
        const xForTime = eventTime => 92 + (eventTime - start) * pixelsPerSecond;
        const firstBeat = Math.floor((start - pulseStart) / beat) - 1;
        const lastBeat = Math.ceil((end - pulseStart) / beat) + 1;
        const phrasePoints = [];
        for (let beatIndex = firstBeat; beatIndex <= lastBeat; beatIndex += 1) {
          const pulseTime = pulseStart + beatIndex * beat;
          const pulseX = xForTime(pulseTime);
          const patternIndex = ((beatIndex % phraseOffsets.length) + phraseOffsets.length) % phraseOffsets.length;
          const offset = phraseOffsets[patternIndex];
          const phraseTime = pulseTime + offset * beat;
          const phraseX = xForTime(phraseTime);
          const phraseY = 72 + Math.sin(beatIndex * .88) * 18;
          grooveStream.appendChild(make('line', { x1: pulseX, y1: 144, x2: phraseX, y2: phraseY + 10 }, 'series-1 no-fill round soft'));
          const pulse = make('circle', { cx: pulseX, cy: 154, r: beatIndex % 4 === 0 ? 7 : 5 }, 'series-2');
          grooveStream.appendChild(pulse);
          phrasePoints.push([phraseX, phraseY, offset]);
        }
        let phrasePath = '';
        phrasePoints.forEach(([x, y], index) => {
          phrasePath += `${index ? ' L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
        });
        const contour = make('path', { d: phrasePath }, 'series-1 no-fill round');
        contour.setAttribute('stroke-width', '5');
        grooveStream.appendChild(contour);
        phrasePoints.forEach(([x, y, offset]) => {
          const accent = make('circle', { cx: x, cy: y, r: 6 + Math.abs(offset) * 10 }, 'series-1');
          grooveStream.appendChild(accent);
        });
      });

      const dialogueAudio = root.querySelector('#jazz-dialogue-audio');
      dialogueAudio.dataset.duration = '34';
      const voiceGroup = root.querySelector('#jazz-dialogue-voice');
      const cornetGroup = root.querySelector('#jazz-dialogue-cornet');
      const voiceSpans = [[2.5,8.2],[9.4,15.2],[17.1,23.2],[24.6,30.3]];
      const cornetSpans = [[0,2.5],[8.2,9.4],[15.2,17.1],[23.2,24.6],[30.3,34]];
      const addSpan = (group, span, y, className) => {
        const start = xAt(span[0], 34);
        const end = xAt(span[1], 34);
        const node = make('rect', { x: start, y, width: Math.max(3, end - start), height: 22, rx: 11 }, `${className} timed medium`);
        node.dataset.start = String(span[0]);
        node.dataset.end = String(span[1]);
        group.appendChild(node);
      };
      voiceSpans.forEach(span => addSpan(voiceGroup, span, 47, 'series-1'));
      cornetSpans.forEach(span => addSpan(cornetGroup, span, 107, 'series-2'));
      wire(dialogueAudio, (time, duration) => {
        moveHead('#jazz-dialogue-head', time, duration);
        [...voiceGroup.children, ...cornetGroup.children].forEach(mark => {
          mark.classList.toggle('live', time >= Number(mark.dataset.start) && time < Number(mark.dataset.end));
        });
      });

      const chorusAudio = root.querySelector('#jazz-chorus-audio');
      chorusAudio.dataset.duration = '32';
      const formGroup = root.querySelector('#jazz-chorus-form');
      const formColors = ['series-1', 'series-2'];
      for (let chorus = 0; chorus < 2; chorus += 1) {
        for (let part = 0; part < 3; part += 1) {
          const start = chorus * 16 + part * (16 / 3);
          const end = start + 16 / 3;
          const rect = make('rect', { x: xAt(start, 32) + 1, y: 146, width: xAt(end, 32) - xAt(start, 32) - 2, height: 28, rx: 4 }, `${formColors[chorus]} timed soft`);
          rect.dataset.start = String(start);
          rect.dataset.end = String(end);
          formGroup.appendChild(rect);
        }
        const label = make('text', { x: xAt(chorus * 16 + 8, 32), y: 194, 'text-anchor': 'middle' }, 'muted-label');
        label.textContent = `chorus ${chorus + 1}: same 12-bar framework`;
        formGroup.appendChild(label);
      }
      wire(chorusAudio, (time, duration) => {
        moveHead('#jazz-chorus-head', time, duration);
        [...formGroup.querySelectorAll('rect')].forEach(mark => {
          mark.classList.toggle('live', time >= Number(mark.dataset.start) && time < Number(mark.dataset.end));
        });
        root.querySelectorAll('#jazz-chorus-contours [data-chorus]').forEach(mark => {
          mark.classList.toggle('live', Number(mark.dataset.chorus) === (time < 16 ? 0 : 1));
        });
      });

      const textureAudio = root.querySelector('#jazz-texture-audio');
      textureAudio.dataset.duration = '30';
      const textureGroup = root.querySelector('#jazz-texture-lines');
      const lanes = [58,106,154,202,250,298,346];
      const phases = [0,.9,1.8,2.7,3.4,3.8,4.1];
      const speeds = [2.2,1.55,1.15,.82,1.95,.65,3.1];
      const amplitudes = [18,14,12,9,7,7,5];
      const series = [1,2,3,4,4,4,4];
      const paintTexture = time => {
        while (textureGroup.firstChild) textureGroup.removeChild(textureGroup.firstChild);
        lanes.forEach((lane, index) => {
          let d = '';
          for (let px = 134; px <= 728; px += 7) {
            const relative = (px - 340) / 78;
            const phase = (time + relative) * speeds[index] + phases[index];
            const y = lane + Math.sin(phase) * amplitudes[index] + Math.sin(phase * 2.3) * amplitudes[index] * .25;
            d += `${d ? ' L' : 'M'}${px.toFixed(1)} ${y.toFixed(1)}`;
          }
          textureGroup.appendChild(make('path', { d }, `series-${series[index]} no-fill round`));
          textureGroup.lastChild.setAttribute('stroke-width', index === 5 ? '7' : index === 6 ? '4' : '5');
        });
      };
      wire(textureAudio, time => paintTexture(time));
    })();
  
})();
</script>

