      const saxReturn=[[20,.5,65],[20.625,.406,68],[21.25,.531,72],[21.875,.562,75],[22.5,.438,72],[23.125,.438,68],[23.75,.438,65]];
      const trumpetReturn=[[20,.469,77],[21.25,.469,80],[22.5,.469,82],[23.75,.625,77],[25,.5,80],[26.25,.5,77],[27.5,.781,75]];
      const bass=[0,2.5,5,7.5,10,12.5,15,17.5,20,22.5,25,27.5];
      const allAudio=[...root.querySelectorAll('audio')];
      const el=(name,attrs={})=>{const node=document.createElementNS(ns,name);Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,value));return node;};
      const yFor=(pitch,voice)=>voice==='sax'?137-(pitch-63)*4.6:137-(pitch-72)*4.6;
      const phase=time=>time<9.9?'saxophone calls':time<19.9?'trumpet answers':time<29.7?'voices return together':'the sound settles';
      function paint(svg,audio,isGroup){
        const group=svg.querySelector('.moving'), now=audio.currentTime, px=88, x0=252;
        group.replaceChildren();
        bass.forEach((time,index)=>{const x=x0+(time-now)*px;if(x>-40&&x<780){group.appendChild(el('rect',{class:'bass',x:x.toFixed(1),y:String(224-(index%3)*4),width:String(2.219*px),height:'11',rx:'5'}));group.appendChild(el('circle',{class:'comp',cx:x.toFixed(1),cy:'201',r:'9'}));}});
        const voices=[{notes:saxCall,voice:'sax'},{notes:trumpetAnswer,voice:'trumpet'}];
        if(isGroup)voices.push({notes:saxReturn,voice:'sax'},{notes:trumpetReturn,voice:'trumpet'});
        voices.forEach(({notes,voice})=>{
          let path='';
          notes.forEach(([start,duration,pitch],index)=>{const x=x0+(start-now)*px,y=yFor(pitch,voice);if(index===0)path=`M${x.toFixed(1)} ${y.toFixed(1)}`;else path+=` L${x.toFixed(1)} ${y.toFixed(1)}`;});
