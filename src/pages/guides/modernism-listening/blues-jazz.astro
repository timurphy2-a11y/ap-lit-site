          notes.forEach(([start,duration,pitch])=>{const x=x0+(start-now)*px,y=yFor(pitch,voice);if(x>-80&&x<780){const active=now>=start&&now<=start+duration;group.appendChild(el('rect',{class:`note ${voice}${active?' active':''}`,x:x.toFixed(1),y:(y-6).toFixed(1),width:Math.max(10,duration*px).toFixed(1),height:'12',rx:'6'}));}});
