  <p class="sr-only">Two synchronized versions share the same steady pulse and melodic contour. In the first, the melody's note beginnings line up with pulse posts. In the second, several note beginnings appear before or after those posts.</p>

  <section class="clip" aria-labelledby="groove-pulse-title">
    <p class="clip-title" id="groove-pulse-title"><strong>Melody lands with the pulse</strong><span>note beginnings meet the beat</span></p>
    <audio id="groove-pulse-audio" controls preload="metadata"><source src="/guides/modernism-listening/blues-jazz/audio/viz/jazz-groove-on-pulse.m4a" type="audio/mp4"></audio>
    <svg class="stage" data-groove="pulse" viewBox="0 0 760 274" role="img" aria-labelledby="groove-pulse-svg-title groove-pulse-svg-desc">
      <title id="groove-pulse-svg-title">On-pulse melody</title><desc id="groove-pulse-svg-desc">Melody-note bars cross the fixed now line at the same moments as evenly spaced pulse posts.</desc>
      <defs><clipPath id="groove-pulse-window"><rect x="92" y="32" width="640" height="210"></rect></clipPath></defs>
      <text class="muted" x="18" y="96">melody</text><text class="muted" x="18" y="217">steady pulse</text>
      <line class="baseline" x1="92" y1="210" x2="732" y2="210"></line>
      <g class="moving" clip-path="url(#groove-pulse-window)"></g>
      <line class="now" x1="252" y1="32" x2="252" y2="242"></line><text x="252" y="22" text-anchor="middle">now</text>
      <text class="muted" x="92" y="262">same evenly spaced pulse throughout</text>
    </svg>
  </section>

  <section class="clip" aria-labelledby="groove-lean-title">
    <p class="clip-title" id="groove-lean-title"><strong>Melody leans around the pulse</strong><span>note beginnings enter the spaces</span></p>
    <audio id="groove-lean-audio" controls preload="metadata"><source src="/guides/modernism-listening/blues-jazz/audio/viz/jazz-groove-lean.m4a" type="audio/mp4"></audio>
    <svg class="stage" data-groove="lean" viewBox="0 0 760 274" role="img" aria-labelledby="groove-lean-svg-title groove-lean-svg-desc">
      <title id="groove-lean-svg-title">Syncopated melody around a steady pulse</title><desc id="groove-lean-svg-desc">Melody-note bars cross the fixed now line before and after evenly spaced pulse posts while the pulse itself remains steady.</desc>
      <defs><clipPath id="groove-lean-window"><rect x="92" y="32" width="640" height="210"></rect></clipPath></defs>
      <text class="muted" x="18" y="96">melody</text><text class="muted" x="18" y="217">steady pulse</text>
      <line class="baseline" x1="92" y1="210" x2="732" y2="210"></line>
      <g class="moving" clip-path="url(#groove-lean-window)"></g>
      <line class="now" x1="252" y1="32" x2="252" y2="242"></line><text x="252" y="22" text-anchor="middle">now</text>
      <text class="muted" x="92" y="262">orange links show a note leaning before or after the nearest beat</text>
    </svg>
  </section>

  <script is:inline>
    (() => {
      const root=document.getElementById('jazz-groove-pulse-lean-motion'), ns='http://www.w3.org/2000/svg';
      const onPulse=[[0,.531,65],[1.25,.531,68],[2.5,.75,72],[3.75,.531,75],[5,.531,72],[6.25,.531,69],[7.5,.75,65],[8.75,.531,62]];
      const leaning=[[0,.5,65],[1.094,.5,68],[1.938,.75,72],[3.219,.5,75],[4.656,.5,72],[6.094,.5,69],[6.938,.75,65],[8.219,.5,62]];
      const beats=Array.from({length:17},(_,index)=>index*.625), allAudio=[...root.querySelectorAll('audio')];
      const make=(name,attrs={})=>{const node=document.createElementNS(ns,name);Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,value));return node;};
      const melodyY=pitch=>146-((pitch-62)/13)*88;
      function paint(svg,audio,notes,showOffsets){
        const now=audio.currentTime, x0=252, px=105, moving=svg.querySelector('.moving');
        moving.replaceChildren();
        beats.forEach((time,index)=>{const x=x0+(time-now)*px;if(x>-30&&x<780){const strong=index%4===0;moving.appendChild(make('line',{class:`pulse-post${strong?' strong':''}`,x1:x.toFixed(1),y1:'42',x2:x.toFixed(1),y2:'214'}));moving.appendChild(make('circle',{class:`pulse-dot${strong?' strong':''}`,cx:x.toFixed(1),cy:'210',r:strong?'6':'4'}));}});
        let path='';
        notes.forEach(([start,duration,pitch],index)=>{const x=x0+(start-now)*px,y=melodyY(pitch);path+=`${index?' L':'M'}${x.toFixed(1)} ${y.toFixed(1)}`;});
        moving.appendChild(make('path',{class:'melody-line',d:path}));
        notes.forEach(([start,duration,pitch])=>{
          const x=x0+(start-now)*px,y=melodyY(pitch),width=Math.max(12,duration*px),active=now>=start&&now<=start+duration;
          if(x<=-90||x>=780)return;
          if(showOffsets){const nearest=Math.round(start/.625)*.625,beatX=x0+(nearest-now)*px;if(Math.abs(nearest-start)>.015){moving.appendChild(make('line',{class:'offset-link',x1:x.toFixed(1),y1:(y+12).toFixed(1),x2:beatX.toFixed(1),y2:(y+12).toFixed(1)}));moving.appendChild(make('circle',{class:'offset-end',cx:beatX.toFixed(1),cy:(y+12).toFixed(1),r:'3.5'}));}}
          moving.appendChild(make('rect',{class:`melody-note${active?' active':''}`,x:x.toFixed(1),y:(y-6).toFixed(1),width:width.toFixed(1),height:'12',rx:'6'}));
        });
      }
      function wire(audio,svg,notes,showOffsets,status){window.ListeningVisual.wire({root,audio,paint:()=>paint(svg,audio,notes,showOffsets),peers:allAudio,status,initialStatus:status(0)});}
      wire(root.querySelector('#groove-pulse-audio'),root.querySelector('[data-groove="pulse"]'),onPulse,false,()=> 'Melody-note beginnings meet the steady pulse.');
      wire(root.querySelector('#groove-lean-audio'),root.querySelector('[data-groove="lean"]'),leaning,true,()=> 'Melody-note beginnings lean before and after the steady pulse.');
    })();
  </script>
  <p class="model-note">Simplified listening model: horizontal spacing shows approximate note beginnings against a pulse grid; the bars are not notation.</p>
