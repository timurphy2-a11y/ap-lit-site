  <script is:inline>
    (() => {
      const root=document.getElementById('modernist-color-blocks-pair-motion'),ns='http://www.w3.org/2000/svg',allAudio=[...root.querySelectorAll('audio')];
      const cellStarts=[0,4,8],cellEnds=[2.12,5.9,10.75],cellNotes=[[0,.299,67],[.406,.299,70],[.812,.299,76],[1.25,.438,72]];
      const blockStarts=[0,6,12],blockEnds=[5.05,11.15,16.9],blockNames=['LOW STRINGS + PIANO','HIGH REEDS','METALLIC PERCUSSION'];
      const make=(name,attrs={})=>{const node=document.createElementNS(ns,name);Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,value));return node;};
      const motifPoints=[[62,87],[91,69],[127,34],[162,61]];
      root.querySelectorAll('.motif').forEach(group=>{
        group.appendChild(make('path',{class:'motif-line',d:motifPoints.map((p,i)=>`${i?'L':'M'}${p[0]} ${p[1]}`).join(' ')}));
        motifPoints.forEach(([x,y],i)=>group.appendChild(make('circle',{class:'motif-note','data-note':i,cx:x,cy:y,r:i===3?8:7})));
      });
      const isActive=(now,start,duration)=>now>=start&&now<=start+duration;
      function paintCell(audio){
        const now=audio.currentTime,svg=root.querySelector('[data-color-view="cell"]');
        svg.querySelectorAll('.field').forEach((field,index)=>{
          const sounding=now>=cellStarts[index]&&now<=cellEnds[index];field.classList.toggle('active',sounding);
          const motif=field.querySelector('.motif'),phase=Math.max(0,now-cellStarts[index]);
          if(sounding){
            const wobble=index===0?Math.sin(phase*15)*2:index===1?Math.sin(phase*27)*1.2:Math.sin(phase*36)*2.5;
            const scale=index===0?1+Math.sin(phase*9)*.016:index===1?1+Math.sin(phase*14)*.01:1+Math.sin(phase*22)*.024;
            motif.setAttribute('transform',`translate(${wobble.toFixed(2)} ${(-wobble*.45).toFixed(2)}) scale(${scale.toFixed(3)})`);
            field.querySelector('.field-outline').setAttribute('transform',`translate(${(-wobble*.35).toFixed(2)} ${(wobble*.25).toFixed(2)}) scale(${scale.toFixed(3)})`);
          } else { motif.setAttribute('transform',''); field.querySelector('.field-outline').setAttribute('transform',''); }
          field.querySelectorAll('.motif-note').forEach((note,n)=>note.classList.toggle('active',isActive(now,cellStarts[index]+cellNotes[n][0],cellNotes[n][1])));
        });
        const active=cellStarts.findLastIndex(start=>now>=start);svg.querySelectorAll('.map-block').forEach((box,i)=>box.classList.toggle('active',i===active&&now<=cellEnds[i]));
        svg.querySelector('.progress').setAttribute('cx',Math.min(724,Math.max(0,now/12*724)).toFixed(1));
      }
      function paintBlocks(audio){
        const now=audio.currentTime,svg=root.querySelector('[data-color-view="blocks"]'),moving=svg.querySelector('.moving-blocks'),x0=252,px=48;
        moving.replaceChildren();
        blockStarts.forEach((start,index)=>{
          const x=x0+(start-now)*px,w=6*px,classes=['low','reed','metal'];
          if(x+w<-20||x>760)return;
          const group=make('g');const active=now>=start&&now<start+6;
          group.appendChild(make('rect',{class:`block ${classes[index]}${active?' active':''}`,x:x.toFixed(1),y:'42',width:w.toFixed(1),height:'188',rx:index===0?'10':index===1?'34':'4'}));
          const label=make('text',{x:(x+18).toFixed(1),y:'67','font-size':'14','font-weight':'600'});label.textContent=blockNames[index];group.appendChild(label);
          group.appendChild(make('line',{class:'foundation',x1:(x+18).toFixed(1),y1:index===0?'190':index===1?'180':'200',x2:(x+w-18).toFixed(1),y2:index===0?'190':index===1?'180':'200'}));
          const pts=cellNotes.map(([offset,,pitch])=>[x+18+offset*px,145-(pitch-67)*5]);
          group.appendChild(make('path',{class:'block-motif',d:pts.map((p,i)=>`${i?'L':'M'}${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' ')}));
          pts.forEach(([cx,cy],n)=>group.appendChild(make('circle',{class:`block-note${isActive(now,start+cellNotes[n][0],cellNotes[n][1])?' active':''}`,cx:cx.toFixed(1),cy:cy.toFixed(1),r:n===3?'8':'7'})));
          moving.appendChild(group);
        });
        const active=blockStarts.findLastIndex(start=>now>=start);svg.querySelectorAll('.map-block').forEach((box,i)=>box.classList.toggle('active',i===active&&now<startSafe(i)));
        svg.querySelector('.progress').setAttribute('cx',Math.min(646,Math.max(0,now/18*646)).toFixed(1));
      }
      const startSafe=i=>i<2?blockStarts[i+1]:18;
      function wire(audio,paint,status){window.ListeningVisual.wire({root,audio,paint:()=>paint(audio),peers:allAudio,status,initialStatus:status(0)});}
      wire(root.querySelector('#color-cell-audio'),paintCell,time=>time<4?'The four-note cell sounds in a reedy woodwind.':time<8?'The same cell moves to muted brass.':'The same cell moves to vibraphone.');
      wire(root.querySelector('#color-block-audio'),paintBlocks,time=>time<6?'Low strings and piano form the first block.':time<12?'High reeds form the second block.':'Metallic percussion forms the third block.');
    })();
  </script>
  <p class="model-note">Simplified listening model: shapes and blocks distinguish broad timbral character and succession, not measured spectra or emotional values.</p>
