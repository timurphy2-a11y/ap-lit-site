  <script is:inline>
    (() => {
      const root=document.getElementById('modernist-ostinato-pair-motion'), ns='http://www.w3.org/2000/svg', cycle=4.138;
      const groundCycle=[[0,.373,50],[.517,.373,45],[1.034,.373,51],[1.552,.373,48],[2.069,.373,50],[2.586,.373,44],[3.103,.373,52],[3.621,.373,46]];
      const repeated=count=>Array.from({length:count},(_,turn)=>groundCycle.map(note=>[note[0]+turn*cycle,note[1],note[2]])).flat();
      const upper=[[4.138,.621,65],[5.172,.414,70],[6.207,.517,76],[7.241,.724,72],[8.276,.517,68],[9.828,.621,62],[10.862,.362,71]], allAudio=[...root.querySelectorAll('audio')];
      const make=(name,attrs={})=>{const node=document.createElementNS(ns,name);Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,value));return node;};
      const groundY=pitch=>226-(pitch-44)*7, upperY=pitch=>121-(pitch-62)*5;
      function pathFor(notes,now,x0,px,yFor){return notes.map(([start,,pitch],index)=>`${index?'L':'M'}${(x0+(start-now)*px).toFixed(1)} ${yFor(pitch).toFixed(1)}`).join(' ');}
      function drawNotes(group,notes,now,x0,px,yFor,className){notes.forEach(([start,duration,pitch])=>{const x=x0+(start-now)*px,y=yFor(pitch);if(x<=-80||x>=780)return;group.appendChild(make('rect',{class:`${className}${now>=start&&now<=start+duration?' active':''}`,x:x.toFixed(1),y:(y-6).toFixed(1),width:Math.max(12,duration*px).toFixed(1),height:'12',rx:'6'}));});}
      function paint(svg,audio,count,showUpper){
