function drawColor(ctx,w,h,acc,ink,rule,variant,t){
  geoGrid(ctx,w,h,acc,rule);
  const pad=20, top=30, bot=h-40, n=3, gap=16;
  const bw=(w-2*pad-gap*(n-1))/n;
  const fields=[{id:'a',lbl:'Field 1',dash:[]},{id:'b',lbl:'Field 2',dash:[6,3]},{id:'c',lbl:'Field 3',dash:[2,2]}];
  fields.forEach((f,i)=>{
    const x=pad+i*(bw+gap); const active=variant===f.id;
    ctx.strokeStyle= active?acc:rule; ctx.lineWidth= active?2:1; ctx.setLineDash(f.dash); ctx.strokeRect(x,top,bw,bot-top); ctx.setLineDash([]);
    ctx.fillStyle=active?'color-mix(in oklab, '+acc+' 10%, transparent)':'transparent'; ctx.fillRect(x,top,bw,bot-top);
    ctx.save(); ctx.beginPath(); ctx.rect(x,top,bw,bot-top); ctx.clip();
