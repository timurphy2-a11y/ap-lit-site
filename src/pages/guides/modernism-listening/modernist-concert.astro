    else{ ctx.save(); ctx.translate(x+bw/2,top+22); ctx.rotate(Math.PI/6); ctx.fillRect(-16,-16,32,32); ctx.restore(); }
    ctx.globalAlpha=1; ctx.restore();
    ctx.strokeStyle= active?acc:'color-mix(in oklab, '+ink+' 55%, white)'; ctx.lineWidth=1.6; ctx.beginPath();
    const cell=[0,2,4,2];
    cell.forEach((d,ci)=>{ const cx=x+18+ci*((bw-36)/3); const cy=bot-24-((d/8)*(bot-top-40)); if(ci===0) ctx.moveTo(cx,cy); else ctx.lineTo(cx,cy); });
    ctx.stroke();
    ctx.font='9px IBM Plex Mono, monospace'; ctx.fillStyle=ink; ctx.textAlign='center'; ctx.globalAlpha=active?1:.55;
    ctx.fillText(f.lbl, x+bw/2, bot+16); ctx.globalAlpha=1;
  });
}

document.querySelectorAll('.guide-toggle').forEach(btn=>{
