  <p class="sr-only">A quiet recurring field continues while a rising harp line becomes the foreground color. Later, piccolo and celesta take up that line as two smaller high echoes. The change of instrumental color is the formal event.</p>
  <p class="clip-title"><strong>Schoenberg · a new color becomes the event</strong><span>Farben · measures 12–17</span></p>
  <audio id="farben-color-audio" controls preload="metadata"><source src="/guides/modernism-listening/modernist-concert/audio/viz/schoenberg-farben-harp-line--web-final-01.m4a" type="audio/mp4"></audio>

  <svg class="stage" viewBox="0 0 760 390" role="img" aria-labelledby="farben-color-title farben-color-desc">
    <title id="farben-color-title">A harp color line passed to piccolo and celesta</title>
    <desc id="farben-color-desc">A muted recurring field remains present. A large rising harp curve appears first; two smaller high curves then show piccolo and celesta echoing its identity.</desc>
    <path class="field" d="M102 241 C117 164 211 129 313 151 C407 117 563 144 646 218 C617 305 514 331 403 304 C286 335 154 317 102 241 Z"></path>
    <ellipse class="field-pulse" cx="380" cy="236" rx="252" ry="80"></ellipse>
    <text class="muted" x="380" y="337" text-anchor="middle">quiet recurring field remains present</text>
    <g class="harp-layer">
      <path class="harp" pathLength="1" d="M175 260 C226 250 246 220 281 209 C326 194 357 162 414 151 C462 141 495 116 543 98"></path>
      <circle class="harp-dot" cx="175" cy="260" r="8"></circle>
      <text class="muted" x="183" y="284">harp color line</text>
    </g>
    <g class="echo-layer">
      <path class="piccolo" pathLength="1" d="M337 112 C379 99 402 78 438 70 C478 62 508 45 548 38"></path>
      <path class="celesta" pathLength="1" d="M331 127 C374 117 400 96 435 89 C477 81 503 65 542 58"></path>
      <circle class="echo-dot pic" data-dot="pic" cx="337" cy="112" r="6"></circle>
      <circle class="echo-dot cel" data-dot="cel" cx="331" cy="127" r="6"></circle>
      <text class="muted" x="567" y="43">piccolo</text><text class="muted" x="567" y="64">celesta</text>
    </g>
    <g class="bar-map" transform="translate(82 350)"></g>
  </svg>

  <script is:inline>
    (() => {
      const root=document.getElementById('schoenberg-farben-color-motion');
      const audio=root.querySelector('#farben-color-audio');
      const svg=root.querySelector('.stage');
      const ns='http://www.w3.org/2000/svg';
      const beat=60/70, bar=beat*4;
      const harpStarts=[beat,bar+beat,2*bar+beat,3*bar+beat];
      const echoStarts=[4*bar+2*beat,5*bar+2*beat];
      const lastEvent=20.964;
      const harpPath=svg.querySelector('.harp');
      const harpDot=svg.querySelector('.harp-dot');
      const piccolo=svg.querySelector('.piccolo');
      const celesta=svg.querySelector('.celesta');
      const picDot=svg.querySelector('[data-dot="pic"]');
      const celDot=svg.querySelector('[data-dot="cel"]');
      const map=svg.querySelector('.bar-map');
      const make=(name,attrs={})=>{const node=document.createElementNS(ns,name);Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,value));return node;};

      Array.from({length:6},(_,index)=>index).forEach(index=>{
        const x=index*101.3;
        map.appendChild(make('rect',{class:'bar-cell','data-bar':index,x,y:'0',width:'93',height:'27',rx:'6'}));
        const label=make('text',{x:x+46.5,y:'18','text-anchor':'middle'});label.textContent=index<4?'harp':index===4?'high echo':'echo + field';map.appendChild(label);
      });
      map.appendChild(make('circle',{class:'progress',cx:'0',cy:'34',r:'4'}));

      function drawCurrent(path,dot,portion){
        const clamped=Math.max(0,Math.min(1,portion));
        path.style.strokeDasharray='1';path.style.strokeDashoffset=String(1-clamped);
        const point=path.getPointAtLength(path.getTotalLength()*clamped);
        dot.setAttribute('cx',point.x.toFixed(1));dot.setAttribute('cy',point.y.toFixed(1));
      }
      function nearestPortion(now,starts,duration){
        const current=starts.findLast(start=>now>=start);
        if(current===undefined)return 0;
        return Math.max(0,Math.min(1,(now-current)/duration));
      }
      function paint(){
        const now=audio.currentTime||0;
        const harpPortion=nearestPortion(now,harpStarts,2.35*beat);
        const echoPortion=nearestPortion(now,echoStarts,2.35*beat);
        drawCurrent(harpPath,harpDot,harpPortion);
        drawCurrent(piccolo,picDot,echoPortion);
        drawCurrent(celesta,celDot,Math.max(0,echoPortion-.14)/.86);
        svg.querySelector('.harp-layer').style.opacity=now>=harpStarts[0]?'1':'.18';
        svg.querySelector('.echo-layer').style.opacity=now>=echoStarts[0]?'1':'.16';
        const pulsePhase=(now%(bar/2))/(bar/2);
        svg.querySelector('.field-pulse').style.opacity=String(.2+.28*(1-Math.abs(pulsePhase*2-1)));
        const activeBar=Math.min(5,Math.floor(now/bar));
        map.querySelectorAll('.bar-cell').forEach((cell,index)=>cell.classList.toggle('active',index===activeBar&&now<=lastEvent));
        map.querySelector('.progress').setAttribute('cx',Math.min(599,Math.max(0,now/lastEvent*599)).toFixed(1));
      }
      const status=time=>time<harpStarts[0]?'The quiet recurring field is present.':time<echoStarts[0]?'A rising harp line becomes a new foreground color.':time<=lastEvent?'Piccolo and celesta acquire the line as a high echo while the field remains.':'The changed instrumental color has made a new formal region.';
      window.ListeningVisual.wire({root,audio,paint,status,initialStatus:status(0)});
    })();
  </script>
  <p class="model-note">Reduced Logic performance of an original score passage. Simplified listening guide, not a score: curves identify the transfer of a timbral line while the muted field represents continuing background color.</p>
