function notesFrom(list,waveDefault){ return list.map(n=>({f:n.deg!=null?deg(n.deg):n.f,t:n.t,d:n.d,wave:n.wave||waveDefault,vel:n.vel!=null?n.vel:0.7})); }
const CLIPS={};
function addClip(id,notes,duration,opts){CLIPS[id]={notes,duration,opts:opts||{}};}
function mergeLayers(layers){let out=[];layers.forEach(l=>out=out.concat(l));return out;}

const ostBass=[0,0.9,1.8,2.7].flatMap(s=>[{t:s,d:.28,f:ROOT.C3,vel:.4},{t:s+0.3,d:.22,f:ROOT.F3,vel:.3},{t:s+0.55,d:.28,f:ROOT.C3,vel:.34}]);
const ostUpper=[1.8,2.25,2.7,3.15].map((t,i)=>({t,d:.4,deg:5+(i%2),vel:.5,wave:'sine'}));
addClip('ostinato-full', mergeLayers([notesFrom(ostBass,'triangle'),notesFrom(ostUpper,'sine')]), 3.7);

const collGround=[0,.25,.5,.75,1,1.25,1.5,1.75].map(t=>({t,d:.18,f:196.0,vel:.3,wave:'triangle'}));
const collTop=[0,.33,.66,1.0,1.33,1.66].map((t,i)=>({t,d:.28,deg:4+(i%3),vel:.55,wave:'sawtooth'}));
addClip('collision-full', mergeLayers([notesFrom(collGround,'triangle'),notesFrom(collTop,'sawtooth')]), 2.2);

const centerCells=[[5,7],[1,3],[6,0],[2,4]];
const centerNotes=centerCells.flatMap((pair,i)=>[{t:i*0.95,d:.32,deg:pair[0]},{t:i*0.95+0.38,d:.36,deg:pair[1]}]);
addClip('center-full', notesFrom(centerNotes,'sine'), 3.9);

const colorCell=[{t:0,d:.3,deg:0},{t:.35,d:.3,deg:2},{t:.7,d:.3,deg:4},{t:1.05,d:.35,deg:2}];
addClip('color-a', notesFrom(colorCell,'square'), 1.55, {filter:{type:'lowpass',freq:900}});
addClip('color-b', notesFrom(colorCell,'sawtooth'), 1.55, {brighten:true});
addClip('color-c', notesFrom(colorCell.map(n=>({...n,d:.28})),'sine'), 1.55);

async function renderClip(def){
  const sr=22050, len=Math.ceil((def.duration+0.4)*sr);
  const ctx=new OfflineAudioContext(1,len,sr);
  const master=ctx.createGain(); master.gain.value=0.85;
  let tail=master;
  if(def.opts.filter){const f=ctx.createBiquadFilter();f.type=def.opts.filter.type;f.frequency.value=def.opts.filter.freq;tail=f;f.connect(master);}
  tail.connect(ctx.destination);
  const dest=tail;
  def.notes.forEach(n=>{
    const g=ctx.createGain();
    const atk=Math.min(.02,n.d*.25), rel=Math.min(.09,n.d*.4);
    g.gain.setValueAtTime(0,n.t); g.gain.linearRampToValueAtTime(n.vel,n.t+atk);
    g.gain.setValueAtTime(n.vel,Math.max(n.t+atk,n.t+n.d-rel)); g.gain.linearRampToValueAtTime(0,n.t+n.d);
    g.connect(dest);
    const osc=ctx.createOscillator(); osc.type=n.wave; osc.frequency.value=n.f;
    osc.connect(g); osc.start(n.t); osc.stop(n.t+n.d+.02);
    if(def.opts.brighten){
      const g2=ctx.createGain();
      g2.gain.setValueAtTime(0,n.t); g2.gain.linearRampToValueAtTime(n.vel*.35,n.t+atk);
      g2.gain.setValueAtTime(n.vel*.35,Math.max(n.t+atk,n.t+n.d-rel)); g2.gain.linearRampToValueAtTime(0,n.t+n.d);
      const osc2=ctx.createOscillator(); osc2.type='sawtooth'; osc2.frequency.value=n.f*2;
      osc2.connect(g2); g2.connect(dest); osc2.start(n.t); osc2.stop(n.t+n.d+.02);
    }
  });
  return ctx.startRendering();
}
function bufferToWav(buffer){
  const samples=buffer.getChannelData(0), sr=buffer.sampleRate;
  const dataLen=samples.length*2, ab=new ArrayBuffer(44+dataLen), view=new DataView(ab);
  function ws(o,s){for(let i=0;i<s.length;i++)view.setUint8(o+i,s.charCodeAt(i));}
  ws(0,'RIFF'); view.setUint32(4,36+dataLen,true); ws(8,'WAVE');
  ws(12,'fmt '); view.setUint32(16,16,true); view.setUint16(20,1,true); view.setUint16(22,1,true);
  view.setUint32(24,sr,true); view.setUint32(28,sr*2,true); view.setUint16(32,2,true); view.setUint16(34,16,true);
  ws(36,'data'); view.setUint32(40,dataLen,true);
  let off=44;
  for(let i=0;i<samples.length;i++){const s=Math.max(-1,Math.min(1,samples[i]));view.setInt16(off, s<0?s*0x8000:s*0x7FFF, true); off+=2;}
  return new Blob([ab],{type:'audio/wav'});
}
async function renderAll(){
  await Promise.all(Object.keys(CLIPS).map(async id=>{
    const buf=await renderClip(CLIPS[id]);
    const url=URL.createObjectURL(bufferToWav(buf));
    document.querySelectorAll('audio[data-clip="'+id+'"]').forEach(a=>a.src=url);
  }));
  document.getElementById('loading-note').classList.add('ready');
}

document.addEventListener('play',function(e){
  if(e.target.tagName!=='AUDIO') return;
  document.querySelectorAll('audio').forEach(a=>{if(a!==e.target && !a.paused) a.pause();});
  const lens=e.target.dataset.lens; if(lens) lensLastVariant[lens]=e.target.dataset.variant;
  startLoop();
},true);
document.querySelectorAll('audio').forEach(a=>{
  a.addEventListener('pause',()=>drawLens(a.dataset.lens));
  a.addEventListener('seeked',()=>drawLens(a.dataset.lens));
});
let rafRunning=false;
function startLoop(){ if(rafRunning) return; rafRunning=true; step(); }
function step(){ let any=false; document.querySelectorAll('audio').forEach(a=>{ if(!a.paused){any=true; drawLens(a.dataset.lens);} }); if(any) requestAnimationFrame(step); else rafRunning=false; }
const lensLastVariant={};
function activeAudioFor(lens){
  const variant=lensLastVariant[lens];
  const list=document.querySelectorAll('audio[data-lens="'+lens+'"]');
  if(!list.length) return null;
  if(variant){ for(const a of list){ if(a.dataset.variant===variant) return a; } }
  return list[0];
}
function drawLens(lens){
  if(!lens) return;
  const canvas=document.querySelector('canvas[data-lens-canvas="'+lens+'"]'); if(!canvas) return;
  const ctx=canvas.getContext('2d'); const w=canvas.width,h=canvas.height;
  const acc=getComputedStyle(document.body).getPropertyValue('--acc').trim()||'#A03828';
  const ink=getComputedStyle(document.body).getPropertyValue('--ink-mute').trim()||'#4a4138';
  const rule=getComputedStyle(document.body).getPropertyValue('--rule').trim()||'#C9BDA5';
  ctx.clearRect(0,0,w,h);
  const audio=activeAudioFor(lens);
  const t=audio&&audio.duration?audio.currentTime:0;
  const variant=lensLastVariant[lens];
  if(lens==='ostinato') drawOstinato(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='collision') drawCollision(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='center') drawCenter(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='color') drawColor(ctx,w,h,acc,ink,rule,variant,t);
}
function playhead(ctx,w,h,x,acc){ ctx.strokeStyle=acc; ctx.lineWidth=2; ctx.beginPath(); ctx.moveTo(x,6); ctx.lineTo(x,h-6); ctx.stroke(); ctx.beginPath(); ctx.arc(x,6,3,0,7); ctx.fillStyle=acc; ctx.fill(); }
function geoGrid(ctx,w,h,acc,rule){
  ctx.save(); ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.globalAlpha=.5;
  [0.18,0.62,0.84].forEach(f=>{ ctx.beginPath(); ctx.moveTo(w*f,0); ctx.lineTo(w*f,h); ctx.stroke(); });
  [0.3,0.7].forEach(f=>{ ctx.beginPath(); ctx.moveTo(0,h*f); ctx.lineTo(w,h*f); ctx.stroke(); });
  ctx.globalAlpha=.5; ctx.fillStyle=acc; ctx.beginPath(); ctx.moveTo(w-1,0); ctx.lineTo(w-1,h*0.16); ctx.lineTo(w-1-h*0.16,0); ctx.closePath(); ctx.fill();
  ctx.restore();
}

function drawOstinato(ctx,w,h,acc,ink,rule,variant,t){
  geoGrid(ctx,w,h,acc,rule);
  const pad=20, gridDur=3.7, lowY0=h-90, lowY1=h-30, upY0=30, upY1=lowY0-14;
  const xOf=tt=>pad+(tt/gridDur)*(w-2*pad);
  ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(pad,lowY1); ctx.lineTo(w-pad,lowY1); ctx.stroke();
  [0,0.9,1.8,2.7].forEach(rep=>{ const active=variant&&t>=rep&&t<rep+0.9;
    ctx.fillStyle= active? acc:'color-mix(in oklab, '+acc+' 55%, white)';
    const x=xOf(rep), bw=xOf(rep+0.85)-x;
    ctx.fillRect(x,lowY0,bw,lowY1-lowY0);
    ctx.strokeStyle=ink; ctx.globalAlpha=.5; ctx.strokeRect(x,lowY0,bw,lowY1-lowY0); ctx.globalAlpha=1; });
  ctx.font='9px IBM Plex Mono, monospace'; ctx.fillStyle=ink; ctx.globalAlpha=.6; ctx.textAlign='left'; ctx.fillText('STABLE PATTERN — NEVER STOPS', pad, lowY1+16); ctx.globalAlpha=1;
  ostUpper.forEach(n=>{ const active=variant&&t>=n.t&&t<n.t+n.d; const x=xOf(n.t); const y=upY1-((n.deg%4)*10)-10;
    ctx.fillStyle= active? ink:'color-mix(in oklab, '+ink+' 45%, white)';
    ctx.beginPath(); ctx.moveTo(x,y-7); ctx.lineTo(x+7,y); ctx.lineTo(x,y+7); ctx.lineTo(x-7,y); ctx.closePath(); ctx.fill(); });
  ctx.strokeStyle=rule; ctx.setLineDash([3,3]); ctx.beginPath(); ctx.moveTo(xOf(1.8),upY0); ctx.lineTo(xOf(1.8),lowY1); ctx.stroke(); ctx.setLineDash([]);
  ctx.font='9px IBM Plex Mono, monospace'; ctx.fillStyle=ink; ctx.globalAlpha=.6; ctx.fillText('2ND LAYER ENTERS', xOf(1.8)+6, upY0+10); ctx.globalAlpha=1;
  if(variant) playhead(ctx,w,h,xOf(Math.min(t,gridDur)),acc);
}
function drawCollision(ctx,w,h,acc,ink,rule,variant,t){
  geoGrid(ctx,w,h,acc,rule);
  const pad=20, gridDur=2.2, groundY=h-50, topY=40;
  const xOf=tt=>pad+(tt/gridDur)*(w-2*pad);
  ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(pad,groundY+20); ctx.lineTo(w-pad,groundY+20); ctx.stroke();
  [0,.25,.5,.75,1,1.25,1.5,1.75].forEach(pt=>{ const active=variant&&t>=pt&&t<pt+0.18; const x=xOf(pt);
    ctx.beginPath(); ctx.moveTo(x,groundY); ctx.lineTo(x,groundY+20); ctx.strokeStyle= active?acc:'color-mix(in oklab, '+acc+' 45%, white)'; ctx.lineWidth=2.4; ctx.stroke(); });
  const topGroups=[[0,.33,.66],[1.0,1.33,1.66]];
  topGroups.forEach(group=>{
    const x0=xOf(group[0]), x1=xOf(group[group.length-1]+0.28);
    ctx.strokeStyle=ink; ctx.lineWidth=1; ctx.globalAlpha=.5; ctx.beginPath(); ctx.moveTo(x0,topY-10); ctx.lineTo(x1,topY-10); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(x0,topY-10); ctx.lineTo(x0-8,topY+40); ctx.stroke(); ctx.globalAlpha=1;
    group.forEach(pt=>{ const active=variant&&t>=pt&&t<pt+0.28; const x=xOf(pt);
      ctx.save(); ctx.translate(x+5,topY+13); ctx.rotate(Math.PI/12);
      ctx.fillStyle= active? ink:'color-mix(in oklab, '+ink+' 45%, white)'; ctx.fillRect(-5,-13,10,26); ctx.restore(); });
  });
  ctx.font='9px IBM Plex Mono, monospace'; ctx.fillStyle=ink; ctx.globalAlpha=.6; ctx.textAlign='left';
  ctx.fillText('GROUND: EVEN PULSE', pad, groundY+38); ctx.fillText('ABOVE: GROUPED IN THREES', pad, topY-16); ctx.globalAlpha=1;
  if(variant) playhead(ctx,w,h,xOf(Math.min(t,gridDur)),acc);
}
function drawCenter(ctx,w,h,acc,ink,rule,variant,t){
  geoGrid(ctx,w,h,acc,rule);
  const pad=40, gridDur=3.9, midY=h/2;
  const xOf=tt=>pad+(tt/gridDur)*(w-2*pad);
  const cellsT=[0,0.95,1.9,2.85];
  const cellsDeg=[6,2,3,3];
  const pts=cellsT.map((ct,i)=>({x:xOf(ct+0.19),y:midY-((cellsDeg[i]/8)*(h-70))+35}));
  ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath();
  pts.forEach((p,i)=>{ if(i===0) ctx.moveTo(p.x,p.y); else ctx.lineTo(p.x,p.y); }); ctx.stroke();
  pts.forEach((p,i)=>{ const active=variant&&t>=cellsT[i]&&t<cellsT[i]+0.75; const s=active?9:7;
    ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(Math.PI/4);
    ctx.fillStyle= active?acc:'color-mix(in oklab, '+acc+' 60%, white)'; ctx.fillRect(-s/2,-s/2,s,s);
    ctx.strokeStyle='#fff'; ctx.strokeRect(-s/2,-s/2,s,s); ctx.restore(); });
  ctx.font='9px IBM Plex Mono, monospace'; ctx.fillStyle=ink; ctx.globalAlpha=.6; ctx.textAlign='center';
  ctx.fillText('RELATED BY PROXIMITY — NO FIXED HOME', w/2, h-16); ctx.globalAlpha=1;
  if(variant) playhead(ctx,w,h,xOf(Math.min(t,gridDur)),acc);
