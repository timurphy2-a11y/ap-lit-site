<!-- ============ CROSS-PERIOD PRIMER ============ -->
<section class="primer" id="primer">
<p class="primer-tagline">Before the timeline · the material every period reshapes</p>
<h2>One short tune, and what “form” makes of it</h2>
<p class="setup"><strong>Musical form</strong> makes composition intelligible by letting musical ideas <em>repeat</em>, creating <em>contrast</em>, letting an idea <em>transform</em> while staying recognizable, and bringing ideas back in <em>return</em>.</p>
<p class="setup">Almost every study on this page is built from the <em>same</em> four-bar tune. Learn it once, here, and you will recognize it again through the timeline — prolonged into a chant, chased through a fugue, argued in a sonata, circled over a ground bass, teased by a rondo.</p>

<p class="hero-marker">Step one · Meet the theme</p>
<p class="body">A melody is a connected line of notes. What makes it recognizable is not the exact notes but their <em>contour</em> — the shape they trace as they rise, turn back, climb higher, and settle home. Play the tune once. Then hear a version that <em>changes several pitches but keeps that shape</em>: it still sounds like the same idea.</p>

<div class="realmusic">
<div class="realmusic-head"><span class="rm-tag">The theme</span><span class="rm-work">A four-bar tune · “Question, Answer, Return”</span></div>
<p class="rm-intro">The solid line is the tune's contour; when you play the <em>same-shape</em> version, a dashed ghost of the original stays behind. The shape survives even as the pitches move.</p>
<div class="viz-embed">
  <div id="form-theme-identity-motion">
    <style is:global>
    #form-theme-identity-motion .clip-title { display:flex; justify-content:space-between; gap:1rem; align-items:baseline; margin:0 0 .5rem; }
    #form-theme-identity-motion .clip-title strong { font-weight:500; }
    #form-theme-identity-motion .clip-title span, #form-theme-identity-motion .status { color:var(--muted-foreground); }
    #form-theme-identity-motion .stage { display:block; width:100%; margin:.55rem 0 0; }
    #form-theme-identity-motion text { fill:var(--foreground); font-family:inherit; }
    #form-theme-identity-motion .muted { fill:var(--muted-foreground); font-size:12px; }
    #form-theme-identity-motion .guide { stroke:var(--border); stroke-width:1; }
    #form-theme-identity-motion .c-line { fill:none; stroke:var(--viz-series-1,var(--primary)); stroke-width:3.4; stroke-linecap:round; stroke-linejoin:round; }
    #form-theme-identity-motion .ghost-line { fill:none; stroke:var(--viz-series-2,var(--primary)); stroke-width:2; stroke-dasharray:4 4; opacity:.55; }
    #form-theme-identity-motion .c-dot { fill:var(--viz-series-1,var(--primary)); stroke:var(--background); stroke-width:1.4; opacity:.5; }
    #form-theme-identity-motion .c-dot.on { fill:var(--foreground); opacity:1; }
    #form-theme-identity-motion .now { stroke:var(--foreground); stroke-width:2.5; }
    #form-theme-identity-motion .status { margin:.25rem 0 0; }
    @media (max-width:620px) { #form-theme-identity-motion .clip-title { display:block; } #form-theme-identity-motion .stage text { font-size:20px; } }
    </style>
    <p class="clip-title"><strong>The theme, as a contour</strong><span>rise · turn back · higher rise · return home</span></p>
    <p class="sr-only">One four-bar melody. It begins low, rises in a small arch and turns back toward its opening, then climbs to a higher peak before descending to a low final note. A second reading changes several pitches but keeps the same broad rise-and-return shape.</p>
    <div class="ab-rows">
      <div class="ab-row"><span class="ab-tag">The theme</span><audio controls preload="none" data-variant="orig"><source src="/guides/listening-studio/musical-forms/audio/melody-original.m4a" type="audio/mp4"></audio><span class="ab-lbl">The tune by itself — learn its shape.</span></div>
      <div class="ab-row"><span class="ab-tag">Same shape</span><audio controls preload="none" data-variant="changed"><source src="/guides/listening-studio/musical-forms/audio/melody-altered.m4a" type="audio/mp4"></audio><span class="ab-lbl">Several pitches changed — still recognizably the same idea.</span></div>
    </div>
    <svg class="stage" viewBox="0 0 760 300" role="img" aria-labelledby="theme-id-title theme-id-desc">
      <title id="theme-id-title">The four-bar theme drawn as a contour</title>
      <desc id="theme-id-desc">A single line rises from a low opening, turns back toward its start, climbs to a higher peak, then descends to a low final note. A faint dashed line shows an alternate reading with several pitches changed but the same overall shape.</desc>
      <text class="muted" x="20" y="60">higher</text>
      <text class="muted" x="20" y="236">lower</text>
      <g class="guides">
        <line class="guide" x1="90" y1="54" x2="734" y2="54"></line>
        <line class="guide" x1="90" y1="98" x2="734" y2="98"></line>
        <line class="guide" x1="90" y1="143" x2="734" y2="143"></line>
        <line class="guide" x1="90" y1="187" x2="734" y2="187"></line>
        <line class="guide" x1="90" y1="232" x2="734" y2="232"></line>
      </g>
      <g class="ghost"></g><g class="contour"></g><g class="dots"></g>
      <line class="now" x1="96" y1="44" x2="96" y2="250"></line>
    </svg>
    <p class="status" aria-hidden="true">The theme begins low and rises in a small arch.</p>
    <p class="sr-only" data-listening-live aria-live="polite">The theme begins low and rises in a small arch.</p>
    <script is:inline>
      (()=>{
        const root=document.getElementById('form-theme-identity-motion'),svg=root.querySelector('.stage'),ns='http://www.w3.org/2000/svg';
        const origAudio=root.querySelector('audio[data-variant="orig"]'),chgAudio=root.querySelector('audio[data-variant="changed"]');
        const dur=8.571,x0=96,x1=724,top=54,bot=232;
        const pts={
          orig:[[0,.18,'the line begins low'],[1.071,.58,'a first rise, then it turns back'],[2.143,.32,'it returns toward the opening'],[4.286,.88,'a higher second rise'],[6.429,.10,'it descends toward the final note'],[8.571,.10,'arrival on the low final note']],
          changed:[[0,.18,'the line begins low'],[1.071,.66,'a first rise, then it turns back'],[2.143,.24,'it returns toward the opening'],[4.286,.96,'a higher second rise'],[6.429,.10,'it descends toward the final note'],[8.571,.10,'arrival on the low final note']]
        };
        const xOf=t=>x0+Math.max(0,Math.min(1,t/dur))*(x1-x0),yOf=y=>bot-y*(bot-top);
        const make=(n,a={})=>{const e=document.createElementNS(ns,n);for(const k in a)e.setAttribute(k,a[k]);return e;};
        const gGhost=svg.querySelector('.ghost'),gLine=svg.querySelector('.contour'),gDots=svg.querySelector('.dots'),now=svg.querySelector('.now'),statusEl=root.querySelector('.status');
        let active=origAudio,variant='orig';
        const build=()=>{
          gGhost.textContent='';gLine.textContent='';gDots.textContent='';
          if(variant==='changed') gGhost.appendChild(make('polyline',{class:'ghost-line',points:pts.orig.map(p=>xOf(p[0]).toFixed(1)+','+yOf(p[1]).toFixed(1)).join(' ')}));
          gLine.appendChild(make('polyline',{class:'c-line',points:pts[variant].map(p=>xOf(p[0]).toFixed(1)+','+yOf(p[1]).toFixed(1)).join(' ')}));
          pts[variant].forEach((p,i)=>gDots.appendChild(make('circle',{class:'c-dot','data-i':i,cx:xOf(p[0]).toFixed(1),cy:yOf(p[1]).toFixed(1),r:'4.5'})));
        };
        const nearest=time=>{const P=pts[variant];let best=P[0],bd=1e9;P.forEach(p=>{const d=Math.abs(time-p[0]);if(d<bd){bd=d;best=p;}});return best[2];};
        const status=time=>(variant==='orig'?'The theme: ':'Same shape, changed pitches: ')+nearest(Math.max(0,Math.min(dur,time||0)))+'.';
        const paint=()=>{
          const time=Math.max(0,Math.min(dur,active.currentTime||0)),x=xOf(time);
          now.setAttribute('x1',x);now.setAttribute('x2',x);
          svg.querySelectorAll('.c-dot').forEach(d=>{const p=pts[variant][+d.dataset.i],on=Math.abs(time-p[0])<0.45;d.classList.toggle('on',on);d.setAttribute('r',on?'6.5':'4.5');});
          statusEl.textContent=status(time);
        };
        const setVariant=a=>{active=a;variant=(a===chgAudio)?'changed':'orig';build();paint();};
        origAudio.addEventListener('play',()=>setVariant(origAudio));
        chgAudio.addEventListener('play',()=>setVariant(chgAudio));
        build();
        window.ListeningVisual.wire({root,audio:origAudio,paint,peers:[origAudio,chgAudio],status:t=>status(t),initialStatus:status(0)});
        window.ListeningVisual.wire({root,audio:chgAudio,paint,peers:[origAudio,chgAudio],status:t=>status(t)});
      })();
    </script>
  </div>
</div>
</div>

