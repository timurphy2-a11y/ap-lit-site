        {start:10,end:20,label:'I0',detail:'inversion',form:row.map(n=>(12-n)%12),copy:'I0: inversion mirrors every interval while retaining the same twelve-tone discipline.'},
        {start:20,end:30,label:'R0',detail:'retrograde',form:[...row].reverse(),copy:'R0: retrograde reads the original ordered row backward.'},
        {start:30,end:40,label:'RI0',detail:'retrograde inversion',form:row.map(n=>(12-n)%12).reverse(),copy:'RI0: retrograde inversion combines the mirror with backward order.'},
        {start:40,end:53.333333,label:'LAYERED',detail:'row forms together',form:row,copy:'Layered conclusion: several row forms overlap, creating denser counterpoint from the same ordered source.'}
      ];
      const make=(name,attrs={})=>{const node=document.createElementNS(ns,name);Object.entries(attrs).forEach(([key,value])=>node.setAttribute(key,value));return node;};
      const text=(parent,value,attrs={})=>{const node=make('text',attrs);node.textContent=value;parent.appendChild(node);return node;};
      const xFor=time=>x0+time/musicalEnd*width;
      row.forEach((pc,index)=>{
