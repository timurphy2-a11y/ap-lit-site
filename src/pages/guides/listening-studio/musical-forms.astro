        root.querySelectorAll('[data-lane]').forEach((n,i)=>n.classList.toggle('active',i===0||i===2||(parts[part].kind==='scherzo'&&i===1)||(parts[part].kind==='trio'&&i===3)));
        const x=xFor(time),now=stage.querySelector('.now');now.setAttribute('x1',x);now.setAttribute('x2',x);
        statusCopy.textContent=status(time);
      };
      window.ListeningVisual.wire({root,audio,paint,peers:[audio],status,initialStatus:status(0)});
    })();
