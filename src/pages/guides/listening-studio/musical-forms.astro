          const y=46+lane*108;
          const points=wave(x,w,y,lane===3?'trio':'scherzo',index+lane).split(' ').filter((_,i)=>i%2===0).join(' ');
          stage.querySelector('.support-lines').appendChild(make('polyline',{class:'support','data-support':index,points}));
        }
        const pulseCount=Math.max(2,Math.round((phrase.end-phrase.start)*1.6));
        for(let p=0;p<pulseCount;p++){
          stage.querySelector('.pulses').appendChild(make('circle',{class:'pulse','data-pulse':index,cx:x+(p+.5)/pulseCount*w,cy:'188',r:'2.7'}));
        }
      });
      const phraseAt=time=>{let i=phrases.findIndex(p=>time<p.end);return i<0?phrases.length-1:i;};
      const partAt=time=>{let i=parts.findIndex(p=>time<p.end);return i<0?parts.length-1:i;};
      const status=time=>phrases[phraseAt(time)].copy,statusCopy=root.querySelector('.status');
      const paint=()=>{
        const time=Math.max(0,Math.min(musicalEnd,audio.currentTime||0)),phrase=phraseAt(time),part=partAt(time);
        root.querySelectorAll('[data-part]').forEach((n,i)=>n.classList.toggle('active',i===part));
