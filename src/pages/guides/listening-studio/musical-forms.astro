        stage.querySelector('.bass').appendChild(make('circle',{class:'bass-dot','data-bass':beat,cx:x.toFixed(2),cy:y.toFixed(2),r:'1.8'}));
      }
      stage.querySelector('.bass').insertBefore(make('polyline',{class:'bass-line',points:bassPoints.join(' ')}),stage.querySelector('.bass').firstChild);
      const phraseAt=time=>Math.min(5,Math.floor(Math.max(0,time)/phraseLength));
      const barAt=time=>Math.min(23,Math.floor(Math.max(0,time)/barLength));
      const status=time=>phrases[phraseAt(time)].copy, statusCopy=root.querySelector('.status');
      const paint=()=>{
        const time=Math.max(0,Math.min(musicalEnd,audio.currentTime||0)),phrase=phraseAt(time),bar=barAt(time);
        root.querySelectorAll('[data-map-phrase], [data-phrase], [data-lead]').forEach(node=>node.classList.toggle('active',Number(node.dataset.mapPhrase??node.dataset.phrase??node.dataset.lead)===phrase));
        root.querySelectorAll('[data-map-bar], [data-bar]').forEach(node=>node.classList.toggle('active',Number(node.dataset.mapBar??node.dataset.bar)===bar));
        const beat=Math.min(96,Math.floor(time/(barLength/4)));
        root.querySelectorAll('[data-bass]').forEach(node=>node.classList.toggle('active',Number(node.dataset.bass)===beat));
        const x=x0+time/musicalEnd*width, now=stage.querySelector('.now');now.setAttribute('x1',x);now.setAttribute('x2',x);
        statusCopy.textContent=status(time);
      };
      window.ListeningVisual.wire({root,audio,paint,peers:[audio],status,initialStatus:status(0)});
    })();
  </script>
