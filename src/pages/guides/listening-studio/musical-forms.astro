        text(stage.querySelector('.harmony-cells'),harmony,{x:(x+w/2).toFixed(2),y:'284','text-anchor':'middle'});
      });
      const bassPoints=[];
      for(let beat=0;beat<=96;beat++){
        const x=x0+beat*width/96,y=366-(beat%4)*7+(beat%8===7?12:0);
