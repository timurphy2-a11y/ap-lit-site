      const marks=[...root.querySelectorAll('.pressure-mark')];
      const cues=[
        [0,166,170],[4.5,216,148],[9.5,271,123],[14,326,96],[18.5,410,102],
        [23.5,487,143],[28,560,190],[32,638,220],[35,526,205],[37.4,382,142]
      ];
      const length=trace.getTotalLength();
      const clamp=value=>Math.max(0,Math.min(1,value));
      const locate=time=>{
        for(let index=1;index<cues.length;index+=1){
          const [end,endX,endY]=cues[index];
          if(time<=end){
            const [start,startX,startY]=cues[index-1],mix=clamp((time-start)/(end-start));
