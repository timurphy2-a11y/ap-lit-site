  <p id="direct-detail" class="copy">The image is drawn by the recording’s actual playback time: the broad field stops, then the violin’s gestures trace one at a time.</p>

  <script is:inline>
    (() => {
      const root = document.getElementById('scheherazade-color-direct-motion');
      const audio = root.querySelector('#direct-audio');
      const orchestra = root.querySelector('#direct-orchestra');
      const orchestraPaths = Array.from(orchestra.querySelectorAll('.orchestra-thread'));
      const gestures = Array.from(root.querySelectorAll('.violin-gesture'));
      const status = root.querySelector('#direct-status');
      const clamp = (value) => Math.min(1, Math.max(0, value));
      const pathLengths = new Map();

      [...orchestraPaths, ...gestures.flatMap((gesture) => Array.from(gesture.querySelectorAll('.violin-line')))].forEach((path) => {
        pathLengths.set(path, path.getTotalLength());
      });

      const draw = (paths, progress) => {
        paths.forEach((path) => {
          const length = pathLengths.get(path);
          path.style.strokeDasharray = String(length);
          path.style.strokeDashoffset = String(length * (1 - progress));
        });
      };
      const update = () => {
        const time = audio.currentTime;
        const orchestraProgress = clamp(time / 9.5);
        orchestra.dataset.state = time < 9.5 ? 'current' : 'past';
        draw(orchestraPaths, orchestraProgress);
        gestures.forEach((gesture) => {
          const start = Number(gesture.dataset.start);
          const end = Number(gesture.dataset.end);
          const progress = clamp((time - start) / (end - start));
          const paths = Array.from(gesture.querySelectorAll('.violin-line'));
          draw(paths, progress);
          gesture.querySelectorAll('.violin-note').forEach((note, index, notes) => {
            note.style.opacity = String(clamp(progress * notes.length - index + 1));
          });
          gesture.dataset.state = time < start ? 'future' : time <= end ? 'current' : 'past';
        });
        if (time < 9.5) status.textContent = 'the orchestra opens in a broad field';
        else if (time < 10.55) status.textContent = 'the field clears';
        else if (time < 34) status.textContent = 'the solo violin traces a finer line';
        else status.textContent = 'the violin line reaches silence';
      };
      const phase = time => {
        if (time < 9.5) return 'The orchestra opens in a broad field.';
        if (time < 10.55) return 'The orchestral field clears.';
        if (time < 34) return 'The solo violin traces a finer line.';
        return 'The violin line reaches silence.';
      };
      window.ListeningVisual.wire({root,audio,paint:update,status:phase,initialStatus:phase(0)});
