function step(){
  let any=false;
  document.querySelectorAll('audio').forEach(a=>{ if(!a.paused){any=true; drawLens(a.dataset.lens);} });
  if(any) requestAnimationFrame(step); else rafRunning=false;
}

function activeAudioFor(lens){
  const variant=lensLastVariant[lens];
  const list=document.querySelectorAll('audio[data-lens="'+lens+'"]');
  if(!list.length) return null;
  if(variant){ for(const a of list){ if(a.dataset.variant===variant) return a; } }
  return list[0];
}

function setAnnounce(lens,text){
  const el=document.querySelector('[data-announce="'+lens+'"]');
  if(el) el.textContent = text ? 'Now: '+text : '';
}

function drawLens(lens){
  if(!lens) return;
  const canvas=document.querySelector('canvas[data-lens-canvas="'+lens+'"]');
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  const w=canvas.width,h=canvas.height;
  const acc=getComputedStyle(document.body).getPropertyValue('--acc').trim()||'#6F5E95';
  const ink=getComputedStyle(document.body).getPropertyValue('--ink-mute').trim()||'#4a4138';
  const rule=getComputedStyle(document.body).getPropertyValue('--rule').trim()||'#C9BDA5';
  ctx.clearRect(0,0,w,h);
  const audio=activeAudioFor(lens);
  const variant=lensLastVariant[lens];
  const t = audio ? audio.currentTime : 0;
  if(lens==='melody') drawMelody(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='rhythm') drawRhythm(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='timbre') drawTimbre(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='texture') drawTexture(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='harmony') drawHarmony(ctx,w,h,acc,ink,rule,variant,t);
  else if(lens==='form') drawForm(ctx,w,h,acc,ink,rule,variant,t);
}

function playhead(ctx,w,h,x,acc,glow){
  if(glow && !REDUCED){ ctx.save(); ctx.shadowColor=acc; ctx.shadowBlur=8; }
  ctx.strokeStyle=acc; ctx.lineWidth=2; ctx.beginPath(); ctx.moveTo(x,6); ctx.lineTo(x,h-6); ctx.stroke();
  ctx.beginPath(); ctx.arc(x,6,3,0,7); ctx.fillStyle=acc; ctx.fill();
  if(glow && !REDUCED) ctx.restore();
}

function nearestLabel(list,t,keyT,keyLabel){
  let cur=null;
  list.forEach(item=>{ if(item[keyT]<=t+0.01) cur=item; });
  return cur ? cur[keyLabel] : null;
}

function drawMelody(ctx,w,h,acc,ink,rule,variant,t){
  const dur=TIMING.melody.duration;
  const pts = TIMING.melody.points[variant]||TIMING.melody.points.orig;
  const pad=44, top=22, bot=h-30;
  const xOf=tt=>pad+(tt/dur)*(w-pad-16);
  const yOf=y=>bot-(y*(bot-top));
  ctx.font='10px IBM Plex Mono, monospace'; ctx.textAlign='right'; ctx.textBaseline='middle';
  for(let g=0; g<=1; g+=0.25){
    const y=yOf(g);
    ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(w-16,y); ctx.stroke();
  }
  ctx.beginPath(); ctx.moveTo(xOf(pts[0].t), bot);
  pts.forEach(p=>ctx.lineTo(xOf(p.t), yOf(p.y)));
  ctx.lineTo(xOf(pts[pts.length-1].t), bot); ctx.closePath();
  ctx.fillStyle='color-mix(in oklab, '+acc+' 12%, transparent)'; ctx.fill();
  ctx.strokeStyle=ink; ctx.lineWidth=1.6; ctx.lineJoin='round'; ctx.beginPath();
  pts.forEach((p,i)=>{ const x=xOf(p.t), y=yOf(p.y); if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
  ctx.stroke();
  if(variant==='changed'){
    const orig=TIMING.melody.points.orig;
    ctx.strokeStyle='color-mix(in oklab, '+acc+' 55%, '+ink+' 15%)'; ctx.setLineDash([3,3]); ctx.lineWidth=1.2;
    orig.forEach((p,i)=>{ if(i===0||i===orig.length-1) return; const x=xOf(p.t); ctx.beginPath(); ctx.moveTo(x,yOf(p.y)); ctx.lineTo(x,yOf(pts[i].y)); ctx.stroke(); });
    ctx.setLineDash([]);
  }
  pts.forEach(p=>{
    const x=xOf(p.t), y=yOf(p.y);
    const near = variant && Math.abs(t-p.t)<0.18;
    ctx.beginPath(); ctx.arc(x,y, near?6:4.5,0,7);
    ctx.fillStyle= near? acc : 'color-mix(in oklab, '+acc+' 75%, '+ink+' 15%)'; ctx.fill();
    ctx.strokeStyle='#fff'; ctx.lineWidth=1; ctx.stroke();
  });
  if(variant){ playhead(ctx,w,h,xOf(Math.min(t,dur)),acc,true); setAnnounce('melody', nearestLabel(pts,t,'t','label')); }
}

function drawRhythm(ctx,w,h,acc,ink,rule,variant,t){
  const data = variant==='even' ? TIMING.rhythm.even : TIMING.rhythm.shaped;
  const totalDur = variant==='even' ? TIMING.rhythm.even.duration : TIMING.rhythm.shaped.duration;
  const pad=20, top=34, bot=h-56;
  const xOf=tt=>pad+(tt/totalDur)*(w-2*pad);
  data.segments.forEach(seg=>{
    const x=xOf(seg.t0), bw=Math.max(xOf(seg.t1)-x,3);
    if(seg.type==='space'){
      ctx.strokeStyle=rule; ctx.setLineDash([3,3]); ctx.lineWidth=1;
      ctx.strokeRect(x,top,bw,bot-top); ctx.setLineDash([]);
    } else {
      const sounding = variant && t>=seg.t0 && t<seg.t1;
      ctx.fillStyle= sounding? acc : 'color-mix(in oklab, '+acc+' 65%, white)';
      ctx.fillRect(x,top,bw,bot-top);
      ctx.fillStyle=ink; ctx.beginPath(); ctx.moveTo(x,top-2); ctx.lineTo(x+6,top-2); ctx.lineTo(x,top+8); ctx.closePath(); ctx.fill();
    }
  });
  if(variant==='even' && data.phraseEnd<totalDur){
    const x=xOf(data.phraseEnd), ex=xOf(totalDur);
    ctx.strokeStyle=rule; ctx.setLineDash([2,3]); ctx.lineWidth=1; ctx.strokeRect(x,top,ex-x,bot-top); ctx.setLineDash([]);
    ctx.font='9px IBM Plex Mono, monospace'; ctx.fillStyle=ink; ctx.globalAlpha=0.55; ctx.textAlign='center';
    ctx.fillText('silence', (x+ex)/2, top+(bot-top)/2+3); ctx.globalAlpha=1;
  }
  ctx.font='9px IBM Plex Mono, monospace'; ctx.textAlign='center'; ctx.fillStyle=ink; ctx.globalAlpha=0.5;
  for(let i=0;i*1.0<=totalDur;i++){
    const x=xOf(i); ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(x,bot+8); ctx.lineTo(x,bot+16); ctx.stroke();
  }
  ctx.globalAlpha=1;
  if(variant){
    playhead(ctx,w,h,xOf(Math.min(t,totalDur)),acc,true);
    let label = null;
    if(variant==='even' && t>=data.phraseEnd) label = data.silenceLabel;
    else label = nearestLabel(data.segments.filter(s=>s.type==='note'||true),t,'t0','label');
    setAnnounce('rhythm', label);
  }
}

const TIMBRE_PROFILES={
  reedy:{cycles:6,shape:'square',bars:[1,0.08,0.62,0.05,0.42,0.04,0.3,0.04]},
  brass:{cycles:7,shape:'brass',bars:[1,0.78,0.66,0.58,0.5,0.42,0.36,0.3]},
  mallet:{cycles:5,shape:'decay',bars:[1,0.1,0.42,0.06,0.08,0.03,0.02,0.01]}
};
function drawTimbre(ctx,w,h,acc,ink,rule,variant,t){
  const key = variant||'reedy';
  const prof=TIMBRE_PROFILES[key];
  const wfMid=64, wfW=w-40;
  ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(20,wfMid); ctx.lineTo(w-20,wfMid); ctx.stroke();
  ctx.strokeStyle= variant? acc:'color-mix(in oklab, '+acc+' 40%, white)'; ctx.lineWidth=1.8; ctx.beginPath();
  const anim = (variant && !REDUCED)? t*4:0;
  for(let i=0;i<=wfW;i+=2){
    const phase=(i/wfW)*prof.cycles*2*Math.PI + anim;
    let y;
    if(prof.shape==='brass'){ y=Math.sin(phase)+0.3*Math.sin(2*phase)+0.15*Math.sin(3*phase); }
    else if(prof.shape==='decay'){ y=Math.sin(phase)*Math.exp(-((i/wfW)%0.34)*2.2); }
    else { y=Math.sign(Math.sin(phase))*0.7 + 0.3*Math.sin(phase); }
    ctx.lineTo(20+i, wfMid - y*26);
  }
  ctx.stroke();
  const specTop=110, specBot=h-16, barW=(w-60)/8;
  ctx.font='9px IBM Plex Mono, monospace'; ctx.textAlign='center'; ctx.fillStyle=ink;
  prof.bars.forEach((amp,i)=>{
    const x=40+i*barW;
    let a=amp;
    if(!REDUCED){
      if(key==='mallet' && variant) a*=0.7+0.3*Math.abs(Math.sin(t*6+i));
      if(key==='brass' && variant) a*=0.85+0.15*Math.sin(t*10+i*0.5);
    }
    const bh=(specBot-specTop)*a;
    ctx.fillStyle= variant? 'color-mix(in oklab, '+acc+' '+(40+a*55)+'%, white)':'color-mix(in oklab, '+acc+' 25%, white)';
    ctx.fillRect(x,specBot-bh,barW-4,bh);
    ctx.globalAlpha=0.6; ctx.fillText(String(i+1), x+(barW-4)/2, specBot+11); ctx.globalAlpha=1;
  });
  ctx.textAlign='left'; ctx.fillStyle=ink; ctx.globalAlpha=0.6; ctx.font='9px IBM Plex Mono, monospace';
  ctx.fillText('OVERTONE SERIES', 40, 100); ctx.globalAlpha=1;
  if(variant) playhead(ctx,w,h,20+(Math.min(t,TIMING.timbre.duration)/TIMING.timbre.duration)*wfW,acc,true);
}

function drawTexture(ctx,w,h,acc,ink,rule,variant,t){
  const dur=TIMING.texture.duration, lanes=TIMING.texture.lanes;
  const pad=20, laneH=(h-30)/4;
  const xOf=tt=>pad+(tt/dur)*(w-pad-90);
  let currentLabel=null;
  lanes.forEach((lane,li)=>{
    const y0=10+li*laneH;
    const active = variant && t>=lane.start;
    ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(pad,y0+laneH-4); ctx.lineTo(w-90,y0+laneH-4); ctx.stroke();
    ctx.font='10px IBM Plex Sans, sans-serif'; ctx.textAlign='left'; ctx.textBaseline='middle';
    ctx.fillStyle= active? ink:'color-mix(in oklab, '+ink+' 35%, transparent)';
    ctx.fillText(lane.label, w-84, y0+laneH/2-4);
    if(!active) return;
    if(currentLabel===null || lane.start>0) if(Math.abs(t-lane.start)<0.3) currentLabel=lane.announce;
    const yMid=y0+laneH/2, xStart=xOf(lane.start), xEnd=xOf(dur);
    ctx.strokeStyle=acc; ctx.lineWidth=1.6; ctx.beginPath();
    if(lane.key==='main'){
      for(let x=xStart;x<=xEnd;x+=4){ const p=(x-xStart)/(xEnd-xStart||1); const y=yMid-Math.sin(p*Math.PI*2)*8; if(x===xStart) ctx.moveTo(x,y); else ctx.lineTo(x,y); }
    } else if(lane.key==='foundation'){
      ctx.moveTo(xStart,yMid); ctx.lineTo(xEnd,yMid); ctx.lineWidth=4;
    } else if(lane.key==='pulse'){
      let up=true; for(let x=xStart;x<=xEnd;x+=10){ const y=up?yMid-7:yMid+7; if(x===xStart) ctx.moveTo(x,y); else ctx.lineTo(x,y); up=!up; }
    } else {
      ctx.setLineDash([4,3]);
      for(let x=xStart;x<=xEnd;x+=4){ const p=(x-xStart)/(xEnd-xStart||1); const y=yMid-Math.sin(p*Math.PI*3)*9; if(x===xStart) ctx.moveTo(x,y); else ctx.lineTo(x,y); }
    }
    ctx.stroke(); ctx.setLineDash([]);
  });
  if(variant){ playhead(ctx,w,h,xOf(Math.min(t,dur)),acc,true); setAnnounce('texture', nearestLabel(lanes.map(l=>({t:l.start,label:l.announce})),t,'t','label')); }
}

function drawHarmony(ctx,w,h,acc,ink,rule,variant,t){
  const data = TIMING.harmony[variant]||TIMING.harmony.return;
  const stops=data.stops, tension=data.tension;
  const pad=44, baseY=h-40, n=stops.length, arcTop=30;
  const xOf=i=>pad+i*((w-2*pad)/(n-1));
  const yOf=i=>baseY-tension[i]*(baseY-arcTop);
  ctx.strokeStyle='color-mix(in oklab, '+acc+' 55%, white)'; ctx.lineWidth=2; ctx.beginPath();
  stops.forEach((s,i)=>{ const x=xOf(i),y=yOf(i); if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y); });
  ctx.stroke();
  ctx.font='9px IBM Plex Mono, monospace'; ctx.textAlign='center'; ctx.fillStyle=ink; ctx.globalAlpha=0.6;
  ctx.fillText('TENSION', pad, arcTop-12); ctx.globalAlpha=1;
  let activeIdx=-1;
  if(variant) stops.forEach((s,i)=>{ if(t>=s.t) activeIdx=i; });
  stops.forEach((s,i)=>{
    const x=xOf(i), y=baseY, isHome=s.lab==='D', isLast=i===n-1;
    ctx.strokeStyle=rule; ctx.lineWidth=1; ctx.beginPath(); ctx.moveTo(x,y); ctx.lineTo(x,yOf(i)); ctx.setLineDash([2,2]); ctx.stroke(); ctx.setLineDash([]);
    ctx.beginPath(); ctx.arc(x,y,15,0,7);
    ctx.fillStyle = i===activeIdx ? acc : (isHome? 'color-mix(in oklab, '+acc+' 18%, white)' : '#fff');
    ctx.fill(); ctx.strokeStyle= isHome? acc : ink; ctx.lineWidth=isHome?2.4:1.4; ctx.stroke();
    ctx.fillStyle= i===activeIdx? '#fff':ink; ctx.font='13px IBM Plex Mono, monospace'; ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(s.lab,x,y);
    if(isLast){ ctx.font='16px IBM Plex Sans, sans-serif'; ctx.fillStyle=ink; ctx.fillText(isHome?'\u2713':'\u2013', x, y+30); }
    if(isHome && i===0){ ctx.font='10px IBM Plex Mono, monospace'; ctx.fillStyle=acc; ctx.fillText('HOME',x,y+34); }
  });
  if(variant) setAnnounce('harmony', activeIdx>=0 ? stops[activeIdx].label : null);
}

function hatch(ctx,x,y,w,h,spacing,color,angle){
  ctx.save(); ctx.beginPath(); ctx.rect(x,y,w,h); ctx.clip();
  ctx.strokeStyle=color; ctx.lineWidth=1.2;
  const len=Math.hypot(w,h)*2;
  for(let d=-len;d<len;d+=spacing){
    ctx.beginPath();
    if(angle==='cross'){ ctx.moveTo(x+d,y-len); ctx.lineTo(x+d+len,y+len); }
    else { ctx.moveTo(x,y+d); ctx.lineTo(x+len,y+d+len); }
    ctx.stroke();
  }
  ctx.restore();
}
function drawForm(ctx,w,h,acc,ink,rule,variant,t){
  const total=TIMING.form.duration, sections=TIMING.form.sections;
  const pad=16, top=30, bot=h-56;
  sections.forEach(sec=>{
    const x=pad+(sec.start/total)*(w-2*pad), bw=((sec.end-sec.start)/total)*(w-2*pad);
    const isB = sec.id==='B';
    ctx.fillStyle='color-mix(in oklab, '+acc+' 20%, white)';
    ctx.fillRect(x,top,bw-3,bot-top);
    if(isB) hatch(ctx,x,top,bw-3,bot-top,7,'color-mix(in oklab, '+acc+' 55%, white)','cross');
    else hatch(ctx,x,top,bw-3,bot-top,16-sec.density*3.5,'color-mix(in oklab, '+acc+' 60%, white)');
    const active = variant && t>=sec.start && t<sec.end;
    if(active){ ctx.strokeStyle=acc; ctx.lineWidth=2.5; ctx.strokeRect(x+1,top+1,bw-5,bot-top-2); }
    ctx.fillStyle=ink; ctx.font='13px IBM Plex Sans, sans-serif'; ctx.textAlign='center'; ctx.textBaseline='middle';
    ctx.fillText(sec.lab, x+bw/2, top-14);
    if(sec.id==='App'){ ctx.font='9px IBM Plex Mono, monospace'; ctx.fillStyle=ink; ctx.textBaseline='alphabetic'; ctx.fillText('ALTERED ENDING', x+bw/2, bot+16); }
  });
  if(variant) playhead(ctx,w,h,pad+(Math.min(t,total)/total)*(w-2*pad),ink,true);
  if(variant) setAnnounce('form', nearestLabel(sections.map(s=>({t:s.start,label:s.label})),t,'t','label'));
}

// ---- Form section seek buttons ----
const formAudio=document.getElementById('form-audio');
document.querySelectorAll('[data-seek-form]').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const sec=TIMING.form.sections.find(s=>s.id===btn.dataset.seekForm);
    if(!sec||!formAudio) return;
    document.querySelectorAll('audio').forEach(a=>{if(a!==formAudio && !a.paused) a.pause();});
    formAudio.currentTime=sec.start;
    lensLastVariant.form='full'; hasPlayed.form=true; updateToggleLabel('form');
    formAudio.play();
  });
});

// ---- Toggle "show visual guide" panels ----
function updateToggleLabel(lens){
  const btn=document.querySelector('#lens-'+lens+' .guide-toggle');
  if(!btn) return;
  const open = btn.getAttribute('aria-expanded')==='true';
  const span=btn.querySelector('.gtxt');
  span.textContent = open ? 'Hide visual guide' : (hasPlayed[lens] ? 'Replay with the visual guide' : 'Show visual guide');
}
document.querySelectorAll('.guide-toggle').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const open = btn.getAttribute('aria-expanded')==='true';
    btn.setAttribute('aria-expanded', String(!open));
    const panel=document.getElementById(btn.getAttribute('aria-controls'));
    panel.classList.toggle('open', !open);
    const lens = panel.id.replace('guide-','');
    if(!open){ drawLens(lens); }
    const span=btn.querySelector('.gtxt');
    span.textContent = !open ? 'Hide visual guide' : (hasPlayed[lens] ? 'Replay with the visual guide' : 'Show visual guide');
  });
});
})();
</script>

<script is:inline>
(function(){
  const detail=document.getElementById('lens-detail'),dThread=document.getElementById('dThread');
  const wraps=[...document.querySelectorAll('.lens-wrap')],cards=[...document.querySelectorAll('.ocard')];
  const threadName={rhythm:'Structure & Freedom',form:'Structure & Freedom',timbre:'Texture & Voices',texture:'Texture & Voices',melody:'Consonance & Dissonance',harmony:'Consonance & Dissonance'};
  function stopAll(){document.querySelectorAll('audio').forEach(a=>{if(!a.paused)a.pause();});}
  function openLens(key){stopAll();detail.classList.remove('is-hidden');wraps.forEach(w=>w.classList.toggle('is-hidden',w.dataset.lens!==key));cards.forEach(c=>{const on=c.dataset.lens===key;c.classList.toggle('on',on);c.setAttribute('aria-pressed',on?'true':'false');});dThread.textContent=threadName[key]||'';}
  function closeLens(){stopAll();detail.classList.add('is-hidden');wraps.forEach(w=>w.classList.add('is-hidden'));cards.forEach(c=>{c.classList.remove('on');c.setAttribute('aria-pressed','false');});}
  cards.forEach(c=>{c.setAttribute('aria-pressed','false');c.addEventListener('click',()=>{c.classList.contains('on')?closeLens():openLens(c.dataset.lens);});});
  document.getElementById('dClose').addEventListener('click',closeLens);
  const h=(location.hash||'').replace('#lens-','');
  if(threadName[h]) openLens(h);
})();
</script>

