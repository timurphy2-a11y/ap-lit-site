  <script is:inline>
    (() => {
      const root=document.getElementById('timbre-material-signatures-motion');
      const audio=root.querySelector('audio');
      const source=audio.querySelector('source');
      const detail=root.querySelector('.selected-detail');
      const buttons=[...root.querySelectorAll('[data-select]')];
      const now=root.querySelector('.now');
      const nowLabel=root.querySelector('.now-label');
      const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
      const ns='http://www.w3.org/2000/svg';
      const clipDuration=8.571;
      const secondsPerBeat=60/112;
      const noteMap=[
        [0,1.45,62],[1.75,.25,65],[2.1,.25,67],[2.5,.78,69],[3.45,.4,67],
        [4,1.25,64],[5.5,.25,65],[5.85,.25,64],[6.35,1.25,62],
        [8,1.4,65],[9.7,.25,69],[10.05,.25,70],[10.45,1.05,72],[11.7,.45,69],
        [12.5,.85,67],[13.65,.25,64],[14.25,1.55,62]
      ];
      const events=noteMap.map(([start,length,pitch],index)=>({index,pitch,start:start*secondsPerBeat,end:(start+length)*secondsPerBeat}));
      const files={
        flute:'question-answer-return--flute.m4a',
        trumpet:'question-answer-return--trumpet.m4a',
        vibraphone:'question-answer-return--vibraphone.m4a'
      };
      const names={flute:'Flute',trumpet:'Trumpet',vibraphone:'Vibraphone'};
      const descriptions={
        flute:'airy entrance · light, continuous sustain',
        trumpet:'immediate entrance · focused, projecting sustain',
        vibraphone:'clear strike · resonance that blooms and fades'
      };
      const laneCenters={flute:92,trumpet:180,vibraphone:268};
      let selected='flute';
      const make=(name,attrs={})=>{const element=document.createElementNS(ns,name);Object.entries(attrs).forEach(([key,value])=>element.setAttribute(key,value));return element;};
      const xFor=time=>132+Math.max(0,Math.min(1,time/clipDuration))*596;
      const yFor=(instrument,pitch)=>laneCenters[instrument]-((pitch-62)/10)*34;

      [2.143,4.286,6.429].forEach(time=>{
        const x=xFor(time);
        root.querySelector('.measure-guides').appendChild(make('line',{class:'measure-guide',x1:x.toFixed(2),y1:'40',x2:x.toFixed(2),y2:'304'}));
      });

      events.forEach(event=>{
        const x=xFor(event.start),end=xFor(Math.min(clipDuration,event.end)),width=Math.max(5,end-x);

        const fluteY=yFor('flute',event.pitch),flute=root.querySelector('[data-marks="flute"]');
        flute.appendChild(make('line',{class:'flute-halo',x1:(x+3).toFixed(2),y1:fluteY.toFixed(2),x2:end.toFixed(2),y2:fluteY.toFixed(2)}));
        flute.appendChild(make('line',{class:'flute-core','data-event':event.index,x1:(x+3).toFixed(2),y1:fluteY.toFixed(2),x2:end.toFixed(2),y2:fluteY.toFixed(2)}));
        flute.appendChild(make('circle',{class:'breath',cx:(x-1).toFixed(2),cy:(fluteY-7).toFixed(2),r:'2.4'}));
        flute.appendChild(make('circle',{class:'breath',cx:(x+4).toFixed(2),cy:(fluteY+8).toFixed(2),r:'1.8'}));

        const trumpetY=yFor('trumpet',event.pitch),trumpet=root.querySelector('[data-marks="trumpet"]');
        trumpet.appendChild(make('path',{class:'trumpet-mark','data-event':event.index,d:`M${x.toFixed(2)} ${trumpetY.toFixed(2)} L${(x+8).toFixed(2)} ${(trumpetY-9).toFixed(2)} L${end.toFixed(2)} ${(trumpetY-6).toFixed(2)} L${end.toFixed(2)} ${(trumpetY+6).toFixed(2)} L${(x+8).toFixed(2)} ${(trumpetY+9).toFixed(2)} Z`}));
        trumpet.appendChild(make('line',{class:'trumpet-ray',x1:(x+4).toFixed(2),y1:(trumpetY-13).toFixed(2),x2:Math.min(728,end+7).toFixed(2),y2:(trumpetY-11).toFixed(2)}));

        const vibraphoneY=yFor('vibraphone',event.pitch),vibraphone=root.querySelector('[data-marks="vibraphone"]');
        vibraphone.appendChild(make('path',{class:'vibraphone-tail',d:`M${x.toFixed(2)} ${(vibraphoneY-5).toFixed(2)} L${end.toFixed(2)} ${(vibraphoneY-2).toFixed(2)} L${end.toFixed(2)} ${(vibraphoneY+2).toFixed(2)} L${x.toFixed(2)} ${(vibraphoneY+5).toFixed(2)} Z`}));
        vibraphone.appendChild(make('circle',{class:'vibraphone-head','data-event':event.index,cx:x.toFixed(2),cy:vibraphoneY.toFixed(2),r:'6.5'}));
        vibraphone.appendChild(make('circle',{class:'resonance','data-ring':event.index,cx:x.toFixed(2),cy:vibraphoneY.toFixed(2),r:'12'}));
      });

      const activeEvent=time=>events.find(event=>time>=event.start&&time<=event.end);
      const phrase=time=>time<2.143?'the first rise':time<4.286?'the return toward the starting pitch':time<6.429?'the higher answering arch':'the final descent';
      const paint=()=>{
        const time=Math.max(0,Math.min(clipDuration,audio.currentTime||0)),x=xFor(time),current=activeEvent(time);
        root.querySelectorAll('.lane').forEach(lane=>lane.classList.toggle('active',lane.dataset.lane===selected));
        root.querySelectorAll('[data-event]').forEach(mark=>mark.classList.toggle('current',Boolean(current)&&Number(mark.dataset.event)===current.index));
        root.querySelectorAll('.flute-core').forEach(mark=>{
          if(!mark.classList.contains('current')||selected!=='flute'){mark.style.transform='';return;}
          const breath=reduced.matches?1.08:1.08+Math.sin(time*6)*.045;
          mark.style.transform=`scaleY(${breath.toFixed(3)})`;
        });
        root.querySelectorAll('.trumpet-mark').forEach(mark=>{
          if(!mark.classList.contains('current')||selected!=='trumpet'){mark.style.transform='';return;}
          const projection=reduced.matches?1.03:1.03+Math.sin(time*9)*.025;
          mark.style.transform=`scaleX(${projection.toFixed(3)})`;
        });
        root.querySelectorAll('[data-ring]').forEach(ring=>{
          const event=events[Number(ring.dataset.ring)],age=time-event.start;
          if(selected!=='vibraphone'||age<0||age>.9){ring.style.transform='';ring.style.opacity='.16';return;}
          const bloom=1+Math.min(1,age/.9)*.9;
          ring.style.transform=`scale(${bloom.toFixed(3)})`;
          ring.style.opacity=String(Math.max(.08,.62-age*.58));
        });
        now.setAttribute('x1',x.toFixed(2));
        now.setAttribute('x2',x.toFixed(2));
        nowLabel.setAttribute('x',x.toFixed(2));
      };
      const status=time=>`${names[selected]} selected. The shared phrase is in ${phrase(time)}.`;
      const controller=window.ListeningVisual.wire({root,audio,paint,status,initialStatus:status(0)});
      const choose=instrument=>{
        selected=instrument;
        controller.stop();
        audio.pause();
        source.src="/guides/listening-studio/audio/viz/"+files[instrument];
        audio.load();
        buttons.forEach(button=>button.setAttribute('aria-pressed',String(button.dataset.select===instrument)));
        detail.innerHTML=`<strong>${names[instrument]}</strong> · ${descriptions[instrument]}`;
        controller.render();
      };
      buttons.forEach(button=>button.addEventListener('click',()=>choose(button.dataset.select)));
    })();
  </script>
  <p class="model-note">Simplified listening model: vertical position shows the shared pitch direction; shapes suggest contrasting attack, sustain, and decay rather than literal sound waves.</p>
