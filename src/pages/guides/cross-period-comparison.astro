<script is:inline>
(function(){
 // simple guide-units (controlled studies, no work-selector)
 document.querySelectorAll('.guide-unit[data-simple]').forEach(function(unit){
  var btn=unit.querySelector('[data-role="guide"]');
  if(!btn)return;
  btn.addEventListener('click',function(){
   var on=btn.getAttribute('aria-pressed')!=='true';
   btn.setAttribute('aria-pressed',String(on));
   btn.setAttribute('aria-expanded',String(on));
   btn.querySelector('.gt-label').textContent=on?'Hide visual guide':'Show visual guide';
   unit.classList.toggle('guided',on);
   var cap=unit.querySelector(':scope > .caption,:scope > .study-body > .caption');
   var key=unit.querySelector('.guide-key');
   if(cap)cap.hidden=!on;
   if(key)key.hidden=!on;
   var sr=unit.querySelector('.sr-only[data-unmarked]');
   if(sr){var guided=sr.getAttribute('data-guided'),unmarked=sr.getAttribute('data-unmarked');sr.textContent=on?guided:unmarked;}
  });
 });
 // real-art sections with a mutually-exclusive work selector (guide + independent source-context toggle)
 document.querySelectorAll('.realart[data-selector]').forEach(function(section){
  var buttons=[].slice.call(section.querySelectorAll('.work-select [data-work]'));
  var panels=[].slice.call(section.querySelectorAll('[data-panel]'));
  var guideBtn=section.querySelector('[data-role="guide"]');
  var sourceBtn=section.querySelector('[data-role="source"]');
  var sr=section.querySelector('.sr-only[data-desc]');
  var active=buttons.length?buttons[0].dataset.work:null;
  function panelFor(name){return section.querySelector('[data-panel="'+name+'"]');}
  function resetControls(){
   if(guideBtn){
    guideBtn.setAttribute('aria-pressed','false');
    guideBtn.setAttribute('aria-expanded','false');
    var gl=guideBtn.querySelector('.gt-label');if(gl)gl.textContent='Show visual guide';
   }
   if(sourceBtn){
    sourceBtn.setAttribute('aria-expanded','false');
    sourceBtn.textContent='Show source context';
   }
   panels.forEach(function(p){
    p.classList.remove('guided');
    var cap=p.querySelector('[data-caption]');if(cap)cap.hidden=true;
    var key=p.querySelector('[data-guide-key]');if(key)key.hidden=true;
    var gd=p.querySelector('[data-guided-detail]');if(gd)gd.hidden=true;
    var src=p.querySelector('[data-source]');if(src)src.hidden=true;
   });
  }
  function selectWork(name){
   active=name;
   buttons.forEach(function(b){b.setAttribute('aria-pressed',String(b.dataset.work===name));});
   panels.forEach(function(p){p.hidden=p.dataset.panel!==name;});
   resetControls();
   if(sr){var p=panelFor(name);sr.textContent=p.getAttribute('data-desc-unmarked')||'';}
  }
  buttons.forEach(function(b){b.addEventListener('click',function(){selectWork(b.dataset.work);});});
  if(guideBtn){
   guideBtn.addEventListener('click',function(){
    var on=guideBtn.getAttribute('aria-pressed')!=='true';
    var p=panelFor(active);
    guideBtn.setAttribute('aria-pressed',String(on));
    guideBtn.setAttribute('aria-expanded',String(on));
    var gl=guideBtn.querySelector('.gt-label');if(gl)gl.textContent=on?'Hide visual guide':'Show visual guide';
    p.classList.toggle('guided',on);
    var cap=p.querySelector('[data-caption]');if(cap)cap.hidden=!on;
    var key=p.querySelector('[data-guide-key]');if(key)key.hidden=!on;
    var gd=p.querySelector('[data-guided-detail]');if(gd)gd.hidden=!on;
    if(sr)sr.textContent=(on?p.getAttribute('data-desc-guided'):p.getAttribute('data-desc-unmarked'))||'';
   });
  }
  if(sourceBtn){
   sourceBtn.addEventListener('click',function(){
    var on=sourceBtn.getAttribute('aria-expanded')!=='true';
    var p=panelFor(active);
    var src=p.querySelector('[data-source]');
    sourceBtn.setAttribute('aria-expanded',String(on));
    sourceBtn.textContent=on?'Hide source context':'Show source context';
    if(src)src.hidden=!on;
   });
  }
 });
 // takeaway toggles (shared pattern, wording preserved by data-kind)
 document.querySelectorAll('[data-role="takeaway"]').forEach(function(btn){
  btn.addEventListener('click',function(){
   var wrap=btn.closest('.takeaway-wrap'),p=wrap.querySelector('.takeaway'),on=p.hidden;
   p.hidden=!on;
   btn.setAttribute('aria-expanded',String(on));
   var kind=btn.dataset.kind||'concept';
   btn.textContent=on?('Hide takeaway '+kind):('Show takeaway '+kind);
  });
 });
 // lens choosers: each .chooser-group manages its own detail panel; one open at a time, within that group
 function soft(){return window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth';}
 document.querySelectorAll('.chooser-group').forEach(function(group){
  var detail=group.querySelector('.lens-detail');
  if(!detail)return;
  var dThread=detail.querySelector('.dthread'),dClose=detail.querySelector('.detail-close');
  var cards=[].slice.call(group.querySelectorAll('.ocard')),wraps=[].slice.call(detail.querySelectorAll('.lens-wrap'));
  function open(id){
   cards.forEach(function(c){c.classList.toggle('on',c.dataset.lens===id);});
   wraps.forEach(function(w){w.classList.toggle('is-hidden',w.dataset.lens!==id);});
   detail.classList.remove('is-hidden');
   var card=cards.find(function(c){return c.dataset.lens===id;});
   if(dThread){var thread=card?card.querySelector('.othread'):null;dThread.textContent=thread?thread.textContent:'';}
   var w=detail.querySelector('.lens-wrap:not(.is-hidden)');
   var h=w?w.querySelector('.lens-title'):null;
   if(h){h.tabIndex=-1;h.focus({preventScroll:true});}
   if(w)window.scrollTo({top:w.getBoundingClientRect().top+window.scrollY-24,behavior:soft()});
   if(card)detail.style.setProperty('--acc',getComputedStyle(card).getPropertyValue('--acc'));
  }
  function close(){
   cards.forEach(function(c){c.classList.remove('on');});
   wraps.forEach(function(w){w.classList.add('is-hidden');});
   detail.classList.add('is-hidden');
   detail.style.removeProperty('--acc');
  }
  cards.forEach(function(c){c.addEventListener('click',function(){c.classList.contains('on')?close():open(c.dataset.lens);});});
  if(dClose)dClose.addEventListener('click',function(){
   var on=cards.find(function(c){return c.classList.contains('on');});
   close();
   if(on){on.focus({preventScroll:true});window.scrollTo({top:on.getBoundingClientRect().top+window.scrollY-80,behavior:soft()});}
  });
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!detail.classList.contains('is-hidden'))dClose&&dClose.click();});
 });
 // lightbox: click any scene to see a full, unmarked-guide-stripped enlargement
 var lb=document.getElementById('cpl-lightbox');
 var lbContent=document.getElementById('cpl-lightboxContent'),lbClose=lb.querySelector('.lightbox-close');
 function closeLightbox(){lb.hidden=true;lbContent.innerHTML='';}
 function openLightboxImg(src,alt){
  var img=document.createElement('img');img.src=src;img.alt=alt||'';
  lbContent.innerHTML='';lbContent.appendChild(img);lb.hidden=false;
 }
 function parseRatio(str){
  if(!str||str==='auto')return 0;
  var parts=str.split('/').map(function(s){return parseFloat(s);});
  if(parts.length===2&&parts[1])return parts[0]/parts[1];
  if(parts.length===1&&parts[0])return parts[0];
  return 0;
 }
 function fitBox(clone,ratio){
  var vw=window.innerWidth*0.92,vh=window.innerHeight*0.88;
  clone.style.maxWidth='none';clone.style.maxHeight='none';
  if(ratio){
   var W=vw,H=vw/ratio;
   if(H>vh){H=vh;W=vh*ratio;}
   clone.style.width=W+'px';clone.style.height=H+'px';
  } else {
   clone.style.maxWidth=vw+'px';clone.style.maxHeight=vh+'px';clone.style.width='auto';clone.style.height='auto';
  }
 }
 function revealAfter(imgs,cb){
  var pending=imgs.filter(function(im){return !im.complete;});
  if(pending.length===0){cb();return;}
  var remaining=pending.length;
  function done(){remaining--;if(remaining<=0)cb();}
  pending.forEach(function(im){im.addEventListener('load',done,{once:true});im.addEventListener('error',done,{once:true});});
 }
 function openLightboxScene(scene){
  var clone=scene.cloneNode(true);
  clone.querySelectorAll('.gsvg').forEach(function(g){g.remove();});
  var clonedImgs=[].slice.call(clone.querySelectorAll('img'));
  clonedImgs.forEach(function(im){im.loading='eager';});
  clone.style.margin='0';
  lbContent.innerHTML='';lbContent.appendChild(clone);
  revealAfter(clonedImgs,function(){
   var ratio=parseRatio(scene.getAttribute('data-crop-ratio'));
   if(!ratio)ratio=parseRatio(getComputedStyle(scene).aspectRatio);
   if(!ratio){
    var primary=clonedImgs[0];
    if(primary&&primary.naturalWidth&&primary.naturalHeight)ratio=primary.naturalWidth/primary.naturalHeight;
   }
   fitBox(clone,ratio);
   lb.hidden=false;
  });
 }
 document.querySelectorAll('.lens-detail .scene').forEach(function(scene){
  scene.addEventListener('click',function(e){e.stopPropagation();openLightboxScene(scene);});
 });
 document.querySelectorAll('.lens-detail .detail-crop').forEach(function(crop){
  crop.addEventListener('click',function(e){
   e.stopPropagation();
   var img=crop.querySelector('img');
   if(img)openLightboxImg(img.currentSrc||img.src,img.alt);
  });
 });
 lb.addEventListener('click',closeLightbox);
 lbClose.addEventListener('click',function(e){e.stopPropagation();closeLightbox();});
 document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!lb.hidden)closeLightbox();});
})();
</script>

