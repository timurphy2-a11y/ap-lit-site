---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BioLink from '../components/BioLink.astro';
import MusicPlate from '../components/MusicPlate.astro';
import ThreadIcon from '../components/ThreadIcon.astro';

const UNIT_IDS = [
  '00-medieval', '01-renaissance', '02-baroque',
  '03-enlightenment', '04-romanticism', '05-modernism',
] as const;

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#5b82c8',
  '01-renaissance':   '#e8a820',
  '02-baroque':       '#dc5f6c',
  '03-enlightenment': '#48a0e0',
  '04-romanticism':   '#b978d2',
  '05-modernism':     '#3aa87a',
};

const NAV_LABELS: Record<string, string> = {
  '00-medieval': 'Medieval', '01-renaissance': 'Renaissance',
  '02-baroque': 'Baroque',   '03-enlightenment': 'Enlightenment',
  '04-romanticism': 'Romanticism', '05-modernism': 'Modernism',
};

const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/music`)));
const rendered = await Promise.all(entries.map((e) => render(e)));

function getFeaturedItems(entry: typeof entries[0]) {
  const fl = entry.data.featured_listening;
  if (!fl) return [];
  return Array.isArray(fl) ? fl : [fl];
}
---

<Layout title="Hearing Through Form — AP Literature">

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<section class="g-hero">
  <div class="g-wrap">
    <p class="g-label">§ III &nbsp;·&nbsp; Shared Resource &nbsp;·&nbsp; Music</p>
    <h1 class="g-title">Hearing Through Form</h1>
    <p class="g-thesis">
      A complete guide to the music of each period, from the single unaccompanied line of medieval
      plainchant through Modernism's dismantling of tonality. Three threads — Texture &amp; Voices,
      Consonance &amp; Dissonance, and Structure &amp; Freedom — run continuously through all six
      periods. Follow them from start to finish, or jump to any period below.
    </p>
  </div>
</section>

<!-- ── Sticky period nav ─────────────────────────────────────────────────── -->
<div class="g-nav-bar">
  <div class="g-wrap">
    <nav class="g-nav" aria-label="Jump to period">
      {UNIT_IDS.map((id) => (
        <a
          href={`#${id.slice(3)}`}
          class="g-nav-link period-nav-link"
          data-anchor={id.slice(3)}
          style={`--accent: ${UNIT_ACCENTS[id]};`}
        >{NAV_LABELS[id]}</a>
      ))}
    </nav>
  </div>
</div>

<!-- ── Period sections ───────────────────────────────────────────────────── -->
<main class="g-wrap">
  {entries.map((entry, i) => {
    const { Content } = rendered[i];
    const unitId = entry.data.unit;
    const accent = UNIT_ACCENTS[unitId] ?? '#C9A24B';
    const num = unitId.slice(0, 2);
    const anchor = unitId.slice(3);
    const featured = getFeaturedItems(entry);
    const gallery = entry.data.gallery_listening ?? [];
    const isLast = i === entries.length - 1;

    return (
      <>
        <div id={anchor} class="g-period-head">
          <div class="g-period-eyebrow" style={`--u-acc: ${accent}`}>
            <span class="g-period-num">{num}</span>
            <div>
              <h2 class="g-period-name">{entry.data.period}</h2>
              <span class="g-period-dates">{entry.data.dates}</span>
            </div>
          </div>
          {entry.data.core_text && (
            <div class="g-core-tag" style={`--u-acc: ${accent}`}>
              Core text: <em>{entry.data.core_text}</em>
              {entry.data.author ? ` — ${entry.data.author}` : ''}
            </div>
          )}
        </div>

        <div class="g-body">
          <div
            class="prose prose-invert max-w-none"
            style={`--prose-drop-cap-color: ${accent};`}
          >
            <Content components={{ BioLink, MusicPlate }} />
          </div>

          <aside class="g-sidebar">
            {(featured.length > 0 || gallery.length > 0) && (
              <div class="card">
                <h4>Featured Listening</h4>
                <ul class="works">
                  {[...featured, ...gallery].map((item) => (
                    <li>
                      <div class="t">{item.title}</div>
                      <div class="by">{item.composer}{item.date ? ` · ${item.date}` : ''}</div>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="card">
              <h4>Analytical Threads</h4>
              <ul class="threads-list">
                {entry.data.threads.map((t) => (
                  <li style={`--sub-acc: ${accent}`}>
                    <ThreadIcon thread={t.id} size={20} />
                    <div>
                      <div class="tn">{t.label}</div>
                      <div class="ts">{t.period_summary}</div>
                    </div>
                  </li>
                ))}
              </ul>
            </div>

            <a
              href={`/units/${unitId}`}
              class="g-unit-link"
              style={`--u-acc: ${accent}`}
            >Full {entry.data.period} unit →</a>
          </aside>
        </div>

        {!isLast && <hr class="g-divider" />}
      </>
    );
  })}
</main>

<!-- ── Footer ────────────────────────────────────────────────────────────── -->
<footer class="g-footer">
  <div class="g-wrap">
    <div class="g-footer-inner">
      <a href="/seeing-through-paint">← Seeing Through Paint</a>
      <div class="g-footer-links">
        <a href="/sculpting-through-time">Sculpting Through Time</a>
        <a href="/">Home →</a>
      </div>
    </div>
  </div>
</footer>

</Layout>

<style>
  .g-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 64px); }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .g-hero { padding: 64px 0 56px; border-bottom: 1px solid var(--rule); }
  .g-label { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-soft); margin: 0 0 28px; }
  .g-title { font-family: var(--font-display); font-weight: 300; font-size: clamp(40px, 6vw, 80px); line-height: 0.98; letter-spacing: -0.02em; margin: 0 0 28px; color: var(--ink); }
  .g-thesis { max-width: 58ch; font-family: var(--font-display); font-size: 17px; line-height: 1.65; color: var(--ink-mute); margin: 0; }

  /* ── Sticky nav ───────────────────────────────────────────────── */
  .g-nav-bar { position: sticky; top: 57px; z-index: 30; background: var(--bg); border-bottom: 1px solid var(--rule); overflow-x: auto; }
  .g-nav { display: flex; gap: 2px; padding: 8px 0; white-space: nowrap; }
  .g-nav-link { font-family: var(--font-ui); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 14px; color: var(--ink-soft); border: 1px solid transparent; transition: color 150ms, background 150ms, border-color 150ms; }
  .g-nav-link:hover { color: var(--ink); }
  .g-nav-link.active { color: var(--accent); border-color: color-mix(in oklab, var(--accent) 40%, transparent); background: color-mix(in oklab, var(--accent) 8%, transparent); }

  /* ── Period header ────────────────────────────────────────────── */
  .g-period-head { padding: 56px 0 20px; scroll-margin-top: 110px; }
  .g-period-eyebrow { display: flex; align-items: baseline; gap: 14px; margin-bottom: 10px; }
  .g-period-num { font-family: var(--font-display); font-weight: 300; font-size: 44px; line-height: 1; color: var(--u-acc); flex-shrink: 0; }
  .g-period-name { font-family: var(--font-display); font-weight: 400; font-size: 26px; color: var(--ink); line-height: 1.1; margin: 0; }
  .g-period-dates { display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ink-soft); margin-top: 4px; }
  .g-core-tag { display: inline-block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.08em; padding: 4px 12px; border: 1px solid color-mix(in oklab, var(--u-acc) 35%, transparent); background: color-mix(in oklab, var(--u-acc) 10%, transparent); color: var(--u-acc); margin-top: 8px; }

  /* ── Prose + sidebar layout ───────────────────────────────────── */
  .g-body { display: grid; grid-template-columns: 1fr; gap: 40px; padding-bottom: 48px; }
  @media (min-width: 900px) { .g-body { grid-template-columns: 1fr 240px; gap: 56px; } }

  /* ── Sidebar ──────────────────────────────────────────────────── */
  .g-sidebar { display: flex; flex-direction: column; gap: 16px; }
  .card { border: 1px solid var(--rule); background: var(--bg-raised); }
  .card h4 { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-soft); padding: 12px 16px 10px; border-bottom: 1px solid var(--rule); margin: 0; }

  .works { list-style: none; padding: 0; margin: 0; }
  .works li { padding: 10px 16px; border-bottom: 1px solid var(--rule); }
  .works li:last-child { border-bottom: none; }
  .works .t { font-family: var(--font-display); font-style: italic; font-size: 14px; color: var(--ink); line-height: 1.3; }
  .works .by { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; color: var(--ink-soft); margin-top: 2px; }

  .threads-list { list-style: none; padding: 0; margin: 0; }
  .threads-list li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; padding: 12px 16px; border-bottom: 1px solid var(--rule); align-items: start; }
  .threads-list li:last-child { border-bottom: none; }
  .threads-list .tn { font-family: var(--font-ui); font-size: 13px; font-weight: 500; color: var(--sub-acc, var(--ink)); margin-bottom: 3px; }
  .threads-list .ts { font-family: var(--font-display); font-size: 13.5px; line-height: 1.55; color: var(--ink-soft); }

  .g-unit-link { display: block; font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; padding: 10px 16px; border: 1px solid var(--rule); color: var(--u-acc, var(--ink-soft)); text-align: center; transition: background 150ms, border-color 150ms; }
  .g-unit-link:hover { background: color-mix(in oklab, var(--u-acc, var(--acc)) 10%, transparent); border-color: color-mix(in oklab, var(--u-acc, var(--acc)) 35%, transparent); }

  /* ── Divider / footer ─────────────────────────────────────────── */
  .g-divider { border: none; border-top: 1px solid var(--rule); margin: 8px 0; }
  .g-footer { margin-top: 48px; border-top: 1px solid var(--rule); }
  .g-footer-inner { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding: 24px 0; }
  .g-footer-links { display: flex; gap: 24px; }
  .g-footer a, .g-footer-links a { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); transition: color 150ms; }
  .g-footer a:hover, .g-footer-links a:hover { color: var(--ink); }

  /* ── Prose overrides ─────────────────────────────────────────── */
  .prose { --tw-prose-body: var(--ink-mute); --tw-prose-headings: var(--ink); --tw-prose-bold: var(--ink); --tw-prose-hr: var(--rule); }
</style>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.period-nav-link');
  const sectionIds = ['medieval','renaissance','baroque','enlightenment','romanticism','modernism'];

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const id = e.target.id;
          navLinks.forEach((link) => link.classList.toggle('active', link.dataset.anchor === id));
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
