---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const UNIT_IDS = [
  '00-medieval', '01-renaissance', '02-baroque',
  '03-enlightenment', '04-romanticism', '05-modernism',
] as const;

const PERIOD_ACCENTS: Record<string, string> = {
  '00-medieval':      '#C9A24B',
  '01-renaissance':   '#B54C3A',
  '02-baroque':       '#B07028',
  '03-enlightenment': '#698BA1',
  '04-romanticism':   '#3D5A6D',
  '05-modernism':     '#A03828',
};

const THREADS = [
  {
    id: 'texture-voices',
    title: 'Texture & Voices',
    weight: 'var(--th-1)',
    question: 'How many voices are active, what are they doing, and what does their relationship imply about the individual and the collective?',
    story: "is the story of what music is made of — how many voices are sounding, what they are doing to each other, and what their relationship implies about the individual and the collective. Medieval music answers with a single voice: one melody, sung in unison, the sonic image of a community that has subordinated individual will to collective devotion. The Renaissance multiplies that voice into four, five, even forty independent lines, each distinct, all interlocking — a humanist ideal of discourse in which multiple perspectives coexist without hierarchy. The Baroque intensifies that plurality into drama: the fugue pursues a single theme through increasingly complex elaboration, while the concerto opposes soloist against ensemble in a dialogue that is sometimes collaborative, sometimes competitive. The Classical era strips back to a single clear melody supported by subordinate accompaniment, making the individual perspective legible and primary. Romanticism loads that individual voice with heroic weight and sets it against an orchestra of overwhelming collective force. Modernism shatters the texture entirely: Stravinsky stacks independent voices in rhythmic collision, Schoenberg isolates instruments in strange combinations, and jazz improvisation creates a fluid, democratic dialogue that no European tradition had imagined.",
  },
  {
    id: 'consonance-dissonance',
    title: 'Consonance & Dissonance',
    weight: 'var(--th-2)',
    question: 'How does the music handle sonic tension? What do its rules about dissonance and resolution reveal about the culture that made them?',
    story: "is the story of how music has handled the fact of conflict — sonic tension — and what its rules about tension and resolution reveal about the cultures that made them. In medieval monophony, the question barely arises: there is only one voice, and a single voice cannot be in conflict with itself. The Renaissance introduces harmony and with it the possibility of dissonance, but governs it strictly: discord must be prepared, brief, and resolved — a world where conflict is acknowledged but order is always restored. The Baroque liberates dissonance for emotional and dramatic effect, using the contrast between consonance and dissonance the way painters use light against shadow. The Classical era disciplines dissonance into a structural tool: moments of tension create departure and anticipation within sonata form, always resolved at the recapitulation. Romanticism pushes toward the breaking point: Wagner's Tristan chord, introduced in the opera's first measure, refuses resolution for the entire four-hour length of the work — the most consequential musical act of the nineteenth century. Schoenberg draws the logical conclusion and abolishes the system itself, declaring the emancipation of dissonance, treating all twelve chromatic notes as equals, leaving the listener in a space where tension never resolves because there is no longer any stable ground to define resolution.",
  },
  {
    id: 'structure-freedom',
    title: 'Structure & Freedom',
    weight: 'var(--th-3)',
    question: "How do composers relate to inherited formal structures — submitting to them, working brilliantly within them, or breaking them apart?",
    story: "is the story of rules — inherited formal structures — and composers' changing relationship to them, from complete submission to outright abandonment. Medieval music has no abstract formal structure at all: its shape is entirely determined by the liturgical text it serves, the music a vehicle for prayer rather than an autonomous form. The Renaissance establishes the first purely musical rules — the contrapuntal laws that govern how voices may move in relation to each other — and demonstrates that extraordinary ingenuity and expression are possible within strict inherited constraints. The Baroque inherits those rules and enriches them: the fugue is among the most intellectually rigorous forms in Western music, its every note governed, yet within that architecture performers added elaborate improvised ornaments that the structure both enables and contains. The Classical era codifies structure into the elegant logic of sonata form — exposition, development, recapitulation — which creates expectations and then fulfills or wittily subverts them. Romanticism stretches those inherited structures until they cannot hold: symphonies double in length, forms dissolve into tone poems and rhapsodies, and emotional truth takes priority over formal neatness. Modernism completes the rupture, either shattering inherited forms entirely or replacing them with new frameworks — the jazz blues progression, a minimal twelve-bar structure that enables essentially unlimited improvisation within its firm, repeating ground.",
  },
];

const SIGS: Record<string, string> = {
  'texture-voices':        `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20 Q10 12,16 20 T28 20 T40 20"/><circle cx="10" cy="16" r="1" fill="currentColor" stroke="none"/><circle cx="22" cy="24" r="1" fill="currentColor" stroke="none"/><circle cx="34" cy="16" r="1" fill="currentColor" stroke="none"/></svg>`,
  'consonance-dissonance': `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="20" cy="20" r="14"/><path d="M6 20 A14 14 0 0 1 34 20"/><line x1="12" y1="20" x2="28" y2="20" stroke-dasharray="2 2"/><circle cx="20" cy="20" r="1.5" fill="currentColor" stroke="none"/></svg>`,
  'structure-freedom':     `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><path d="M4 20 Q9 14,14 20 Q19 26,24 20 Q29 14,34 20"/><line x1="14" y1="10" x2="14" y2="30" stroke-dasharray="1.5 2.5" opacity=".6"/><line x1="24" y1="10" x2="24" y2="30" stroke-dasharray="1.5 2.5" opacity=".6"/></svg>`,
};

const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/music`)));

function getFeatured(entry: typeof entries[0]) {
  const fl = entry.data.featured_listening;
  if (!fl) return null;
  return Array.isArray(fl) ? fl[0] : fl;
}
---

<Layout title="Hearing Through Form — AP Literature">

<div class="stp-page">

  <!-- Full-bleed three-strand braid band -->
  <div id="stp-band" class="stp-band" aria-hidden="true"></div>

  <!-- Centered header -->
  <header class="stp-head">
    <div class="stp-seal" aria-hidden="true">
      <!-- Music mark: fermata arc + dot + baseline (scaled to 40×40) -->
      <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round">
        <path d="M8 22 A12 12 0 0 1 32 22"/>
        <circle cx="20" cy="14" r="2.5" fill="currentColor" stroke="none"/>
        <line x1="4" y1="28" x2="36" y2="28"/>
      </svg>
    </div>
    <p class="stp-eyebrow"><strong>§ III</strong> · Shared Resource · Music</p>
    <h1 class="stp-title">Hearing Through <em>Form</em></h1>
    <p class="stp-lede">
      A complete guide to the music of each period, from the single unaccompanied line of medieval
      plainchant through Modernism's dismantling of tonality. Three threads — Texture &amp; Voices,
      Consonance &amp; Dissonance, and Structure &amp; Freedom — run continuously through all six
      periods. Follow them from start to finish, or jump to any thread below.
    </p>
  </header>

  <!-- Sticky thread nav -->
  <nav class="stp-tnav" id="stp-tnav" aria-label="Jump to thread">
    <div class="stp-tnav-row">
      {THREADS.map((t, i) => (
        <a
          class:list={['stp-tbtn', i === 0 && 'active']}
          href={`#${t.id}`}
          data-target={t.id}
          style={`--w: ${t.weight}`}
        >
          <span class="stp-tbtn-sig" set:html={SIGS[t.id]}></span>
          <span class="stp-tbtn-label">{t.title}</span>
        </a>
      ))}
    </div>
  </nav>

  <div class="stp-wrap">

    <!-- Intro prose -->
    <section class="stp-intro">
      <p>Music is the most time-bound of the arts: it exists only in the act of performance and unfolds in duration. What a composer chooses to do with multiple voices, with tension and resolution, and with inherited formal structures reveals fundamental assumptions about what music is for — whether it exists to serve prayer, to represent nature, to express individual emotion, or to explore the autonomous logic of sound itself.</p>
      <p>This guide traces three analytical threads across six historical periods, from the single unaccompanied voice of medieval plainchant to the radical dismantling of the tonal system in early Modernism. Reading each thread as a continuous arc makes visible something that individual unit pages cannot: the cumulative story of how Western culture has heard and organized sound over more than a thousand years.</p>
      <div class="stp-divider"></div>
    </section>

    <!-- Thread sections -->
    <main>
      {THREADS.map((thread) => (
        <section class="stp-thread" id={thread.id} style={`--w: ${thread.weight}`}>

          <div class="stp-thread-head">
            <div class="stp-thread-sigil" set:html={SIGS[thread.id]}></div>
            <div>
              <div class="stp-thread-label">Thread · <strong>{thread.title}</strong></div>
              <h2>{thread.title}</h2>
            </div>
          </div>

          <p class="stp-thread-q">{thread.question}</p>

          <div class="stp-story">
            <p><strong>The story this thread tells</strong> {thread.story}</p>
          </div>

          <div class="stp-cards">
            {entries.map((entry) => {
              const unitId = entry.data.unit;
              const acc = PERIOD_ACCENTS[unitId] ?? '#A07820';
              const num = unitId.slice(0, 2);
              const gloss = entry.data.threads.find((t) => t.id === thread.id)?.period_summary ?? '';
              const featured = getFeatured(entry);
              return (
                <a class="stp-card" href={`/units/${unitId}/music`} style={`--acc: ${acc}`} aria-label={`Read the full ${entry.data.period} unit`}>
                  <!-- Audio band replaces image -->
                  <div class="stp-card-audio-band">
                    <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
                      <circle cx="20" cy="20" r="14" stroke="currentColor" stroke-width="1.2" opacity=".4"/>
                      <polygon points="17,14 17,26 29,20" fill="currentColor" opacity=".7"/>
                    </svg>
                  </div>
                  <div class="stp-card-body">
                    <div class="stp-card-top">
                      <span class="stp-card-num">{num}</span>
                      <span class="stp-card-ttl">{entry.data.period}</span>
                    </div>
                    <div class="stp-card-dates">{entry.data.dates}</div>
                    <p class="stp-card-gloss">{gloss}</p>
                    <div class="stp-card-cap">
                      {featured && (
                        <>
                          <div class="stp-card-work">{featured.title}</div>
                          <div class="stp-card-by">{featured.composer}</div>
                        </>
                      )}
                      <span class="stp-card-full">Full {entry.data.period} unit →</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>

        </section>
      ))}
    </main>

    <!-- Footer -->
    <footer class="stp-footer">
      <a class="stp-home" href="/">← Home</a>
      <div class="stp-siblings">
        <a href="/seeing-through-paint">Seeing Through Paint</a>
        <a href="/sculpting-through-time">Sculpting Through Time</a>
      </div>
    </footer>

  </div><!-- /.stp-wrap -->
</div><!-- /.stp-page -->

</Layout>

<style>
  .stp-page {
    --th-1: #574878;   /* Texture & Voices      · deep violet */
    --th-2: #6F5E95;   /* Consonance & Dissonance · mid violet */
    --th-3: #8C80AE;   /* Structure & Freedom  · muted violet */
    --seal:  #5A4022;
    --gutter: clamp(24px, 4.5vw, 80px);
    --maxw: 1320px;
  }

  .stp-band {
    width: 100%;
    height: 60px;
    overflow: hidden;
    line-height: 0;
    background: var(--bg);
  }

  .stp-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
    padding: 52px var(--gutter) 48px;
    max-width: var(--maxw);
    margin: 0 auto;
  }
  .stp-seal {
    width: 88px;
    height: 88px;
    background: var(--seal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .stp-seal svg { width: 46px; height: 46px; color: var(--bg); }

  .stp-eyebrow {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: .22em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0;
  }
  .stp-eyebrow strong { color: var(--ink-mute); font-weight: 500; }

  .stp-title {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 300;
    font-size: clamp(30px, 5.8vw, 74px);
    line-height: 1.05;
    letter-spacing: -.02em;
    margin: 0;
    color: var(--ink);
    white-space: nowrap;
  }
  .stp-title em { font-style: italic; color: var(--ink-mute); }

  .stp-lede {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-mute);
    max-width: 60ch;
    margin: 0;
    text-wrap: pretty;
  }

  .stp-tnav {
    position: sticky;
    top: 62px;
    z-index: 39;
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: 1px solid var(--rule);
    padding: 14px var(--gutter);
  }
  .stp-tnav-row {
    display: flex;
    gap: 12px;
    max-width: calc(var(--maxw) - 2 * var(--gutter));
    margin: 0 auto;
  }

  .stp-tbtn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--bg);
    border: 1px solid var(--rule);
    padding: 13px 18px;
    position: relative;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    font-size: 18px;
    color: var(--ink-mute);
    text-decoration: none;
    transition: background 160ms, color 160ms, border-color 160ms;
  }
  .stp-tbtn-sig {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color 160ms;
  }
  .stp-tbtn-sig svg { width: 100%; height: 100%; }

  .stp-tbtn:hover { background: var(--bg-raised); color: var(--ink); }
  .stp-tbtn:hover .stp-tbtn-sig { color: var(--ink-mute); }

  .stp-tbtn.active {
    background: color-mix(in oklab, var(--w) 12%, var(--bg));
    border-color: var(--w);
    color: var(--w);
  }
  .stp-tbtn.active::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--w);
  }
  .stp-tbtn.active .stp-tbtn-sig { color: var(--w); }

  @media (max-width: 720px) {
    .stp-tbtn { font-size: 0; gap: 0; padding: 13px; }
    .stp-tbtn-sig { width: 24px; height: 24px; }
  }

  .stp-wrap {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .stp-intro { padding: 56px 0 8px; text-align: center; }
  .stp-intro p {
    font-size: 18px;
    line-height: 1.7;
    color: var(--ink-mute);
    max-width: 62ch;
    margin: 0 auto 22px;
    text-wrap: pretty;
  }
  .stp-divider { height: 1px; background: var(--rule); margin: 40px 0 0; }

  .stp-thread { padding: 56px 0 8px; scroll-margin-top: 76px; }

  .stp-thread-head {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 22px;
    align-items: center;
    margin-bottom: 8px;
  }
  .stp-thread-sigil {
    width: 64px;
    height: 64px;
    border: 1px solid color-mix(in oklab, var(--w) 32%, var(--rule));
    background: color-mix(in oklab, var(--w) 6%, var(--bg));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--w);
    flex-shrink: 0;
  }
  .stp-thread-sigil svg { width: 36px; height: 36px; }

  .stp-thread-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 6px;
  }
  .stp-thread-label strong { color: var(--w); font-weight: 500; }

  .stp-thread-head h2 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-size: clamp(34px, 4vw, 46px);
    line-height: 1;
    letter-spacing: -.015em;
    margin: 0;
    color: var(--ink);
  }

  .stp-thread-q {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 21px;
    line-height: 1.4;
    color: var(--w);
    margin: 18px 0 24px;
    max-width: 60ch;
  }

  .stp-story {
    background: color-mix(in oklab, var(--w) 7%, var(--bg));
    border: 1px solid color-mix(in oklab, var(--w) 26%, var(--rule));
    border-left: 3px solid var(--w);
    padding: 26px 30px;
    margin-bottom: 36px;
  }
  .stp-story p {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-mute);
    margin: 0;
    text-wrap: pretty;
  }
  .stp-story p strong { color: var(--w); font-weight: 600; }

  .stp-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 1080px) { .stp-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 680px)  { .stp-cards { grid-template-columns: 1fr; } }

  .stp-card {
    display: flex;
    flex-direction: column;
    background: color-mix(in oklab, var(--acc) 12%, var(--bg));
    border: 1px solid color-mix(in oklab, var(--acc) 32%, var(--rule));
    border-left: 3px solid var(--acc);
    overflow: hidden;
    text-decoration: none;
    transition: filter 160ms;
  }
  .stp-card:hover { filter: brightness(.97); }

  /* Audio band — tinted period-accent rectangle with a play disc */
  .stp-card-audio-band {
    height: 72px;
    background: color-mix(in oklab, var(--acc) 18%, var(--bg));
    border-bottom: 1px solid color-mix(in oklab, var(--acc) 30%, var(--rule));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--acc);
  }
  .stp-card-audio-band svg { width: 40px; height: 40px; }

  .stp-card-body {
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .stp-card-top { display: flex; align-items: baseline; gap: 12px; }
  .stp-card-num {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 400;
    font-size: 38px;
    line-height: .85;
    color: var(--acc);
    letter-spacing: -.02em;
    flex-shrink: 0;
  }
  .stp-card-ttl {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    font-size: 21px;
    line-height: 1.05;
    color: var(--ink);
    letter-spacing: -.005em;
  }
  .stp-card-dates {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    color: var(--ink-soft);
    margin: 6px 0 0;
  }
  .stp-card-gloss {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 14px 0 0;
    text-wrap: pretty;
  }
  .stp-card-cap {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid color-mix(in oklab, var(--acc) 26%, var(--rule));
  }
  .stp-card-work {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: 15.5px;
    line-height: 1.25;
    color: var(--ink);
  }
  .stp-card-by {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 5px;
  }
  .stp-card-full {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--acc);
  }

  .stp-footer {
    margin: 80px 0 0;
    padding: 26px 0 64px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 18px;
  }
  .stp-home {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 160ms;
  }
  .stp-home:hover { color: var(--ink); }
  .stp-siblings { display: flex; gap: 14px; }
  .stp-siblings a {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-size: 18px;
    color: var(--ink-mute);
    padding: 8px 16px;
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: color 160ms, border-color 160ms;
  }
  .stp-siblings a:hover { color: var(--ink); border-color: var(--rule-strong); }
</style>

<script>
  (function buildBraidBand() {
    const H = 60, mid = H / 2, amp = H * 0.30, wl = H * 1.25;
    const phases = [0, (2 * Math.PI) / 3, (4 * Math.PI) / 3];
    const weights = ['var(--th-1)', 'var(--th-2)', 'var(--th-3)'];
    const sineD = (phase: number) => {
      const step = wl / 24;
      let d = `M ${(-step).toFixed(2)} ${(mid + amp * Math.sin((2 * Math.PI * -step) / wl + phase)).toFixed(2)}`;
      for (let x = 0; x <= wl + step; x += step) {
        d += ` L ${x.toFixed(2)} ${(mid + amp * Math.sin((2 * Math.PI * x) / wl + phase)).toFixed(2)}`;
      }
      return d;
    };
    const strands = phases.map((p, i) => {
      const d = sineD(p);
      return `<path d="${d}" fill="none" stroke="var(--bg)" stroke-width="8"/>`
           + `<path d="${d}" fill="none" stroke="${weights[i]}" stroke-width="3.4" stroke-linecap="round"/>`;
    }).join('');
    const el = document.getElementById('stp-band');
    if (el) {
      el.innerHTML =
        `<svg width="100%" height="${H}" xmlns="http://www.w3.org/2000/svg">`
        + `<defs><pattern id="braidpat-music" width="${wl}" height="${H}" patternUnits="userSpaceOnUse">${strands}</pattern></defs>`
        + `<rect x="0" y="0" width="100%" height="${H}" fill="url(#braidpat-music)"/></svg>`;
    }
  })();

  const btns = [...document.querySelectorAll<HTMLElement>('.stp-tbtn')];
  const secs = ['texture-voices', 'consonance-dissonance', 'structure-freedom'].map(id => document.getElementById(id));

  const spy = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const id = e.target.id;
        btns.forEach(b => b.classList.toggle('active', b.dataset.target === id));
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });

  secs.forEach(s => { if (s) spy.observe(s); });
</script>
