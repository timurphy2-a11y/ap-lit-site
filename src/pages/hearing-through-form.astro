---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BioLink from '../components/BioLink.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';

const UNIT_IDS = [
  '00-medieval',
  '01-renaissance',
  '02-baroque',
  '03-enlightenment',
  '04-romanticism',
  '05-modernism',
] as const;

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#5b82c8',
  '01-renaissance':   '#e8a820',
  '02-baroque':       '#c04050',
  '03-enlightenment': '#48a0e0',
  '04-romanticism':   '#9b58b8',
  '05-modernism':     '#3aa87a',
};

const THREAD_COLORS = ['#e09438', '#c84068', '#48a888'];

const NAV_LABELS: Record<string, string> = {
  '00-medieval':      'Medieval',
  '01-renaissance':   'Renaissance',
  '02-baroque':       'Baroque',
  '03-enlightenment': 'Enlightenment',
  '04-romanticism':   'Romanticism',
  '05-modernism':     'Modernism',
};

// Load all music entries in parallel
const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/music`)));
const rendered = await Promise.all(entries.map((e) => render(e)));

function getFeaturedItems(entry: typeof entries[0]) {
  const fl = entry.data.featured_listening;
  if (!fl) return [];
  return Array.isArray(fl) ? fl : [fl];
}
---

<Layout title="Hearing Through Form — AP Literature">

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="border-b border-[#3d2e1a]">
    <div class="max-w-5xl mx-auto px-6 py-12 md:py-16">
      <p class="text-xs font-semibold tracking-widest uppercase text-amber-600 mb-3">Shared Resource · Music</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#f2e8d5] leading-tight mb-4">
        Hearing Through Form
      </h1>
      <p class="text-[#a09070] text-base leading-relaxed max-w-2xl">
        A complete guide to the music of each period, from the single unaccompanied line of medieval plainchant through Modernism's dismantling of tonality. Three threads — Texture &amp; Voices, Consonance &amp; Dissonance, and Structure &amp; Freedom — run continuously through all six periods. Follow them from start to finish, or jump to any period below.
      </p>
    </div>
  </section>

  <!-- ── Sticky period nav ─────────────────────────────────────────────────── -->
  <div class="sticky top-[53px] z-30 bg-[#1a140c]/95 backdrop-blur-sm border-b border-[#3d2e1a] overflow-x-auto">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="flex gap-1 py-2 min-w-max" aria-label="Jump to period">
        {UNIT_IDS.map((id) => {
          const accent = UNIT_ACCENTS[id];
          const anchor = id.slice(3); // e.g. "medieval"
          return (
            <a
              href={`#${anchor}`}
              class="period-nav-link px-3 py-1.5 rounded-lg text-xs font-medium transition-colors text-[#a09070] hover:text-[#f2e8d5] whitespace-nowrap"
              data-anchor={anchor}
              style={`--accent: ${accent};`}
            >
              {NAV_LABELS[id]}
            </a>
          );
        })}
      </nav>
    </div>
  </div>

  <!-- ── Period sections ───────────────────────────────────────────────────── -->
  <main class="max-w-5xl mx-auto px-6">
    {entries.map((entry, i) => {
      const { Content } = rendered[i];
      const unitId = entry.data.unit;
      const accent = UNIT_ACCENTS[unitId] ?? '#d4a820';
      const num = unitId.slice(0, 2);
      const anchor = unitId.slice(3); // e.g. "medieval"
      const featured = getFeaturedItems(entry);
      const gallery = entry.data.gallery_listening ?? [];
      const isLast = i === entries.length - 1;

      return (
        <>
          <!-- Period header -->
          <div
            id={anchor}
            class="pt-14 pb-6 scroll-mt-24"
          >
            <div class="flex items-baseline gap-3 mb-1">
              <span
                class="font-serif text-3xl font-bold tabular-nums"
                style={`color: ${accent};`}
              >{num}</span>
              <div>
                <h2 class="font-serif text-2xl font-bold text-[#f2e8d5]">{entry.data.period}</h2>
                <p class="text-sm text-[#6e5e48]">{entry.data.dates}</p>
              </div>
            </div>
            {entry.data.core_text && (
              <span
                class="inline-block mt-2 text-xs font-medium px-2.5 py-1 rounded"
                style={`background-color: color-mix(in srgb, ${accent} 14%, #1a140c); color: ${accent};`}
              >
                Core text: <em>{entry.data.core_text}</em>
                {entry.data.author ? ` — ${entry.data.author}` : ''}
              </span>
            )}
          </div>

          <!-- Prose + sidebar -->
          <div class="lg:grid lg:grid-cols-[1fr_260px] lg:gap-12 pb-10">

            <!-- Main prose -->
            <div class="prose prose-stone prose-invert prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-base prose-p:leading-relaxed max-w-none">
              <Content components={{ BioLink }} />
            </div>

            <!-- Sidebar -->
            <aside class="mt-10 lg:mt-0 space-y-6">

              <!-- Featured listening -->
              {featured.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Featured Listening</h3>
                  <div class="space-y-3">
                    {featured.map((item) => (
                      <div
                        class="border border-[#3d2e1a] rounded-xl overflow-hidden"
                        style="background-color: #231a0f;"
                      >
                        {item.youtube_id && (
                          <YouTubeEmbed id={item.youtube_id} title={item.title} />
                        )}
                        <div class="p-3">
                          <p class="text-sm font-serif italic font-bold text-[#f2e8d5] leading-snug">{item.title}</p>
                          <p class="text-xs text-[#a09070] mt-1">{item.composer} · {item.date}</p>
                          {item.duration && <p class="text-xs text-[#6e5e48] mt-0.5">{item.duration}</p>}
                          {item.listen_for && (
                            <p class="text-xs text-[#a09070] mt-2 leading-relaxed border-t border-[#3d2e1a] pt-2">
                              {item.listen_for}
                            </p>
                          )}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Thread summaries -->
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Threads</h3>
                <div class="space-y-2">
                  {entry.data.threads.map((t, ti) => {
                    const tc = THREAD_COLORS[ti % THREAD_COLORS.length];
                    return (
                      <div
                        class="border rounded-lg p-3"
                        style={`background-color: color-mix(in srgb, ${tc} 14%, #1a140c); border-color: color-mix(in srgb, ${tc} 45%, transparent);`}
                      >
                        <p class="text-xs font-semibold mb-1" style={`color: ${tc};`}>{t.label}</p>
                        <p class="text-xs text-[#a09070] leading-relaxed">{t.period_summary}</p>
                      </div>
                    );
                  })}
                </div>
              </div>

              <!-- Gallery listening -->
              {gallery.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-widest text-[#6e5e48] mb-3">Also Listen</h3>
                  <div class="space-y-3">
                    {gallery.map((item) => (
                      <div
                        class="border border-[#3d2e1a] rounded-xl overflow-hidden"
                        style="background-color: #231a0f;"
                      >
                        {item.youtube_id && (
                          <YouTubeEmbed id={item.youtube_id} title={item.title} />
                        )}
                        <div class="px-3 py-2">
                          <p class="text-sm font-serif italic text-[#a09070] leading-snug">{item.title}</p>
                          <p class="text-xs text-[#6e5e48]">{item.composer} · {item.date}</p>
                          {item.duration && <p class="text-xs text-[#6e5e48]">{item.duration}</p>}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Link to full unit -->
              <a
                href={`/units/${unitId}`}
                class="block text-xs text-center py-2 px-3 rounded-lg border transition-colors hover:brightness-125"
                style={`color: ${accent}; border-color: color-mix(in srgb, ${accent} 30%, transparent); background-color: color-mix(in srgb, ${accent} 8%, #1a140c);`}
              >
                Full {entry.data.period} unit →
              </a>

            </aside>
          </div>

          <!-- Divider between periods -->
          {!isLast && (
            <hr class="border-0 border-t border-[#3d2e1a] my-2" />
          )}
        </>
      );
    })}
  </main>

  <!-- ── Footer ────────────────────────────────────────────────────────────── -->
  <footer class="border-t border-[#3d2e1a] mt-8">
    <div class="max-w-5xl mx-auto px-6 py-8 flex flex-wrap gap-4 justify-between items-center">
      <a href="/seeing-through-paint" class="text-sm text-[#a09070] hover:text-[#f2e8d5] transition-colors">← Seeing Through Paint</a>
      <a href="/" class="text-sm text-[#a09070] hover:text-[#f2e8d5] transition-colors">Home →</a>
    </div>
  </footer>

</Layout>

<script>
  // Highlight active period in the sticky nav based on scroll position
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.period-nav-link');
  const sections = document.querySelectorAll<HTMLElement>('[id]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            const isActive = link.dataset.anchor === id;
            if (isActive) {
              link.style.backgroundColor = `color-mix(in srgb, var(--accent) 18%, #1a140c)`;
              link.style.color = `var(--accent)`;
            } else {
              link.style.backgroundColor = '';
              link.style.color = '';
            }
          });
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sections.forEach((sec) => observer.observe(sec));
</script>
