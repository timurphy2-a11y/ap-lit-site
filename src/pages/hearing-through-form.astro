---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ThreadIcon from '../components/ThreadIcon.astro';

const UNIT_IDS = [
  '00-medieval', '01-renaissance', '02-baroque',
  '03-enlightenment', '04-romanticism', '05-modernism',
] as const;

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#C9A24B',
  '01-renaissance':   '#B54C3A',
  '02-baroque':       '#B07028',
  '03-enlightenment': '#698BA1',
  '04-romanticism':   '#3D5A6D',
  '05-modernism':     '#A03828',
};

const THREAD_COLORS = ['#3278AA', '#2560A0', '#4090C8'];

const THREADS = [
  {
    id: 'texture-voices',
    label: 'Texture & Voices',
    question: 'How many voices are active, what are they doing, and what does their relationship imply about the individual and the collective?',
    arc: "The story this thread tells is the story of what music is made of — how many voices are sounding, what they are doing to each other, and what their relationship implies about the individual and the collective. Medieval music answers with a single voice: one melody, sung in unison, the sonic image of a community that has subordinated individual will to collective devotion. The Renaissance multiplies that voice into four, five, even forty independent lines, each distinct, all interlocking — a humanist ideal of discourse in which multiple perspectives coexist without hierarchy. The Baroque intensifies that plurality into drama: the fugue pursues a single theme through increasingly complex elaboration, while the concerto opposes soloist against ensemble in a dialogue that is sometimes collaborative, sometimes competitive. The Classical era strips back to a single clear melody supported by subordinate accompaniment, making the individual perspective legible and primary. Romanticism loads that individual voice with heroic weight and sets it against an orchestra of overwhelming collective force. Modernism shatters the texture entirely: Stravinsky stacks independent voices in rhythmic collision, Schoenberg isolates instruments in strange combinations, and jazz improvisation creates a fluid, democratic dialogue that no European tradition had imagined.",
  },
  {
    id: 'consonance-dissonance',
    label: 'Consonance & Dissonance',
    question: 'How does the music handle sonic tension? What do its rules about dissonance and resolution reveal about the culture that made them?',
    arc: "The story this thread tells is the story of how music has handled the fact of conflict — sonic tension — and what its rules about tension and resolution reveal about the cultures that made them. In medieval monophony, the question barely arises: there is only one voice, and a single voice cannot be in conflict with itself. The Renaissance introduces harmony and with it the possibility of dissonance, but governs it strictly: discord must be prepared, brief, and resolved — a world where conflict is acknowledged but order is always restored. The Baroque liberates dissonance for emotional and dramatic effect, using the contrast between consonance and dissonance the way painters use light against shadow. The Classical era disciplines dissonance into a structural tool: moments of tension create departure and anticipation within sonata form, always resolved at the recapitulation. Romanticism pushes toward the breaking point: Wagner's Tristan chord, introduced in the opera's first measure, refuses resolution for the entire four-hour length of the work — the most consequential musical act of the nineteenth century. Schoenberg draws the logical conclusion and abolishes the system itself, declaring the emancipation of dissonance, treating all twelve chromatic notes as equals, leaving the listener in a space where tension never resolves because there is no longer any stable ground to define resolution.",
  },
  {
    id: 'structure-freedom',
    label: 'Structure & Freedom',
    question: "How do composers relate to inherited formal structures — submitting to them, working brilliantly within them, or breaking them apart?",
    arc: "The story this thread tells is the story of rules — inherited formal structures — and composers' changing relationship to them, from complete submission to outright abandonment. Medieval music has no abstract formal structure at all: its shape is entirely determined by the liturgical text it serves, the music a vehicle for prayer rather than an autonomous form. The Renaissance establishes the first purely musical rules — the contrapuntal laws that govern how voices may move in relation to each other — and demonstrates that extraordinary ingenuity and expression are possible within strict inherited constraints. The Baroque inherits those rules and enriches them: the fugue is among the most intellectually rigorous forms in Western music, its every note governed, yet within that architecture performers added elaborate improvised ornaments that the structure both enables and contains. The Classical era codifies structure into the elegant logic of sonata form — exposition, development, recapitulation — which creates expectations and then fulfills or wittily subverts them. Romanticism stretches those inherited structures until they cannot hold: symphonies double in length, forms dissolve into tone poems and rhapsodies, and emotional truth takes priority over formal neatness. Modernism completes the rupture, either shattering inherited forms entirely or replacing them with new frameworks — the jazz blues progression, a minimal twelve-bar structure that enables essentially unlimited improvisation within its firm, repeating ground.",
  },
];

const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/music`)));

function getFeatured(entry: typeof entries[0]) {
  const fl = entry.data.featured_listening;
  if (!fl) return null;
  return Array.isArray(fl) ? fl[0] : fl;
}
---

<Layout title="Hearing Through Form — AP Literature">

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<section class="g-hero">
  <div class="g-wrap">
    <p class="g-label">§ III &nbsp;·&nbsp; Shared Resource &nbsp;·&nbsp; Music</p>
    <h1 class="g-title">Hearing Through Form</h1>
    <p class="g-thesis">
      A complete guide to the music of each period, from the single unaccompanied line of medieval
      plainchant through Modernism's dismantling of tonality. Three threads — Texture &amp; Voices,
      Consonance &amp; Dissonance, and Structure &amp; Freedom — run continuously through all six
      periods. Follow them from start to finish, or jump to any thread below.
    </p>
  </div>
</section>

<!-- ── Sticky thread nav ─────────────────────────────────────────────────── -->
<div class="g-nav-bar">
  <div class="g-wrap">
    <nav class="g-nav" aria-label="Jump to thread">
      {THREADS.map((thread, ti) => (
        <a
          href={`#${thread.id}`}
          class="g-nav-link thread-nav-link"
          data-anchor={thread.id}
          style={`--accent: ${THREAD_COLORS[ti]};`}
        >
          <ThreadIcon thread={thread.id} size={24} color={THREAD_COLORS[ti]} />
          {thread.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<!-- ── Introduction ──────────────────────────────────────────────────────── -->
<div class="g-wrap">
  <div class="g-intro">
    <p>
      Music is the art form that makes time visible — or rather, audible. The choices a composer
      makes about how many voices to use, how to handle tension and resolution, and how freely to
      treat inherited forms are never merely technical. They are arguments about order and chaos,
      the individual and the collective, and what it means to exist in time.
    </p>
    <p>
      This guide traces three analytical threads across six historical periods, from the medieval
      plainchant to the jazz-inflected modernism of the mid-twentieth century. Reading each thread
      as a continuous arc — rather than encountering the periods one by one — makes visible
      something that individual unit pages cannot: the long argument Western music has been having
      with itself about what sound is for.
    </p>
  </div>
</div>

<!-- ── Thread sections ───────────────────────────────────────────────────── -->
<main class="g-wrap">
  {THREADS.map((thread, ti) => {
    const tc = THREAD_COLORS[ti];
    const isLast = ti === THREADS.length - 1;

    return (
      <>
        <div id={thread.id} class="g-thread-head">
          <div class="g-thread-eyebrow">
            <ThreadIcon thread={thread.id} size={34} color={tc} />
            <h2 class="g-thread-name">{thread.label}</h2>
          </div>
          <p class="g-thread-question">{thread.question}</p>
        </div>

        <div class="g-arc-block" style={`--tc: ${THREAD_COLORS[0]}`}>
          <span class="g-arc-kicker">The story this thread tells</span>
          {' '}{thread.arc.replace('The story this thread tells', '').trimStart()}
        </div>

        <div class="g-card-grid">
          {entries.map((entry) => {
            const unitId = entry.data.unit;
            const uAccent = UNIT_ACCENTS[unitId] ?? '#A07820';
            const num = unitId.slice(0, 2);
            const periodThread = entry.data.threads.find((t: { id: string }) => t.id === thread.id);
            const featured = getFeatured(entry);

            return (
              <article class="g-mcard" style={`--u-acc: ${uAccent}`}>
                <div class="g-mcard-swatch"></div>
                {featured?.youtube_id && (
                  <div
                    class="g-mcard-video"
                    data-yt-id={featured.youtube_id}
                    data-yt-title={featured.title}
                  >
                    <button class="g-mcard-play-btn" type="button" aria-label={`Play ${featured.title}`}>
                      <img
                        src={`https://img.youtube.com/vi/${featured.youtube_id}/hqdefault.jpg`}
                        alt={featured.title}
                        class="g-mcard-thumb"
                        loading="lazy"
                      />
                      <div class="g-mcard-play-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="currentColor">
                          <path d="M8 5v14l11-7z"/>
                        </svg>
                      </div>
                    </button>
                  </div>
                )}
                <div class="g-mcard-body">
                  <div class="g-mcard-eyebrow">
                    <span class="g-mcard-num">{num}</span>
                    <div>
                      <div class="g-mcard-period">{entry.data.period}</div>
                      <span class="g-mcard-dates">{entry.data.dates}</span>
                    </div>
                  </div>
                  {periodThread && <p class="g-mcard-summary">{periodThread.period_summary}</p>}
                  {featured && (
                    <div class="g-mcard-work">
                      <em>{featured.title}</em>
                      <span class="g-mcard-composer">{featured.composer}</span>
                    </div>
                  )}
                  <a href={`/units/${unitId}/music`} class="g-mcard-link">
                    Full {entry.data.period} unit →
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        {!isLast && <hr class="g-divider" />}
      </>
    );
  })}
</main>

<!-- ── Footer ────────────────────────────────────────────────────────────── -->
<footer class="g-footer">
  <div class="g-wrap">
    <div class="g-footer-inner">
      <a href="/">← Home</a>
      <div class="g-footer-links">
        <a href="/seeing-through-paint">Seeing Through Paint</a>
        <a href="/sculpting-through-time">Sculpting Through Time</a>
      </div>
    </div>
  </div>
</footer>

</Layout>

<style>
  .g-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 64px); }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .g-hero { padding: 64px 0 56px; border-bottom: 1px solid var(--rule); }
  .g-label {
    font-family: var(--font-ui);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 28px;
  }
  .g-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
    color: var(--ink);
  }
  .g-thesis {
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-mute);
    margin: 0;
  }

  /* ── Sticky nav ───────────────────────────────────────────────── */
  .g-nav-bar { position: sticky; top: 57px; z-index: 30; background: var(--bg); border-bottom: 1px solid var(--rule); overflow-x: auto; }
  .g-nav { display: flex; gap: 8px; padding: 10px 0; white-space: nowrap; align-items: center; }
  .g-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 18px;
    color: var(--ink-soft);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    transition: color 150ms, background 150ms, border-color 150ms;
    white-space: nowrap;
  }
  .g-nav-link:hover {
    color: var(--ink);
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
  }
  .g-nav-link.active {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }

  /* ── Intro ────────────────────────────────────────────────────── */
  .g-intro {
    max-width: 72ch;
    padding: 48px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .g-intro p {
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-mute);
  }
  .g-intro p:first-child { color: var(--ink); }

  /* ── Thread heading ───────────────────────────────────────────── */
  .g-thread-head { padding: 40px 0 16px; scroll-margin-top: 110px; }
  .g-thread-eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .g-thread-name { font-family: var(--font-display); font-weight: 400; font-size: 32px; color: var(--ink); margin: 0; }
  .g-thread-question { font-family: var(--font-display); font-style: italic; font-size: 17px; color: var(--ink-soft); margin: 0; padding-left: 46px; }

  /* ── Arc block ────────────────────────────────────────────────── */
  .g-arc-block {
    margin: 16px 0 28px;
    padding: 18px 22px;
    border: 1px solid color-mix(in oklab, var(--tc) 30%, transparent);
    background: color-mix(in oklab, var(--tc) 7%, transparent);
    font-family: var(--font-display);
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-mute);
  }
  .g-arc-kicker { font-weight: 600; color: var(--tc); }

  /* ── Card grid ────────────────────────────────────────────────── */
  .g-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-bottom: 48px;
  }
  @media (max-width: 900px) { .g-card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .g-card-grid { grid-template-columns: 1fr; } }

  /* ── Music card ───────────────────────────────────────────────── */
  .g-mcard { position: relative; display: flex; flex-direction: column; background: var(--bg-raised); overflow: hidden; transition: background 200ms; }
  .g-mcard:hover { background: #E0D5BD; }
  .g-mcard-swatch { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--u-acc); z-index: 1; }

  /* ── Inline video ─────────────────────────────────────────────── */
  .g-mcard-video { position: relative; aspect-ratio: 16 / 9; background: var(--bg-sunken); overflow: hidden; }
  .g-mcard-play-btn {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    border: none;
    padding: 0;
    cursor: pointer;
    background: none;
  }
  .g-mcard-thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transition: opacity 200ms;
  }
  .g-mcard-play-btn:hover .g-mcard-thumb { opacity: 1; }
  .g-mcard-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .g-mcard-play-icon svg {
    width: 40px;
    height: 40px;
    padding: 11px;
    color: rgba(232,223,208,.9);
    background: rgba(20,17,16,.72);
    border: 1px solid rgba(232,223,208,.45);
    border-radius: 50%;
    transition: background 200ms, border-color 200ms;
  }
  .g-mcard-play-btn:hover .g-mcard-play-icon svg {
    background: rgba(175,50,30,.85);
    border-color: rgba(232,223,208,.7);
  }
  .g-mcard-iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
  }

  /* ── Card body ────────────────────────────────────────────────── */
  .g-mcard-body { padding: 20px 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .g-mcard-eyebrow { display: flex; align-items: baseline; gap: 12px; }
  .g-mcard-num { font-family: var(--font-display); font-weight: 300; font-size: 40px; line-height: 1; color: var(--u-acc); flex-shrink: 0; }
  .g-mcard-period { font-family: var(--font-display); font-weight: 400; font-size: 19px; color: var(--ink); line-height: 1.2; }
  .g-mcard-dates { display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ink-soft); margin-top: 3px; }
  .g-mcard-summary { font-family: var(--font-display); font-size: 15px; line-height: 1.65; color: var(--ink-mute); flex: 1; }
  .g-mcard-work { padding-top: 12px; border-top: 1px solid var(--rule); font-family: var(--font-display); font-size: 14px; color: var(--ink-mute); }
  .g-mcard-work em { color: var(--ink); font-style: italic; }
  .g-mcard-composer { display: block; font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 4px; }
  .g-mcard-link { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.04em; color: var(--ink-soft); transition: color 150ms; margin-top: auto; }
  .g-mcard-link:hover { color: var(--ink); }

  /* ── Divider / footer ─────────────────────────────────────────── */
  .g-divider { border: none; border-top: 1px solid var(--rule); margin: 8px 0; }
  .g-footer { margin-top: 48px; border-top: 1px solid var(--rule); }
  .g-footer-inner { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding: 24px 0; }
  .g-footer-links { display: flex; gap: 24px; }
  .g-footer a, .g-footer-links a { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); transition: color 150ms; }
  .g-footer a:hover, .g-footer-links a:hover { color: var(--ink); }
</style>

<script>
  // Thread nav active state
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.thread-nav-link');
  const sectionIds = ['texture-voices', 'consonance-dissonance', 'structure-freedom'];

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const id = e.target.id;
          navLinks.forEach((link) => link.classList.toggle('active', link.dataset.anchor === id));
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });

  // Inline YouTube embeds
  document.querySelectorAll<HTMLElement>('.g-mcard-video').forEach((div) => {
    const btn = div.querySelector<HTMLButtonElement>('.g-mcard-play-btn');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const id = div.dataset.ytId!;
      const title = div.dataset.ytTitle ?? '';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'g-mcard-iframe';
      btn.replaceWith(iframe);
    });
  });
</script>
