---
import { getCollection } from 'astro:content';
import { PERIOD_MOTIFS } from '../data/period-motifs';
import Layout from '../layouts/Layout.astro';

const artEntries = (await getCollection('units', ({ id }) => id.endsWith('/art')))
  .sort((a, b) => a.id.localeCompare(b.id));

const PERIOD_DATA: Record<string, { accent: string; highlight: string; tint: string }> = {
  '00-medieval':      { accent: '#C9A24B', highlight: '#E0C387', tint: '#EFE2BD' },
  '01-renaissance':   { accent: '#B54C3A', highlight: '#C68A7A', tint: '#EFD4CC' },
  '02-baroque':       { accent: '#B07028', highlight: '#D49432', tint: '#EFDEBE' },
  '03-enlightenment': { accent: '#698BA1', highlight: '#A2B7C8', tint: '#D8E0E7' },
  '04-romanticism':   { accent: '#3D5A6D', highlight: '#8AA3B5', tint: '#CAD5DD' },
  '05-modernism':     { accent: '#A03828', highlight: '#D49A8C', tint: '#EDD3CC' },
};
---

<Layout title="AP Literature — Historical &amp; Aesthetic Background">

<div class="page">

  <!-- ── Hero ──────────────────────────────────────────────────────── -->
  <section class="hero">
    <h1>Cultural Background Materials</h1>
    <p class="thesis">
      Six units of philosophical, visual, and musical context — from the medieval
      foundations that all later periods react against, through Modernism's crisis
      of certainty.
    </p>
  </section>

  <!-- ── Six-unit spectrum band ─────────────────────────────────────── -->
  <nav class="spectrum" aria-label="The six units">
    {[
      { id: '00-medieval',      n: '00', acc: '#A8862E', label: 'Unit 00 — Medieval'       },
      { id: '01-renaissance',   n: '01', acc: '#B54C3A', label: 'Unit 01 — Renaissance'    },
      { id: '02-baroque',       n: '02', acc: '#B07028', label: 'Unit 02 — Baroque'        },
      { id: '03-enlightenment', n: '03', acc: '#698BA1', label: 'Unit 03 — Enlightenment'  },
      { id: '04-romanticism',   n: '04', acc: '#3D5A6D', label: 'Unit 04 — Romanticism'    },
      { id: '05-modernism',     n: '05', acc: '#A03828', label: 'Unit 05 — Modernism'      },
    ].map(({ id, acc, label }) => (
      <a class="seg" href={`/units/${id}`} style={`--c: ${acc}`} aria-label={label}>
        <span class="block"
              style={`--mark-primary:var(--bg);--mark-highlight:var(--bg);--mark-cream:var(--bg);--mark-spot:transparent;--mark-ink:var(--bg)`}
              set:html={PERIOD_MOTIFS[id]?.[1] ?? ''}
              aria-hidden="true">
        </span>
      </a>
    ))}
  </nav>

  <!-- ── Section label ─────────────────────────────────────────────── -->
  <div class="section-label">
    <span class="n">§ I</span>
    <span>The Six Units</span>
    <span class="rule-line"></span>
    <span>1000 – 1950</span>
  </div>

  <!-- ── Card Codex ────────────────────────────────────────────────── -->
  <div class="codex">
    {artEntries.map((entry) => {
      const unitId   = entry.id.replace('/art', '');
      const num      = unitId.slice(0, 2);
      const pd       = PERIOD_DATA[unitId] ?? PERIOD_DATA['00-medieval'];
      const { accent, highlight, tint } = pd;
      const motifSvg = PERIOD_MOTIFS[unitId]?.[1] ?? '';
      const { period, dates, core_text, author } = entry.data;
      return (
        <a class="codex-card" href={`/units/${unitId}`}
           style={`--acc:${accent}; --hl:${highlight}; --tint:${tint};`}>

          <div class="left-tile">
            <div class="numeral">{num}</div>
            <div class="unit-label">UNIT</div>
          </div>

          <div class="card-body">
            <div class="dates">{dates}</div>
            <h3>{period}</h3>
            <div class="anchor">
              {core_text
                ? <><em>{core_text}</em><span class="by">{author}</span></>
                : <span class="no-anchor">Foundation unit</span>
              }
            </div>
          </div>

          <div class="medallion"
               style={`--mark-primary:${accent}; --mark-highlight:${highlight}; --mark-ink:#2C2820; --mark-cream:#F6F1E8; --mark-spot:transparent;`}
               set:html={motifSvg} />

        </a>
      );
    })}
  </div>

  <!-- ── Resources ─────────────────────────────────────────────────── -->
  <section class="resources">
    <div class="section-label" style="padding-top: 0">
      <span class="n">§ II</span>
      <span>Cross-Cutting Guides</span>
      <span class="rule-line"></span>
      <span>Read across, not down</span>
    </div>
    <div class="res-grid">

      <!-- Timeline — a tick-mark scale -->
      <a class="res" href="/timeline">
        <div class="sigil" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4"  y1="20" x2="36" y2="20"/>
            <line x1="8"  y1="14" x2="8"  y2="26"/>
            <line x1="16" y1="16" x2="16" y2="24"/>
            <line x1="24" y1="16" x2="24" y2="24"/>
            <line x1="32" y1="14" x2="32" y2="26"/>
          </svg>
        </div>
        <div class="kind">Timeline</div>
        <h4>Historical Timeline</h4>
        <p>Political and cultural landmarks from 1000 to 1950, with all five core texts placed in context.</p>
      </a>

      <!-- People — profile reduced to head + shoulder arc -->
      <a class="res" href="/people">
        <div class="sigil" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="20" cy="15" r="5"/>
            <path d="M8 32 C 8 24, 32 24, 32 32"/>
          </svg>
        </div>
        <div class="kind">Index</div>
        <h4>Biographical Index</h4>
        <p>Sixty-plus writers, philosophers, artists, and composers across all six units.</p>
      </a>

      <!-- Compare / Threads — three interwoven strands -->
      <a class="res" href="/compare">
        <div class="sigil" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 10 C 14 20, 26 20, 34 10"/>
            <path d="M6 20 C 14 30, 26 10, 34 20"/>
            <path d="M6 30 C 14 20, 26 20, 34 30"/>
          </svg>
        </div>
        <div class="kind">Method</div>
        <h4>Threads Across Time</h4>
        <p>Trace each analytical thread — philosophy, art, music — across all six periods side by side.</p>
      </a>

      <!-- Painting — a diamond/lozenge: picture plane on its point -->
      <a class="res" href="/seeing-through-paint">
        <div class="sigil" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
            <rect x="8" y="8" width="24" height="24" transform="rotate(45 20 20)"/>
            <circle class="dot" cx="20" cy="20" r="1.5"/>
          </svg>
        </div>
        <div class="kind">Visual Art</div>
        <h4>Seeing Through Paint</h4>
        <p>Medieval gold-ground to Modernist fragmentation — the full cross-period visual guide.</p>
      </a>

      <!-- Music — a fermata arc over a dot: hold this moment -->
      <a class="res" href="/hearing-through-form">
        <div class="sigil" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 24 A 14 14 0 0 1 34 24"/>
            <circle class="dot" cx="20" cy="24" r="2"/>
            <line x1="6" y1="32" x2="34" y2="32"/>
          </svg>
        </div>
        <div class="kind">Music</div>
        <h4>Hearing Through Form</h4>
        <p>Plainchant monophony to Modernist atonality, with embedded listening for every period.</p>
      </a>

      <!-- Sculpture — an axonometric cube: volume made visible -->
      <a class="res" href="/sculpting-through-time">
        <div class="sigil" aria-hidden="true">
          <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 6 L 34 14 L 34 28 L 20 36 L 6 28 L 6 14 Z"/>
            <path d="M6 14 L 20 22 L 34 14"/>
            <line x1="20" y1="22" x2="20" y2="36"/>
          </svg>
        </div>
        <div class="kind">Sculpture</div>
        <h4>Sculpting Through Time</h4>
        <p>Cathedral portals to Modernist abstraction — three analytical threads across six periods.</p>
      </a>

    </div>
  </section>

  <!-- ── Footer ────────────────────────────────────────────────────── -->
  <footer class="pg-footer">
    <div class="colophon">AP Literature · Historical &amp; Aesthetic Background</div>
    <div>A course site in six units</div>
  </footer>

</div><!-- /page -->

</Layout>

<style>
  :root {
    --seal: #5A4022;
    --iron: #2E3640;
  }

  /* ── Page wrapper ────────────────────────────────────────────── */
  .page {
    padding: 0 var(--gutter);
  }

  /* ── Hero ────────────────────────────────────────────────────── */
  .hero {
    padding: 92px 0 52px;
    border-bottom: 1px solid var(--rule);
    text-align: center;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(30px, 6.3vw, 88px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--ink);
    white-space: nowrap;
  }
  .hero .thesis {
    max-width: 58ch;
    margin: 26px auto 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--ink-mute);
    text-wrap: balance;
  }
  @media (max-width: 600px) {
    .hero { padding: 56px 0 40px; }
    .hero h1 { white-space: normal; }
  }

  /* ── Spectrum band ───────────────────────────────────────────── */
  .spectrum {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
    padding: 44px 0 8px;
    text-decoration: none;
  }
  .spectrum .seg { display: block; text-decoration: none; }
  .spectrum .block {
    height: 88px;
    background: var(--c);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms ease;
  }
  .spectrum .seg:hover .block { transform: translateY(-4px); }
  .spectrum .block :global(svg) { display: block; width: 52px; height: 52px; }
  @media (max-width: 680px) {
    .spectrum { grid-template-columns: repeat(3, 1fr); row-gap: 4px; }
    .spectrum .block { height: 72px; }
  }

  /* ── Section label ───────────────────────────────────────────── */
  .section-label {
    display: flex;
    align-items: baseline;
    gap: 18px;
    padding: 72px 0 28px;
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .section-label .n {
    font-family: var(--font-mono);
    color: var(--ink-mute);
  }
  .rule-line {
    flex: 1;
    height: 1px;
    background: var(--rule);
    display: block;
  }

  /* ── Card Codex ──────────────────────────────────────────────── */
  .codex {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  @media (max-width: 900px) { .codex { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .codex { grid-template-columns: 1fr; } }

  .codex-card {
    background: var(--bg-raised);
    display: grid;
    grid-template-columns: 92px 1fr;
    border: 1px solid var(--hl);
    min-height: 200px;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: background 160ms ease;
  }
  .codex-card:hover { background: #E0D5BD; }

  /* Left illuminated-initial tile */
  .left-tile {
    background: var(--tint);
    border-right: 1px solid var(--hl);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 18px 0;
  }
  .numeral {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 56px;
    line-height: 0.9;
    color: var(--acc);
    letter-spacing: -0.02em;
  }
  .unit-label {
    font-family: var(--font-mono);
    font-size: 8.5px;
    letter-spacing: 0.16em;
    color: var(--acc);
    opacity: 0.7;
    margin-top: 10px;
  }

  /* Right body column */
  .card-body {
    padding: 20px 80px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card-body .dates {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .codex-card h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--ink);
  }
  .card-body .anchor {
    margin-top: auto;
    border-top: 1px solid var(--rule);
    padding-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .card-body .anchor em {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
    color: var(--ink);
  }
  .card-body .anchor .by {
    font-family: var(--font-ui);
    font-style: normal;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .card-body .anchor .no-anchor {
    font-family: var(--font-display);
    font-size: 14px;
    color: var(--ink-soft);
  }

  /* Corner medallion */
  .medallion {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 52px;
    height: 52px;
    opacity: 0.92;
    pointer-events: none;
  }
  .medallion :global(svg) {
    width: 100%;
    height: 100%;
  }

  /* ── Resources ───────────────────────────────────────────────── */
  .resources {
    margin-top: 72px;
    padding: 48px 0 32px;
    border-top: 1px solid var(--rule);
  }
  .res-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }
  @media (max-width: 900px) { .res-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .res-grid { grid-template-columns: 1fr; } }

  .res {
    background: var(--bg);
    padding: 24px 24px 26px;
    display: grid;
    grid-template-columns: 56px 1fr;
    grid-template-rows: auto auto auto;
    column-gap: 18px;
    row-gap: 4px;
    transition: background 160ms ease;
  }
  .res:hover { background: var(--bg-raised); }

  .res .sigil {
    grid-row: 1 / 4;
    width: 56px;
    height: 56px;
    background: var(--seal);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .res .sigil svg {
    width: 30px;
    height: 30px;
    color: var(--bg);
    stroke: var(--bg);
  }
  .res .sigil svg .dot {
    fill: var(--bg);
    stroke: none;
  }

  .res .kind {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--iron);
    align-self: start;
  }
  .res h4 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.005em;
    margin: 2px 0 0;
    color: var(--ink);
  }
  .res p {
    font-family: var(--font-display);
    font-size: 14px;
    line-height: 1.5;
    color: var(--iron);
    margin: 4px 0 0;
    max-width: 42ch;
  }

  /* ── Footer ──────────────────────────────────────────────────── */
  .pg-footer {
    margin-top: 96px;
    padding: 40px 0 56px;
    border-top: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .pg-footer .colophon {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15px;
    color: var(--ink-mute);
    letter-spacing: 0;
  }
</style>
