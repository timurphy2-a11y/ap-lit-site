---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const entries = (await getCollection('units', ({ id }) => id.endsWith('/philosophy')))
  .sort((a, b) => a.id.localeCompare(b.id));

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#a08c6a',
  '01-renaissance':   '#d4a820',
  '02-baroque':       '#c07828',
  '03-enlightenment': '#d8c870',
  '04-romanticism':   '#b06040',
  '05-modernism':     '#909070',
};
---

<Layout title="AP Literature — Historical & Aesthetic Background">

  <!-- ── Hero ───────────────────────────────────────────────────────── -->
  <section class="border-b border-[#3d2e1a]">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-20">
      <p class="text-xs font-semibold tracking-widest uppercase text-amber-600 mb-3">
        AP Literature
      </p>
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-[#f2e8d5] leading-tight mb-4">
        Historical &amp; Aesthetic<br />Background Materials
      </h1>
      <p class="text-[#a09070] text-lg leading-relaxed max-w-2xl">
        Six units of philosophical, visual, and musical context for the major works
        of this course — from the medieval foundations that all later periods react
        against, through Modernism's crisis of certainty.
      </p>
    </div>
  </section>

  <!-- ── Unit cards ─────────────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 py-12">
    <h2 class="text-xs font-semibold tracking-widest uppercase text-[#6e5e48] mb-6">
      The Six Units
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {entries.map((entry) => {
        const unitId = entry.id.replace('/philosophy', '');
        const unitNum = unitId.slice(0, 2);
        const accent = UNIT_ACCENTS[unitId] ?? '#d4a820';
        const { period, dates, core_text, author } = entry.data;

        return (
          <a
            href={`/units/${unitId}`}
            class="group block rounded-xl border p-5 transition hover:brightness-110"
            style={`background-color: color-mix(in srgb, ${accent} 10%, #1a140c); border-color: color-mix(in srgb, ${accent} 35%, transparent);`}
          >
            <p class="text-2xl font-serif font-bold mb-3 tabular-nums" style={`color: ${accent};`}>
              {unitNum}
            </p>
            <h3 class="font-serif text-base font-bold text-[#f2e8d5] leading-snug mb-1">
              {period}
            </h3>
            <p class="text-xs text-[#a09070] mb-3">{dates}</p>
            {core_text ? (
              <span
                class="inline-block text-xs font-medium px-2 py-0.5 rounded"
                style={`background-color: color-mix(in srgb, ${accent} 18%, #1a140c); color: ${accent};`}
              >
                <em>{core_text}</em>
                {author ? ` — ${author}` : ''}
              </span>
            ) : (
              <span class="inline-block text-xs text-[#6e5e48] italic">Foundation unit</span>
            )}
          </a>
        );
      })}
    </div>
  </section>

  <!-- ── Shared resources ───────────────────────────────────────────── -->
  <section class="max-w-5xl mx-auto px-6 pb-16">
    <h2 class="text-xs font-semibold tracking-widest uppercase text-[#6e5e48] mb-6">
      Shared Resources
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

      <a
        href="/timeline"
        class="group block rounded-xl border border-[#3d2e1a] p-5 transition hover:border-[#5a4830]"
        style="background-color: #231a0f;"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold text-amber-400" style="background-color: #2e2212;">
            →
          </div>
          <h3 class="font-serif font-bold text-[#f2e8d5]">Historical Timeline</h3>
        </div>
        <p class="text-sm text-[#a09070] leading-relaxed">
          Political and cultural landmarks from 1590 to 1955, with all five core texts placed in their historical context.
        </p>
      </a>

      <a
        href="/people"
        class="group block rounded-xl border border-[#3d2e1a] p-5 transition hover:border-[#5a4830]"
        style="background-color: #231a0f;"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-8 h-8 rounded-lg flex items-center justify-center text-sm font-bold text-amber-400" style="background-color: #2e2212;">
            P
          </div>
          <h3 class="font-serif font-bold text-[#f2e8d5]">Biographical Index</h3>
        </div>
        <p class="text-sm text-[#a09070] leading-relaxed">
          Forty-plus writers, philosophers, artists, and composers referenced across all six units, with biographical sketches and course significance.
        </p>
      </a>

    </div>
  </section>

</Layout>
