---
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BioLink from '../components/BioLink.astro';
import ThreadIcon from '../components/ThreadIcon.astro';

const UNIT_IDS = [
  '00-medieval',
  '01-renaissance',
  '02-baroque',
  '03-enlightenment',
  '04-romanticism',
  '05-modernism',
] as const;

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#5b82c8',
  '01-renaissance':   '#e8a820',
  '02-baroque':       '#dc5f6c',
  '03-enlightenment': '#48a0e0',
  '04-romanticism':   '#b978d2',
  '05-modernism':     '#3aa87a',
};

const THREAD_COLORS = ['#e09438', '#c84068', '#48a888'];

const NAV_LABELS: Record<string, string> = {
  '00-medieval':      'Medieval',
  '01-renaissance':   'Renaissance',
  '02-baroque':       'Baroque',
  '03-enlightenment': 'Enlightenment',
  '04-romanticism':   'Romanticism',
  '05-modernism':     'Modernism',
};

// Load all art entries in parallel
const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/art`)));
const rendered = await Promise.all(entries.map((e) => render(e)));
---

<Layout title="Seeing Through Paint — AP Literature">

  <!-- ── Hero ─────────────────────────────────────────────────────────────── -->
  <section class="border-b border-[#3d2e1a]">
    <div class="max-w-5xl mx-auto px-6 py-12 md:py-16">
      <p class="text-xs font-semibold tracking-widest uppercase text-amber-600 mb-3">Shared Resource · Visual Art</p>
      <h1 class="font-serif text-3xl md:text-4xl font-bold text-[#f2e8d5] leading-tight mb-4">
        Seeing Through Paint
      </h1>
      <p class="text-[#a09070] text-base leading-relaxed max-w-2xl">
        A complete guide to the visual art of each period, from the gold-ground certainties of medieval painting through Modernism's shattering of the picture plane. Three threads — Figure &amp; Space, Light &amp; Shadow, and Brushwork &amp; Surface — run continuously through all six periods. Follow them from start to finish, or jump to any period below.
      </p>
    </div>
  </section>

  <!-- ── Sticky period nav ─────────────────────────────────────────────────── -->
  <div class="sticky top-[53px] z-30 bg-[#1a140c]/95 backdrop-blur-sm border-b border-[#3d2e1a] overflow-x-auto">
    <div class="max-w-5xl mx-auto px-6">
      <nav class="flex gap-1 py-2 min-w-max" aria-label="Jump to period">
        {UNIT_IDS.map((id) => {
          const accent = UNIT_ACCENTS[id];
          const anchor = id.slice(3); // e.g. "medieval"
          return (
            <a
              href={`#${anchor}`}
              class="period-nav-link px-3 py-1.5 rounded-lg text-xs font-medium transition-colors text-[#a09070] hover:text-[#f2e8d5] whitespace-nowrap"
              data-anchor={anchor}
              style={`--accent: ${accent};`}
            >
              {NAV_LABELS[id]}
            </a>
          );
        })}
      </nav>
    </div>
  </div>

  <!-- ── Period sections ───────────────────────────────────────────────────── -->
  <main class="max-w-5xl mx-auto px-6">
    {entries.map((entry, i) => {
      const { Content } = rendered[i];
      const unitId = entry.data.unit;
      const accent = UNIT_ACCENTS[unitId] ?? '#d4a820';
      const num = unitId.slice(0, 2);
      const anchor = unitId.slice(3); // e.g. "medieval"
      const hero = entry.data.hero_painting;
      const gallery = entry.data.gallery_paintings ?? [];
      const isLast = i === entries.length - 1;

      return (
        <>
          <!-- Period header -->
          <div
            id={anchor}
            class="pt-14 pb-6 scroll-mt-24"
          >
            <div class="flex items-baseline gap-3 mb-1">
              <span
                class="font-serif text-3xl font-bold tabular-nums"
                style={`color: ${accent};`}
              >{num}</span>
              <div>
                <h2 class="font-serif text-2xl font-bold text-[#f2e8d5]">{entry.data.period}</h2>
                <p class="text-sm text-[#a5967d]">{entry.data.dates}</p>
              </div>
            </div>
            {entry.data.core_text && (
              <span
                class="inline-block mt-2 text-xs font-medium px-2.5 py-1 rounded"
                style={`background-color: color-mix(in srgb, ${accent} 14%, #1a140c); color: ${accent};`}
              >
                Core text: <em>{entry.data.core_text}</em>
                {entry.data.author ? ` — ${entry.data.author}` : ''}
              </span>
            )}
          </div>

          <!-- Hero painting -->
          {hero?.image && (
            <figure class="mb-8">
              <div
                class="rounded-xl overflow-hidden flex items-center justify-center"
                style="max-height: 540px; background-color: #0e0b06; padding: 6px; border: 1px solid rgba(180,165,140,0.25);"
              >
                <img
                  src={hero.image}
                  alt={hero.title}
                  class="w-full h-full object-contain rounded-lg"
                  style="max-height: 528px;"
                  loading="lazy"
                />
              </div>
              <figcaption class="mt-3 text-center">
                <p class="font-serif italic text-sm text-[#f2e8d5]">{hero.title}</p>
                <p class="text-xs text-[#a09070] mt-0.5">{hero.artist}</p>
                <p class="text-xs text-[#a5967d] mt-0.5">
                  {hero.date}
                  {hero.medium && <span> · {hero.medium}</span>}
                  {hero.location && <span> · {hero.location}</span>}
                </p>
              </figcaption>
            </figure>
          )}

          <!-- Prose + sidebar -->
          <div class="lg:grid lg:grid-cols-[1fr_260px] lg:gap-12 pb-10">

            <!-- Main prose -->
            <div class="prose prose-stone prose-invert prose-headings:font-serif prose-headings:font-bold prose-h2:text-xl prose-h2:mt-10 prose-h2:mb-3 prose-h3:text-base prose-p:leading-relaxed max-w-none" style={`--prose-drop-cap-color: ${accent};`}>
              <Content components={{ BioLink }} />
            </div>

            <!-- Sidebar -->
            <aside class="mt-10 lg:mt-0 space-y-6">

              <!-- Thread summaries -->
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-widest text-[#a5967d] mb-3">Threads</h3>
                <div class="space-y-2">
                  {entry.data.threads.map((t, ti) => {
                    const tc = THREAD_COLORS[ti % THREAD_COLORS.length];
                    return (
                      <div
                        class="border rounded-lg p-3"
                        style={`background-color: color-mix(in srgb, ${tc} 14%, #1a140c); border-color: color-mix(in srgb, ${tc} 45%, transparent);`}
                      >
                        <p class="text-xs font-semibold mb-1 flex items-center gap-1.5" style={`color: ${tc};`}><ThreadIcon thread={t.id} size={16} />{t.label}</p>
                        <p class="text-xs text-[#a09070] leading-relaxed">{t.period_summary}</p>
                      </div>
                    );
                  })}
                </div>
              </div>

              <!-- Gallery paintings -->
              {gallery.length > 0 && (
                <div>
                  <h3 class="text-xs font-semibold uppercase tracking-widest text-[#a5967d] mb-3">Gallery</h3>
                  <div class="space-y-4">
                    {gallery.map((p) => (
                      <figure class="group">
                        {p.image && (
                          <div class="rounded-lg overflow-hidden mb-1.5" style="background-color: #0e0b06; padding: 4px; border: 1px solid rgba(180,165,140,0.2);">
                            <img
                              src={p.image}
                              alt={p.title}
                              class="w-full object-contain rounded transition-transform duration-300 group-hover:scale-[1.02]"
                              style="max-height: 176px;"
                              loading="lazy"
                            />
                          </div>
                        )}
                        <figcaption class="mt-1">
                          <p class="text-xs font-serif italic text-[#f2e8d5] leading-snug">{p.title}</p>
                          <p class="text-xs text-[#a5967d]">{p.artist} · {p.date}</p>
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                </div>
              )}

              <!-- Link to full unit -->
              <a
                href={`/units/${unitId}`}
                class="block text-xs text-center py-2 px-3 rounded-lg border transition-colors hover:brightness-125"
                style={`color: ${accent}; border-color: color-mix(in srgb, ${accent} 30%, transparent); background-color: color-mix(in srgb, ${accent} 8%, #1a140c);`}
              >
                Full {entry.data.period} unit →
              </a>

            </aside>
          </div>

          <!-- Divider between periods -->
          {!isLast && (
            <hr class="border-0 border-t border-[#3d2e1a] my-2" />
          )}
        </>
      );
    })}
  </main>

  <!-- ── Footer ────────────────────────────────────────────────────────────── -->
  <footer class="border-t border-[#3d2e1a] mt-8">
    <div class="max-w-5xl mx-auto px-6 py-8 flex flex-wrap gap-4 justify-between items-center">
      <a href="/" class="text-sm text-[#a09070] hover:text-[#f2e8d5] transition-colors">← Home</a>
      <a href="/hearing-through-form" class="text-sm text-[#a09070] hover:text-[#f2e8d5] transition-colors">
        Hearing Through Form →
      </a>
    </div>
  </footer>

</Layout>

<script>
  // Highlight active period in the sticky nav based on scroll position
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.period-nav-link');
  const sections = document.querySelectorAll<HTMLElement>('[id]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.id;
          navLinks.forEach((link) => {
            const isActive = link.dataset.anchor === id;
            if (isActive) {
              link.style.backgroundColor = `color-mix(in srgb, var(--accent) 18%, #1a140c)`;
              link.style.color = `var(--accent)`;
            } else {
              link.style.backgroundColor = '';
              link.style.color = '';
            }
          });
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sections.forEach((sec) => observer.observe(sec));
</script>
