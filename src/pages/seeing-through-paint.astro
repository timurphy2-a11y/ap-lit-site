---
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ThreadIcon from '../components/ThreadIcon.astro';

const UNIT_IDS = [
  '00-medieval', '01-renaissance', '02-baroque',
  '03-enlightenment', '04-romanticism', '05-modernism',
] as const;

const UNIT_ACCENTS: Record<string, string> = {
  '00-medieval':      '#3f6cc8',
  '01-renaissance':   '#c98a18',
  '02-baroque':       '#c64254',
  '03-enlightenment': '#2a9bb0',
  '04-romanticism':   '#b8438c',
  '05-modernism':     '#2d9560',
};

const THREAD_COLORS = ['#c98a18', '#a57014', '#e0a028'];

const THREADS = [
  {
    id: 'figure-space',
    label: 'Figure & Space',
    question: 'How does the painting represent space, and what is the relationship of the human figure to the world it inhabits?',
    arc: "The story this thread tells is the story of Western painting's ambition to represent space — and ultimately, its abandonment of that ambition. The medieval painter places figures on a flat, symbolic ground: spatial depth is irrelevant because the real space being mapped is spiritual hierarchy, not physical distance. The Renaissance invents a rational system for representing three-dimensional space on a flat surface, and the figure steps confidently into it — standing on solid ground, inhabiting a world the viewer could in principle walk through. The Baroque keeps perspectival space but charges it with instability: figures twist, surge, and emerge from shadow in compositions that feel dynamic and vertiginous. The Enlightenment brings the figure indoors, into intimate, legible social spaces where people perform for each other. Romanticism reverses the Renaissance hierarchy: the figure shrinks until it is almost nothing against an immensity of sky, mountain, and sea that no rational system can contain. Modernism completes the reversal, shattering the unified picture plane itself — showing multiple viewpoints simultaneously, dissolving the figure into geometry, asking whether a coherent represented space was ever anything more than a convention.",
  },
  {
    id: 'light-shadow',
    label: 'Light & Shadow',
    question: "Where does light come from, how does it fall, and what does the painter's handling of illumination reveal about the culture's assumptions?",
    arc: "The story this thread tells is the story of what light means — and of the moment painting realized that light is not a given but a choice. For medieval painters, light is not a physical phenomenon at all: it is the intrinsic radiance of the sacred, uniform, omnidirectional, shadowless — the visual equivalent of divine truth that illuminates everything equally without casting darkness on anything. The Renaissance naturalizes light: it comes from somewhere specific, casts shadows that reveal the volume of forms, and makes the world look as an informed observer would actually see it. The Baroque weaponizes light's opposite: tenebrism reduces the world to near-total darkness, then picks out a single crucial action in a concentrated beam, making light itself the drama. The Enlightenment relaxes into soft, diffuse, flattering illumination — a pastel world where irony hides beneath the charm. Romanticism releases light into weather and atmosphere: Turner's skies are not lit by a source so much as constituted by light itself, form dissolving into radiance. Modernism dismantles the system entirely, first decomposing light into its component colors, then producing luminosity from paint alone, with no reference to any external source.",
  },
  {
    id: 'brushwork-surface',
    label: 'Brushwork & Surface',
    question: "Is the painter's hand visible? What does the texture and treatment of the painted surface declare about art, craft, and individual expression?",
    arc: "The story this thread tells is the story of the painter's hand — when it became visible, and what that visibility meant. For the medieval craftsman, the individual touch is precisely what must not appear: the goal is fidelity to tradition and devotion to the sacred subject, and the seamless, anonymous surface is the visual proof of that subordination. Renaissance painting achieves a different kind of invisibility: oil paint, used with extraordinary skill, creates surfaces of such smooth, continuous illusion that the medium disappears entirely behind the image — the rational mind, it claims, can reproduce reality without a trace of its own presence. The Baroque splits this convention: Vermeer perfects the Renaissance ideal of luminous, seamless surface, while Rembrandt's thick impasto makes the paint itself a physical presence, a texture the eye can almost feel. The Enlightenment returns to refined, decorative fluency — surfaces that shimmer with the exquisite ease of silk and lacework. Romanticism makes the hand conspicuous and purposeful: visible, energetic brushwork stops merely depicting a storm and starts behaving like one, embodying emotion rather than representing it. Modernism declares the surface not a means to an end but the subject itself — what Rembrandt introduced, modernism makes explicit and final: a painting is a flat surface covered with paint, and the mark of the maker is everything.",
  },
];

const entries = await Promise.all(UNIT_IDS.map((id) => getEntry('units', `${id}/art`)));
---

<Layout title="Seeing Through Paint — AP Literature">

<!-- ── Hero ──────────────────────────────────────────────────────────────── -->
<section class="g-hero">
  <div class="g-wrap">
    <p class="g-label">§ III &nbsp;·&nbsp; Shared Resource &nbsp;·&nbsp; Visual Art</p>
    <h1 class="g-title">Seeing Through Paint</h1>
    <p class="g-thesis">
      A complete guide to the visual art of each period, from the gold-ground certainties of medieval
      painting through Modernism's shattering of the picture plane. Three threads — Figure &amp; Space,
      Light &amp; Shadow, and Brushwork &amp; Surface — run continuously through all six periods.
      Follow them from start to finish, or jump to any thread below.
    </p>
  </div>
</section>

<!-- ── Sticky thread nav ─────────────────────────────────────────────────── -->
<div class="g-nav-bar">
  <div class="g-wrap">
    <nav class="g-nav" aria-label="Jump to thread">
      {THREADS.map((thread, ti) => (
        <a
          href={`#${thread.id}`}
          class="g-nav-link thread-nav-link"
          data-anchor={thread.id}
          style={`--accent: ${THREAD_COLORS[ti]};`}
        >
          <ThreadIcon thread={thread.id} size={24} />
          {thread.label}
        </a>
      ))}
    </nav>
  </div>
</div>

<!-- ── Introduction ──────────────────────────────────────────────────────── -->
<div class="g-wrap">
  <div class="g-intro">
    <p>
      Painting is the art form that most directly records the assumptions of its culture about what
      the world looks like and how it should be represented. The choices a painter makes about space,
      light, and the physical act of painting are never merely aesthetic — they are arguments about
      perception, reality, and the relationship between the observer and the observed.
    </p>
    <p>
      This guide traces three analytical threads across six historical periods, from the medieval
      gold ground to the Modernist canvas. Reading each thread as a continuous arc — rather than
      encountering the periods one by one — makes visible something that individual unit pages cannot:
      the story of how Western culture has understood the act of seeing, and what painting is for.
    </p>
  </div>
</div>

<!-- ── Thread sections ───────────────────────────────────────────────────── -->
<main class="g-wrap">
  {THREADS.map((thread, ti) => {
    const tc = THREAD_COLORS[ti];
    const isLast = ti === THREADS.length - 1;

    return (
      <>
        <div id={thread.id} class="g-thread-head">
          <div class="g-thread-eyebrow">
            <ThreadIcon thread={thread.id} size={34} />
            <h2 class="g-thread-name">{thread.label}</h2>
          </div>
          <p class="g-thread-question">{thread.question}</p>
        </div>

        <div class="g-arc-block" style={`--tc: ${tc}`}>
          <span class="g-arc-kicker">The story this thread tells</span>
          {' '}{thread.arc.replace('The story this thread tells', '').trimStart()}
        </div>

        <div class="g-card-grid">
          {entries.map((entry) => {
            const unitId = entry.data.unit;
            const uAccent = UNIT_ACCENTS[unitId] ?? '#A07820';
            const num = unitId.slice(0, 2);
            const periodThread = entry.data.threads.find((t: { id: string }) => t.id === thread.id);
            const hero = entry.data.hero_painting;

            return (
              <article class="g-scard" style={`--u-acc: ${uAccent}`}>
                <div class="g-scard-swatch"></div>
                {hero?.image && (
                  <a href={`/units/${unitId}/art`} class="g-scard-img-wrap">
                    <img src={hero.image} alt={`${hero.title} by ${hero.artist}`} loading="lazy" />
                  </a>
                )}
                <div class="g-scard-body">
                  <div class="g-scard-eyebrow">
                    <span class="g-scard-num">{num}</span>
                    <div>
                      <div class="g-scard-period">{entry.data.period}</div>
                      <span class="g-scard-dates">{entry.data.dates}</span>
                    </div>
                  </div>
                  {periodThread && <p class="g-scard-summary">{periodThread.period_summary}</p>}
                  {hero && (
                    <div class="g-scard-work">
                      <em>{hero.title}</em>
                      <span class="g-scard-artist">{hero.artist}</span>
                    </div>
                  )}
                  <a href={`/units/${unitId}/art`} class="g-scard-link">
                    Full {entry.data.period} unit →
                  </a>
                </div>
              </article>
            );
          })}
        </div>

        {!isLast && <hr class="g-divider" />}
      </>
    );
  })}
</main>

<!-- ── Footer ────────────────────────────────────────────────────────────── -->
<footer class="g-footer">
  <div class="g-wrap">
    <div class="g-footer-inner">
      <a href="/">← Home</a>
      <div class="g-footer-links">
        <a href="/sculpting-through-time">Sculpting Through Time</a>
        <a href="/hearing-through-form">Hearing Through Form</a>
      </div>
    </div>
  </div>
</footer>

</Layout>

<style>
  .g-wrap { max-width: 1100px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 64px); }

  /* ── Hero ─────────────────────────────────────────────────────── */
  .g-hero { padding: 64px 0 56px; border-bottom: 1px solid var(--rule); }
  .g-label {
    font-family: var(--font-ui);
    font-size: 11.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 28px;
  }
  .g-title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 0.98;
    letter-spacing: -0.02em;
    margin: 0 0 28px;
    color: var(--ink);
  }
  .g-thesis {
    max-width: 58ch;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.65;
    color: var(--ink-mute);
    margin: 0;
  }

  /* ── Sticky nav ───────────────────────────────────────────────── */
  .g-nav-bar { position: sticky; top: 57px; z-index: 30; background: var(--bg); border-bottom: 1px solid var(--rule); overflow-x: auto; }
  .g-nav { display: flex; gap: 8px; padding: 10px 0; white-space: nowrap; align-items: center; }
  .g-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 10px 18px;
    color: var(--ink-soft);
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    transition: color 150ms, background 150ms, border-color 150ms;
    white-space: nowrap;
  }
  .g-nav-link:hover {
    color: var(--ink);
    border-color: color-mix(in oklab, var(--accent) 45%, transparent);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
  }
  .g-nav-link.active {
    color: var(--accent);
    border-color: color-mix(in oklab, var(--accent) 55%, transparent);
    background: color-mix(in oklab, var(--accent) 14%, transparent);
  }

  /* ── Intro ────────────────────────────────────────────────────── */
  .g-intro {
    max-width: 72ch;
    padding: 48px 0 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .g-intro p {
    font-family: var(--font-display);
    font-size: 16px;
    line-height: 1.75;
    color: var(--ink-mute);
  }
  .g-intro p:first-child { color: var(--ink); }

  /* ── Thread heading ───────────────────────────────────────────── */
  .g-thread-head { padding: 40px 0 16px; scroll-margin-top: 110px; }
  .g-thread-eyebrow { display: flex; align-items: center; gap: 12px; margin-bottom: 8px; }
  .g-thread-name { font-family: var(--font-display); font-weight: 400; font-size: 32px; color: var(--ink); margin: 0; }
  .g-thread-question { font-family: var(--font-display); font-style: italic; font-size: 17px; color: var(--ink-soft); margin: 0; padding-left: 46px; }

  /* ── Arc block ────────────────────────────────────────────────── */
  .g-arc-block {
    margin: 16px 0 28px;
    padding: 18px 22px;
    border: 1px solid color-mix(in oklab, var(--tc) 30%, transparent);
    background: color-mix(in oklab, var(--tc) 7%, transparent);
    font-family: var(--font-display);
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--ink-mute);
  }
  .g-arc-kicker { font-weight: 600; color: var(--tc); }

  /* ── Card grid ────────────────────────────────────────────────── */
  .g-card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--rule);
    border: 1px solid var(--rule);
    margin-bottom: 48px;
  }
  @media (max-width: 900px) { .g-card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .g-card-grid { grid-template-columns: 1fr; } }

  /* ── Painting card ────────────────────────────────────────────── */
  .g-scard { position: relative; display: flex; flex-direction: column; background: var(--bg-raised); overflow: hidden; transition: background 200ms; }
  .g-scard:hover { background: #E0D5BD; }
  .g-scard-swatch { position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--u-acc); z-index: 1; }
  .g-scard-img-wrap { display: block; position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--bg-sunken); }
  .g-scard-img-wrap img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .g-scard-img-wrap::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 50%, rgba(20,17,16,.5) 100%); pointer-events: none; }
  .g-scard-body { padding: 20px 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .g-scard-eyebrow { display: flex; align-items: baseline; gap: 12px; }
  .g-scard-num { font-family: var(--font-display); font-weight: 300; font-size: 40px; line-height: 1; color: var(--u-acc); flex-shrink: 0; }
  .g-scard-period { font-family: var(--font-display); font-weight: 400; font-size: 19px; color: var(--ink); line-height: 1.2; }
  .g-scard-dates { display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; color: var(--ink-soft); margin-top: 3px; }
  .g-scard-summary { font-family: var(--font-display); font-size: 15px; line-height: 1.65; color: var(--ink-mute); flex: 1; }
  .g-scard-work { padding-top: 12px; border-top: 1px solid var(--rule); font-family: var(--font-display); font-size: 14px; color: var(--ink-mute); }
  .g-scard-work em { color: var(--ink); font-style: italic; }
  .g-scard-artist { display: block; font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 4px; }
  .g-scard-link { font-family: var(--font-ui); font-size: 13px; letter-spacing: 0.04em; color: var(--ink-soft); transition: color 150ms; margin-top: auto; }
  .g-scard-link:hover { color: var(--ink); }

  /* ── Divider / footer ─────────────────────────────────────────── */
  .g-divider { border: none; border-top: 1px solid var(--rule); margin: 8px 0; }
  .g-footer { margin-top: 48px; border-top: 1px solid var(--rule); }
  .g-footer-inner { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; padding: 24px 0; }
  .g-footer-links { display: flex; gap: 24px; }
  .g-footer a, .g-footer-links a { font-family: var(--font-ui); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-soft); transition: color 150ms; }
  .g-footer a:hover, .g-footer-links a:hover { color: var(--ink); }
</style>

<script>
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.thread-nav-link');
  const sectionIds = ['figure-space', 'light-shadow', 'brushwork-surface'];

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          const id = e.target.id;
          navLinks.forEach((link) => link.classList.toggle('active', link.dataset.anchor === id));
        }
      });
    },
    { rootMargin: '-20% 0px -70% 0px' }
  );

  sectionIds.forEach((id) => {
    const el = document.getElementById(id);
    if (el) observer.observe(el);
  });
</script>
