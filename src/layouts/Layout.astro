---
import '../styles/global.css';
import { PEOPLE } from '../components/BiographyPanel.jsx';

interface Props {
  title: string;
}

const { title } = Astro.props;
const peopleJson = JSON.stringify(PEOPLE);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,300;0,400;0,500;1,400;1,500&family=IBM+Plex+Sans:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="topbar">
      <a href="/" class="brand">AP Literature</a>
      <nav class="nav">
        <a href="/timeline">Timeline</a>
        <a href="/people">People</a>
        <a href="/compare">Compare</a>
        <a href="/seeing-through-paint">Painting</a>
        <a href="/sculpting-through-time">Sculpture</a>
        <a href="/hearing-through-form">Music</a>
      </nav>
    </div>

    <slot />

    <!-- Bio modal -->
    <div
      id="bio-modal"
      class="bio-modal"
      role="dialog"
      aria-modal="true"
    >
      <div id="bio-backdrop" class="bio-backdrop"></div>
      <div class="bio-panel">
        <button id="bio-close" class="bio-close" aria-label="Close">×</button>
        <div class="bio-header">
          <img id="bio-portrait" src="" alt="" class="bio-portrait hidden" />
          <div class="bio-meta">
            <p id="bio-field" class="bio-field"></p>
            <h2 id="bio-name" class="bio-name"></h2>
            <p id="bio-dates" class="bio-dates"></p>
          </div>
        </div>
        <p id="bio-bio" class="bio-body"></p>
        <p id="bio-significance" class="bio-sig"></p>
      </div>
    </div>

    <script define:vars={{ peopleJson }}>
      const PEOPLE = JSON.parse(peopleJson);
      const modal    = document.getElementById('bio-modal');
      const backdrop = document.getElementById('bio-backdrop');
      const closeBtn = document.getElementById('bio-close');

      function openModal(id) {
        const person = PEOPLE.find((p) => p.id === id);
        if (!person || !modal) return;
        document.getElementById('bio-field').textContent        = person.field ?? '';
        document.getElementById('bio-name').textContent         = person.name;
        document.getElementById('bio-dates').textContent        = person.dates ?? '';
        document.getElementById('bio-bio').textContent          = person.bio ?? '';
        document.getElementById('bio-significance').textContent = person.significance ?? '';
        const portrait = document.getElementById('bio-portrait');
        if (person.portrait) {
          portrait.src = person.portrait;
          portrait.alt = person.name;
          portrait.classList.remove('hidden');
        } else {
          portrait.classList.add('hidden');
        }
        modal.classList.remove('hidden');
        modal.classList.add('open');
      }

      function closeModal() {
        modal.classList.add('hidden');
        modal.classList.remove('open');
      }

      document.addEventListener('click', (e) => {
        const btn = e.target.closest('.bio-link-btn');
        if (btn) openModal(btn.dataset.bioId);
      });

      closeBtn?.addEventListener('click', closeModal);
      backdrop?.addEventListener('click', closeModal);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });
    </script>
  </body>
</html>

<style is:global>
  /* ── Design tokens ───────────────────────────────────────────────── */
  :root {
    /* Surfaces (warm cream paper) */
    --bg:          #F4EDDF;
    --bg-raised:   #EBE2D0;
    --bg-sunken:   #FAF4E6;

    /* Ink (warm dark brown) */
    --ink:         #1B1714;
    --ink-mute:    #4a4138;
    --ink-soft:    #6a6053;

    /* Rules / borders */
    --rule:        #C9BDA5;
    --rule-strong: #A89978;

    /* Default accent (gold leaf, darkened for paper) */
    --acc:         #A07820;

    /* Per-period accents */
    --acc-medieval:       #C9A24B;
    --acc-renaissance:    #B54C3A;
    --acc-baroque:        #B07028;
    --acc-enlightenment:  #698BA1;
    --acc-romanticism:    #3D5A6D;
    --acc-modernism:      #A03828;

    /* Dark-mode tokens kept for reference only */
    --bg-dark:           #141110;
    --bg-dark-raised:    #1b1714;
    --bg-dark-sunken:    #0d0b0a;
    --ink-dark:          #E8DFD0;
    --rule-dark:         #3A332C;
    --acc-medieval-dark:      #5b82c8;
    --acc-renaissance-dark:   #e8a820;
    --acc-baroque-dark:       #dc5f6c;
    --acc-enlightenment-dark: #48a0e0;
    --acc-romanticism-dark:   #b978d2;
    --acc-modernism-dark:     #3aa87a;

    --font-display: 'Spectral', 'Source Serif Pro', Georgia, serif;
    --font-ui:      'IBM Plex Sans', system-ui, sans-serif;
    --font-mono:    'IBM Plex Mono', ui-monospace, monospace;

    --gutter: clamp(20px, 4vw, 64px);
    --col:    min(860px, 100%);
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 18px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  a { color: inherit; text-decoration: none; }

  /* ── Top nav ─────────────────────────────────────────────────────── */
  .topbar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 22px var(--gutter) 18px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: 14px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    overflow-x: auto;
    white-space: nowrap;
  }
  .brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-style: italic;
    font-size: 16px;
    letter-spacing: 0.02em;
    text-transform: none;
    color: var(--ink);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .nav { display: flex; gap: 24px; flex-shrink: 0; }
  .nav a:hover { color: var(--ink); transition: color 150ms ease; }

  /* ── Bio modal ───────────────────────────────────────────────────── */
  .bio-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .bio-modal.open { display: flex; }

  .bio-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(4px);
  }

  .bio-panel {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 480px;
    border: 1px solid var(--rule-strong);
    background: var(--bg-raised);
    padding: 28px;
    box-shadow: 0 24px 64px rgba(0,0,0,.6);
  }

  .bio-close {
    position: absolute;
    right: 16px;
    top: 14px;
    background: none;
    border: none;
    color: var(--ink-soft);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    padding: 2px 6px;
  }
  .bio-close:hover { color: var(--ink); }

  .bio-header {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
  }

  .bio-portrait {
    width: 72px;
    height: 72px;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--rule);
  }
  .bio-portrait.hidden { display: none; }

  .bio-field {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--acc);
    margin-bottom: 4px;
  }

  .bio-name {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.15;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .bio-dates {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-soft);
  }

  .bio-body {
    font-family: var(--font-display);
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink-mute);
    margin-bottom: 14px;
  }

  .bio-sig {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--ink);
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }
</style>
