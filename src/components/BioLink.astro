---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<button
  class="bio-link-btn"
  data-bio-id={id}
  type="button"
><slot /></button>

<style>
  .bio-link-btn {
    display: inline;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: #e8a820;
    text-decoration: underline;
    text-decoration-style: dotted;
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 0.15s;
  }
  .bio-link-btn:hover {
    color: #f2cc6e;
  }
</style>
