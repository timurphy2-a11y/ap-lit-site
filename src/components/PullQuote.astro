---
interface Props {
  attribution?: string;
}
const { attribution } = Astro.props;
---
<blockquote class="pull-quote not-prose">
  <p class="pull-quote-text"><slot /></p>
  {attribution && <cite class="pull-quote-cite">{attribution}</cite>}
</blockquote>

<style>
  .pull-quote {
    border-left: 3px solid var(--thread-acc, var(--acc));
    padding: 0.9rem 1.25rem 0.9rem 1.1rem;
    margin: 2rem 0;
    background-color: color-mix(in oklab, var(--thread-acc, var(--acc)) 6%, var(--bg));
    border-radius: 0;
  }
  .pull-quote-text {
    font-size: 1.05em;
    line-height: 1.6;
    color: var(--ink-mute);
    font-style: italic;
    margin: 0;
  }
  .pull-quote-cite {
    display: block;
    text-align: right;
    font-size: 0.8em;
    font-style: normal;
    color: var(--ink-soft);
    margin-top: 0.6rem;
  }
</style>
