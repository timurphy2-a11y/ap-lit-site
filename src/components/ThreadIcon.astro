---
import { THREAD_ICONS } from './threadIcons';

interface Props {
  thread: string;
  size?: number;
  class?: string;
}

const { thread, size = 24, class: className = '' } = Astro.props;
const icon = THREAD_ICONS[thread];
---

{icon ? (
  <svg
    width={size}
    height={size}
    viewBox={icon.viewBox}
    aria-hidden="true"
    class={`thread-icon inline-block flex-shrink-0 ${className}`}
    style={`color: ${icon.color};`}
    set:html={icon.content}
  />
) : null}
