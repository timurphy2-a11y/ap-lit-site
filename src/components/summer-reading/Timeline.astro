---
// Timeline.astro
// Right-rail vertical timeline component.
// Spec: 04-spoke-page.md — year labels, stem, tick marks, event text.

interface TimelineEvent {
  year:       string;
  label:      string;
  highlight?: boolean;
}

interface Props {
  events:  TimelineEvent[];
  accent?: 'pachinko' | 'tfa';
  eyebrow?: string;
}

const { events, accent = 'pachinko', eyebrow } = Astro.props;
const accentColor = accent === 'tfa' ? 'var(--t-terra)' : 'var(--p-teal)';
const eyebrowColor = accent === 'tfa' ? 'var(--t-ochre)' : 'var(--p-orange)';
---

<aside class="sr-timeline-rail">
  {eyebrow && (
    <p class="sr-timeline-rail-eyebrow" style={`color: ${eyebrowColor}`}>{eyebrow}</p>
  )}
  <div class="sr-timeline-rail-inner">
    <!-- Vertical stem -->
    <div class="sr-timeline-stem"></div>

    {events.map(({ year, label, highlight }) => (
      <div class={`sr-timeline-rail-entry${highlight ? ' highlight' : ''}`}>
        <div
          class="sr-timeline-rail-year"
          style={highlight ? `color: ${accentColor}` : ''}
        >
          {year}
        </div>
        <div
          class="sr-timeline-rail-tick"
          style={highlight ? `background: ${accentColor}` : ''}
        ></div>
        <div class="sr-timeline-rail-label">{label}</div>
      </div>
    ))}
  </div>
</aside>

<style>
  .sr-timeline-rail {
    font-family: var(--font-body);
    margin-bottom: var(--s-6);
  }

  .sr-timeline-rail-eyebrow {
    font-family:    var(--font-mono);
    font-size:      var(--t-eyebrow);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--color-muted);
    margin:         0 0 var(--s-4);
  }

  .sr-timeline-rail-inner {
    position: relative;
    padding-left: 3.5rem;
  }

  .sr-timeline-stem {
    position:   absolute;
    left:       3.5rem;
    top:        0;
    bottom:     0;
    width:      1px;
    background: var(--color-rule);
  }

  .sr-timeline-rail-entry {
    display:        grid;
    grid-template-columns: 3rem 1rem 1fr;
    gap:            0;
    align-items:    baseline;
    padding:        var(--s-2) 0;
    position:       relative;
    margin-left:    -3.5rem;
  }

  .sr-timeline-rail-year {
    font-family:  var(--font-mono);
    font-size:    0.6875rem; /* 11px */
    color:        var(--color-muted);
    text-align:   right;
    padding-right: var(--s-2);
    line-height:  1.4;
  }

  .sr-timeline-rail-tick {
    width:       1rem;
    height:      1px;
    background:  var(--color-rule);
    align-self:  center;
    flex-shrink: 0;
  }

  .sr-timeline-rail-label {
    font-family:  var(--font-body);
    font-size:    var(--t-meta);
    line-height:  var(--lh-meta);
    color:        var(--color-ink);
    padding-left: var(--s-3);
  }

  .sr-timeline-rail-entry.highlight .sr-timeline-rail-year {
    font-weight: 500;
  }

  .sr-timeline-rail-entry.highlight .sr-timeline-rail-label {
    color:       var(--color-ink);
    font-weight: 500;
  }
</style>
