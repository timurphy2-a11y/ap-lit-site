  <!-- Mt Fuji orientation mark -->
  <g stroke="#3B454F" stroke-width="0.9" fill="none" opacity="0.75">
    <path d="M 461,197.1 l 12,-22 l 12,22 Z" />
  </g>
  <text x="473" y="210.1" text-anchor="middle" class="jm-tag" style="font-size:7px;letter-spacing:.08em">Fuji</text>

  <!-- Region labels — Honshū plain (no letter-spacing) to preserve combining macron -->
