    <rect x="-8" y="-15" width="208" height="46" rx="2" fill="#F1EADA" opacity="0.72" />
    <rect x="0" y="-9" width="18" height="11" fill="url(#jmHatchJp)" stroke="#3B454F" stroke-width="1" />
