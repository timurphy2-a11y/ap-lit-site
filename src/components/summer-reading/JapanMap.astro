  <text x="104" y="348" text-anchor="middle" class="jm-region" style="font-size:12px;letter-spacing:.08em;fill:#2E3842">Shikoku</text>

  <!-- Compass -->
  <g transform="translate(672,58)" stroke="#5A4A30" fill="#5A4A30">
    <circle cx="0" cy="0" r="14" fill="none" stroke-width="0.75" opacity="0.5" />
