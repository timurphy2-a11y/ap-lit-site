    <path d="M 208.5,267.1 L 323.2,278.1 L 421.4,253.2 L 503.3,218.2 L 558.1,165" class="jm-route" />
    <path d="M 558.1,165 L 554.4,177 L 546,168.3 Z" fill="#9C6B2E" />
