---
// ScrollyZone.astro — Full-spoke scrollytelling zone wrapper.
// One mechanic: sticky visual field, beats fade through it.
// Two levers: `field` (visual type) and `tempo` (pacing preset).
// No per-zone animation or easing props — intentional by design.

import KoreaStraitMap from './KoreaStraitMap.astro';
import JapanMap from './JapanMap.astro';
import CosmologicalDescent from './CosmologicalDescent.astro';

interface Props {
  field: 'photo' | 'map' | 'cascade' | 'ground';
  tempo: 'contemplative' | 'steady' | 'driving' | 'still';
  image?: string;
  mapId?: 'korea-strait' | 'japan' | 'cosmo-descent';
  alt?: string;
  caption?: string;
  ground?: 'cream' | 'tinted';
  text?: 'pachinko' | 'tfa';
  portrait?: boolean;
}

const {
  field,
  tempo,
  image,
  mapId,
  alt,
  caption,
  ground = 'cream',
  text = 'pachinko',
  portrait = false,
} = Astro.props;
---

<section
  class={`sr-scrolly-zone sr-scrolly-zone--${field}`}
  data-field={field}
  data-tempo={tempo}
  data-ground={ground}
  data-text={text}
>

  {/* ── Photo field ─────────────────────────────────────────────────── */}
  {field === 'photo' && (
    <div class="sr-zone-field sr-zone-photo-field" aria-hidden="true">
      {image && (
        <img
          src={image}
          alt={alt ?? ''}
          class={`sr-zone-photo${portrait ? ' sr-zone-photo--portrait' : ''}`}
          loading="lazy"
          decoding="async"
        />
      )}
      {caption && (
        <div class="sr-zone-caption">{caption}</div>
      )}
    </div>
  )}

  {/* ── Map field ───────────────────────────────────────────────────── */}
  {field === 'map' && (
    <div class="sr-zone-field sr-zone-map-field" aria-hidden="true">
      {mapId === 'korea-strait' && <KoreaStraitMap />}
      {mapId === 'japan' && <JapanMap />}
      {mapId === 'cosmo-descent' && <CosmologicalDescent />}
    </div>
  )}

  {/* ── Cascade field: single-column wire; sr-cascade-entries wrapper is in the MDX ── */}
  {field === 'cascade' && (
    <div class="sr-zone-cascade-content">
      <slot />
    </div>
  )}

  {/* ── Beats overlay (photo and map zones) ─────────────────────────── */}
  {(field === 'photo' || field === 'map') && (
    <div class="sr-zone-beats">
      <slot />
    </div>
  )}

  {/* ── Ground zone: normal flow, no sticky ─────────────────────────── */}
  {field === 'ground' && (
    <div class="sr-zone-ground-content">
      <slot />
    </div>
  )}

</section>

<script>
  // Scrolly zone controller. Runs once (Astro deduplicates bundled scripts).
  // Respects reduced-motion and mobile breakpoint — CSS fallback handles static layout.

  function initScrollyZones(): void {
    const isReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const w = window.innerWidth;
    const isMobile = w > 0 && w < 768;
    if (isReduced || isMobile) return;

    // ── Cascade: position-driven playhead sweep ──────────────────────────
    // Robust to fast/jumped scrolls: IntersectionObserver only catches boundary
    // crossings, so a fling can skip entries and strand them dim. A scroll-driven
    // sweep re-evaluates every entry against the viewport midpoint on every tick.
    const cascadeSweeps: Array<() => void> = [];

    function initCascadeZone(zone: HTMLElement): void {
      const entries = Array.from(zone.querySelectorAll<HTMLElement>('.sr-cascade-entry'));
      const progress = zone.querySelector<HTMLElement>('.sr-zone-cascade-progress');
      if (!entries.length) return;

      function sweep(): void {
        const line = window.innerHeight * 0.5;
        let lastLit = -1;
        entries.forEach((el, i) => {
          const anchor = el.getBoundingClientRect().top + 8; // pin position
          const lit = anchor < line;
          const was = el.classList.contains('is-revealed');
          if (lit) {
            lastLit = i;
            if (!was) {
              el.classList.add('is-revealed');
              el.classList.remove('landed');
              void el.offsetWidth; // restart transition
              el.classList.add('landed');
            }
          } else if (was) {
            el.classList.remove('is-revealed', 'landed');
          }
        });
        entries.forEach((el, i) => el.classList.toggle('is-newest', i === lastLit));
        if (progress) {
          progress.style.height =
            Math.max(0, Math.round(((lastLit + 1) / entries.length) * 100)) + '%';
        }
      }

      cascadeSweeps.push(sweep);
      sweep();
    }

    let sweepQueued = false;
    function runCascadeSweeps(): void {
      if (sweepQueued) return;
      sweepQueued = true;
      requestAnimationFrame(() => {
        sweepQueued = false;
        cascadeSweeps.forEach(fn => fn());
      });
    }

    // ── Photo/map: one active beat at a time ─────────────────────────────
    const zones = document.querySelectorAll<HTMLElement>(
      '.sr-scrolly-zone:not([data-field="ground"])'
    );

    zones.forEach(zone => {
      const field = zone.querySelector<HTMLElement>('.sr-zone-field');
      const beats = zone.querySelectorAll<HTMLElement>('[data-beat]');
      if (!beats.length) return;

      if (zone.dataset.field === 'cascade') {
        initCascadeZone(zone);
      } else {
        beats[0].classList.add('is-active');
        if (field && beats[0].dataset.activates) {
          field.dataset.state = beats[0].dataset.activates;
        }

        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) return;
            beats.forEach(b => b.classList.remove('is-active'));
            const beat = entry.target as HTMLElement;
            beat.classList.add('is-active');
            const state = beat.dataset.activates;
            if (state && field) field.dataset.state = state;
          });
        }, {
          threshold: 0,
          rootMargin: '-38% 0px -38% 0px',
        });

        beats.forEach(beat => observer.observe(beat));
      }
    });

    if (cascadeSweeps.length) {
      window.addEventListener('scroll', runCascadeSweeps, { passive: true });
      window.addEventListener('resize', runCascadeSweeps);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollyZones);
  } else {
    initScrollyZones();
  }
</script>
