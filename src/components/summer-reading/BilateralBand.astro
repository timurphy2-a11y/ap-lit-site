---
// BilateralBand.astro
// Pachinko section divider — a row of small medallion circles
// alternating with hairline dots. aria-hidden (decorative).
interface Props {
  width?: number;
  height?: number;
}
const { width = 400, height = 20 } = Astro.props;
const cx = width / 2;
---
<svg
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="sr-bilateral-band"
>
  <!-- repeating unit: circle glyph · dot · circle glyph -->
  {Array.from({ length: 9 }, (_, i) => {
    const x = cx + (i - 4) * 44;
    const isCircle = i % 2 === 0;
    return isCircle ? (
      <g transform={`translate(${x}, ${height / 2})`}>
        <circle cx="0" cy="0" r="6" stroke="var(--p-teal)" stroke-width="1.5" />
        <circle cx="0" cy="0" r="2.5" fill="var(--p-teal)" />
      </g>
    ) : (
      <circle cx={x} cy={height / 2} r="1.5" fill="var(--color-rule)" />
    );
  })}
</svg>
