---
// Medallion.astro
// Pachinko corner mark — concentric circle medallion pattern.
// Positioned absolutely by the parent; aria-hidden (decorative).
interface Props {
  size?: number;
  fill?: string;
  opacity?: number;
}
const { size = 280, fill = 'var(--p-gold)', opacity = 0.16 } = Astro.props;
const cx = size / 2;
---
<svg
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="sr-medallion"
  style={`opacity: ${opacity};`}
>
  <!-- Concentric rings -->
  {[0.48, 0.38, 0.28, 0.18, 0.10].map((r) => (
    <circle
      cx={cx}
      cy={cx}
      r={cx * r * 2}
      stroke={fill}
      stroke-width="1.5"
    />
  ))}
  <!-- Eight-point star / spoke pattern -->
  {Array.from({ length: 8 }, (_, i) => {
    const angle = (i * Math.PI) / 4;
    const x1 = cx + Math.cos(angle) * (cx * 0.12);
    const y1 = cx + Math.sin(angle) * (cx * 0.12);
    const x2 = cx + Math.cos(angle) * (cx * 0.45);
    const y2 = cx + Math.sin(angle) * (cx * 0.45);
    return <line x1={x1} y1={y1} x2={x2} y2={y2} stroke={fill} stroke-width="1" />;
  })}
  <!-- Center dot -->
  <circle cx={cx} cy={cx} r={cx * 0.06} fill={fill} />
</svg>
