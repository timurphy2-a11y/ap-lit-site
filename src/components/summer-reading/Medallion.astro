---
interface Props {
  size?: number;
  color?: string;
  opacity?: number;
}
const { size = 40, color = 'var(--p-teal)', opacity = 1 } = Astro.props;
const cx = size / 2;
const cy = size / 2;
const outer = size * 0.44;
const inner = size * 0.30;
const dot   = size * 0.07;
---
<svg
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="sr-motif-medallion"
  style={`opacity: ${opacity};`}
>
  <circle cx={cx} cy={cy} r={outer} stroke={color} stroke-width="1.5" />
  <circle cx={cx} cy={cy} r={inner} stroke={color} stroke-width="1" />
  <circle cx={cx} cy={cy} r={dot}   fill="var(--p-gold)" />
</svg>
