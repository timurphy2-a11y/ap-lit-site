---
// PachinkoCrest.astro
// "The Cascade Crest" super-motif — pachinko playfield folded into a medallion.
// Geometry from design_handoff_landing_redesign/references/threshold-motifs.jsx.
// Use cream/tcream line values on dark fields; ink values on cream surfaces.

interface Props {
  size?:   number;
  line?:   string;   // outer ring, ticks, petals, pins
  gold?:   string;   // balls, upper butterfly wings
  accent?: string;   // channel lines, lower butterfly wings, inner ring
}

const {
  size   = 320,
  line   = 'var(--t-cream)',
  gold   = 'var(--p-gold)',
  accent = '#7FD4CE',
} = Astro.props;

const D2R = Math.PI / 180;
const C = 200;

// 72 tick marks around the outer perimeter
const ticks: { x1: number; y1: number; x2: number; y2: number; major: boolean }[] = [];
for (let i = 0; i < 72; i++) {
  const a = i * 5 * D2R;
  const r2 = i % 6 === 0 ? 176 : 183;
  ticks.push({ x1: C + 190 * Math.cos(a), y1: C + 190 * Math.sin(a), x2: C + r2 * Math.cos(a), y2: C + r2 * Math.sin(a), major: i % 6 === 0 });
}

// 36 rosette petals between ring r150–r168
const petals: { x1: number; y1: number; x2: number; y2: number; major: boolean }[] = [];
for (let i = 0; i < 36; i++) {
  const a = i * 10 * D2R;
  petals.push({ x1: C + 150 * Math.cos(a), y1: C + 150 * Math.sin(a), x2: C + 168 * Math.cos(a), y2: C + 168 * Math.sin(a), major: i % 3 === 0 });
}

// Triangular pin lattice — 5 sectors between channels, apex inward
const pins: { cx: number; cy: number }[] = [];
const ROWS = 5, R0 = 52, DR = 19, STEP = 22;
for (let s = 0; s < 5; s++) {
  const ab = (-90 + s * 72 + 36) * D2R;
  const ux = Math.cos(ab), uy = Math.sin(ab);
  const px = Math.cos(ab + Math.PI / 2), py = Math.sin(ab + Math.PI / 2);
  for (let k = 0; k < ROWS; k++) {
    const r = R0 + k * DR;
    for (let j = 0; j <= k; j++) {
      const v = (j - k / 2) * STEP;
      pins.push({ cx: C + ux * r + px * v, cy: C + uy * r + py * v });
    }
  }
}

// 5 radial channels — nod to the five spokes
const channels: { x1: number; y1: number; x2: number; y2: number }[] = [];
for (let i = 0; i < 5; i++) {
  const a = (-90 + i * 72) * D2R;
  channels.push({ x1: C + 34 * Math.cos(a), y1: C + 34 * Math.sin(a), x2: C + 146 * Math.cos(a), y2: C + 146 * Math.sin(a) });
}

// 5 gold balls at r=132, one per channel
const balls: { cx: number; cy: number }[] = [-90, -18, 54, 126, 198].map(deg => {
  const a = deg * D2R;
  return { cx: C + 132 * Math.cos(a), cy: C + 132 * Math.sin(a) };
});
---

<svg
  viewBox="0 0 400 400"
  width={size}
  height={size}
  aria-hidden="true"
  style="display:block;overflow:visible;"
>
  <!-- outer rings -->
  <circle cx={C} cy={C} r="190" fill="none" stroke={line} stroke-width="1.6" opacity="0.85" />
  <circle cx={C} cy={C} r="170" fill="none" stroke={line} stroke-width="0.8" opacity="0.5" />

  <!-- tick scale -->
  {ticks.map((t, i) => (
    <line key={i} x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke={line} stroke-width={t.major ? 1.4 : 0.7} opacity="0.75" />
  ))}

  <!-- rosette crown -->
  {petals.map((p, i) => (
    <line key={i} x1={p.x1} y1={p.y1} x2={p.x2} y2={p.y2} stroke={line} stroke-width={p.major ? 1.6 : 0.8} opacity={p.major ? 0.95 : 0.5} />
  ))}

  <!-- inner lattice ring -->
  <circle cx={C} cy={C} r="146" fill="none" stroke={line} stroke-width="0.8" opacity="0.4" />

  <!-- radial channels -->
  {channels.map((ch, i) => (
    <line key={i} x1={ch.x1} y1={ch.y1} x2={ch.x2} y2={ch.y2} stroke={accent} stroke-width="1.3" opacity="0.6" />
  ))}

  <!-- pin-dot lattice -->
  {pins.map((p, i) => (
    <circle key={i} cx={p.cx} cy={p.cy} r="1.7" fill={line} opacity="0.55" />
  ))}

  <!-- gold balls -->
  {balls.map((b, i) => (
    <g key={i}>
      <circle cx={b.cx} cy={b.cy} r="6" fill={gold} />
      <circle cx={b.cx - 1.6} cy={b.cy - 1.6} r="1.8" fill="#fff" opacity="0.55" />
    </g>
  ))}

  <!-- center medallion ring -->
  <circle cx={C} cy={C} r="34" fill="none" stroke={line} stroke-width="1.4" opacity="0.85" />
  <circle cx={C} cy={C} r="27" fill="none" stroke={accent} stroke-width="0.8" opacity="0.6" />

  <!-- butterfly at center -->
  <g transform={`translate(${C} ${C})`} opacity="0.95">
    <line x1="0" y1="-12" x2="0" y2="16" stroke={line} stroke-width="1.1" />
    <path d="M 0 -6 C -14 -16, -26 -8, -22 2 C -19 9, -7 6, 0 0 Z" fill={gold} opacity="0.9" />
    <path d="M 0 -6 C 14 -16, 26 -8, 22 2 C 19 9, 7 6, 0 0 Z" fill={gold} opacity="0.9" />
    <path d="M 0 0 C -10 6, -16 12, -15 18 C -8 16, -2 8, 0 4 Z" fill={accent} opacity="0.85" />
    <path d="M 0 0 C 10 6, 16 12, 15 18 C 8 16, 2 8, 0 4 Z" fill={accent} opacity="0.85" />
    <circle cx="0" cy="-13" r="1.6" fill={line} />
  </g>
</svg>
