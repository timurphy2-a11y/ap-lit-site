---
// TSpokeGlyph.astro
// Per-spoke ideograms for Things Fall Apart (idx 0–4).
// 48×48 viewBox line-art glyphs in the TFA/uli aesthetic.
// Source: design_handoff_landing_redesign/references/threshold-motifs.jsx

interface Props {
  idx:    0 | 1 | 2 | 3 | 4;
  size?:  number;
  color?: string;
  ochre?: string;
}

const { idx, size = 46, color = 'var(--color-ink)', ochre = 'var(--t-ochre)' } = Astro.props;
---

<svg
  viewBox="0 0 48 48"
  width={size}
  height={size}
  aria-hidden="true"
  style="display:block;"
>
  {idx === 0 && (
    <!-- 01 World — village compound: conical huts on a ground line -->
    <g>
      <path d="M11 30 L16 20 L21 30" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M27 30 L32 18 L37 30" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M19 32 L23 24 L27 32" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
      <line x1="7" y1="36" x2="41" y2="36" stroke={color} stroke-width="2" stroke-linecap="round" />
    </g>
  )}
  {idx === 1 && (
    <!-- 02 Society — egwugwu mask in uli curves -->
    <g>
      <path d="M24 7 C 13 7, 12 22, 16 32 C 19 40, 29 40, 32 32 C 36 22, 35 7, 24 7 Z" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="19" cy="22" r="1.6" fill={color} />
      <circle cx="29" cy="22" r="1.6" fill={color} />
      <line x1="24" y1="26" x2="24" y2="33" stroke={color} stroke-width="2" stroke-linecap="round" />
      <path d="M16 14 C 20 12, 28 12, 32 14" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
    </g>
  )}
  {idx === 2 && (
    <!-- 03 Colonialism — mission church on a dashed frontier line -->
    <g>
      <line x1="24" y1="6" x2="24" y2="14" stroke={color} stroke-width="2" stroke-linecap="round" />
      <line x1="20" y1="9" x2="28" y2="9" stroke={color} stroke-width="2" stroke-linecap="round" />
      <path d="M14 24 L24 16 L34 24" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M16 24 V38 H32 V24" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <line x1="40" y1="6" x2="40" y2="42" stroke={color} stroke-width="2" stroke-linecap="round" stroke-dasharray="3 4" opacity="0.55" />
    </g>
  )}
  {idx === 3 && (
    <!-- 04 Key Figures — profile as a single uli line -->
    <g>
      <path d="M30 9 C 18 9, 14 20, 17 27 C 18 30, 16 32, 17 36 C 18 40, 26 40, 31 38" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="25" cy="22" r="1.6" fill={color} />
    </g>
  )}
  {idx === 4 && (
    <!-- 05 Connections — split kola nut (the proverb) -->
    <g>
      <circle cx="24" cy="24" r="16" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      <line x1="24" y1="8" x2="24" y2="40" stroke={color} stroke-width="2" stroke-linecap="round" />
      <path d="M24 16 C 19 19, 19 29, 24 32" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
      <path d="M24 16 C 29 19, 29 29, 24 32" fill="none" stroke={color} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.6" />
    </g>
  )}
</svg>
