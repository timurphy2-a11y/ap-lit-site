---
// ImageCaption.astro
// Inline figure + caption in the prose flow.
// Spec: 04-spoke-page.md
//
// widthVariant: optional modifier class applied to the <figure>.
// Used by ImageBlock to apply sr-image-caption--inset/full/bleed.
// When used directly in MDX (no width context) leave it unset.

interface Props {
  src:           string;
  alt:           string;
  figureNumber:  number;
  caption:       string;
  credit?:       string;
  accent?:       'pachinko' | 'tfa';
  widthVariant?: string;
}

const { src, alt, figureNumber, caption, credit, accent = 'pachinko', widthVariant } = Astro.props;
const eyebrowColor = accent === 'tfa' ? 'var(--t-terra)' : 'var(--p-orange)';
const figLabel = `FIG ${String(figureNumber).padStart(2, '0')}`;
const figureClass = ['sr-image-caption', widthVariant].filter(Boolean).join(' ');
---

<figure class={figureClass}>
  <img src={src} alt={alt} class="sr-image-caption-img" loading="lazy" />
  <figcaption class="sr-image-caption-caption">
    <span class="sr-image-caption-fig" style={`color: ${eyebrowColor}`}>{figLabel}</span>
    {caption}
    {credit && <span class="sr-image-caption-credit"> — {credit}</span>}
  </figcaption>
</figure>

<style>
  .sr-image-caption {
    margin:   var(--s-8) 0;
    padding:  0;
  }

  .sr-image-caption-img {
    display:         block;
    width:           100%;
    height:          auto;
    max-height:      65vh;
    object-fit:      cover;
    object-position: center top;
    border:          1px solid var(--color-rule);
  }

  .sr-image-caption-caption {
    display:     flex;
    align-items: baseline;
    gap:         var(--s-2);
    margin-top:  var(--s-2);
    font-family: var(--font-body);
    font-size:   var(--t-meta);
    line-height: var(--lh-meta);
    color:       var(--color-muted);
  }

  .sr-image-caption-fig {
    font-family:    var(--font-mono);
    font-size:      var(--t-tag);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    flex-shrink:    0;
  }

  .sr-image-caption-credit {
    color: var(--color-muted);
    opacity: 0.7;
  }
</style>
