---
import FloralScroll from './FloralScroll.astro';
import UliTendril from './UliTendril.astro';

interface Props {
  quote?: string;
  attribution?: string;
  text?: 'pachinko' | 'tfa';
}
const { quote, attribution, text } = Astro.props;
---

<figure class={`sr-pullquote${text ? ` sr-pullquote--${text}` : ''}`}>
  {text === 'pachinko' && (
    <div class="sr-pullquote-bracket sr-pullquote-bracket--top" aria-hidden="true">
      <FloralScroll width={80} color="var(--p-orange)" />
    </div>
  )}
  {text === 'tfa' && (
    <div class="sr-pullquote-bracket sr-pullquote-bracket--top" aria-hidden="true">
      <UliTendril width={80} color="var(--t-terra)" opacity={0.7} />
    </div>
  )}
  <blockquote class="sr-pullquote-body">
    {quote ? <p>{quote}</p> : <slot />}
  </blockquote>
  {attribution && <figcaption class="sr-pullquote-attribution">{attribution}</figcaption>}
  {text === 'pachinko' && (
    <div class="sr-pullquote-bracket sr-pullquote-bracket--bottom" aria-hidden="true">
      <FloralScroll width={80} color="var(--p-orange)" />
    </div>
  )}
  {text === 'tfa' && (
    <div class="sr-pullquote-bracket sr-pullquote-bracket--bottom" aria-hidden="true">
      <UliTendril width={80} color="var(--t-terra)" opacity={0.7} />
    </div>
  )}
</figure>
