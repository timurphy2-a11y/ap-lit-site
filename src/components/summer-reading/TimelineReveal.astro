---
// Injects IntersectionObserver for [data-timeline-reveal] timelines.
// Place once per page that contains a .sr-timeline with data-timeline-reveal.
---
<script>
  const entries = document.querySelectorAll(
    '[data-timeline-reveal] .sr-timeline-entry'
  );
  if (entries.length) {
    const observer = new IntersectionObserver(
      (observations) => {
        observations.forEach((obs) => {
          if (obs.isIntersecting) {
            obs.target.classList.add('is-visible');
            observer.unobserve(obs.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -32px 0px' }
    );
    entries.forEach((el) => observer.observe(el));
  }
</script>
