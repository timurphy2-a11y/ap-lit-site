---
interface Props {
  size?: number;
  color?: string;
}
const { size = 40, color = 'var(--t-terra)' } = Astro.props;

const c   = size / 2;
const r   = size * 0.42;
const w   = size * 0.56;
const x0  = (size - w) / 2;
const a   = w * 0.20;
const y   = c + size * 0.02;
const nx  = c;
const ny  = c - size * 0.20;
const nr  = size * 0.045;
const curve = `M ${x0} ${y + a * 0.2} C ${x0 + w * 0.16} ${y - a}, ${x0 + w * 0.34} ${y - a}, ${x0 + w * 0.5} ${y} C ${x0 + w * 0.66} ${y + a}, ${x0 + w * 0.84} ${y + a}, ${x0 + w} ${y - a * 0.6}`;
---
<svg
  width={size}
  height={size}
  viewBox={`0 0 ${size} ${size}`}
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="sr-motif-uli-seal"
>
  <circle cx={c}  cy={c}  r={r}  stroke={color} stroke-width="1.3" />
  <circle cx={nx} cy={ny} r={nr} fill="#D4A840" />
  <path d={curve} stroke={color} stroke-width="1.4" stroke-linecap="round" fill="none" />
</svg>
