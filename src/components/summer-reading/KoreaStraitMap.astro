---
// Korea Strait engraved map for Pachinko World Zone 3.
// Land paths traced from Natural Earth 1:50m — survey-accurate geometry.
// Calibration: Busan (35.10°N, 129.04°E) → SVG (160,110);
//              Shimonoseki (33.95°N, 130.93°E) → SVG (536,346).
// Accumulative reveals via data-show-from; CSS in scrolly-zones.css controls opacity per state.
---

<svg
  viewBox="0 0 660 460"
  xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMid meet"
  class="sr-korea-strait-map"
  role="img"
  aria-label="Engraved chart of the Korea Strait crossing from Busan to Shimonoseki"
>
  <style>
    .km-sea{fill:#F1EADA;}
    .km-grid{stroke:#C9B68E;stroke-width:.6;opacity:.3;}
    .km-halo{fill:#D8C7A1;}
    .km-land{fill:url(#kmHatch);stroke:#5A4A30;stroke-width:1.1;stroke-linejoin:round;}
    .km-ls{font-family:"Fraunces",ui-serif,serif;font-style:italic;fill:#4A3A22;}
    .km-lm{font-family:"JetBrains Mono",ui-monospace,monospace;text-transform:uppercase;fill:#6B6355;}
    .km-route{fill:none;stroke:#9C6B2E;stroke-width:2;stroke-dasharray:3 4;stroke-linecap:round;}
    .km-route2{fill:none;stroke:#9C6B2E;stroke-width:3.6;stroke-dasharray:3 4;stroke-linecap:round;opacity:.9;}
  </style>
  <defs>
    <pattern id="kmHatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" fill="#E7DCC4" />
      <line x1="0" y1="0" x2="0" y2="6" stroke="#C9B68E" stroke-width="0.6" opacity="0.6" />
    </pattern>
    <filter id="kmHalo" x="-25%" y="-25%" width="150%" height="150%"><feGaussianBlur stdDeviation="3.5" /></filter>
  </defs>

  <rect width="660" height="460" class="km-sea" />
  <g class="km-grid">
    <line x1="90" y1="0" x2="90" y2="460" /><line x1="330" y1="0" x2="330" y2="460" /><line x1="560" y1="0" x2="560" y2="460" />
    <line x1="0" y1="105" x2="660" y2="105" /><line x1="0" y1="315" x2="660" y2="315" />
  </g>

  <!-- Land halo (blur layer) — Natural Earth 1:50m geometry -->
  <g class="km-halo" filter="url(#kmHalo)">
    <path d="M 644.7,331.8 L 631.1,335.0 L 614.1,342.9 L 596.2,346.4 L 579.8,340.7 L 564.2,331.5 L 549.2,334.2 L 533.8,340.7 L 527.9,282.0 L 530.9,274.3 L 540.3,264.0 L 550.8,255.2 L 576.2,252.1 L 602.0,255.0 L 620.4,250.9 L 636.0,239.3 L 652.4,222.8 L 670.9,209.4 L 679.9,205.6 L 679.9,327.3 L 644.7,331.8 Z" />
    <path d="M 611.4,423.4 L 622.7,423.8 L 633.2,421.0 L 649.2,413.0 L 665.9,407.1 L 677.9,410.1 L 679.9,411.4 L 679.9,451.5 L 672.4,460.5 L 659.5,480.5 L 270.7,480.5 L 273.4,470.4 L 283.3,466.1 L 291.7,467.1 L 320.0,474.9 L 322.6,463.9 L 318.5,458.1 L 316.3,451.3 L 334.9,441.7 L 365.3,433.9 L 371.6,430.2 L 377.0,422.3 L 384.4,418.2 L 405.7,418.3 L 423.6,410.8 L 438.4,390.3 L 441.9,379.0 L 447.2,369.7 L 484.2,353.1 L 493.4,350.6 L 518.0,352.6 L 540.6,362.0 L 551.7,381.7 L 561.5,402.9 L 584.7,417.3 L 611.4,423.4 Z" />
    <path d="M 243.9,473.0 L 259.1,467.5 L 265.4,466.9 L 254.8,480.5 L 240.1,480.5 L 243.9,473.0 Z" />
    <path d="M 296.6,395.8 L 286.3,389.2 L 291.3,370.9 L 294.7,364.8 L 306.5,370.8 L 310.3,387.3 L 296.6,395.8 Z" />
    <path d="M 194.7,318.7 L 189.1,306.0 L 194.8,269.9 L 219.1,277.3 L 218.7,288.4 L 207.6,310.4 L 194.7,318.7 Z" />
    <path d="M 224.7,273.0 L 211.2,266.0 L 205.1,259.7 L 217.6,228.6 L 216.1,216.9 L 216.9,211.1 L 241.8,194.8 L 246.0,198.0 L 247.6,202.5 L 245.4,209.4 L 246.6,224.8 L 227.9,250.3 L 228.8,263.2 L 224.7,273.0 Z" />
    <path d="M 81.8,184.5 L 56.5,167.5 L 50.4,158.2 L 69.7,144.4 L 86.0,128.7 L 96.7,127.7 L 100.5,171.9 L 81.8,184.5 Z" />
    <path d="M 248.6,-10.5 L 235.4,28.4 L 217.5,62.2 L 194.6,93.2 L 167.3,105.3 L 148.1,109.7 L 111.4,111.3 L 80.9,106.0 L 54.7,109.8 L 44.2,116.3 L 36.4,127.3 L 42.2,144.5 L 41.4,157.1 L 30.2,156.2 L 8.0,148.8 L -16.6,147.8 L -19.9,146.7 L -19.9,-20.5 L 251.5,-20.5 L 248.6,-10.5 Z" />
  </g>

  <!-- Land fill — Natural Earth 1:50m geometry -->
  <g class="km-land">
    <path d="M 644.7,331.8 L 631.1,335.0 L 614.1,342.9 L 596.2,346.4 L 579.8,340.7 L 564.2,331.5 L 549.2,334.2 L 533.8,340.7 L 527.9,282.0 L 530.9,274.3 L 540.3,264.0 L 550.8,255.2 L 576.2,252.1 L 602.0,255.0 L 620.4,250.9 L 636.0,239.3 L 652.4,222.8 L 670.9,209.4 L 679.9,205.6 L 679.9,327.3 L 644.7,331.8 Z" />
    <path d="M 611.4,423.4 L 622.7,423.8 L 633.2,421.0 L 649.2,413.0 L 665.9,407.1 L 677.9,410.1 L 679.9,411.4 L 679.9,451.5 L 672.4,460.5 L 659.5,480.5 L 270.7,480.5 L 273.4,470.4 L 283.3,466.1 L 291.7,467.1 L 320.0,474.9 L 322.6,463.9 L 318.5,458.1 L 316.3,451.3 L 334.9,441.7 L 365.3,433.9 L 371.6,430.2 L 377.0,422.3 L 384.4,418.2 L 405.7,418.3 L 423.6,410.8 L 438.4,390.3 L 441.9,379.0 L 447.2,369.7 L 484.2,353.1 L 493.4,350.6 L 518.0,352.6 L 540.6,362.0 L 551.7,381.7 L 561.5,402.9 L 584.7,417.3 L 611.4,423.4 Z" />
    <path d="M 243.9,473.0 L 259.1,467.5 L 265.4,466.9 L 254.8,480.5 L 240.1,480.5 L 243.9,473.0 Z" />
    <path d="M 296.6,395.8 L 286.3,389.2 L 291.3,370.9 L 294.7,364.8 L 306.5,370.8 L 310.3,387.3 L 296.6,395.8 Z" />
    <path d="M 194.7,318.7 L 189.1,306.0 L 194.8,269.9 L 219.1,277.3 L 218.7,288.4 L 207.6,310.4 L 194.7,318.7 Z" />
    <path d="M 224.7,273.0 L 211.2,266.0 L 205.1,259.7 L 217.6,228.6 L 216.1,216.9 L 216.9,211.1 L 241.8,194.8 L 246.0,198.0 L 247.6,202.5 L 245.4,209.4 L 246.6,224.8 L 227.9,250.3 L 228.8,263.2 L 224.7,273.0 Z" />
    <path d="M 81.8,184.5 L 56.5,167.5 L 50.4,158.2 L 69.7,144.4 L 86.0,128.7 L 96.7,127.7 L 100.5,171.9 L 81.8,184.5 Z" />
    <path d="M 248.6,-10.5 L 235.4,28.4 L 217.5,62.2 L 194.6,93.2 L 167.3,105.3 L 148.1,109.7 L 111.4,111.3 L 80.9,106.0 L 54.7,109.8 L 44.2,116.3 L 36.4,127.3 L 42.2,144.5 L 41.4,157.1 L 30.2,156.2 L 8.0,148.8 L -16.6,147.8 L -19.9,146.7 L -19.9,-20.5 L 251.5,-20.5 L 248.6,-10.5 Z" />
  </g>

  <!-- Always-visible region and water labels -->
  <text x="44" y="40" class="km-ls" style="font-size:20px;letter-spacing:.06em">Korea</text>
  <text x="624" y="446" text-anchor="end" class="km-ls" style="font-size:17px">Kyūshū</text>
  <text x="332" y="250" text-anchor="middle" class="km-ls" style="font-size:16px;letter-spacing:.18em;fill:#6B6355">Korea Strait</text>
  <text x="180" y="124" text-anchor="start" class="km-lm" style="font-size:8px;letter-spacing:.12em">Yeongdo</text>
  <text x="220" y="256" text-anchor="middle" transform="rotate(52 220 256)" class="km-ls" style="font-size:12px">Tsushima</text>
  <text x="285" y="374" text-anchor="middle" class="km-ls" style="font-size:11px">Iki</text>

  <!-- Compass -->
  <g transform="translate(612,56)" stroke="#5A4A30" fill="#5A4A30">
    <circle cx="0" cy="0" r="14" fill="none" stroke-width="0.75" opacity="0.5" />
    <path d="M0,-16 L4,0 L0,3 L-4,0 Z" />
    <path d="M0,16 L4,0 L0,-3 L-4,0 Z" fill="none" stroke-width="0.75" />
    <text x="0" y="-19" text-anchor="middle" class="km-lm" style="font-size:8px;fill:#5A4A30">N</text>
  </g>

  <!-- Scale bar -->
  <g transform="translate(44,432)" stroke="#6B6355">
    <line x1="0" y1="0" x2="93" y2="0" stroke-width="1.5" />
    <line x1="0" y1="-3" x2="0" y2="3" stroke-width="1.5" />
    <line x1="46.5" y1="-3" x2="46.5" y2="3" stroke-width="1.5" />
    <line x1="93" y1="-3" x2="93" y2="3" stroke-width="1.5" />
    <text x="0" y="13" class="km-lm" style="font-size:8px" stroke="none">0</text>
    <text x="93" y="13" text-anchor="end" class="km-lm" style="font-size:8px" stroke="none">100 km</text>
  </g>

  <!-- route-base: city dots + labels -->
  <g data-show-from="route-base">
    <circle cx="160" cy="110" r="4.5" fill="#2AA8A0" />
    <text x="150" y="106" text-anchor="end" class="km-ls" style="font-size:15px;fill:#2C2820">Busan</text>
    <circle cx="536" cy="346" r="4.5" fill="#2AA8A0" />
    <text x="536" y="338" text-anchor="middle" class="km-ls" style="font-size:15px;fill:#2C2820">Shimonoseki</text>
  </g>

  <!-- route-line: the crossing -->
  <g data-show-from="route-line">
    <path d="M 168,116 Q 380,150 524,336" class="km-route" />
  </g>

  <!-- year-1905 -->
  <g data-show-from="year-1905">
    <text x="196" y="104" class="km-ls" style="font-size:13px;fill:#9C6B2E">1905</text>
  </g>

  <!-- volume-1930: thicker route emphasis -->
  <g data-show-from="volume-1930">
    <path d="M 168,116 Q 380,150 524,336" class="km-route2" />
  </g>

  <!-- inspection: boarding requirement marker near Busan -->
  <g data-show-from="inspection">
    <path d="M 150,128 l 8,6 l -8,6 l -8,-6 z" fill="none" stroke="#9C6B2E" stroke-width="1.3" />
  </g>

  <!-- ikaino-marker: overland rail from Shimonoseki toward Osaka (off-screen east) -->
  <g data-show-from="ikaino-marker">
    <path d="M 536,346 Q 592,334 648,318" stroke="#C4722A" stroke-width="1.5" fill="none" stroke-linecap="round" />
    <path d="M 643,313 L 657,318 L 643,323 Z" fill="#C4722A" />
    <text x="638" y="311" text-anchor="end" class="km-ls" style="font-size:13px;fill:#C4722A">Osaka</text>
  </g>
</svg>
