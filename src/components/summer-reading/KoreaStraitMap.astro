---
// Korea Strait engraved map for Pachinko World Zone 3.
// Land paths traced from Natural Earth 1:50m — real geography, projected Mercator.
// Territory color-coding: ember #B0541A = Korean land; graphite #49545F = Japanese.
// Macron note: Kyūshū rendered plain (no letter-spacing) to keep combining macron attached.
// Accumulative reveals via data-show-from; CSS in scrolly-zones.css controls opacity per state.
---

<svg
  viewBox="0 0 660 460"
  xmlns="http://www.w3.org/2000/svg"
  preserveAspectRatio="xMidYMid meet"
  class="sr-korea-strait-map"
  role="img"
  aria-label="Engraved chart of the Korea Strait crossing from Busan to Shimonoseki"
>
  <style>
    .km-sea{fill:#F1EADA;}
    .km-grid{stroke:#C9B68E;stroke-width:.6;opacity:.3;}
    .km-land-kr{fill:url(#kmHatchKr);stroke:#8E4112;stroke-width:1.15;stroke-linejoin:round;}
    .km-land-jp{fill:url(#kmHatchJp);stroke:#3B454F;stroke-width:1.15;stroke-linejoin:round;}
    .km-city{font-family:"Fraunces",ui-serif,serif;font-style:normal;font-weight:600;paint-order:stroke;stroke:#F1EADA;stroke-width:3;stroke-linejoin:round;}
    .km-region{font-family:"Fraunces",ui-serif,serif;font-style:italic;paint-order:stroke;stroke:#F1EADA;stroke-width:3.4;stroke-linejoin:round;}
    .km-water{font-family:"Fraunces",ui-serif,serif;font-style:italic;fill:#71808A;paint-order:stroke;stroke:#F1EADA;stroke-width:3;stroke-linejoin:round;}
    .km-island{font-family:"Fraunces",ui-serif,serif;font-style:italic;fill:#2E3842;paint-order:stroke;stroke:#F1EADA;stroke-width:2.6;stroke-linejoin:round;}
    .km-tag{font-family:"JetBrains Mono",ui-monospace,monospace;text-transform:uppercase;fill:#6B6355;paint-order:stroke;stroke:#F1EADA;stroke-width:2.4;stroke-linejoin:round;}
    .km-route{fill:none;stroke:#9C6B2E;stroke-width:2;stroke-dasharray:3 4;stroke-linecap:round;}
    .km-route2{fill:none;stroke:#9C6B2E;stroke-width:3.6;stroke-dasharray:3 4;stroke-linecap:round;opacity:.9;}
  </style>
  <defs>
    <pattern id="kmHatchKr" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" fill="#ECDDC4" />
      <line x1="0" y1="0" x2="0" y2="6" stroke="#B0541A" stroke-width="0.7" opacity="0.42" />
    </pattern>
    <pattern id="kmHatchJp" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <rect width="6" height="6" fill="#E3E3DD" />
      <line x1="0" y1="0" x2="0" y2="6" stroke="#5C6670" stroke-width="0.7" opacity="0.38" />
    </pattern>
    <filter id="kmHalo" x="-25%" y="-25%" width="150%" height="150%"><feGaussianBlur stdDeviation="3.5" /></filter>
  </defs>

  <rect width="660" height="460" class="km-sea" />
  <g class="km-grid">
    <line x1="195.5" y1="0" x2="195.5" y2="460" />
    <line x1="353.7" y1="0" x2="353.7" y2="460" />
    <line x1="512" y1="0" x2="512" y2="460" />
    <line x1="0" y1="298.6" x2="660" y2="298.6" />
    <line x1="0" y1="106.6" x2="660" y2="106.6" />
  </g>
  <text x="353.7" y="13" class="km-tag" style="font-size:7.5px;letter-spacing:.12em;opacity:.7" text-anchor="middle">130°E</text>
  <text x="5" y="295.6" class="km-tag" style="font-size:7.5px;letter-spacing:.12em;opacity:.7">34°N</text>

  <!-- Shoreline halos — Korean territory warm, Japanese graphite -->
  <g class="km-halo-kr" fill="#DCC49B" filter="url(#kmHalo)">
    <path d="M 264.7,0 L 247.6,42.2 L 229.4,71.4 L 207.7,82.9 L 192.4,87 L 163.2,88.4 L 139,83.5 L 118.1,87.1 L 109.8,93.2 L 103.6,103.6 L 108.1,119.7 L 107.5,131.6 L 98.6,130.7 L 81,123.8 L 68.9,123.2 L 68.9,0 Z" />
    <path d="M 154.5,145.5 L 139.6,157.3 L 119.5,141.4 L 114.7,132.6 L 130,119.7 L 143,104.9 L 151.5,104 Z" />
  </g>
  <g class="km-halo-jp" fill="#C6C9C6" filter="url(#kmHalo)">
    <path d="M 539.6,374.2 L 560.9,379.9 L 569.9,380.3 L 591.1,370.2 L 591.1,460 L 400.3,460 L 391.3,454.8 L 383.3,460 L 308.3,460 L 287.3,443.7 L 292.1,423.4 L 299.9,419.3 L 329.1,427.5 L 331.2,417.4 L 326.2,405.7 L 340.9,396.9 L 365.1,389.6 L 380.3,375.1 L 397.3,375.2 L 411.5,368.2 L 423.3,349.2 L 430.3,330.1 L 467,312.4 L 486.6,314.3 L 504.5,323 L 521.1,360.9 Z" />
    <path d="M 591.1,294.3 L 576.5,297.9 L 563,305.2 L 548.8,308.5 L 535.7,303.2 L 523.3,294.6 L 511.4,297.2 L 499.1,303.2 L 494.4,248.5 L 496.8,241.3 L 512.6,223.5 L 532.9,220.6 L 553.4,223.3 L 568,219.5 L 591.1,196.1 Z" />
    <path d="M 256.5,230.9 L 253.3,240.2 L 242.6,233.6 L 237.7,227.7 L 247.6,198.7 L 247.1,182.3 L 266.9,167 L 271.5,174.2 L 269.7,180.7 L 270.7,195.1 L 255.9,218.9 Z" />
    <path d="M 239.7,275 L 229.4,282.8 L 225,270.9 L 229.5,237.3 L 248.9,244.1 L 248.5,254.5 Z" />
    <path d="M 273.3,446.2 L 262.2,455.1 L 254.1,455.1 L 261.5,444.7 L 268.6,425.7 L 285.7,420.1 L 275.9,434.6 Z" />
    <path d="M 321.4,346.4 L 310.5,354.3 L 302.3,348.2 L 309,325.6 L 318.3,331.1 Z" />
  </g>

  <!-- Japanese land (graphite: Kyūshū, Tsushima, Iki) -->
  <g class="km-land-jp">
    <path d="M 539.6,374.2 L 560.9,379.9 L 569.9,380.3 L 591.1,370.2 L 591.1,460 L 400.3,460 L 391.3,454.8 L 383.3,460 L 308.3,460 L 287.3,443.7 L 292.1,423.4 L 299.9,419.3 L 329.1,427.5 L 331.2,417.4 L 326.2,405.7 L 340.9,396.9 L 365.1,389.6 L 380.3,375.1 L 397.3,375.2 L 411.5,368.2 L 423.3,349.2 L 430.3,330.1 L 467,312.4 L 486.6,314.3 L 504.5,323 L 521.1,360.9 Z" />
    <path d="M 591.1,294.3 L 576.5,297.9 L 563,305.2 L 548.8,308.5 L 535.7,303.2 L 523.3,294.6 L 511.4,297.2 L 499.1,303.2 L 494.4,248.5 L 496.8,241.3 L 512.6,223.5 L 532.9,220.6 L 553.4,223.3 L 568,219.5 L 591.1,196.1 Z" />
    <path d="M 256.5,230.9 L 253.3,240.2 L 242.6,233.6 L 237.7,227.7 L 247.6,198.7 L 247.1,182.3 L 266.9,167 L 271.5,174.2 L 269.7,180.7 L 270.7,195.1 L 255.9,218.9 Z" />
    <path d="M 239.7,275 L 229.4,282.8 L 225,270.9 L 229.5,237.3 L 248.9,244.1 L 248.5,254.5 Z" />
    <path d="M 273.3,446.2 L 262.2,455.1 L 254.1,455.1 L 261.5,444.7 L 268.6,425.7 L 285.7,420.1 L 275.9,434.6 Z" />
    <path d="M 321.4,346.4 L 310.5,354.3 L 302.3,348.2 L 309,325.6 L 318.3,331.1 Z" />
  </g>

  <!-- Korean land (ember: mainland Korea, Geoje) -->
  <g class="km-land-kr">
    <path d="M 264.7,0 L 247.6,42.2 L 229.4,71.4 L 207.7,82.9 L 192.4,87 L 163.2,88.4 L 139,83.5 L 118.1,87.1 L 109.8,93.2 L 103.6,103.6 L 108.1,119.7 L 107.5,131.6 L 98.6,130.7 L 81,123.8 L 68.9,123.2 L 68.9,0 Z" />
    <path d="M 154.5,145.5 L 139.6,157.3 L 119.5,141.4 L 114.7,132.6 L 130,119.7 L 143,104.9 L 151.5,104 Z" />
  </g>

  <!-- Labels: settlements upright roman, water/islands italic, regions letter-spaced -->
  <!-- Macron words (Kyūshū) rendered plain — no letter-spacing to preserve combining macron -->
  <text x="104" y="42.7" class="km-region" style="font-size:21px;letter-spacing:.14em;fill:#7C3A10">Korea</text>
  <text x="451.8" y="422.2" text-anchor="middle" class="km-region" style="font-size:16px;fill:#2E3842">Kyūshū</text>
  <text x="341.1" y="172.1" text-anchor="middle" transform="rotate(-19 341.1 172.1)" class="km-water" style="font-size:15px;letter-spacing:.34em">Korea Strait</text>
  <text x="219" y="250" text-anchor="end" class="km-island" style="font-size:11.5px;letter-spacing:.04em">Tsushima</text>
  <text x="321.6" y="348.1" text-anchor="start" class="km-island" style="font-size:10.5px">Iki</text>
  <text x="198.7" y="106.6" text-anchor="middle" class="km-tag" style="font-size:7.5px;letter-spacing:.12em">Yeongdo</text>

  <!-- Compass -->
  <g transform="translate(612,54)" stroke="#5A4A30" fill="#5A4A30">
    <circle cx="0" cy="0" r="14" fill="none" stroke-width="0.75" opacity="0.5" />
    <path d="M0,-16 L4,0 L0,3 L-4,0 Z" />
    <path d="M0,16 L4,0 L0,-3 L-4,0 Z" fill="none" stroke-width="0.75" />
    <text x="0" y="-19" text-anchor="middle" class="km-tag" style="font-size:8px;fill:#5A4A30" stroke="none">N</text>
  </g>

  <!-- Scale bar (100 km) -->
  <g transform="translate(40,432)" stroke="#6B6355">
    <line x1="0" y1="0" x2="172.2" y2="0" stroke-width="1.5" />
    <line x1="0" y1="-3" x2="0" y2="3" stroke-width="1.5" />
    <line x1="86.1" y1="-3" x2="86.1" y2="3" stroke-width="1.5" />
    <line x1="172.2" y1="-3" x2="172.2" y2="3" stroke-width="1.5" />
    <text x="0" y="13" class="km-tag" style="font-size:8px" stroke="none">0</text>
    <text x="172.2" y="13" text-anchor="end" class="km-tag" style="font-size:8px" stroke="none">100 km</text>
  </g>

  <!-- Territory legend -->
  <g transform="translate(34,346)">
    <rect x="-8" y="-15" width="172" height="46" rx="2" fill="#F1EADA" opacity="0.72" />
    <rect x="0" y="-9" width="18" height="11" fill="url(#kmHatchKr)" stroke="#8E4112" stroke-width="1" />
    <text x="26" y="0" class="km-tag" style="font-size:9px;letter-spacing:.08em;fill:#4A3A22" stroke="none">Korean territory</text>
    <rect x="0" y="9" width="18" height="11" fill="url(#kmHatchJp)" stroke="#3B454F" stroke-width="1" />
    <text x="26" y="18" class="km-tag" style="font-size:9px;letter-spacing:.08em;fill:#3B454F" stroke="none">Japanese territory</text>
  </g>

  <!-- route-base: city dots + labels (ember Busan, graphite Shimonoseki) -->
  <g data-show-from="route-base">
    <circle cx="202.6" cy="87.3" r="4.5" fill="#B0541A" stroke="#F1EADA" stroke-width="1.4" />
    <text x="193.6" y="72" text-anchor="end" class="km-city" style="font-size:15px;fill:#7C3A10">Busan</text>
    <circle cx="503.2" cy="307.2" r="4.5" fill="#49545F" stroke="#F1EADA" stroke-width="1.4" />
    <text x="512.2" y="302.2" class="km-city" style="font-size:15px;fill:#2E3842">Shimonoseki</text>
  </g>

  <!-- route-line: the crossing arc -->
  <g data-show-from="route-line">
    <path d="M 202.6,87.3 L 282.5,160.6 L 393.3,256.5 L 503.2,307.2" class="km-route" />
    <path d="M 503.2,307.2 L 490.7,308.1 L 495.7,297.1 Z" fill="#9C6B2E" />
  </g>

  <!-- year-1905 -->
  <g data-show-from="year-1905">
    <text x="276" y="139" text-anchor="middle" class="km-tag" style="font-size:11px;letter-spacing:.08em;fill:#9C6B2E">1905</text>
  </g>

  <!-- volume-1930: thicker route overlay -->
  <g data-show-from="volume-1930">
    <path d="M 202.6,87.3 L 282.5,160.6 L 393.3,256.5 L 503.2,307.2" class="km-route2" />
  </g>

  <!-- inspection: boarding checkpoint diamond -->
  <g data-show-from="inspection">
    <path d="M 356.9,228.5 l 8,7 l -8,7 l -8,-7 z" fill="none" stroke="#9C6B2E" stroke-width="1.3" />
  </g>

  <!-- ikaino-marker: ember dot for the Korean community in Osaka -->
  <g data-show-from="ikaino-marker">
    <line x1="507.2" y1="311.2" x2="555.2" y2="341.2" stroke="#B0541A" stroke-width="1.3" stroke-dasharray="5 4" />
    <circle cx="559.2" cy="343.2" r="5" fill="#B0541A" stroke="#F1EADA" stroke-width="1.3" />
    <text x="570.2" y="341.2" class="km-city" style="font-size:13px;fill:#7C3A10">Ikaino</text>
    <text x="570.2" y="355.2" class="km-tag" style="font-size:8px;letter-spacing:.1em">Osaka →</text>
  </g>
</svg>
