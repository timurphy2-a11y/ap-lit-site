---
import { inlineMd } from '../lib/inline-md';
import PeriodMotif from './PeriodMotif.astro';
interface Props {
  id: string;
  title?: string;
  composer?: string;
  note?: string;
  analysisEyebrow?: string;
  analysis?: string;
  analysisPrompt?: string;
  plateFor?: string;
  /** Unit id for the period sigil on the typographic poster. */
  unit?: string;
  /** Use the compact listening strip instead of the YouTube thumbnail (rolled out per unit). */
  typographic?: boolean;
  /** Optional poster image, shown in the standard mat instead of the typographic frame. */
  poster?: string;
}

const { id, title = '', composer, note, analysisEyebrow, analysis, analysisPrompt, plateFor, unit, typographic = false, poster } = Astro.props;
const variant = poster ? 'is-poster' : typographic ? 'is-strip' : null;
const trimEyebrow = (t?: string) => t?.replace(/^(Close looking|Listen for)\s*·\s*/, '');
const thumbnail = `https://img.youtube.com/vi/${id}/hqdefault.jpg`;
const hasAnalysis = Boolean(analysis);
---

<figure class="yt-embed work-figure" data-yt-id={id} data-yt-title={title} data-plate-for={plateFor}>
  <button class:list={['yt-preview', variant]} type="button" aria-label={`Play ${title}`}>
    {poster ? (
      <img src={poster} alt="" class="yt-poster-img" loading="lazy" />
    ) : typographic ? (
      <div class="yt-strip" aria-hidden="true">
        {unit && <span class="yt-strip-sigil"><PeriodMotif unit={unit} role={1} /></span>}
        <span class="yt-strip-rule"></span>
      </div>
    ) : (
      <img src={thumbnail} alt={title} class="yt-thumb" loading="lazy" />
    )}
    <div class="yt-play" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7z"/>
      </svg>
    </div>
  </button>
  {(title || composer || note || hasAnalysis) && (
    <figcaption class="yt-caption">
      {title && <div class="yt-title">{title}</div>}
      {composer && <div class="yt-composer">{composer}</div>}
      {note && <div class="yt-note">{note}</div>}
      {hasAnalysis && (
        <button class="analyze-hot" type="button" aria-expanded="false" aria-label={`Read what to listen for in ${title}`}>
          <span class="hot-dot" aria-hidden="true"></span><span class="hot-lbl" data-reserve="What to listen for">What to listen for</span>
        </button>
      )}
    </figcaption>
  )}
  {hasAnalysis && (
    <div class="analysis-panel" hidden>
      {analysisEyebrow && <div class="analysis-eyebrow">{trimEyebrow(analysisEyebrow)}</div>}
      <p set:html={inlineMd(analysis)} />
      {analysisPrompt && <p class="analysis-prompt" set:html={inlineMd(analysisPrompt)} />}
    </div>
  )}
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.yt-embed').forEach((figure) => {
    const btn = figure.querySelector<HTMLButtonElement>('.yt-preview');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const id = figure.dataset.ytId!;
      const title = figure.dataset.ytTitle ?? '';
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.className = 'yt-iframe';
      btn.replaceWith(iframe);
    });
  });
</script>

<style>
  .yt-embed {
    margin: 32px 0;
    border: 1px solid var(--rule);
    background: var(--bg-raised);
  }

  .yt-preview {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-sunken);
    border: none;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
  }

  .yt-thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.82;
    transition: opacity 200ms;
  }
  .yt-preview:hover .yt-thumb { opacity: 1; }

  .yt-play {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .yt-play svg {
    width: 52px;
    height: 52px;
    padding: 14px;
    color: rgba(232,223,208,.9);
    background: rgba(20,17,16,.72);
    border: 1px solid rgba(232,223,208,.45);
    border-radius: 50%;
    transition: background 200ms, border-color 200ms;
  }
  .yt-preview:hover .yt-play svg {
    background: rgba(175, 50, 30, .85);
    border-color: rgba(232,223,208,.7);
  }

  /* C6: matted frames instead of commercial YouTube thumbnails.
     With a poster image: full 16:9 frame in the standard mat.
     Without one: a compact listening strip (about a third of the 16:9 height)
     with the period sigil and the play button; the caption below carries
     title and composer. Clicking swaps in the 16:9 player as before. */
  .yt-preview.is-poster,
  .yt-preview.is-strip {
    background:
      repeating-linear-gradient(135deg, rgba(0,0,0,0.018) 0 14px, rgba(0,0,0,0.035) 14px 28px),
      linear-gradient(180deg, color-mix(in oklab, var(--sub-acc, var(--thread-acc, #C9A24B)) 24%, #F4EDDF), color-mix(in oklab, var(--sub-acc, var(--thread-acc, #C9A24B)) 7%, #F4EDDF));
  }
  .yt-preview.is-poster { padding: 18px; }
  .yt-poster-img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .yt-preview.is-strip {
    aspect-ratio: 16 / 3;
    min-height: 92px;
    padding: 14px;
  }
  .yt-strip {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 0 96px 0 18px;
    transition: background 200ms;
  }
  .yt-strip-sigil { flex: none; width: 44px; height: 44px; }
  .yt-strip-sigil :global(svg) { width: 100%; height: 100%; display: block; }
  .yt-strip-rule { flex: 1; height: 1px; background: var(--rule); }
  .yt-preview.is-strip .yt-play { justify-content: flex-end; padding-right: 34px; }
  .yt-preview.is-strip:hover .yt-strip { background: color-mix(in oklab, var(--bg-raised) 94%, var(--ink)); }
  @media (prefers-reduced-motion: reduce) { .yt-strip { transition: none; } }

  /* Created by script, so it carries no scope attribute: target it via :global */
  .yt-embed :global(.yt-iframe) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
  }

  .yt-caption {
    padding: 16px 22px 18px;
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .yt-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 15.5px;
    color: var(--ink);
    line-height: 1.3;
  }
  .yt-composer {
    font-family: var(--font-ui);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .yt-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-soft);
    margin-top: 4px;
    line-height: 1.6;
    white-space: pre-line;
  }
</style>
